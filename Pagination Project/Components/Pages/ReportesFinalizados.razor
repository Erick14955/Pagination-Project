@page "/reportes-finalizados"
@page "/finished-reports"
@page "/reportes"

@using System.Globalization
@using System.Text
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@using Pagination_Project.Data
@using Pagination_Project.Models
@using Pagination_Project.Services
@using ClosedXML.Excel

@attribute [Authorize]
@layout Pagination_Project.Components.Layout.DashboardLayout

@inject IDbContextFactory<AppDbContext> DbFactory
@inject IDashboardService DashboardService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IUserDataScopeService UserDataScopeService
@inject IJSRuntime JS

<PageTitle>Finished Reports</PageTitle>

@if (CargandoInicial)
{
    <div class="reports-page reports-skeleton-page"
         aria-busy="true"
         aria-label="Loading finished reports">

        <section class="page-hero reports-skeleton-hero">
            <div class="reports-skeleton-hero-copy">
                <div class="reports-skeleton-block reports-skeleton-main-title"></div>
                <div class="reports-skeleton-block reports-skeleton-description"></div>
                <div class="reports-skeleton-block reports-skeleton-description short"></div>
            </div>

            <div class="hero-stats">
                @for (var statIndex = 0; statIndex < 4; statIndex++)
                {
                    <div class="stat-card reports-skeleton-stat-card">
                        <div class="reports-skeleton-block reports-skeleton-stat-label"></div>
                        <div class="reports-skeleton-block reports-skeleton-stat-value"></div>
                    </div>
                }
            </div>
        </section>

        <section class="report-card reports-skeleton-filter-card">
            <div class="section-header">
                <div class="reports-skeleton-section-copy">
                    <div class="reports-skeleton-block reports-skeleton-section-title"></div>
                    <div class="reports-skeleton-block reports-skeleton-section-description"></div>
                </div>
            </div>

            <div class="reports-skeleton-filter-grid">
                @for (var fieldIndex = 0; fieldIndex < 4; fieldIndex++)
                {
                    <div class="reports-skeleton-field">
                        <div class="reports-skeleton-block reports-skeleton-label"></div>
                        <div class="reports-skeleton-block reports-skeleton-input"></div>
                    </div>
                }

                <div class="reports-skeleton-actions">
                    <div class="reports-skeleton-block reports-skeleton-button"></div>
                    <div class="reports-skeleton-block reports-skeleton-button"></div>
                    <div class="reports-skeleton-block reports-skeleton-button download"></div>
                </div>
            </div>
        </section>

        <section class="report-list-card reports-skeleton-list-card">
            <div class="list-header">
                <div class="reports-skeleton-section-copy">
                    <div class="reports-skeleton-block reports-skeleton-list-title"></div>
                    <div class="reports-skeleton-block reports-skeleton-list-description"></div>
                </div>

                <div class="reports-skeleton-block reports-skeleton-total-pill"></div>
            </div>

            <div class="reports-inline-skeleton reports-initial-table-skeleton">
                <div class="reports-skeleton-table-head">
                    @for (var columnIndex = 0; columnIndex < 9; columnIndex++)
                    {
                        <div class="reports-skeleton-block reports-skeleton-column"></div>
                    }
                </div>

                @for (var rowIndex = 0; rowIndex < 7; rowIndex++)
                {
                    <div class="reports-skeleton-table-row">
                        <div class="reports-skeleton-block reports-skeleton-cell wide"></div>
                        <div class="reports-skeleton-block reports-skeleton-cell medium"></div>
                        <div class="reports-skeleton-block reports-skeleton-cell small"></div>
                        <div class="reports-skeleton-block reports-skeleton-cell medium"></div>
                        <div class="reports-skeleton-block reports-skeleton-cell small"></div>
                        <div class="reports-skeleton-block reports-skeleton-cell medium"></div>
                        <div class="reports-skeleton-block reports-skeleton-cell small"></div>
                        <div class="reports-skeleton-block reports-skeleton-cell medium"></div>
                        <div class="reports-skeleton-block reports-skeleton-cell status"></div>
                    </div>
                }
            </div>
        </section>
    </div>
}
else
{
    <div class="reports-page">

        <section class="page-hero">
            <div>
                <h1>Finished Reports</h1>
                <p>
                    Review and download all finalized books, assignments and evaluations.
                </p>
            </div>

            <div class="hero-stats">
                <div class="stat-card">
                    <span>Books</span>
                    <strong>@LibrosReporte.Count</strong>
                </div>

                <div class="stat-card">
                    <span>Assignments</span>
                    <strong>@AsignacionesReporte.Count</strong>
                </div>

                <div class="stat-card">
                    <span>Evaluations</span>
                    <strong>@EvaluacionesReporte.Count</strong>
                </div>

                <div class="stat-card">
                    <span>Late Work</span>
                    <strong>@LateWorksReporte.Count</strong>
                </div>

            </div>
        </section>

        <section class="report-card">

            <div class="section-header">
                <div>
                    <h2>Report Filters</h2>
                    <p>Select the report type and apply filters before downloading.</p>
                </div>
            </div>

            <div class="filters-grid">

                <div class="field">
                    <label>Report Type</label>
                    <select @bind="TipoReporteSeleccionado" @bind:after="OnTipoReporteChanged">
                        <option value="Libros">Finished Books</option>
                        <option value="Asignaciones">Finished Assignments</option>
                        <option value="Evaluaciones">Finished Evaluations</option>
                        <option value="LateWork">Finished Late Work</option>
                        <option value="NextDayAssignments">Next Day Assignments</option>
                    </select>
                </div>

                <div class="field">
                    <label>Date From</label>
                    <input type="date" @bind="FechaDesde" disabled="@(!PermiteFiltroFechas)" />
                </div>

                <div class="field">
                    <label>Date To</label>
                    <input type="date" @bind="FechaHasta" disabled="@(!PermiteFiltroFechas)" />
                </div>

                <div class="field">
                    <label>Employee</label>
                    <select @bind="EmpleadoIdSeleccionado" disabled="@(!PermiteFiltroEmpleado)">
                        <option value="">All employees</option>
                        @foreach (var empleado in EmpleadosFiltro)
                        {
                            <option value="@empleado.Id">@empleado.Nombre</option>
                        }
                    </select>
                </div>

                <div class="actions-row">
                    <button class="btn-primary" @onclick="CargarReporteAsync">
                        Search
                    </button>

                    <button class="btn-secondary" @onclick="LimpiarFiltrosAsync">
                        Clear
                    </button>

                    <button class="btn-download" @onclick="DescargarReporteXlsxAsync" disabled="@(!TieneDatos)">
                        Download XLSX
                    </button>
                </div>

            </div>

        </section>

        <section class="report-list-card">

            <div class="list-header">
                <div>
                    <h2>@TituloListado</h2>
                    <p>@SubtituloListado</p>
                </div>

                <div class="total-pill">
                    @TotalActual records
                </div>
            </div>

            @if (Cargando)
            {
                <div class="reports-inline-skeleton"
                     aria-busy="true"
                     aria-label="Loading report">

                    <div class="reports-skeleton-table-head">
                        @for (var columnIndex = 0; columnIndex < 9; columnIndex++)
                        {
                            <div class="reports-skeleton-block reports-skeleton-column"></div>
                        }
                    </div>

                    @for (var rowIndex = 0; rowIndex < 6; rowIndex++)
                    {
                        <div class="reports-skeleton-table-row">
                            <div class="reports-skeleton-block reports-skeleton-cell wide"></div>
                            <div class="reports-skeleton-block reports-skeleton-cell medium"></div>
                            <div class="reports-skeleton-block reports-skeleton-cell small"></div>
                            <div class="reports-skeleton-block reports-skeleton-cell medium"></div>
                            <div class="reports-skeleton-block reports-skeleton-cell small"></div>
                            <div class="reports-skeleton-block reports-skeleton-cell medium"></div>
                            <div class="reports-skeleton-block reports-skeleton-cell small"></div>
                            <div class="reports-skeleton-block reports-skeleton-cell medium"></div>
                            <div class="reports-skeleton-block reports-skeleton-cell status"></div>
                        </div>
                    }
                </div>
            }
            else if (!TieneDatos)
            {
                <div class="empty-box">
                    @MensajeSinDatos
                </div>
            }
            else
            {
                @if (TipoReporteSeleccionado == "Libros")
                {
                    <div class="table-shell">
                        <table class="reports-table reports-table-books">
                            <thead>
                                <tr>
                                    <th>Book Name</th>
                                    @if (Scope.ViewAllEmployeeTypes)
                                    {
                                        <th>Department</th>
                                    }
                                    <th>KGEN</th>
                                    <th>LSA</th>
                                    <th>State</th>
                                    <th>Database</th>
                                    <th>Legacy</th>
                                    <th>Proof</th>
                                    <th>Final</th>
                                    <th>Memo</th>
                                    <th>Final PO</th>
                                    <th>Shipping</th>
                                    <th>Dirxion</th>
                                    <th>Pub Date</th>
                                    <th>Status</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var item in LibrosReporte)
                                {
                                    <tr>
                                        <td class="strong-cell">@item.BookName</td>
                                        @if (Scope.ViewAllEmployeeTypes)
                                        {
                                            <td><span class="kgen-pill">@item.EmployeeTypeCode</span></td>
                                        }
                                        <td>@item.Kgen</td>
                                        <td>@item.Lsa</td>
                                        <td>@item.State</td>
                                        <td>@item.Database</td>
                                        <td>@item.Legacy</td>
                                        <td>@FormatDate(item.ProofDate)</td>
                                        <td>@FormatDate(item.FinalDate)</td>
                                        <td>@FormatDate(item.MemoDate)</td>
                                        <td>@FormatDate(item.FinalPoDate)</td>
                                        <td>@FormatDate(item.ShippingDate)</td>
                                        <td>@FormatDate(item.DirxionDate)</td>
                                        <td>@FormatDate(item.PubDate)</td>
                                        <td>
                                            <span class="status-pill">Finished</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                @if (TipoReporteSeleccionado == "Asignaciones")
                {
                    <div class="table-shell">
                        <table class="reports-table reports-table-assignments">
                            <thead>
                                <tr>
                                    <th>Employee</th>
                                    @if (Scope.ViewAllEmployeeTypes)
                                    {
                                        <th>Department</th>
                                    }
                                    <th>Book Name</th>
                                    <th>KGEN</th>
                                    <th>Pub Date</th>
                                    <th>Dirxion Date</th>
                                    <th>Proof</th>
                                    <th>Final</th>
                                    <th>Memo</th>
                                    <th>Status</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var item in AsignacionesReporte)
                                {
                                    <tr>
                                        <td class="strong-cell">@item.EmployeeName</td>
                                        @if (Scope.ViewAllEmployeeTypes)
                                        {
                                            <td><span class="kgen-pill">@item.EmployeeTypeCode</span></td>
                                        }
                                        <td>@item.BookName</td>
                                        <td>@item.Kgen</td>
                                        <td>@FormatDate(item.PubDate)</td>
                                        <td>@FormatDate(item.DirectionDate)</td>
                                        <td>@FormatDate(item.ProofDate)</td>
                                        <td>@FormatDate(item.FinalDate)</td>
                                        <td>@FormatDate(item.MemoDate)</td>
                                        <td>
                                            <span class="status-pill">Finished</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                @if (TipoReporteSeleccionado == "Evaluaciones")
                {
                    <div class="table-shell">
                        <table class="reports-table reports-table-evaluations">
                            <thead>
                                <tr>
                                    <th>Employee</th>
                                    @if (Scope.ViewAllEmployeeTypes)
                                    {
                                        <th>Department</th>
                                    }
                                    <th>Book Name</th>
                                    <th>KGEN</th>
                                    <th>LSA</th>
                                    <th>Pub Date</th>
                                    <th>Motif YP</th>
                                    <th>Motif WP</th>
                                    <th>Inventory Report</th>
                                    <th>Shipping Folder</th>
                                    <th>Task Memo</th>
                                    <th>Total %</th>
                                    <th>Status</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var item in EvaluacionesReporte)
                                {
                                    <tr>
                                        <td class="strong-cell">@item.EmployeeName</td>
                                        @if (Scope.ViewAllEmployeeTypes)
                                        {
                                            <td><span class="kgen-pill">@item.EmployeeTypeCode</span></td>
                                        }
                                        <td>@item.BookName</td>
                                        <td>
                                            <span class="kgen-pill">@item.Kgen</span>
                                        </td>
                                        <td>@item.Lsa</td>
                                        <td>@FormatDate(item.PubDate)</td>
                                        <td>@FormatPercent(item.MotifYp)</td>
                                        <td>@FormatPercent(item.MotifWp)</td>
                                        <td>@FormatPercent(item.InventoryReport)</td>
                                        <td>@FormatPercent(item.ProductShippingFolder)</td>
                                        <td>@FormatPercent(item.TaskMemo)</td>
                                        <td class="total-percent">@FormatPercent(item.TotalPorcentaje)</td>
                                        <td>
                                            <span class="status-pill">Finished</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                @if (TipoReporteSeleccionado == "NextDayAssignments")
                {
                    <div class="table-shell">
                        <table class="reports-table reports-table-next-day">
                            <thead>
                                <tr>
                                    <th>Employee</th>
                                    @if (Scope.ViewAllEmployeeTypes)
                                    {
                                        <th>Department</th>
                                    }
                                    <th>KGEN Code</th>
                                    <th>LSA Code</th>
                                    <th>Book</th>
                                    <th>Database</th>
                                    <th>Stage</th>
                                    <th>Stage Date</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var item in AsignacionesDiaSiguienteReporte)
                                {
                                    <tr>
                                        <td class="strong-cell" data-label="Employee">@item.EmployeeName</td>
                                        @if (Scope.ViewAllEmployeeTypes)
                                        {
                                            <td data-label="Department"><span class="kgen-pill">@item.EmployeeTypeCode</span></td>
                                        }
                                        <td data-label="KGEN Code">
                                            <span class="kgen-pill">@item.KgenCode</span>
                                        </td>
                                        <td data-label="LSA Code">
                                            <span class="kgen-pill secondary">@item.LsaCode</span>
                                        </td>
                                        <td data-label="Book">@item.BookName</td>
                                        <td data-label="Database">
                                            @{
                                                var databaseCode = GetDatabaseCode(item.Database);
                                                var databaseFullName = GetDatabaseFullName(item.Database);
                                            }

                                            <span class="report-database-pill"
                                                  title="@databaseFullName"
                                                  aria-label="@databaseFullName">
                                                @databaseCode
                                            </span>
                                        </td>
                                        <td data-label="Stage">
                                            <span class="report-stage-pill @GetReportStageClass(item.StageKey)">
                                                @item.Stage
                                            </span>
                                        </td>
                                        <td data-label="Stage Date">@FormatDate(item.StageDate)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                @if (TipoReporteSeleccionado == "LateWork")
                {
                    <div class="table-shell">
                        <table class="reports-table reports-table-latework">
                            <thead>
                                <tr>
                                    <th>Employee</th>
                                    @if (Scope.ViewAllEmployeeTypes)
                                    {
                                        <th>Department</th>
                                    }
                                    <th>Book Name</th>
                                    <th>KGEN</th>
                                    <th>LSA</th>
                                    <th>Late Work ID</th>
                                    <th>Client ID</th>
                                    <th>Dirxion Date</th>
                                    <th>Created At</th>
                                    <th>Completed</th>
                                    <th>Completed At</th>
                                    <th>Status</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var item in LateWorksReporte)
                                {
                                    <tr>
                                        <td class="strong-cell">@item.EmployeeName</td>
                                        @if (Scope.ViewAllEmployeeTypes)
                                        {
                                            <td><span class="kgen-pill">@item.EmployeeTypeCode</span></td>
                                        }
                                        <td>@item.BookName</td>
                                        <td>
                                            <span class="kgen-pill">@item.Kgen</span>
                                        </td>
                                        <td>@item.Lsa</td>
                                        <td>@item.LateWorkId</td>
                                        <td>@item.ClientId</td>
                                        <td>@FormatDate(item.DirxionDate)</td>
                                        <td>@FormatDateTime(item.CreatedAt)</td>
                                        <td>
                                            @(item.Completed ? "Yes" : "No")
                                        </td>
                                        <td>@FormatDateTime(item.CompletedAt)</td>
                                        <td>
                                            <span class="status-pill">Finished Book</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }

        </section>

    </div>
}

@code {

    private string TipoReporteSeleccionado { get; set; } = "Libros";

    private DateTime? FechaDesde { get; set; }
    private DateTime? FechaHasta { get; set; }

    private DateOnly FechaAsignacionesDiaSiguiente { get; set; }

    private Guid? EmpleadoIdSeleccionado { get; set; }

    private bool CargandoInicial { get; set; } = true;
    private bool _cargaInicialIniciada;
    private bool Cargando { get; set; }
    private UserDataScope Scope { get; set; } = new();

    private List<EmpleadoFiltroDto> EmpleadosFiltro { get; set; } = new();

    private List<LibroReporteDto> LibrosReporte { get; set; } = new();
    private List<AsignacionReporteDto> AsignacionesReporte { get; set; } = new();
    private List<EvaluacionReporteDto> EvaluacionesReporte { get; set; } = new();
    private List<LateWorkReporteDto> LateWorksReporte { get; set; } = new();
    private List<AssignedBookDashboardDto> AsignacionesDiaSiguienteReporte { get; set; } = new();
    private List<Database> Databases { get; set; } = new();
    private List<Legacy_Code> LegacyCodes { get; set; } = new();
    private List<State> States { get; set; } = new();

    private bool PermiteFiltroEmpleado =>
        TipoReporteSeleccionado == "Asignaciones" ||
        TipoReporteSeleccionado == "Evaluaciones" ||
        TipoReporteSeleccionado == "LateWork" ||
        TipoReporteSeleccionado == "NextDayAssignments";

    private bool PermiteFiltroFechas =>
        TipoReporteSeleccionado != "NextDayAssignments";

    private bool TieneDatos =>
        TipoReporteSeleccionado switch
        {
            "Libros" => LibrosReporte.Any(),
            "Asignaciones" => AsignacionesReporte.Any(),
            "Evaluaciones" => EvaluacionesReporte.Any(),
            "LateWork" => LateWorksReporte.Any(),
            "NextDayAssignments" => AsignacionesDiaSiguienteReporte.Any(),
            _ => false
        };

    private int TotalActual =>
        TipoReporteSeleccionado switch
        {
            "Libros" => LibrosReporte.Count,
            "Asignaciones" => AsignacionesReporte.Count,
            "Evaluaciones" => EvaluacionesReporte.Count,
            "LateWork" => LateWorksReporte.Count,
            "NextDayAssignments" => AsignacionesDiaSiguienteReporte.Count,
            _ => 0
        };

    private string TituloListado =>
        TipoReporteSeleccionado switch
        {
            "Libros" => "Finished Books List",
            "Asignaciones" => "Finished Assignments List",
            "Evaluaciones" => "Finished Evaluations List",
            "LateWork" => "Finished Late Work List",
            "NextDayAssignments" => "Next Day Assignments List",
            _ => "Finished Report"
        };

    private string SubtituloListado =>
        TipoReporteSeleccionado switch
        {
            "Libros" => "Showing only finalized books.",
            "Asignaciones" => "Showing only finalized assignments.",
            "Evaluaciones" => "Showing only finalized evaluations.",
            "LateWork" => "Showing Late Work activities from books already finalized by Dirxion date.",
            "NextDayAssignments" => $"Assignments scheduled for {FechaAsignacionesDiaSiguiente:MM/dd/yyyy}, using the same stage rules as Assigned Books.",
            _ => string.Empty
        };

    private string MensajeSinDatos =>
        TipoReporteSeleccionado == "NextDayAssignments"
            ? $"No assignments found for {FechaAsignacionesDiaSiguiente:MM/dd/yyyy}."
            : "No finalized records found with the selected filters.";

    protected override void OnInitialized()
    {
        FechaDesde = DateTime.Today.AddMonths(-1);
        FechaHasta = DateTime.Today;
        FechaAsignacionesDiaSiguiente = ObtenerSiguienteDiaLaborable(
            DateOnly.FromDateTime(DateTime.Today));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _cargaInicialIniciada)
            return;

        _cargaInicialIniciada = true;
        await CargarPaginaInicialAsync();
    }

    private async Task CargarPaginaInicialAsync()
    {
        CargandoInicial = true;
        Cargando = true;

        try
        {
            var authState =
                await AuthenticationStateProvider.GetAuthenticationStateAsync();

            Scope =
                await UserDataScopeService.GetScopeAsync(authState.User);

            await Task.WhenAll(
                CargarCatalogosAsync(),
                CargarEmpleadosAsync());

            await CargarReporteAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading finished reports: {ex}");

            LibrosReporte = new List<LibroReporteDto>();
            AsignacionesReporte = new List<AsignacionReporteDto>();
            EvaluacionesReporte = new List<EvaluacionReporteDto>();
            LateWorksReporte = new List<LateWorkReporteDto>();
            AsignacionesDiaSiguienteReporte = new List<AssignedBookDashboardDto>();
        }
        finally
        {
            Cargando = false;
            CargandoInicial = false;

            await InvokeAsync(StateHasChanged);
        }
    }
    private string GetStateName(Guid? id)
    {
        return States.FirstOrDefault(x => x.Id == id)?.State_Name ?? "-";
    }

    private string GetDatabaseName(Guid? id)
    {
        return Databases.FirstOrDefault(x => x.Id == id)?.Database_Name ?? "-";
    }

    private string GetLegacyCodeName(Guid? id)
    {
        return LegacyCodes.FirstOrDefault(x => x.Id == id)?.Legacy_Code_Name ?? "-";
    }


    private async Task CargarCatalogosAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        Databases = await db.Databases
            .AsNoTracking()
            .OrderBy(x => x.Database_Name)
            .ToListAsync();

        LegacyCodes = await db.Legacy_Codes
            .AsNoTracking()
            .OrderBy(x => x.Legacy_Code_Name)
            .ToListAsync();

        States = await db.States
            .AsNoTracking()
            .OrderBy(x => x.State_Name)
            .ToListAsync();
    }

    private static string FormatDateTime(DateTime? date)
    {
        return date.HasValue
            ? date.Value.ToString("MM/dd/yyyy", CultureInfo.InvariantCulture)
            : "";
    }

    private async Task CargarEmpleadosAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        EmpleadosFiltro = await db.Empleados
            .AsNoTracking()
            .ApplyScope(Scope)
            .OrderBy(e => e.Nombre)
            .Select(e => new EmpleadoFiltroDto
            {
                Id = e.Id,
                Nombre = e.Nombre
            })
            .ToListAsync();
    }

    private async Task OnTipoReporteChanged()
    {
        if (!PermiteFiltroEmpleado)
            EmpleadoIdSeleccionado = null;

        await CargarReporteAsync();
    }

    private async Task LimpiarFiltrosAsync()
    {
        FechaDesde = DateTime.Today.AddMonths(-1);
        FechaHasta = DateTime.Today;
        EmpleadoIdSeleccionado = null;

        await CargarReporteAsync();
    }

    private async Task CargarReporteAsync()
    {
        Cargando = true;

        LibrosReporte.Clear();
        AsignacionesReporte.Clear();
        EvaluacionesReporte.Clear();
        LateWorksReporte.Clear();
        AsignacionesDiaSiguienteReporte.Clear();

        try
        {
            if (TipoReporteSeleccionado == "NextDayAssignments")
            {
                await CargarAsignacionesDiaSiguienteAsync();
                return;
            }

            await using var db = await DbFactory.CreateDbContextAsync();

            await MarcarFinalizadosAutomaticamenteAsync(db);

            if (TipoReporteSeleccionado == "Libros")
            {
                await CargarLibrosFinalizadosAsync(db);
            }
            else if (TipoReporteSeleccionado == "Asignaciones")
            {
                await CargarAsignacionesFinalizadasAsync(db);
            }
            else if (TipoReporteSeleccionado == "Evaluaciones")
            {
                await CargarEvaluacionesFinalizadasAsync(db);
            }
            else if (TipoReporteSeleccionado == "LateWork")
            {
                await CargarLateWorkFinalizadosAsync(db);
            }
        }
        finally
        {
            Cargando = false;
        }
    }

    private async Task DescargarReporteXlsxAsync()
    {
        if (!TieneDatos)
            return;

        try
        {
            using var workbook = new XLWorkbook();

            if (TipoReporteSeleccionado == "Libros")
            {
                GenerarHojaLibros(workbook);
            }
            else if (TipoReporteSeleccionado == "Asignaciones")
            {
                GenerarHojaAsignaciones(workbook);
            }
            else if (TipoReporteSeleccionado == "Evaluaciones")
            {
                GenerarHojaEvaluaciones(workbook);
            }
            else if (TipoReporteSeleccionado == "LateWork")
            {
                GenerarHojaLateWork(workbook);
            }
            else if (TipoReporteSeleccionado == "NextDayAssignments")
            {
                GenerarHojaAsignacionesDiaSiguiente(workbook);
            }

            using var stream = new MemoryStream();
            workbook.SaveAs(stream);

            var bytes = stream.ToArray();
            var base64 = Convert.ToBase64String(bytes);

            var fileName = TipoReporteSeleccionado switch
            {
                "Libros" => $"Finished_Books_{DateTime.Now:yyyyMMdd_HHmmss}.xlsx",
                "Asignaciones" => $"Finished_Assignments_{DateTime.Now:yyyyMMdd_HHmmss}.xlsx",
                "Evaluaciones" => $"Finished_Evaluations_{DateTime.Now:yyyyMMdd_HHmmss}.xlsx",
                "LateWork" => $"Finished_Late_Work_{DateTime.Now:yyyyMMdd_HHmmss}.xlsx",
                "NextDayAssignments" => $"Next_Day_Assignments_{FechaAsignacionesDiaSiguiente:yyyyMMdd}.xlsx",
                _ => $"Finished_Report_{DateTime.Now:yyyyMMdd_HHmmss}.xlsx"
            };

            await JS.InvokeVoidAsync(
                "downloadFileFromBase64",
                fileName,
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
                base64);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error generating XLSX: {ex.Message}");
        }
    }

    private async Task CargarAsignacionesDiaSiguienteAsync()
    {
        FechaAsignacionesDiaSiguiente = ObtenerSiguienteDiaLaborable(
            DateOnly.FromDateTime(DateTime.Today));

        var asignaciones = await DashboardService.GetAssignedBooksForDateAsync(
            FechaAsignacionesDiaSiguiente,
            Scope);

        if (EmpleadoIdSeleccionado.HasValue)
        {
            asignaciones = asignaciones
                .Where(x => x.EmployeeId == EmpleadoIdSeleccionado.Value)
                .ToList();
        }

        AsignacionesDiaSiguienteReporte = asignaciones
            .OrderBy(x => x.StageDate)
            .ThenBy(x => x.EmployeeName)
            .ThenBy(x => x.BookName)
            .ToList();
    }

    private static DateOnly ObtenerSiguienteDiaLaborable(DateOnly fechaActual)
    {
        var fecha = fechaActual.AddDays(1);

        while (fecha.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday)
        {
            fecha = fecha.AddDays(1);
        }

        return fecha;
    }

    private static string GetDatabaseCode(string? database)
    {
        return string.IsNullOrWhiteSpace(database)
            ? "-"
            : database.Trim().ToUpperInvariant();
    }

    private static string GetDatabaseFullName(string? database)
    {
        if (string.IsNullOrWhiteSpace(database))
            return "Database not available";

        var code = database.Trim().ToUpperInvariant();

        return code switch
        {
            "DW" => "WEST",
            "SN" => "vNorth",
            "SW" => "vWest",
            "SS" => "vSouth",
            _ => database.Trim()
        };
    }

    private static string GetReportStageClass(string? stageKey)
    {
        return (stageKey ?? string.Empty).Trim() switch
        {
            "ProofExtract" => "stage-proofextract",
            "FinalExtract" => "stage-finalextract",
            "MemoExtract" => "stage-memoextract",
            "FinalPO" => "stage-finalpo",
            "Shipping" => "stage-shipping",
            "Dirxion" => "stage-dirxion",
            _ => "stage-default"
        };
    }

    private async Task CargarLateWorkFinalizadosAsync(AppDbContext db)
    {
        var query = db.LateWorkActivities
            .AsNoTracking()
            .Include(x => x.Assignment)
                .ThenInclude(a => a!.Empleado)
            .Include(x => x.Assignment)
                .ThenInclude(a => a!.Libro)
                    .ThenInclude(l => l!.EmployeeType)
            .Where(x =>
                x.Assignment != null &&
                x.Assignment.Libro != null &&
                x.Assignment.Libro.Finalizado == true &&
                (Scope.ViewAllEmployeeTypes ||
                 x.Assignment.Libro.EmployeeTypeId == Scope.EmployeeTypeId));

        if (EmpleadoIdSeleccionado.HasValue)
        {
            query = query.Where(x =>
                x.Assignment != null &&
                x.Assignment.IdEmpleado == EmpleadoIdSeleccionado.Value);
        }

        if (FechaDesde.HasValue)
        {
            var desde = DateOnly.FromDateTime(FechaDesde.Value);

            query = query.Where(x =>
                x.Assignment != null &&
                x.Assignment.Libro != null &&
                x.Assignment.Libro.DirxionDate >= desde);
        }

        if (FechaHasta.HasValue)
        {
            var hasta = DateOnly.FromDateTime(FechaHasta.Value);

            query = query.Where(x =>
                x.Assignment != null &&
                x.Assignment.Libro != null &&
                x.Assignment.Libro.DirxionDate <= hasta);
        }

        LateWorksReporte = await query
            .OrderByDescending(x =>
                x.Assignment != null && x.Assignment.Libro != null
                    ? x.Assignment.Libro.DirxionDate
                    : DateOnly.MinValue)
            .Select(x => new LateWorkReporteDto
            {
                EmployeeTypeCode =
                    x.Assignment != null && x.Assignment.Libro != null && x.Assignment.Libro.EmployeeType != null
                        ? x.Assignment.Libro.EmployeeType.Code
                        : "",

                EmployeeName =
                    x.Assignment != null && x.Assignment.Empleado != null
                        ? x.Assignment.Empleado.Nombre
                        : "",

                BookName =
                    x.Assignment != null && x.Assignment.Libro != null
                        ? x.Assignment.Libro.BookName
                        : "",

                Kgen =
                    x.Assignment != null && x.Assignment.Libro != null
                        ? x.Assignment.Libro.KGENCode
                        : "",

                Lsa =
                    x.Assignment != null && x.Assignment.Libro != null
                        ? x.Assignment.Libro.LSACode
                        : "",

                LateWorkId = x.LateWorkId,
                ClientId = x.ClientId,
                Completed = x.Completed,
                CompletedAt = x.CompletedAt,
                CreatedAt = x.CreatedAt,

                DirxionDate =
                    x.Assignment != null && x.Assignment.Libro != null
                        ? x.Assignment.Libro.DirxionDate
                        : null
            })
            .ToListAsync();
    }

