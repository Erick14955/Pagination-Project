    private async Task CargarEmpleadosFiltroAsync()
    {
        EmpleadosFiltro.Clear();


        if (!PermiteFiltroEmpleado)
        {
            EmpleadoIdSeleccionado =
                null;

            return;
        }

        if (EsReporteAsignacionesProgramadas)
        {
            var fechaReporte =
                FechaAsignacionesProgramadasActual;


            await AsegurarAsignacionesProgramadasBaseAsync(
                fechaReporte);


            var baseAsignaciones =
                _asignacionesProgramadasBase;


            if (baseAsignaciones is null ||
                baseAsignaciones.Count == 0)
            {
                EmpleadoIdSeleccionado =
                    null;

                return;
            }


            EmpleadosFiltro =
                baseAsignaciones

                    .Where(x =>
                        x.EmployeeId != Guid.Empty &&
                        !string.IsNullOrWhiteSpace(
                            x.EmployeeName))

                    .GroupBy(x =>
                        x.EmployeeId)

                    .Select(g =>
                        new EmpleadoFiltroDto
                        {
                            Id =
                                g.Key,

                            Nombre =
                                g.Select(x =>
                                        x.EmployeeName)

                                    .FirstOrDefault(n =>
                                        !string.IsNullOrWhiteSpace(n))

                                ?? string.Empty
                        })

                    .Where(x =>
                        !string.IsNullOrWhiteSpace(
                            x.Nombre))

                    .OrderBy(x =>
                        x.Nombre)

                    .ToList();


            ValidarEmpleadoSeleccionado();

            return;
        }

        await using var db =
            await DbFactory.CreateDbContextAsync();


        if (TipoReporteSeleccionado == "Asignaciones")
        {
            EmpleadosFiltro =
                await db.Asignaciones
                    .AsNoTracking()
                    .ApplyScope(Scope)

                    .Where(a =>
                        a.Finalizado &&
                        a.Empleado != null)

                    .Select(a =>
                        new EmpleadoFiltroDto
                        {
                            Id =
                                a.IdEmpleado,

                            Nombre =
                                a.Empleado!.Nombre
                                ?? string.Empty
                        })

                    .Distinct()

                    .OrderBy(x =>
                        x.Nombre)

                    .ToListAsync();
        }
        else if (TipoReporteSeleccionado == "Evaluaciones")
        {
            EmpleadosFiltro =
                await db.Evaluaciones
                    .AsNoTracking()
                    .ApplyScope(Scope)

                    .Where(e =>
                        e.Finalizado &&
                        e.Asignacion != null &&
                        e.Asignacion.Empleado != null)

                    .Select(e =>
                        new EmpleadoFiltroDto
                        {
                            Id =
                                e.Asignacion!.IdEmpleado,

                            Nombre =
                                e.Asignacion.Empleado!.Nombre
                                ?? string.Empty
                        })

                    .Distinct()

                    .OrderBy(x =>
                        x.Nombre)

                    .ToListAsync();
        }
        else if (TipoReporteSeleccionado == "LateWork")
        {
            EmpleadosFiltro =
                await db.Empleados
                    .AsNoTracking()
                    .ApplyScope(Scope)

                    .OrderBy(e =>
                        e.Nombre)

                    .Select(e =>
                        new EmpleadoFiltroDto
                        {
                            Id =
                                e.Id,

                            Nombre =
                                e.Nombre
                                ?? string.Empty
                        })

                    .ToListAsync();
        }


        ValidarEmpleadoSeleccionado();
    }


    private void ValidarEmpleadoSeleccionado()
    {
        if (!EmpleadoIdSeleccionado.HasValue)
            return;


        if (!EmpleadosFiltro.Any(
                x =>
                    x.Id ==
                    EmpleadoIdSeleccionado.Value))
        {
            EmpleadoIdSeleccionado =
                null;
        }
    }

    private async Task OnTipoReporteChanged()
    {
        if (EsEmpleado &&
            !EsReportePermitidoParaEmpleado(
                TipoReporteSeleccionado))
        {
            TipoReporteSeleccionado =
                "NextDayAssignments";
        }


        if (TipoReporteSeleccionado == "AssignmentsByDate" &&
            !FechaReporteSeleccionada.HasValue)
        {
            FechaReporteSeleccionada =
                DateTime.Today;
        }


        EmpleadoIdSeleccionado =
            null;


        InvalidarCacheAsignacionesProgramadas();


        await EjecutarCargaReporteAsync(
            recargarEmpleados: true);
    }

    private async Task LimpiarFiltrosAsync()
    {
        FechaDesde =
            DateTime.Today.AddMonths(-1);

        FechaHasta =
            DateTime.Today;

        FechaReporteSeleccionada =
            DateTime.Today;

        EmpleadoIdSeleccionado =
            null;


        if (EsReporteAsignacionesProgramadas)
        {
            InvalidarCacheAsignacionesProgramadas();
        }


        await EjecutarCargaReporteAsync(
            recargarEmpleados:
                EsReporteAsignacionesProgramadas);
    }

    private async Task CargarReporteAsync()
    {
        if (!PuedeBuscar)
            return;


        if (EsEmpleado &&
            !EsReportePermitidoParaEmpleado(
                TipoReporteSeleccionado))
        {
            TipoReporteSeleccionado =
                "NextDayAssignments";
        }


        await EjecutarCargaReporteAsync(
            recargarEmpleados:
                EsReporteAsignacionesProgramadas,

            mostrarResultado:
                true);
    }

    private async Task EjecutarCargaReporteAsync(
        bool recargarEmpleados,
        bool mostrarResultado = false)
    {
        Cargando = true;


        LimpiarDatosReporte();


        await InvokeAsync(
            StateHasChanged);

        await Task.Yield();


        try
        {
            await PrepararFinalizadosSiAplicaAsync();


            if (recargarEmpleados)
            {
                await CargarEmpleadosFiltroAsync();
            }


            await CargarReporteDatosAsync();


            if (mostrarResultado)
            {
                if (TieneDatos)
                {
                    MostrarResultadoReporte(
                        "Report ready",

                        $"{TituloReporteActual} loaded successfully with {TotalActual} record{(TotalActual == 1 ? string.Empty : "s")}.",

                        "success");
                }
                else
                {
                    MostrarResultadoReporte(
                        "No records found",

                        MensajeSinDatos,

                        "info");
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"Error loading selected report: {ex}");


            LimpiarDatosReporte();


            MostrarResultadoReporte(
                "Unable to load report",

                $"The selected report could not be loaded. Details: {ex.Message}",

                "error");
        }
        finally
        {
            Cargando = false;


            await InvokeAsync(
                StateHasChanged);
        }
    }

    private async Task PrepararFinalizadosSiAplicaAsync()
    {
        if (EsReporteAsignacionesProgramadas)
            return;


        var hoy =
            DateOnly.FromDateTime(
                DateTime.Today);

        if (_fechaFinalizacionAutomaticaAplicada ==
            hoy)
        {
            return;
        }


        await using var db =
            await DbFactory.CreateDbContextAsync();


        await MarcarFinalizadosAutomaticamenteAsync(
            db);


        _fechaFinalizacionAutomaticaAplicada =
            hoy;
    }

    private async Task CargarReporteDatosAsync()
    {
        if (EsEmpleado &&
            !EsReportePermitidoParaEmpleado(
                TipoReporteSeleccionado))
        {
            TipoReporteSeleccionado =
                "NextDayAssignments";
        }


        if (EsReporteAsignacionesProgramadas)
        {
            await CargarAsignacionesProgramadasAsync();

            return;
        }


        await using var db =
            await DbFactory.CreateDbContextAsync();


        switch (TipoReporteSeleccionado)
        {
            case "Libros":

                await CargarLibrosFinalizadosAsync(
                    db);

                break;


            case "Asignaciones":

                await CargarAsignacionesFinalizadasAsync(
                    db);

                break;


            case "Evaluaciones":

                await CargarEvaluacionesFinalizadasAsync(
                    db);

                break;


            case "LateWork":

                await CargarLateWorkFinalizadosAsync(
                    db);

                break;
        }
    }

    private void MostrarResultadoReporte(
        string titulo,
        string mensaje,
        string tipo)
    {
        TituloModalResultadoReporte =
            titulo;


        MensajeModalResultadoReporte =
            mensaje;


        TipoModalResultadoReporte =
            tipo.ToLowerInvariant() switch
            {
                "error" =>
                    "error",

                "info" =>
                    "info",

                _ =>
                    "success"
            };


        MostrarModalResultadoReporte =
            true;
    }


    private void CerrarModalResultadoReporte()
    {
        MostrarModalResultadoReporte =
            false;

        TituloModalResultadoReporte =
            string.Empty;

        MensajeModalResultadoReporte =
            string.Empty;

        TipoModalResultadoReporte =
            "success";
    }

    private void LimpiarDatosReporte()
    {
        LibrosReporte.Clear();

        AsignacionesReporte.Clear();

        EvaluacionesReporte.Clear();

        LateWorksReporte.Clear();

        AsignacionesDiaSiguienteReporte.Clear();
    }

    private async Task CargarAsignacionesProgramadasAsync()
    {
        var fechaReporte =
            FechaAsignacionesProgramadasActual;


        await AsegurarAsignacionesProgramadasBaseAsync(
            fechaReporte);


        IEnumerable<AssignedBookDashboardDto>
            asignaciones =
                _asignacionesProgramadasBase
                ?? Enumerable.Empty<AssignedBookDashboardDto>();


        if (EmpleadoIdSeleccionado.HasValue)
        {
            asignaciones =
                asignaciones.Where(
                    x =>
                        x.EmployeeId ==
                        EmpleadoIdSeleccionado.Value);
        }


        AsignacionesDiaSiguienteReporte =
            asignaciones

                .OrderBy(x =>
                    x.StageDate)

                .ThenBy(x =>
                    x.EmployeeName)

                .ThenBy(x =>
                    x.BookName)

                .ToList();
    }


    private async Task AsegurarAsignacionesProgramadasBaseAsync(
        DateOnly fechaReporte)
    {
        if (_asignacionesProgramadasBase is not null &&
            _fechaAsignacionesProgramadasBase ==
            fechaReporte)
        {
            return;
        }


        _asignacionesProgramadasBase =
            await DashboardService
                .GetAssignedBooksForDateAsync(
                    fechaReporte,
                    Scope);


        _fechaAsignacionesProgramadasBase =
            fechaReporte;
    }


    private void InvalidarCacheAsignacionesProgramadas()
    {
        _asignacionesProgramadasBase =
            null;

        _fechaAsignacionesProgramadasBase =
            null;
    }

    private static bool EsReportePermitidoParaEmpleado(
        string tipoReporte)
    {
        return
            tipoReporte == "NextDayAssignments" ||
            tipoReporte == "AssignmentsByDate";
    }


    private static bool EsUsuarioEmpleado(
        ClaimsPrincipal user)
    {
        var lvlId =
            user.FindFirst("LvlId")
                ?.Value;


        var role =
            user.FindFirst(
                    ClaimTypes.Role)
                ?.Value

            ??

            user.FindFirst("Role")
                ?.Value

            ??

            user.FindFirst("RoleName")
                ?.Value

            ??

            user.FindFirst("PermissionLevel")
                ?.Value

            ??

            string.Empty;


        return
            lvlId == "4"

            ||

            role.Equals(
                "Employee",
                StringComparison.OrdinalIgnoreCase)

            ||

            role.Equals(
                "User",
                StringComparison.OrdinalIgnoreCase);
    }

    private static DateOnly ObtenerSiguienteDiaLaborable(
        DateOnly fechaActual)
    {
        var fecha =
            fechaActual.AddDays(1);


        while (fecha.DayOfWeek is
               DayOfWeek.Saturday or
               DayOfWeek.Sunday)
        {
            fecha =
                fecha.AddDays(1);
        }


        return fecha;
    }

    private static string GetDatabaseCode(
        string? database)
    {
        return string.IsNullOrWhiteSpace(database)
            ? "-"
            : database
                .Trim()
                .ToUpperInvariant();
    }


    private static string GetDatabaseFullName(
        string? database)
    {
        if (string.IsNullOrWhiteSpace(database))
        {
            return "Database not available";
        }


        var code =
            database
                .Trim()
                .ToUpperInvariant();


        return code switch
        {
            "DW" =>
                "WEST",

            "SN" =>
                "vNorth",

            "SW" =>
                "vWest",

            "SS" =>
                "vSouth",

            _ =>
                database.Trim()
        };
    }

