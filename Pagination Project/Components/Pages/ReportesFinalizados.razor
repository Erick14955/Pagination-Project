    protected override void OnInitialized()
    {
        FechaDesde =
            DateTime.Today.AddMonths(-1);

        FechaHasta =
            DateTime.Today;

        FechaReporteSeleccionada =
            DateTime.Today;

        FechaAsignacionesDiaSiguiente =
            ObtenerSiguienteDiaLaborable(
                DateOnly.FromDateTime(
                    DateTime.Today));
    }


    protected override async Task OnAfterRenderAsync(
        bool firstRender)
    {
        if (!firstRender ||
            _cargaInicialIniciada)
        {
            return;
        }

        _cargaInicialIniciada =
            true;

        await CargarPaginaInicialAsync();
    }

    private async Task CargarPaginaInicialAsync()
    {
        CargandoInicial = true;
        Cargando = true;

        try
        {
            var authState =
                await AuthenticationStateProvider
                    .GetAuthenticationStateAsync();


            EsEmpleado =
                EsUsuarioEmpleado(
                    authState.User);


            if (EsEmpleado)
            {
                TipoReporteSeleccionado =
                    "NextDayAssignments";
            }


            Scope =
                await UserDataScopeService
                    .GetScopeAsync(
                        authState.User);


            EmpleadosFiltro.Clear();

            EmpleadoIdSeleccionado =
                null;

            await PrepararFinalizadosSiAplicaAsync();


            await CargarEmpleadosFiltroAsync();

            await CargarReporteDatosAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"Error loading finished reports: {ex}");


            LimpiarDatosReporte();


            MostrarResultadoReporte(
                "Unable to load reports",

                $"The reports page could not be loaded. Details: {ex.Message}",

                "error");
        }
        finally
        {
            Cargando = false;
            CargandoInicial = false;

            await InvokeAsync(
                StateHasChanged);
        }
    }

    private async Task AsegurarCatalogosAsync()
    {
        if (_catalogosCargados)
            return;


        await using var db =
            await DbFactory.CreateDbContextAsync();


        _databaseNames =
            await db.Databases
                .AsNoTracking()

                .ToDictionaryAsync(
                    x => x.Id,
                    x => x.Database_Name ?? "-");


        _legacyCodeNames =
            await db.Legacy_Codes
                .AsNoTracking()

                .ToDictionaryAsync(
                    x => x.Id,
                    x => x.Legacy_Code_Name ?? "-");


        _stateNames =
            await db.States
                .AsNoTracking()

                .ToDictionaryAsync(
                    x => x.Id,
                    x => x.State_Name ?? "-");


        _catalogosCargados =
            true;
    }


