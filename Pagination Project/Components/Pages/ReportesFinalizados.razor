    private async Task DescargarReporteXlsxAsync()
    {
        if (DescargandoReporte)
            return;


        if (EsEmpleado &&
            !EsReportePermitidoParaEmpleado(
                TipoReporteSeleccionado))
        {
            MostrarResultadoReporte(
                "Report not available",

                "Your user role does not have access to the selected report.",

                "error");

            return;
        }


        if (!TieneDatos)
        {
            MostrarResultadoReporte(
                "No data to download",

                "Load a report with records before downloading the XLSX file.",

                "info");

            return;
        }


        try
        {
            DescargandoReporte =
                true;


            await InvokeAsync(
                StateHasChanged);


            using var workbook =
                new XLWorkbook();


            switch (TipoReporteSeleccionado)
            {
                case "Libros":

                    GenerarHojaLibros(
                        workbook);

                    break;


                case "Asignaciones":

                    GenerarHojaAsignaciones(
                        workbook);

                    break;


                case "Evaluaciones":

                    GenerarHojaEvaluaciones(
                        workbook);

                    break;


                case "LateWork":

                    GenerarHojaLateWork(
                        workbook);

                    break;


                default:

                    if (EsReporteAsignacionesProgramadas)
                    {
                        GenerarHojaAsignacionesProgramadas(
                            workbook);
                    }

                    break;
            }


            using var stream =
                new MemoryStream();


            workbook.SaveAs(
                stream);


            var bytes =
                stream.ToArray();


            var base64 =
                Convert.ToBase64String(
                    bytes);


            var fileName =
                TipoReporteSeleccionado switch
                {
                    "Libros" =>
                        $"Finished_Books_{DateTime.Now:yyyyMMdd_HHmmss}.xlsx",

                    "Asignaciones" =>
                        $"Finished_Assignments_{DateTime.Now:yyyyMMdd_HHmmss}.xlsx",

                    "Evaluaciones" =>
                        $"Finished_Evaluations_{DateTime.Now:yyyyMMdd_HHmmss}.xlsx",

                    "LateWork" =>
                        $"Finished_Late_Work_{DateTime.Now:yyyyMMdd_HHmmss}.xlsx",

                    "NextDayAssignments" =>
                        $"Next_Day_Assignments_{FechaAsignacionesDiaSiguiente:yyyyMMdd}.xlsx",

                    "AssignmentsByDate" =>
                        $"Assignments_By_Date_{FechaAsignacionesProgramadasActual:yyyyMMdd}.xlsx",

                    _ =>
                        $"Finished_Report_{DateTime.Now:yyyyMMdd_HHmmss}.xlsx"
                };


            await JS.InvokeVoidAsync(
                "downloadFileFromBase64",
                fileName,
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
                base64);


            MostrarResultadoReporte(
                "Report downloaded",

                $"{TituloReporteActual} was downloaded successfully with {TotalActual} record{(TotalActual == 1 ? string.Empty : "s")}.",

                "success");
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"Error generating XLSX: {ex}");


            MostrarResultadoReporte(
                "Unable to download report",

                $"The XLSX file could not be generated. Details: {ex.Message}",

                "error");
        }
        finally
        {
            DescargandoReporte =
                false;


            await InvokeAsync(
                StateHasChanged);
        }
    }

