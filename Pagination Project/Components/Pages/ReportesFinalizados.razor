    private static void EscribirFechaExcel(IXLCell cell, DateOnly? fecha)
    {
        if (fecha.HasValue)
        {
            var dateTime = fecha.Value.ToDateTime(TimeOnly.MinValue);
            cell.Value = dateTime;
            cell.Style.DateFormat.Format = "MM/dd/yyyy";
        }
        else
        {
            cell.Value = "-";
        }
    }

    private static void EscribirPorcentajeExcel(IXLCell cell, decimal? porcentaje)
    {
        if (porcentaje.HasValue)
        {
            cell.Value = porcentaje.Value / 100m;
            cell.Style.NumberFormat.Format = "0.00%";
        }
        else
        {
            cell.Value = 0;
            cell.Style.NumberFormat.Format = "0.00%";
        }
    }

    private static void AplicarEstiloExcel(IXLWorksheet worksheet, int lastRow, int lastColumn)
    {
        if (lastRow < 1)
            lastRow = 1;

        var header = worksheet.Range(1, 1, 1, lastColumn);

        header.Style.Font.Bold = true;
        header.Style.Font.FontColor = XLColor.White;
        header.Style.Fill.BackgroundColor = XLColor.FromHtml("#111827");
        header.Style.Alignment.Horizontal = XLAlignmentHorizontalValues.Center;
        header.Style.Alignment.Vertical = XLAlignmentVerticalValues.Center;
        header.Style.Alignment.WrapText = false;

        worksheet.Row(1).Height = 24;

        var range = worksheet.Range(1, 1, lastRow, lastColumn);
        range.Style.Border.OutsideBorder = XLBorderStyleValues.Thin;
        range.Style.Border.InsideBorder = XLBorderStyleValues.Thin;
        range.Style.Alignment.Vertical = XLAlignmentVerticalValues.Center;

        if (lastRow >= 2)
        {
            var dataRange = worksheet.Range(2, 1, lastRow, lastColumn);
            dataRange.Style.Alignment.Horizontal = XLAlignmentHorizontalValues.Left;
            dataRange.Style.Alignment.Vertical = XLAlignmentVerticalValues.Center;
        }

        worksheet.Columns(1, lastColumn).AdjustToContents();

        for (int col = 1; col <= lastColumn; col++)
        {
            var heading = worksheet.Cell(1, col).GetString();
            var minWidth = Math.Max(heading.Length + 4, 12);

            if (worksheet.Column(col).Width < minWidth)
                worksheet.Column(col).Width = minWidth;

            if (worksheet.Column(col).Width > 45)
            {
                worksheet.Column(col).Width = 45;
                worksheet.Column(col).Style.Alignment.WrapText = true;
            }
        }

        worksheet.SheetView.FreezeRows(1);

        worksheet.Range(1, 1, lastRow, lastColumn).SetAutoFilter();
    }

    private async Task MarcarFinalizadosAutomaticamenteAsync(AppDbContext db)
    {
        var hoy = DateOnly.FromDateTime(DateTime.Today);

        var librosPendientes = await db.Libros
            .ApplyScope(Scope)
            .Where(l => !l.Finalizado && l.DirxionDate < hoy)
            .ToListAsync();

        foreach (var libro in librosPendientes)
        {
            libro.Finalizado = true;
        }

        var asignacionesPendientes = await db.Asignaciones
            .Include(a => a.Libro)
            .ApplyScope(Scope)
            .Where(a => a.Finalizado == false)
            .ToListAsync();

        foreach (var asignacion in asignacionesPendientes)
        {
            if (asignacion.Libro is not null && asignacion.Libro.Finalizado)
                asignacion.Finalizado = true;
        }

        var evaluacionesPendientes = await db.Evaluaciones
            .Include(e => e.Asignacion)
                .ThenInclude(a => a!.Libro)
            .ApplyScope(Scope)
            .Where(e => e.Finalizado == false)
            .ToListAsync();

        foreach (var evaluacion in evaluacionesPendientes)
        {
            if (evaluacion.Asignacion is not null && evaluacion.Asignacion.Finalizado)
                evaluacion.Finalizado = true;
        }

        await db.SaveChangesAsync();
    }

    private async Task CargarLibrosFinalizadosAsync(AppDbContext db)
    {
        var query = db.Libros
            .AsNoTracking()
            .Include(l => l.EmployeeType)
            .ApplyScope(Scope)
            .Where(l => l.Finalizado == true);

        if (FechaDesde.HasValue)
        {
            var desde = DateOnly.FromDateTime(FechaDesde.Value);

            query = query.Where(l =>
                l.DirxionDate >= desde);
        }

        if (FechaHasta.HasValue)
        {
            var hasta = DateOnly.FromDateTime(FechaHasta.Value);

            query = query.Where(l =>
                l.DirxionDate <= hasta);
        }

        var librosDb = await query
            .OrderByDescending(l => l.DirxionDate)
            .ToListAsync();

        LibrosReporte = librosDb
            .Select(l => new LibroReporteDto
            {
                EmployeeTypeCode = l.EmployeeType != null ? l.EmployeeType.Code : "",
                BookName = l.BookName,
                Kgen = l.KGENCode,
                Lsa = l.LSACode,

                State = GetStateName(l.StateId),
                Database = GetDatabaseName(l.DatabaseId),
                Legacy = GetLegacyCodeName(l.LegacyCodeId),

                ProofDate = l.ProofExtract,
                FinalDate = l.FinalExtract,
                MemoDate = l.MemoExtract,
                FinalPoDate = l.FinalPODate,
                ShippingDate = l.ShippingDate,
                DirxionDate = l.DirxionDate,
                PubDate = l.PubDate
            })
            .ToList();
    }

