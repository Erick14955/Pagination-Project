@page "/reportes-finalizados"
@page "/finished-reports"
@page "/reportes"

@using System.Globalization
@using System.Security.Claims
@using System.Text
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@using Pagination_Project.Data
@using Pagination_Project.Models
@using Pagination_Project.Services
@using ClosedXML.Excel

@attribute [Authorize]
@layout Pagination_Project.Components.Layout.DashboardLayout

@inject IDbContextFactory<AppDbContext> DbFactory
@inject IDashboardService DashboardService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IUserDataScopeService UserDataScopeService
@inject IJSRuntime JS

<PageTitle>Reports</PageTitle>

@if (CargandoInicial)
{
    <div class="reports-page reports-skeleton-page"
         aria-busy="true"
         aria-label="Loading finished reports">

        <section class="page-hero reports-skeleton-hero">
            <div class="reports-skeleton-hero-copy">
                <div class="reports-skeleton-block reports-skeleton-main-title"></div>
                <div class="reports-skeleton-block reports-skeleton-description"></div>
                <div class="reports-skeleton-block reports-skeleton-description short"></div>
            </div>

            <div class="hero-stats">
                @for (var statIndex = 0; statIndex < 4; statIndex++)
                {
                    <div class="stat-card reports-skeleton-stat-card">
                        <div class="reports-skeleton-block reports-skeleton-stat-label"></div>
                        <div class="reports-skeleton-block reports-skeleton-stat-value"></div>
                    </div>
                }
            </div>
        </section>

        <section class="report-card reports-skeleton-filter-card">
            <div class="section-header">
                <div class="reports-skeleton-section-copy">
                    <div class="reports-skeleton-block reports-skeleton-section-title"></div>
                    <div class="reports-skeleton-block reports-skeleton-section-description"></div>
                </div>
            </div>

            <div class="reports-skeleton-filter-grid">
                @for (var fieldIndex = 0; fieldIndex < 4; fieldIndex++)
                {
                    <div class="reports-skeleton-field">
                        <div class="reports-skeleton-block reports-skeleton-label"></div>
                        <div class="reports-skeleton-block reports-skeleton-input"></div>
                    </div>
                }

                <div class="reports-skeleton-actions">
                    <div class="reports-skeleton-block reports-skeleton-button"></div>
                    <div class="reports-skeleton-block reports-skeleton-button"></div>
                    <div class="reports-skeleton-block reports-skeleton-button download"></div>
                </div>
            </div>
        </section>

        <section class="report-list-card reports-skeleton-list-card">
            <div class="list-header">
                <div class="reports-skeleton-section-copy">
                    <div class="reports-skeleton-block reports-skeleton-list-title"></div>
                    <div class="reports-skeleton-block reports-skeleton-list-description"></div>
                </div>

                <div class="reports-skeleton-block reports-skeleton-total-pill"></div>
            </div>

            <div class="reports-inline-skeleton reports-initial-table-skeleton">
                <div class="reports-skeleton-table-head">
                    @for (var columnIndex = 0; columnIndex < 9; columnIndex++)
                    {
                        <div class="reports-skeleton-block reports-skeleton-column"></div>
                    }
                </div>

                @for (var rowIndex = 0; rowIndex < 7; rowIndex++)
                {
                    <div class="reports-skeleton-table-row">
                        <div class="reports-skeleton-block reports-skeleton-cell wide"></div>
                        <div class="reports-skeleton-block reports-skeleton-cell medium"></div>
                        <div class="reports-skeleton-block reports-skeleton-cell small"></div>
                        <div class="reports-skeleton-block reports-skeleton-cell medium"></div>
                        <div class="reports-skeleton-block reports-skeleton-cell small"></div>
                        <div class="reports-skeleton-block reports-skeleton-cell medium"></div>
                        <div class="reports-skeleton-block reports-skeleton-cell small"></div>
                        <div class="reports-skeleton-block reports-skeleton-cell medium"></div>
                        <div class="reports-skeleton-block reports-skeleton-cell status"></div>
                    </div>
                }
            </div>
        </section>
    </div>
}
else
{
    <div class="reports-page">

        <section class="page-hero">
            <div>
                <h1>@(EsEmpleado ? "Assignment Reports" : "Finished Reports")</h1>
                <p>
                    @(EsEmpleado
                                    ? "Review and download assignments scheduled for the next business day or for a specific date."
                                    : "Review and download finalized records and scheduled assignments.")
            </p>
        </div>

            <div class="hero-stats">
            @if (EsEmpleado)
                {
                    <div class="stat-card">
                        <span>Report</span>
                        <strong>@(TipoReporteSeleccionado == "AssignmentsByDate" ? "By Date" : "Next Day")</strong>
                    </div>

                    <div class="stat-card">
                        <span>Work Date</span>
                        <strong>@FechaAsignacionesProgramadasActual.ToString("MM/dd")</strong>
                    </div>

                    <div class="stat-card">
                        <span>Assignments</span>
                        <strong>@AsignacionesDiaSiguienteReporte.Count</strong>
                    </div>

                    <div class="stat-card">
                        <span>Employees</span>
                        <strong>@CantidadEmpleadosProgramados</strong>
                    </div>
                }
                else
                {
                    <div class="stat-card">
                        <span>Books</span>
                        <strong>@LibrosReporte.Count</strong>
                    </div>

                    <div class="stat-card">
                        <span>Assignments</span>
                        <strong>@AsignacionesReporte.Count</strong>
                    </div>

                    <div class="stat-card">
                        <span>Evaluations</span>
                        <strong>@EvaluacionesReporte.Count</strong>
                    </div>

                    <div class="stat-card">
                        <span>Late Work</span>
                        <strong>@LateWorksReporte.Count</strong>
                    </div>
                }
            </div>
        </section>

        <section class="report-card">

            <div class="section-header">
                <div>
                    <h2>Report Filters</h2>
                    <p>Select the report type and apply filters before downloading.</p>
                </div>
            </div>

            <div class="filters-grid">

                <div class="field">
                    <label>Report Type</label>
                    <select @bind="TipoReporteSeleccionado"
                            @bind:after="OnTipoReporteChanged">
                        @if (!EsEmpleado)
                        {
                            <option value="Libros">Finished Books</option>
                            <option value="Asignaciones">Finished Assignments</option>
                            <option value="Evaluaciones">Finished Evaluations</option>
                            <option value="LateWork">Finished Late Work</option>
                        }

                        <option value="NextDayAssignments">Next Day Assignments</option>
                        <option value="AssignmentsByDate">Assignments by Date</option>
                    </select>
                </div>

                @if (TipoReporteSeleccionado == "AssignmentsByDate")
                {
                    <div class="field">
                        <label>Report Date</label>
                        <input type="date" @bind="FechaReporteSeleccionada" />
                    </div>
                }
                else if (!EsReporteAsignacionesProgramadas)
                {
                    <div class="field">
                        <label>Date From</label>
                        <input type="date" @bind="FechaDesde" />
                    </div>

                    <div class="field">
                        <label>Date To</label>
                        <input type="date" @bind="FechaHasta" />
                    </div>
                }

                <div class="field">
                    <label>Employee</label>
                    <select @bind="EmpleadoIdSeleccionado" disabled="@(!PermiteFiltroEmpleado)">
                        <option value="">All employees</option>
                        @foreach (var empleado in EmpleadosFiltro)
                        {
                            <option value="@empleado.Id">@empleado.Nombre</option>
                        }
                    </select>
                </div>

                <div class="actions-row">
                    <button class="btn-primary"
                            @onclick="CargarReporteAsync"
                            disabled="@(!PuedeBuscar)">
                        Search
                    </button>

                    <button class="btn-secondary" @onclick="LimpiarFiltrosAsync">
                        Clear
                    </button>

                    <button class="btn-download"
                            @onclick="DescargarReporteXlsxAsync"
                            disabled="@(!TieneDatos || DescargandoReporte)">
                        @(DescargandoReporte ? "Downloading..." : "Download XLSX")
                    </button>
                </div>

            </div>

        </section>

        <section class="report-list-card">

            <div class="list-header">
                <div>
                    <h2>@TituloListado</h2>
                    <p>@SubtituloListado</p>
                </div>

                <div class="total-pill">
                    @TotalActual records
                </div>
            </div>

            @if (Cargando)
            {
                <div class="reports-inline-skeleton"
                     aria-busy="true"
                     aria-label="Loading report">

                    <div class="reports-skeleton-table-head">
                        @for (var columnIndex = 0; columnIndex < 9; columnIndex++)
                        {
                            <div class="reports-skeleton-block reports-skeleton-column"></div>
                        }
                    </div>

                    @for (var rowIndex = 0; rowIndex < 6; rowIndex++)
                    {
                        <div class="reports-skeleton-table-row">
                            <div class="reports-skeleton-block reports-skeleton-cell wide"></div>
                            <div class="reports-skeleton-block reports-skeleton-cell medium"></div>
                            <div class="reports-skeleton-block reports-skeleton-cell small"></div>
                            <div class="reports-skeleton-block reports-skeleton-cell medium"></div>
                            <div class="reports-skeleton-block reports-skeleton-cell small"></div>
                            <div class="reports-skeleton-block reports-skeleton-cell medium"></div>
                            <div class="reports-skeleton-block reports-skeleton-cell small"></div>
                            <div class="reports-skeleton-block reports-skeleton-cell medium"></div>
                            <div class="reports-skeleton-block reports-skeleton-cell status"></div>
                        </div>
                    }
                </div>
            }
            else if (!TieneDatos)
            {
                <div class="empty-box">
                    @MensajeSinDatos
                </div>
            }
            else
            {
                @if (TipoReporteSeleccionado == "Libros")
                {
                    <div class="table-shell">
                        <table class="reports-table reports-table-books">
                            <thead>
                                <tr>
                                    <th>Book Name</th>
                                    @if (Scope.ViewAllEmployeeTypes)
                                    {
                                        <th>Department</th>
                                    }
                                    <th>KGEN</th>
                                    <th>LSA</th>
                                    <th>State</th>
                                    <th>Database</th>
                                    <th>Legacy</th>
                                    <th>Proof</th>
                                    <th>Final</th>
                                    <th>Memo</th>
                                    <th>Final PO</th>
                                    <th>Shipping</th>
                                    <th>Dirxion</th>
                                    <th>Pub Date</th>
                                    <th>Status</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var item in LibrosReporte)
                                {
                                    <tr>
                                        <td class="strong-cell" data-label="Book">@item.BookName</td>
                                        @if (Scope.ViewAllEmployeeTypes)
                                        {
                                            <td data-label="Department"><span class="kgen-pill">@item.EmployeeTypeCode</span></td>
                                        }
                                        <td data-label="KGEN">@item.Kgen</td>
                                        <td data-label="LSA">@item.Lsa</td>
                                        <td data-label="State">@item.State</td>
                                        <td data-label="Database">@item.Database</td>
                                        <td data-label="Legacy">@item.Legacy</td>
                                        <td data-label="Proof">@FormatDate(item.ProofDate)</td>
                                        <td data-label="Final">@FormatDate(item.FinalDate)</td>
                                        <td data-label="Memo">@FormatDate(item.MemoDate)</td>
                                        <td data-label="Final PO">@FormatDate(item.FinalPoDate)</td>
                                        <td data-label="Shipping">@FormatDate(item.ShippingDate)</td>
                                        <td data-label="Dirxion">@FormatDate(item.DirxionDate)</td>
                                        <td data-label="Pub Date">@FormatDate(item.PubDate)</td>
                                        <td data-label="Status">
                                            <span class="status-pill">Finished</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                @if (TipoReporteSeleccionado == "Asignaciones")
                {
                    <div class="table-shell">
                        <table class="reports-table reports-table-assignments">
                            <thead>
                                <tr>
                                    <th>Employee</th>
                                    @if (Scope.ViewAllEmployeeTypes)
                                    {
                                        <th>Department</th>
                                    }
                                    <th>Book Name</th>
                                    <th>KGEN</th>
                                    <th>Pub Date</th>
                                    <th>Dirxion Date</th>
                                    <th>Proof</th>
                                    <th>Final</th>
                                    <th>Memo</th>
                                    <th>Status</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var item in AsignacionesReporte)
                                {
                                    <tr>
                                        <td class="strong-cell" data-label="Employee">@item.EmployeeName</td>
                                        @if (Scope.ViewAllEmployeeTypes)
                                        {
                                            <td data-label="Department"><span class="kgen-pill">@item.EmployeeTypeCode</span></td>
                                        }
                                        <td data-label="Book">@item.BookName</td>
                                        <td data-label="KGEN">@item.Kgen</td>
                                        <td data-label="Pub Date">@FormatDate(item.PubDate)</td>
                                        <td data-label="Dirxion">@FormatDate(item.DirectionDate)</td>
                                        <td data-label="Proof">@FormatDate(item.ProofDate)</td>
                                        <td data-label="Final">@FormatDate(item.FinalDate)</td>
                                        <td data-label="Memo">@FormatDate(item.MemoDate)</td>
                                        <td data-label="Status">
                                            <span class="status-pill">Finished</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                @if (TipoReporteSeleccionado == "Evaluaciones")
                {
                    <div class="table-shell">
                        <table class="reports-table reports-table-evaluations">
                            <thead>
                                <tr>
                                    <th>Employee</th>
                                    @if (Scope.ViewAllEmployeeTypes)
                                    {
                                        <th>Department</th>
                                    }
                                    <th>Book Name</th>
                                    <th>KGEN</th>
                                    <th>LSA</th>
                                    <th>Pub Date</th>
                                    <th>Motif YP</th>
                                    <th>Motif WP</th>
                                    <th>Inventory Report</th>
                                    <th>Shipping Folder</th>
                                    <th>Task Memo</th>
                                    <th>Total %</th>
                                    <th>Status</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var item in EvaluacionesReporte)
                                {
                                    <tr>
                                        <td class="strong-cell" data-label="Employee">@item.EmployeeName</td>
                                        @if (Scope.ViewAllEmployeeTypes)
                                        {
                                            <td data-label="Department"><span class="kgen-pill">@item.EmployeeTypeCode</span></td>
                                        }
                                        <td data-label="Book">@item.BookName</td>
                                        <td data-label="KGEN">
                                            <span class="kgen-pill">@item.Kgen</span>
                                        </td>
                                        <td data-label="LSA">@item.Lsa</td>
                                        <td data-label="Pub Date">@FormatDate(item.PubDate)</td>
                                        <td data-label="Motif YP">@FormatPercent(item.MotifYp)</td>
                                        <td data-label="Motif WP">@FormatPercent(item.MotifWp)</td>
                                        <td data-label="Inventory Report">@FormatPercent(item.InventoryReport)</td>
                                        <td data-label="Shipping Folder">@FormatPercent(item.ProductShippingFolder)</td>
                                        <td data-label="Task Memo">@FormatPercent(item.TaskMemo)</td>
                                        <td class="total-percent" data-label="Total %">@FormatPercent(item.TotalPorcentaje)</td>
                                        <td data-label="Status">
                                            <span class="status-pill">Finished</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                @if (EsReporteAsignacionesProgramadas)
                {
                    <div class="table-shell">
                        <table class="reports-table reports-table-next-day reports-table-scheduled-assignments">
                            <thead>
                                <tr>
                                    <th>Employee</th>
                                    @if (Scope.ViewAllEmployeeTypes)
                                    {
                                        <th>Department</th>
                                    }
                                    <th>KGEN Code</th>
                                    <th>LSA Code</th>
                                    <th>Book</th>
                                    <th>Database</th>
                                    <th>Stage</th>
                                    <th>Stage Date</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var item in AsignacionesDiaSiguienteReporte)
                                {
                                    <tr>
                                        <td class="strong-cell" data-label="Employee">@item.EmployeeName</td>
                                        @if (Scope.ViewAllEmployeeTypes)
                                        {
                                            <td data-label="Department"><span class="kgen-pill">@item.EmployeeTypeCode</span></td>
                                        }
                                        <td data-label="KGEN Code">
                                            <span class="kgen-pill">@item.KgenCode</span>
                                        </td>
                                        <td data-label="LSA Code">
                                            <span class="kgen-pill secondary">@item.LsaCode</span>
                                        </td>
                                        <td data-label="Book">@item.BookName</td>
                                        <td data-label="Database">
                                            @{
                                                var databaseCode = GetDatabaseCode(item.Database);
                                                var databaseFullName = GetDatabaseFullName(item.Database);
                                            }

                                            <span class="report-database-pill"
                                                  title="@databaseFullName"
                                                  aria-label="@databaseFullName">
                                                @databaseCode
                                            </span>
                                        </td>
                                        <td data-label="Stage">
                                            <span class="report-stage-pill @GetReportStageClass(item.StageKey)">
                                                @item.Stage
                                            </span>
                                        </td>
                                        <td data-label="Stage Date">@FormatDate(item.StageDate)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                @if (TipoReporteSeleccionado == "LateWork")
                {
                    <div class="table-shell">
                        <table class="reports-table reports-table-latework">
                            <thead>
                                <tr>
                                    <th>Employee</th>
                                    @if (Scope.ViewAllEmployeeTypes)
                                    {
                                        <th>Department</th>
                                    }
                                    <th>Book Name</th>
                                    <th>KGEN</th>
                                    <th>LSA</th>
                                    <th>Late Work ID</th>
                                    <th>Client ID</th>
                                    <th>Dirxion Date</th>
                                    <th>Created At</th>
                                    <th>Completed</th>
                                    <th>Completed At</th>
                                    <th>Status</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var item in LateWorksReporte)
                                {
                                    <tr>
                                        <td class="strong-cell" data-label="Employee">@item.EmployeeName</td>
                                        @if (Scope.ViewAllEmployeeTypes)
                                        {
                                            <td data-label="Department"><span class="kgen-pill">@item.EmployeeTypeCode</span></td>
                                        }
                                        <td data-label="Book">@item.BookName</td>
                                        <td data-label="KGEN">
                                            <span class="kgen-pill">@item.Kgen</span>
                                        </td>
                                        <td data-label="LSA">@item.Lsa</td>
                                        <td data-label="Late Work ID">@item.LateWorkId</td>
                                        <td data-label="Client ID">@item.ClientId</td>
                                        <td data-label="Dirxion">@FormatDate(item.DirxionDate)</td>
                                        <td data-label="Created At">@FormatDateTime(item.CreatedAt)</td>
                                        <td data-label="Completed">
                                            @(item.Completed ? "Yes" : "No")
                                        </td>
                                        <td data-label="Completed At">@FormatDateTime(item.CompletedAt)</td>
                                        <td data-label="Status">
                                            <span class="status-pill">Finished Book</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }

        </section>

    </div>
}


@if (MostrarModalResultadoReporte)
{
    <div class="report-result-modal-overlay"
         role="presentation"
         @onclick="CerrarModalResultadoReporte">

        <div class="report-result-modal-card @TipoModalResultadoReporte"
             role="dialog"
             aria-modal="true"
             aria-labelledby="reportResultModalTitle"
             @onclick:stopPropagation="true">

            <div class="report-result-modal-accent"></div>

            <div class="report-result-modal-content">
                <div class="report-result-modal-icon" aria-hidden="true">
                    @if (TipoModalResultadoReporte == "success")
                    {
                        <svg viewBox="0 0 24 24">
                            <path d="M20 6 9 17l-5-5"></path>
                        </svg>
                    }
                    else if (TipoModalResultadoReporte == "error")
                    {
                        <svg viewBox="0 0 24 24">
                            <circle cx="12" cy="12" r="9"></circle>
                            <path d="M12 7v6"></path>
                            <path d="M12 17h.01"></path>
                        </svg>
                    }
                    else
                    {
                        <svg viewBox="0 0 24 24">
                            <circle cx="12" cy="12" r="9"></circle>
                            <path d="M12 11v5"></path>
                            <path d="M12 8h.01"></path>
                        </svg>
                    }
                </div>

                <div class="report-result-modal-copy">
                    <span class="report-result-modal-eyebrow">Reports Center</span>
                    <h3 id="reportResultModalTitle">@TituloModalResultadoReporte</h3>
                    <p>@MensajeModalResultadoReporte</p>
                </div>
            </div>

            <div class="report-result-modal-actions">
                <button type="button"
                        class="report-result-modal-ok"
                        @onclick="CerrarModalResultadoReporte">
                    OK
                </button>
            </div>
        </div>
    </div>
}

@code {
    private string TipoReporteSeleccionado { get; set; } = "Libros";

    private DateTime? FechaDesde { get; set; }
    private DateTime? FechaHasta { get; set; }
    private DateTime? FechaReporteSeleccionada { get; set; }

    private DateOnly FechaAsignacionesDiaSiguiente { get; set; }

    private Guid? EmpleadoIdSeleccionado { get; set; }

    private bool CargandoInicial { get; set; } = true;
    private bool _cargaInicialIniciada;

    private bool Cargando { get; set; }
    private bool DescargandoReporte { get; set; }

    private bool EsEmpleado { get; set; }

    private UserDataScope Scope { get; set; } = new();

    private bool MostrarModalResultadoReporte { get; set; }

    private string TituloModalResultadoReporte { get; set; } =
        string.Empty;

    private string MensajeModalResultadoReporte { get; set; } =
        string.Empty;

    private string TipoModalResultadoReporte { get; set; } =
        "success";

    private List<EmpleadoFiltroDto> EmpleadosFiltro { get; set; } =
        new();

    private List<LibroReporteDto> LibrosReporte { get; set; } =
        new();

    private List<AsignacionReporteDto> AsignacionesReporte { get; set; } =
        new();

    private List<EvaluacionReporteDto> EvaluacionesReporte { get; set; } =
        new();

    private List<LateWorkReporteDto> LateWorksReporte { get; set; } =
        new();

    private List<AssignedBookDashboardDto>
        AsignacionesDiaSiguienteReporte
    { get; set; } =
            new();

    private List<AssignedBookDashboardDto>?
        _asignacionesProgramadasBase;

    private DateOnly?
        _fechaAsignacionesProgramadasBase;

    private Dictionary<Guid, string> _databaseNames =
        new();

    private Dictionary<Guid, string> _legacyCodeNames =
        new();

    private Dictionary<Guid, string> _stateNames =
        new();

    private bool _catalogosCargados;

    private DateOnly? _fechaFinalizacionAutomaticaAplicada;

    private bool EsReporteAsignacionesProgramadas =>
        TipoReporteSeleccionado == "NextDayAssignments" ||
        TipoReporteSeleccionado == "AssignmentsByDate";


    private bool PermiteFiltroEmpleado =>
        TipoReporteSeleccionado == "Asignaciones" ||
        TipoReporteSeleccionado == "Evaluaciones" ||
        TipoReporteSeleccionado == "LateWork" ||
        EsReporteAsignacionesProgramadas;


    private bool PuedeBuscar =>
        TipoReporteSeleccionado != "AssignmentsByDate" ||
        FechaReporteSeleccionada.HasValue;


    private DateOnly FechaAsignacionesProgramadasActual =>
        TipoReporteSeleccionado == "AssignmentsByDate"
            ? DateOnly.FromDateTime(
                FechaReporteSeleccionada?.Date
                ?? DateTime.Today)
            : FechaAsignacionesDiaSiguiente;


    private int CantidadEmpleadosProgramados =>
