    private static decimal CalcularPorcentajeGeneralReporte(EvaluacionReporteDto item)
    {
        var valores = new List<decimal>();

        if (item.MotifYp.HasValue)
            valores.Add(item.MotifYp.Value);

        if (item.MotifWp.HasValue)
            valores.Add(item.MotifWp.Value);

        if (item.InventoryReport.HasValue)
            valores.Add(item.InventoryReport.Value);

        if (item.ProductShippingFolder.HasValue)
            valores.Add(item.ProductShippingFolder.Value);

        if (item.TaskMemo.HasValue)
            valores.Add(item.TaskMemo.Value);

        if (valores.Count == 0)
            return 0;

        return Math.Round(valores.Average(), 2);
    }

