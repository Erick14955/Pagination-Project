                "stage-default"
        };
    }

    private async Task MarcarFinalizadosAutomaticamenteAsync(
        AppDbContext db)
    {
        var hoy =
            DateOnly.FromDateTime(
                DateTime.Today);


        var strategy =
            db.Database
                .CreateExecutionStrategy();


        await strategy.ExecuteAsync(
            async () =>
            {
                await using var transaction =
                    await db.Database
                        .BeginTransactionAsync();

                await db.Evaluaciones
                    .ApplyScope(Scope)

                    .Where(e =>
                        !e.Finalizado &&
                        e.Asignacion != null &&
                        e.Asignacion.Libro != null &&
                        e.Asignacion.Libro.DirxionDate <
                        hoy)

                    .ExecuteUpdateAsync(
                        setters =>
                            setters.SetProperty(
                                e => e.Finalizado,
                                true));

                await db.Asignaciones
                    .ApplyScope(Scope)

                    .Where(a =>
                        !a.Finalizado &&
                        a.Libro != null &&
                        a.Libro.DirxionDate <
                        hoy)

                    .ExecuteUpdateAsync(
                        setters =>
                            setters.SetProperty(
                                a => a.Finalizado,
                                true));

                await db.Libros
                    .ApplyScope(Scope)

                    .Where(l =>
                        !l.Finalizado &&
                        l.DirxionDate <
                        hoy)

                    .ExecuteUpdateAsync(
                        setters =>
                            setters.SetProperty(
                                l => l.Finalizado,
                                true));


                await transaction.CommitAsync();
            });
    }

    private async Task CargarLibrosFinalizadosAsync(
        AppDbContext db)
    {
        await AsegurarCatalogosAsync();


        var query =
            db.Libros
                .AsNoTracking()
                .ApplyScope(Scope)

                .Where(l =>
                    l.Finalizado);


        if (FechaDesde.HasValue)
        {
            var desde =
                DateOnly.FromDateTime(
                    FechaDesde.Value);


            query =
                query.Where(l =>
                    l.DirxionDate >=
                    desde);
        }


        if (FechaHasta.HasValue)
        {
            var hasta =
                DateOnly.FromDateTime(
                    FechaHasta.Value);


            query =
                query.Where(l =>
                    l.DirxionDate <=
                    hasta);
        }

        var libros =
            await query

                .OrderByDescending(l =>
                    l.DirxionDate)

                .Select(l =>
                    new LibroRawDto
                    {
                        EmployeeTypeCode =
                            l.EmployeeType != null
                                ? l.EmployeeType.Code
                                    ?? string.Empty
                                : string.Empty,

                        BookName =
                            l.BookName
                            ?? string.Empty,

                        Kgen =
                            l.KGENCode
                            ?? string.Empty,

                        Lsa =
                            l.LSACode
                            ?? string.Empty,

                        StateId =
                            l.StateId,

                        DatabaseId =
                            l.DatabaseId,

                        LegacyCodeId =
                            l.LegacyCodeId,

                        ProofDate =
                            l.ProofExtract,

                        FinalDate =
                            l.FinalExtract,

                        MemoDate =
                            l.MemoExtract,

                        FinalPoDate =
                            l.FinalPODate,

                        ShippingDate =
                            l.ShippingDate,

                        DirxionDate =
                            l.DirxionDate,

                        PubDate =
                            l.PubDate
                    })

                .ToListAsync();


        LibrosReporte =
            new List<LibroReporteDto>(
                libros.Count);


        foreach (var item in libros)
        {
            LibrosReporte.Add(
                new LibroReporteDto
                {
                    EmployeeTypeCode =
                        item.EmployeeTypeCode,

                    BookName =
                        item.BookName,

                    Kgen =
                        item.Kgen,

                    Lsa =
                        item.Lsa,

                    State =
                        GetStateName(
                            item.StateId),

                    Database =
                        GetDatabaseName(
                            item.DatabaseId),

                    Legacy =
                        GetLegacyCodeName(
                            item.LegacyCodeId),

                    ProofDate =
                        item.ProofDate,

                    FinalDate =
                        item.FinalDate,

                    MemoDate =
                        item.MemoDate,

                    FinalPoDate =
                        item.FinalPoDate,

                    ShippingDate =
                        item.ShippingDate,

                    DirxionDate =
                        item.DirxionDate,

                    PubDate =
                        item.PubDate
                });
        }
    }

    private async Task CargarAsignacionesFinalizadasAsync(
        AppDbContext db)
    {
        var query =
            db.Asignaciones
                .AsNoTracking()
                .ApplyScope(Scope)

                .Where(a =>
                    a.Finalizado &&
                    a.Libro != null);


        if (EmpleadoIdSeleccionado.HasValue)
        {
            query =
                query.Where(a =>
                    a.IdEmpleado ==
                    EmpleadoIdSeleccionado.Value);
        }


        if (FechaDesde.HasValue)
        {
            var desde =
                DateOnly.FromDateTime(
                    FechaDesde.Value);


            query =
                query.Where(a =>
                    a.Libro != null &&
                    a.Libro.PubDate >=
                    desde);
        }


        if (FechaHasta.HasValue)
        {
            var hasta =
                DateOnly.FromDateTime(
                    FechaHasta.Value);


            query =
                query.Where(a =>
                    a.Libro != null &&
                    a.Libro.PubDate <=
                    hasta);
        }

        AsignacionesReporte =
            await query

                .Select(a =>
                    new AsignacionReporteDto
                    {
                        EmployeeTypeCode =
                            a.Libro != null &&
                            a.Libro.EmployeeType != null

