    private static void EscribirFechaExcel(
        IXLCell cell,
        DateOnly? fecha)
    {
        if (fecha.HasValue)
        {
            cell.Value =
                fecha.Value.ToDateTime(
                    TimeOnly.MinValue);


            cell.Style.DateFormat.Format =
                "MM/dd/yyyy";
        }
        else
        {
            cell.Value =
                "-";
        }
    }


    private static void EscribirPorcentajeExcel(
        IXLCell cell,
        decimal? porcentaje)
    {
        cell.Value =
            (porcentaje ?? 0m)
            / 100m;


        cell.Style.NumberFormat.Format =
            "0.00%";
    }


    private static void AplicarEstiloExcel(
        IXLWorksheet worksheet,
        int lastRow,
        int lastColumn)
    {
        if (lastRow < 1)
        {
            lastRow = 1;
        }


        var header =
            worksheet.Range(
                1,
                1,
                1,
                lastColumn);


        header.Style.Font.Bold =
            true;

        header.Style.Font.FontColor =
            XLColor.White;

        header.Style.Fill.BackgroundColor =
            XLColor.FromHtml(
                "#111827");

        header.Style.Alignment.Horizontal =
            XLAlignmentHorizontalValues.Center;

        header.Style.Alignment.Vertical =
            XLAlignmentVerticalValues.Center;

        header.Style.Alignment.WrapText =
            false;


        worksheet.Row(1).Height =
            24;


        var range =
            worksheet.Range(
                1,
                1,
                lastRow,
                lastColumn);


        range.Style.Border.OutsideBorder =
            XLBorderStyleValues.Thin;

        range.Style.Border.InsideBorder =
            XLBorderStyleValues.Thin;

        range.Style.Alignment.Vertical =
            XLAlignmentVerticalValues.Center;


        if (lastRow >= 2)
        {
            var dataRange =
                worksheet.Range(
                    2,
                    1,
                    lastRow,
                    lastColumn);


            dataRange.Style.Alignment.Horizontal =
                XLAlignmentHorizontalValues.Left;

            dataRange.Style.Alignment.Vertical =
                XLAlignmentVerticalValues.Center;
        }


        worksheet
            .Columns(
                1,
                lastColumn)
            .AdjustToContents();


        for (var col = 1;
             col <= lastColumn;
             col++)
        {
            var heading =
                worksheet.Cell(
                        1,
                        col)
                    .GetString();


            var minWidth =
                Math.Max(
                    heading.Length + 4,
                    12);


            if (worksheet.Column(col).Width <
                minWidth)
            {
                worksheet.Column(col).Width =
                    minWidth;
            }


            if (worksheet.Column(col).Width >
                45)
            {
                worksheet.Column(col).Width =
                    45;


                worksheet.Column(col)
                    .Style.Alignment.WrapText =
                    true;
            }
        }


        worksheet.SheetView
            .FreezeRows(1);


        worksheet.Range(
                1,
                1,
                lastRow,
                lastColumn)
            .SetAutoFilter();
    }

    private static string FormatDate(
        DateOnly? date)
    {
        return date.HasValue
            ? date.Value.ToString(
                "MM/dd/yyyy",
                CultureInfo.InvariantCulture)
            : string.Empty;
    }


    private static string FormatDateTime(
        DateTime? date)
    {
        return date.HasValue
            ? date.Value.ToString(
                "MM/dd/yyyy",
                CultureInfo.InvariantCulture)
            : string.Empty;
    }


    private static string FormatPercent(
        decimal? value)
    {
        return value.HasValue

            ? value.Value.ToString(
                  "0.00",
                  CultureInfo.InvariantCulture)
              + "%"

            : "0.00%";
    }

    private static decimal CalcularPorcentajeGeneralReporte(
        EvaluacionReporteDto item)
    {
        decimal suma = 0m;
        var cantidad = 0;


        if (item.MotifYp.HasValue)
        {
            suma += item.MotifYp.Value;
            cantidad++;
        }


        if (item.MotifWp.HasValue)
        {
            suma += item.MotifWp.Value;
            cantidad++;
        }


        if (item.InventoryReport.HasValue)
        {
            suma += item.InventoryReport.Value;
            cantidad++;
        }


        if (item.ProductShippingFolder.HasValue)
        {
            suma += item.ProductShippingFolder.Value;
            cantidad++;
        }


        if (item.TaskMemo.HasValue)
        {
            suma += item.TaskMemo.Value;
            cantidad++;
        }


        return cantidad == 0
            ? 0m
            : Math.Round(
                suma / cantidad,
                2);
    }

