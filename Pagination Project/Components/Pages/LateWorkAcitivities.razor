@page "/late-work-activities"
@page "/late-work"
@page "/actividades-late-work"

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using Pagination_Project.Data
@using Pagination_Project.Models
@using Pagination_Project.Services
@using System.Security.Claims

@attribute [Authorize]
@layout Pagination_Project.Components.Layout.DashboardLayout

@inject IDbContextFactory<AppDbContext> DbFactory
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IUserDataScopeService UserDataScopeService
@inject NavigationManager Navigation

<PageTitle>Late Work Activities</PageTitle>

@if (CargandoPermisos)
{
    <div class="late-page">
        <div class="late-card access-card">
            <h2>Loading permissions...</h2>
            <p>Please wait while your access is verified.</p>
        </div>
    </div>
}
else if (!PuedeVerLateWork)
{
    <div class="late-page">
        <div class="late-card access-denied-card">
            <h2>Access denied</h2>
            <p>You do not have permission to view Late Work Activities.</p>

            <button type="button" class="btn-light" @onclick="VolverDashboard">
                Go back
            </button>
        </div>
    </div>
}
else
{
    <div class="late-page">

        <section class="late-hero">
            <div>
                <h1>Late Work Activities</h1>
                <p>
                    Review late work activities by assignment.
                </p>
            </div>

            <div class="late-stats">
                <div class="late-stat-card">
                    <span>Total</span>
                    <strong>@TotalLateWorkGroups</strong>
                </div>

                <div class="late-stat-card success">
                    <span>Completed</span>
                    <strong>@CompletedLateWorkGroups</strong>
                </div>

                <div class="late-stat-card warning">
                    <span>Pending</span>
                    <strong>@PendingLateWorkGroups</strong>
                </div>
            </div>
        </section>

        @if (!string.IsNullOrWhiteSpace(Mensaje))
        {
            <div class="alert-box @(EsError ? "error" : "success")">
                @Mensaje
            </div>
        }

        <section class="permissions-info-bar">
            <span class="permission-pill @(PuedeVerLateWork ? "active" : "inactive")">View</span>
            <span class="permission-pill @(PuedeCrearLateWork ? "active" : "inactive")">Create</span>
            <span class="permission-pill @(PuedeEditarLateWork ? "active" : "inactive")">Edit</span>
            <span class="permission-pill @(PuedeEliminarLateWork ? "active" : "inactive")">Delete</span>
            <span class="permission-pill @(PuedeCompletarLateWork ? "active" : "inactive")">Complete</span>
        </section>

        <section class="late-grid @(PuedeCrearLateWork ? "" : "view-only-grid")">

            @if (PuedeCrearLateWork)
            {
                <div class="late-card form-card">
                    <div class="card-title">
                        <h2>@(LateWorkEditandoId.HasValue ? "Edit Late Work" : "Register Late Work")</h2>
                        <p>
                            @(LateWorkEditandoId.HasValue
                                                ? "Update the selected late work activity and save the changes."
                                                : "Select one or multiple assignments and assign one or multiple late work activities at once.")
                </p>
            </div>

            @if (LateWorkEditandoId.HasValue)
                    {
                        <div class="form-group">
                            <label>Assignment</label>
                            <select @bind="AssignmentSeleccionadoId">
                                <option value="">Select assignment</option>
                                @foreach (var item in Asignaciones)
                                {
                                    <option value="@item.Id">
                                        @item.DisplayName
                                    </option>
                                }
                            </select>
                        </div>
                    }
                    else
                    {
                        <div class="form-group">
                            <label>Assignments</label>
                            <input type="text"
                                   placeholder="Search book, employee, KGEN or LSA..."
                                   @bind="BusquedaAsignacionesRegistro"
                                   @bind:event="oninput" />
                        </div>

                        <div class="bulk-actions">
                            <label class="check-all">
                                <input type="checkbox"
                                       checked="@TodasAsignacionesRegistroSeleccionadas"
                                       @onchange="SeleccionarTodasAsignacionesRegistro" />
                                Select visible assignments
                            </label>

                            <button type="button"
                                    class="btn-light"
                                    disabled="@Procesando"
                                    @onclick="LimpiarAsignacionesRegistro">
                                Clear assignments
                            </button>
                        </div>

                        <div class="table-wrap" style="max-height:320px; overflow:auto;">
                            <table class="late-work-table">
                                <thead>
                                    <tr>
                                        <th></th>
                                        <th>Assignment</th>
                                        @if (Scope.ViewAllEmployeeTypes)
                                        {
                                            <th>Department</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (!AsignacionesRegistroFiltradas.Any())
                                    {
                                        <tr>
                                            <td colspan="@(Scope.ViewAllEmployeeTypes ? 3 : 2)"
                                                class="empty-cell"
                                                data-label="">
                                                No assignments found.
                                            </td>
                                        </tr>
                                    }
                                    else
                                    {
                                        @foreach (var item in AsignacionesRegistroFiltradas)
                                        {
                                            <tr class="@(AssignmentSeleccionados.Contains(item.Id) ? "row-selected" : "")">
                                                <td data-label="Select">
                                                    <input type="checkbox"
                                                           checked="@AssignmentSeleccionados.Contains(item.Id)"
                                                           @onchange="e => ToggleAssignmentRegistro(item.Id, e)" />
                                                </td>
                                                <td data-label="Assignment">
                                                    <strong>@item.DisplayName</strong>
                                                    <div style="margin-top:4px; font-size:.82rem; opacity:.72;">
                                                        KGEN: @(string.IsNullOrWhiteSpace(item.KgenCode) ? "-" : item.KgenCode)
                                                        &nbsp;·&nbsp;
                                                        LSA: @(string.IsNullOrWhiteSpace(item.LsaCode) ? "-" : item.LsaCode)
                                                    </div>
                                                </td>
                                                @if (Scope.ViewAllEmployeeTypes)
                                                {
                                                    <td data-label="Department">
                                                        <span class="status pending">@item.EmployeeTypeCode</span>
                                                    </td>
                                                }
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="readonly-warning">
                            @AssignmentSeleccionados.Count assignment(s) selected.
                            Every Late Work entered below will be assigned to all selected assignments.
                        </div>
                    }

                <div class="form-group">
                    <label>Late Work ID</label>
                    <input type="text"
                           placeholder="Example: 100234"
                           @bind="LateWorkIdTexto" />
                </div>

                <div class="form-group">
                    <label>Client ID</label>
                    <input type="text"
                           placeholder="Example: 24001"
                           @bind="ClientIdTexto" />
                </div>

                <div class="single-actions">
                    <button type="button"
                            class="btn-primary"
                            disabled="@Procesando"
                            @onclick="GuardarUnoAsync">
                        @(Procesando
                                            ? "Saving..."
                                            : LateWorkEditandoId.HasValue
                                            ? "Update Activity"
                                            : "Assign to Selected")
                </button>

                        <button type="button" class="btn-light" @onclick="LimpiarFormulario">
                            Clear
                        </button>
                    </div>

            @if (LateWorkEditandoId.HasValue)
                    {
                        <div class="late-edit-mode-banner">
                            <div>
                                <span>Edit mode</span>
                                <strong>Updating Late Work ID @LateWorkIdTexto</strong>
                            </div>

                            <button type="button"
                                    class="late-edit-cancel"
                                    disabled="@Procesando"
                                    @onclick="LimpiarFormulario">
                                Cancel Edit
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="bulk-box">
                            <label>Bulk Register</label>
                            <p>
                                Enter one Late Work per line using this format:
                                <strong>LateWorkId, ClientId</strong>
                            </p>

                            <textarea rows="8"
                                      placeholder="Example:
                                                                                    100234, 24001
                                                                                    100235, 24002
                                                                                    100236, 24003"
                                      @bind="TextoMasivo">
                                                                </textarea>

                            <button type="button"
                                    class="btn-dark"
                                    disabled="@Procesando"
                                    @onclick="GuardarMasivoAsync">
                                @(Procesando ? "Saving..." : "Assign All to Selected")
                            </button>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="late-card readonly-card">
                    <h2>Read-only access</h2>
                    <p>
                        You can view Late Work Activities, but you do not have permission to create records.
                    </p>
                </div>
            }

            <div class="late-card list-card">
                <div class="card-title list-title">
                    <div>
                        <h2>Registered Activities</h2>
                        <p>Review, filter and complete late work activities according to your permissions.</p>
                    </div>

                    <button type="button" class="btn-refresh" @onclick="CargarDatosAsync">
                        Refresh
                    </button>
                </div>

                <div class="filters-row">
                    <div class="form-group">
                        <label>Filter by assignment</label>
                        <select @bind="FiltroAssignmentId" @bind:after="AplicarFiltro">
                            <option value="">All assignments</option>
                            @foreach (var item in Asignaciones)
                            {
                                <option value="@item.Id">@item.DisplayName</option>
                            }
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Status</label>
                        <select @bind="FiltroEstado" @bind:after="AplicarFiltro">
                            <option value="all">All</option>
                            <option value="pending">Pending / Partial</option>
                            <option value="partial">Partial</option>
                            <option value="completed">Completed Total</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Search</label>
                        <input type="text"
                               placeholder="Late Work ID, Client ID, KGEN, LSA, book or employee..."
                               @bind="TextoBuscar"
                               @bind:event="oninput"
                               @bind:after="AplicarFiltro" />
                    </div>
                </div>

                @if (PuedeCompletarLateWork)
                {
                    <div class="bulk-actions">
                        <label class="check-all">
                            <input type="checkbox" checked="@TodosSeleccionados" @onchange="SeleccionarTodos" />
                            Select my visible pending
                        </label>

                        <button type="button"
                                class="btn-complete-selected"
                                disabled="@(!LateWorksFiltrados.Any(x => x.Seleccionado && !x.Completed && x.EsAsignacionPropia) || Procesando)"
                                @onclick="CompletarSeleccionadosAsync">
                            Complete Selected
                        </button>
                    </div>
                }
                else
                {
                    <div class="readonly-warning">
                        You can view records, but you do not have permission to mark Late Work as completed.
                    </div>
                }

                <div class="table-wrap">
                    <table class="late-work-table">
                        <thead>
                            <tr>
                                @if (PuedeCompletarLateWork)
                                {
                                    <th></th>
                                }

                                <th>Late Work ID</th>
                                <th>Client ID</th>
                                <th>Assignment</th>
                                @if (Scope.ViewAllEmployeeTypes)
                                {
                                    <th>Department</th>
                                }
                                <th>My Assignment Status</th>
                                <th>Overall Progress</th>
                                <th>Completed At</th>

                                @if (PuedeCompletarLateWork || PuedeEditarLateWork || PuedeEliminarLateWork)
                                {
                                    <th>Action</th>
                                }
                            </tr>
                        </thead>

                        <tbody>
                            @if (!LateWorksFiltrados.Any())
                            {
                                <tr>
                                    <td colspan="@ColspanTabla" class="empty-cell" data-label="">
                                        No late work activities found.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var item in LateWorksFiltrados)
                                {
                                    <tr class="@(item.Completed ? "row-completed" : item.Seleccionado ? "row-selected" : "")">
                                        @if (PuedeCompletarLateWork)
                                        {
                                            <td data-label="Select">
                                                @if (!item.Completed && item.EsAsignacionPropia)
                                                {
                                                    <input type="checkbox" @bind="item.Seleccionado" />
                                                }
                                                else if (!item.Completed)
                                                {
                                                    <input type="checkbox" disabled />
                                                }
                                            </td>
                                        }

                                        <td data-label="Late Work ID">
                                            <strong>@item.LateWorkId</strong>
                                        </td>

                                        <td data-label="Client ID">@item.ClientId</td>

                                        <td data-label="Assignment">
                                            <strong>@item.AssignmentName</strong>
                                            <div style="margin-top:4px; font-size:.82rem; opacity:.72;">
                                                KGEN: @(string.IsNullOrWhiteSpace(item.KgenCode) ? "-" : item.KgenCode)
                                                &nbsp;·&nbsp;
                                                LSA: @(string.IsNullOrWhiteSpace(item.LsaCode) ? "-" : item.LsaCode)
                                            </div>
                                        </td>

                                        @if (Scope.ViewAllEmployeeTypes)
                                        {
                                            <td data-label="Department"><span class="status pending">@item.EmployeeTypeCode</span></td>
                                        }

                                        <td data-label="Status">
                                            @if (item.Completed)
                                            {
                                                <span class="status completed">Completed</span>
                                            }
                                            else if (item.EsAsignacionPropia)
                                            {
                                                <span class="status pending">Pending - Mine</span>
                                            }
                                            else
                                            {
                                                <span class="status pending">Pending - Read only</span>
                                            }
                                        </td>

                                        @{
                                            var progreso = ObtenerProgresoLateWork(item);
                                        }

                                        <td data-label="Overall Progress">
                                            @if (progreso.Total > 0 && progreso.Completed == progreso.Total)
                                            {
                                                <span class="status completed">
                                                    Completed Total (@progreso.Completed/@progreso.Total)
                                                </span>
                                            }
                                            else if (progreso.Completed > 0)
                                            {
                                                <span class="status pending">
                                                    Partial (@progreso.Completed/@progreso.Total)
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="status pending">
                                                    Pending Total (0/@progreso.Total)
                                                </span>
                                            }
                                    </td>

                                    <td data-label="Completed At">
                                        @(item.CompletedAt.HasValue
                                                                        ? item.CompletedAt.Value.ToLocalTime().ToString("MM/dd/yyyy hh:mm tt")
                                                                        : "-")
                            </td>

                            @if (PuedeCompletarLateWork || PuedeEditarLateWork || PuedeEliminarLateWork)
                                        {
                                            <td data-label="Actions">
                                                <div class="row-actions">
                                                    @if (PuedeCompletarLateWork)
                                                    {
                                                        @if (item.Completed)
                                                        {
                                                            <span class="done-text">Done</span>
                                                        }
                                                        else if (item.EsAsignacionPropia)
                                                        {
                                                            <button type="button"
                                                                    class="btn-small-complete"
                                                                    disabled="@Procesando"
                                                                    @onclick="() => CompletarUnoAsync(item.Id)">
                                                                Complete My Book
                                                            </button>
                                                        }
                                                        else
                                                        {
                                                            <span class="done-text">Read only</span>
                                                        }
                                                    }

                                                    @if (PuedeEditarLateWork)
                                                    {
                                                        <button type="button"
                                                                class="btn-small-edit"
                                                                disabled="@Procesando"
                                                                @onclick="() => PrepararEdicion(item)">
                                                            Edit
                                                        </button>
                                                    }

                                                    @if (PuedeEliminarLateWork)
                                                    {
                                                        <button type="button"
                                                                class="btn-small-delete"
                                                                disabled="@Procesando"
                                                                @onclick="() => PrepararEliminacion(item)">
                                                            Delete
                                                        </button>
                                                    }
                                                </div>
                                            </td>
                                        }
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>

        </section>
    </div>
}


@if (MostrarModalResultadoLateWork)
{
    <div class="late-result-modal-overlay"
         role="presentation"
         @onclick="CerrarModalResultadoLateWork">

        <div class="late-result-modal-card @TipoModalResultadoLateWork"
             role="dialog"
             aria-modal="true"
             aria-labelledby="lateWorkResultModalTitle"
             @onclick:stopPropagation="true">

            <div class="late-result-modal-accent"></div>

            <div class="late-result-modal-content">
                <div class="late-result-modal-icon" aria-hidden="true">
                    @if (TipoModalResultadoLateWork == "success")
                    {
                        <svg viewBox="0 0 24 24">
                            <path d="M20 6 9 17l-5-5"></path>
                        </svg>
                    }
                    else
                    {
                        <svg viewBox="0 0 24 24">
                            <circle cx="12" cy="12" r="9"></circle>
                            <path d="M12 7v6"></path>
                            <path d="M12 17h.01"></path>
                        </svg>
                    }
                </div>

                <div class="late-result-modal-copy">
                    <span class="late-result-modal-eyebrow">Late Work Activities</span>
                    <h3 id="lateWorkResultModalTitle">@TituloModalResultadoLateWork</h3>
                    <p>@MensajeModalResultadoLateWork</p>
                </div>
            </div>

            <div class="late-result-modal-actions">
                <button type="button"
                        class="late-result-modal-ok"
                        @onclick="CerrarModalResultadoLateWork">
                    OK
                </button>
            </div>
        </div>
    </div>
}

@if (MostrarConfirmacionEliminar && LateWorkPendienteEliminar is not null)
{
    <div class="late-delete-modal-overlay"
         role="presentation"
         @onclick="CancelarEliminacion">

        <div class="late-delete-modal-card"
             role="dialog"
             aria-modal="true"
             aria-labelledby="lateWorkDeleteModalTitle"
             @onclick:stopPropagation="true">

            <div class="late-delete-modal-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                    <path d="M4 7h16"></path>
                    <path d="M9 7V4h6v3"></path>
                    <path d="M7 7l1 13h8l1-13"></path>
                    <path d="M10 11v5"></path>
                    <path d="M14 11v5"></path>
                </svg>
            </div>

            <div class="late-delete-modal-copy">
                <span>Delete late work activity</span>
                <h3 id="lateWorkDeleteModalTitle">
                    Delete Late Work ID @LateWorkPendienteEliminar.LateWorkId?
                </h3>
                <p>
                    This action permanently removes the activity and cannot be undone.
                </p>
            </div>

            <div class="late-delete-summary">
                <div>
                    <span>Late Work ID</span>
                    <strong>@LateWorkPendienteEliminar.LateWorkId</strong>
                </div>

                <div>
                    <span>Client ID</span>
                    <strong>@LateWorkPendienteEliminar.ClientId</strong>
                </div>

                <div class="wide">
                    <span>Assignment</span>
                    <strong>@LateWorkPendienteEliminar.AssignmentName</strong>
                </div>

                <div>
                    <span>Status</span>
                    <strong>@(LateWorkPendienteEliminar.Completed ? "Completed" : "Pending")</strong>
                </div>
            </div>

            <div class="late-delete-warning">
                Deleting this activity may change the Final PO late-work verification for the related assignment.
            </div>

            <div class="late-delete-modal-actions">
                <button type="button"
                        class="late-delete-cancel"
                        disabled="@Procesando"
                        @onclick="CancelarEliminacion">
                    Cancel
                </button>

                <button type="button"
                        class="late-delete-confirm"
                        disabled="@Procesando"
                        @onclick="ConfirmarEliminacionAsync">
                    @(Procesando ? "Deleting..." : "Delete Activity")
                </button>
            </div>
        </div>
    </div>
}

@code {
    private Guid? AssignmentSeleccionadoId { get; set; }

    private HashSet<Guid> AssignmentSeleccionados { get; set; } = new();

    private string BusquedaAsignacionesRegistro { get; set; } = string.Empty;

    private Guid? CurrentEmployeeId { get; set; }

    private string LateWorkIdTexto { get; set; } = string.Empty;

    private string ClientIdTexto { get; set; } = string.Empty;

    private string TextoMasivo { get; set; } = string.Empty;

    private string? FiltroAssignmentId { get; set; }

    private string FiltroEstado { get; set; } = "all";

    private string TextoBuscar { get; set; } = string.Empty;

    private string Mensaje { get; set; } = string.Empty;

    private bool EsError { get; set; }

    private bool Procesando { get; set; }

    private Guid? LateWorkEditandoId { get; set; }

    private bool MostrarModalResultadoLateWork { get; set; }
    private string TituloModalResultadoLateWork { get; set; } = string.Empty;
    private string MensajeModalResultadoLateWork { get; set; } = string.Empty;
    private string TipoModalResultadoLateWork { get; set; } = "success";

    private bool MostrarConfirmacionEliminar { get; set; }
    private LateWorkListItem? LateWorkPendienteEliminar { get; set; }

    private bool TodosSeleccionados { get; set; }

    private bool CargandoPermisos { get; set; } = true;

    private Permisos? PermisosUsuarioActual { get; set; }
    private UserDataScope Scope { get; set; } = new();

    private bool PuedeVerLateWork => PermisosUsuarioActual?.LateWork == true;

    private bool PuedeCrearLateWork => PermisosUsuarioActual?.CreateLateWork == true;

    private bool PuedeEditarLateWork => PermisosUsuarioActual?.EditLateWork == true;

    private bool PuedeEliminarLateWork => PermisosUsuarioActual?.DeleteLateWork == true;

    private bool PuedeCompletarLateWork => PermisosUsuarioActual?.CompleteLateWork == true;

    private int ColspanTabla =>
        6 +
        (Scope.ViewAllEmployeeTypes ? 1 : 0) +
        (PuedeCompletarLateWork ? 1 : 0) +
        ((PuedeCompletarLateWork || PuedeEditarLateWork || PuedeEliminarLateWork) ? 1 : 0);

    private int TotalLateWorkGroups =>
        LateWorks
            .Select(x => (x.LateWorkId, x.ClientId))
            .Distinct()
            .Count();

    private int CompletedLateWorkGroups =>
        LateWorks
            .Select(x => (x.LateWorkId, x.ClientId))
            .Distinct()
            .Count(key =>
                ProgresoGlobalLateWork.TryGetValue(key, out var progreso) &&
                progreso.Total > 0 &&
                progreso.Completed == progreso.Total);

    private int PendingLateWorkGroups =>
        TotalLateWorkGroups - CompletedLateWorkGroups;

    private IEnumerable<AssignmentComboItem> AsignacionesRegistroFiltradas
    {
        get
        {
            IEnumerable<AssignmentComboItem> query = Asignaciones;

            if (!string.IsNullOrWhiteSpace(BusquedaAsignacionesRegistro))
            {
                var term = BusquedaAsignacionesRegistro.Trim();

                query = query.Where(x =>
                    x.DisplayName.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    x.KgenCode.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    x.LsaCode.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    x.BookName.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    x.EmployeeName.Contains(term, StringComparison.OrdinalIgnoreCase));
            }

            return query;
        }
    }

    private bool TodasAsignacionesRegistroSeleccionadas
    {
        get
        {
            var visibles = AsignacionesRegistroFiltradas.ToList();

            return visibles.Any() &&
                   visibles.All(x => AssignmentSeleccionados.Contains(x.Id));
        }
    }

    private List<AssignmentComboItem> Asignaciones { get; set; } = new();

    private List<LateWorkListItem> LateWorks { get; set; } = new();

    private List<LateWorkListItem> LateWorksFiltrados { get; set; } = new();

    private Dictionary<(long LateWorkId, long ClientId), (int Completed, int Total)>
        ProgresoGlobalLateWork
    { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        await CargarPermisosDelUsuarioAsync();

        if (!PuedeVerLateWork)
        {
            CargandoPermisos = false;
            return;
        }

        await CargarDatosAsync();

        CargandoPermisos = false;
    }

    private async Task CargarPermisosDelUsuarioAsync()
    {
        try
        {
            CargandoPermisos = true;

            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            Scope = await UserDataScopeService.GetScopeAsync(user);

            CurrentEmployeeId = Scope.EmployeeId;

            if (!CurrentEmployeeId.HasValue ||
                CurrentEmployeeId.Value == Guid.Empty)
            {
                var employeeClaim =
                    user.FindFirst("EmployeeId")?.Value ??
                    user.FindFirst("Employee_Id")?.Value ??
                    user.FindFirst("EmpleadoId")?.Value ??
                    user.FindFirst("IdEmpleado")?.Value;

                if (Guid.TryParse(employeeClaim, out var employeeId) &&
                    employeeId != Guid.Empty)
                {
                    CurrentEmployeeId = employeeId;
                }
            }

            if (user?.Identity?.IsAuthenticated != true)
            {
                PermisosUsuarioActual = null;
                return;
            }

            var userIdTexto = user.FindFirstValue(ClaimTypes.NameIdentifier);

            if (string.IsNullOrWhiteSpace(userIdTexto))
            {
                PermisosUsuarioActual = null;
                return;
            }

            await using var db = await DbFactory.CreateDbContextAsync();

            if (!Guid.TryParse(userIdTexto, out var userId))
            {
                PermisosUsuarioActual = null;
                return;
            }

            var usuario = await db.Set<Usuario>()
                .AsNoTracking()
                .Include(x => x.Permisos)
                .FirstOrDefaultAsync(x => x.Id == userId);

            PermisosUsuarioActual = usuario?.Permisos;
        }
        catch
        {
            PermisosUsuarioActual = null;
        }
    }

    private async Task CargarDatosAsync()
    {
        if (!PuedeVerLateWork)
            return;

        await using var db = await DbFactory.CreateDbContextAsync();

        await ActualizarFinalizadosPorDirxionAsync(db);

        Asignaciones = await db.Asignaciones
            .AsNoTracking()
            .Include(x => x.Libro)
                .ThenInclude(x => x!.EmployeeType)
            .Include(x => x.Empleado)
            .ApplyScope(Scope)
            .Where(x => !x.Finalizado &&
                        x.Libro != null &&
                        !x.Libro.Finalizado)
            .OrderByDescending(x => x.Id)
            .Select(x => new AssignmentComboItem
            {
                Id = x.Id,
                EmployeeId = x.IdEmpleado,
                BookName = x.Libro != null ? x.Libro.BookName : "Book without name",
                EmployeeName = x.Empleado != null ? x.Empleado.Nombre : "Employee without name",
                KgenCode = x.Libro != null ? (x.Libro.KGENCode ?? string.Empty) : string.Empty,
                LsaCode = x.Libro != null ? (x.Libro.LSACode ?? string.Empty) : string.Empty,
                EmployeeTypeCode = x.Libro != null && x.Libro.EmployeeType != null
                    ? x.Libro.EmployeeType.Code
                    : "",
                DisplayName =
                    (Scope.ViewAllEmployeeTypes && x.Libro != null && x.Libro.EmployeeType != null
                        ? "[" + x.Libro.EmployeeType.Code + "] "
                        : "")
                    + (x.Libro != null ? x.Libro.BookName : "Book without name")
                    + " - "
                    + (x.Empleado != null ? x.Empleado.Nombre : "Employee without name")
            })
            .ToListAsync();

        LateWorks = await db.LateWorkActivities
            .AsNoTracking()
            .Include(x => x.Assignment)
                .ThenInclude(x => x!.Libro)
                    .ThenInclude(x => x!.EmployeeType)
            .Include(x => x.Assignment)
                .ThenInclude(x => x!.Empleado)
            .Where(x => x.Assignment != null &&
                        !x.Assignment.Finalizado &&
                        x.Assignment.Libro != null &&
                        !x.Assignment.Libro.Finalizado &&
                        (Scope.ViewAllEmployeeTypes ||
                         x.Assignment.Libro.EmployeeTypeId == Scope.EmployeeTypeId))
            .OrderByDescending(x => x.CreatedAt)
            .Select(x => new LateWorkListItem
            {
                Id = x.Id,
                AssignmentId = x.AssignmentId,
                EmployeeId = x.Assignment != null ? x.Assignment.IdEmpleado : Guid.Empty,
                EmployeeTypeCode = x.Assignment != null && x.Assignment.Libro != null && x.Assignment.Libro.EmployeeType != null
                    ? x.Assignment.Libro.EmployeeType.Code
                    : "",
                LateWorkId = x.LateWorkId,
                ClientId = x.ClientId,
                BookName =
                    x.Assignment != null && x.Assignment.Libro != null
                        ? x.Assignment.Libro.BookName
                        : "Book without name",
                EmployeeName =
                    x.Assignment != null && x.Assignment.Empleado != null
                        ? x.Assignment.Empleado.Nombre
                        : "Employee without name",
                KgenCode =
                    x.Assignment != null && x.Assignment.Libro != null
                        ? (x.Assignment.Libro.KGENCode ?? string.Empty)
                        : string.Empty,
                LsaCode =
                    x.Assignment != null && x.Assignment.Libro != null
                        ? (x.Assignment.Libro.LSACode ?? string.Empty)
                        : string.Empty,
                Completed = x.Completed,
                CompletedAt = x.CompletedAt,
                CreatedAt = x.CreatedAt,
                AssignmentName =
                    x.Assignment != null
                        ? ((x.Assignment.Libro != null ? x.Assignment.Libro.BookName : "Book without name")
                           + " - "
                           + (x.Assignment.Empleado != null ? x.Assignment.Empleado.Nombre : "Employee without name"))
                        : "Assignment not found"
            })
            .ToListAsync();

        ProgresoGlobalLateWork.Clear();

        var clavesVisibles = LateWorks
            .Select(x => (x.LateWorkId, x.ClientId))
            .Distinct()
            .ToHashSet();

        if (clavesVisibles.Any())
        {
            var lateWorkIdsVisibles = clavesVisibles
                .Select(x => x.LateWorkId)
                .Distinct()
                .ToList();

            var clientIdsVisibles = clavesVisibles
                .Select(x => x.ClientId)
                .Distinct()
                .ToList();

            var progresoRows = await db.LateWorkActivities
                .AsNoTracking()
                .Where(x =>
                    lateWorkIdsVisibles.Contains(x.LateWorkId) &&
                    clientIdsVisibles.Contains(x.ClientId) &&
                    x.Assignment != null &&
                    !x.Assignment.Finalizado &&
                    x.Assignment.Libro != null &&
                    !x.Assignment.Libro.Finalizado)
                .Select(x => new
                {
                    x.LateWorkId,
                    x.ClientId,
                    x.Completed
                })
                .ToListAsync();

            ProgresoGlobalLateWork = progresoRows
                .Where(x =>
                    clavesVisibles.Contains(
                        (x.LateWorkId, x.ClientId)))
                .GroupBy(x => new
                {
                    x.LateWorkId,
                    x.ClientId
                })
                .ToDictionary(
                    g => (g.Key.LateWorkId, g.Key.ClientId),
                    g => (
                        Completed: g.Count(x => x.Completed),
                        Total: g.Count()));
        }

        var assignmentIdsParaResponsabilidad =
            Asignaciones
                .Select(x => x.Id)
                .Concat(LateWorks.Select(x => x.AssignmentId))
                .Distinct()
                .ToList();

        var temporalesFinalPO = await db.TemporaryAssignments
            .AsNoTracking()
            .Include(x => x.TemporaryEmployee)
            .Where(x =>
                x.Active &&
                x.FinalPO &&
                assignmentIdsParaResponsabilidad.Contains(x.AssignmentId))
            .OrderByDescending(x => x.CreatedAt)
            .ToListAsync();

        foreach (var item in Asignaciones)
        {
            var temporal = temporalesFinalPO
                .FirstOrDefault(x =>
                    x.AssignmentId == item.Id);

            if (temporal is not null)
            {
                item.EmployeeId =
                    temporal.TemporaryEmployeeId;

                if (!string.IsNullOrWhiteSpace(
                        temporal.TemporaryEmployee?.Nombre))
                {
                    item.EmployeeName =
                        temporal.TemporaryEmployee.Nombre;
                }
            }

            item.DisplayName =
                (Scope.ViewAllEmployeeTypes
                    ? "[" + item.EmployeeTypeCode + "] "
                    : "")
                + item.BookName
                + " - "
                + item.EmployeeName;
        }

        foreach (var item in LateWorks)
        {
            var temporal = temporalesFinalPO
                .FirstOrDefault(x =>
                    x.AssignmentId == item.AssignmentId);

            if (temporal is not null)
            {
                item.EmployeeId =
                    temporal.TemporaryEmployeeId;

                if (!string.IsNullOrWhiteSpace(
                        temporal.TemporaryEmployee?.Nombre))
                {
                    item.EmployeeName =
                        temporal.TemporaryEmployee.Nombre;
                }
            }

            item.AssignmentName =
                item.BookName + " - " + item.EmployeeName;

            item.EsAsignacionPropia =
                CurrentEmployeeId.HasValue &&
                CurrentEmployeeId.Value != Guid.Empty &&
                item.EmployeeId == CurrentEmployeeId.Value;
        }

        AplicarFiltro();
    }

    private async Task ActualizarFinalizadosPorDirxionAsync(AppDbContext db)
    {
        var hoy = DateOnly.FromDateTime(DateTime.Today);

        var librosParaFinalizar = await db.Libros
            .Include(x => x.Asignaciones)
                .ThenInclude(a => a.Evaluaciones)
            .ApplyScope(Scope)
            .Where(x => !x.Finalizado &&
                        x.DirxionDate < hoy)
            .ToListAsync();

        if (!librosParaFinalizar.Any())
            return;

        foreach (var libro in librosParaFinalizar)
        {
            libro.Finalizado = true;

            foreach (var asignacion in libro.Asignaciones)
            {
                asignacion.Finalizado = true;

                foreach (var evaluacion in asignacion.Evaluaciones)
                {
                    evaluacion.Finalizado = true;
                }
            }
        }

        await db.SaveChangesAsync();
    }

    private async Task GuardarUnoAsync()
    {
        if (Procesando)
            return;

        LimpiarMensaje();

        if (!PuedeCrearLateWork && !LateWorkEditandoId.HasValue)
        {
            MostrarError(
                "You do not have permission to create Late Work activities.",
                "Permission required");
            return;
        }

        if (LateWorkEditandoId.HasValue && !PuedeEditarLateWork)
        {
            MostrarError(
                "You do not have permission to edit Late Work activities.",
                "Permission required");
            return;
        }

        if (LateWorkEditandoId.HasValue)
        {
            if (AssignmentSeleccionadoId is null ||
                AssignmentSeleccionadoId == Guid.Empty)
            {
                MostrarError(
                    "You must select an assignment.",
                    "Assignment required");
                return;
            }
        }
        else if (!AssignmentSeleccionados.Any())
        {
            MostrarError(
                "You must select at least one assignment.",
                "Assignments required");
            return;
        }

        if (string.IsNullOrWhiteSpace(LateWorkIdTexto))
        {
            MostrarError(
                "You must enter the Late Work ID.",
                "Late Work ID required");
            return;
        }

        if (!long.TryParse(LateWorkIdTexto.Trim(), out var lateWorkId))
        {
            MostrarError(
                "The Late Work ID must contain numbers only.",
                "Invalid Late Work ID");
            return;
        }

        if (string.IsNullOrWhiteSpace(ClientIdTexto))
        {
            MostrarError(
                "You must enter the Client ID.",
                "Client ID required");
            return;
        }

        if (!long.TryParse(ClientIdTexto.Trim(), out var clientId))
        {
            MostrarError(
                "The Client ID must contain numbers only.",
                "Invalid Client ID");
            return;
        }

        Procesando = true;

        try
        {
            await using var db =
                await DbFactory.CreateDbContextAsync();

            if (LateWorkEditandoId.HasValue)
            {
                var assignmentId = AssignmentSeleccionadoId!.Value;

                var asignacionActiva = await db.Asignaciones
                    .AsNoTracking()
                    .Include(x => x.Libro)
                    .ApplyScope(Scope)
                    .AnyAsync(x =>
                        x.Id == assignmentId &&
                        !x.Finalizado &&
                        x.Libro != null &&
                        !x.Libro.Finalizado);

                if (!asignacionActiva)
                {
                    MostrarError(
                        "This assignment is no longer available.",
                        "Assignment unavailable");
                    return;
                }

                var existe = await ScopedLateWorkQuery(db)
                    .AnyAsync(x =>
                        x.Id != LateWorkEditandoId.Value &&
                        x.AssignmentId == assignmentId &&
                        x.LateWorkId == lateWorkId &&
                        x.ClientId == clientId);

                if (existe)
                {
                    MostrarError(
                        "This Late Work ID already exists for this assignment and client.",
                        "Duplicate activity");
                    return;
                }

                var item = await ScopedLateWorkQuery(db)
                    .FirstOrDefaultAsync(
                        x => x.Id == LateWorkEditandoId.Value);

                if (item is null)
                {
                    MostrarError(
                        "Late work activity not found.",
                        "Activity not found");
                    return;
                }

                item.AssignmentId = assignmentId;
                item.LateWorkId = lateWorkId;
                item.ClientId = clientId;
                item.UpdatedAt = DateTime.UtcNow;

                await db.SaveChangesAsync();

                LateWorkEditandoId = null;
                AssignmentSeleccionadoId = null;
                AssignmentSeleccionados.Clear();
                LateWorkIdTexto = string.Empty;
                ClientIdTexto = string.Empty;

                await CargarDatosAsync();

                MostrarExito(
                    "Late work activity updated successfully.",
                    "Activity updated");

                return;
            }

            var assignmentIds = AssignmentSeleccionados.ToList();

            var asignacionesActivas = await db.Asignaciones
                .AsNoTracking()
                .Include(x => x.Libro)
                .ApplyScope(Scope)
                .Where(x =>
                    assignmentIds.Contains(x.Id) &&
                    !x.Finalizado &&
                    x.Libro != null &&
                    !x.Libro.Finalizado)
                .Select(x => x.Id)
                .ToListAsync();

            if (asignacionesActivas.Count != assignmentIds.Count)
            {
                MostrarError(
                    "One or more selected assignments are no longer available or are outside your scope.",
                    "Assignments unavailable");
                return;
            }

            var existentes = await ScopedLateWorkQuery(db)
                .Where(x =>
                    assignmentIds.Contains(x.AssignmentId) &&
                    x.LateWorkId == lateWorkId &&
                    x.ClientId == clientId)
                .Select(x => x.AssignmentId)
                .ToListAsync();

            var existentesSet = existentes.ToHashSet();

            var nuevos = assignmentIds
                .Where(id => !existentesSet.Contains(id))
                .Select(id => new LateWorkActivity
                {
                    Id = Guid.NewGuid(),
                    AssignmentId = id,
                    LateWorkId = lateWorkId,
                    ClientId = clientId,
                    Completed = false,
                    CreatedAt = DateTime.UtcNow
                })
                .ToList();

            if (!nuevos.Any())
            {
                MostrarError(
                    "This Late Work already exists for all selected assignments.",
                    "No new activities");
                return;
            }

            db.LateWorkActivities.AddRange(nuevos);
            await db.SaveChangesAsync();

            LateWorkIdTexto = string.Empty;
            ClientIdTexto = string.Empty;

            await CargarDatosAsync();

            MostrarExito(
                $"{nuevos.Count} assignment(s) linked to Late Work ID {lateWorkId}.",
                "Late Work assigned");
        }
        catch (DbUpdateException ex)
        {
            MostrarError(
                $"The activity could not be saved. Details: {ex.InnerException?.Message ?? ex.Message}",
                "Database error");
        }
        catch (Exception ex)
        {
            MostrarError(
                $"The activity could not be saved. Details: {ex.Message}",
                "Unable to save activity");
        }
        finally
        {
            Procesando = false;
        }
    }

    private async Task GuardarMasivoAsync()
    {
        if (Procesando)
            return;

        LimpiarMensaje();

        if (!PuedeCrearLateWork)
        {
            MostrarError(
                "You do not have permission to create Late Work activities.",
                "Permission required");
            return;
        }

        if (!AssignmentSeleccionados.Any())
        {
            MostrarError(
                "You must select at least one assignment before bulk registering.",
                "Assignments required");
            return;
        }

        if (string.IsNullOrWhiteSpace(TextoMasivo))
        {
            MostrarError(
                "You must enter at least one Late Work line.",
                "Late Work required");
            return;
        }

        var lineas = TextoMasivo
            .Split(
                '\n',
                StringSplitOptions.RemoveEmptyEntries |
                StringSplitOptions.TrimEntries)
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .ToList();

        var errores = new List<string>();
        var filasValidas =
            new List<(long LateWorkId, long ClientId)>();

        for (int i = 0; i < lineas.Count; i++)
        {
            var partes = lineas[i]
                .Split(
                    new[] { ',', ';', '\t', '|' },
                    StringSplitOptions.TrimEntries |
                    StringSplitOptions.RemoveEmptyEntries)
                .ToList();

            if (partes.Count < 2)
            {
                errores.Add(
                    $"Line {i + 1}: invalid format. Use LateWorkId, ClientId.");
                continue;
            }

            if (!long.TryParse(partes[0], out var lateWorkId))
            {
                errores.Add(
                    $"Line {i + 1}: Late Work ID must contain numbers only.");
                continue;
            }

            if (!long.TryParse(partes[1], out var clientId))
            {
                errores.Add(
                    $"Line {i + 1}: Client ID must contain numbers only.");
                continue;
            }

            filasValidas.Add((lateWorkId, clientId));
        }

        if (errores.Any())
        {
            MostrarError(
                string.Join(" | ", errores),
                "Invalid bulk data");
            return;
        }

        filasValidas = filasValidas
            .Distinct()
            .ToList();

        if (!filasValidas.Any())
        {
            MostrarError(
                "No valid records were found.",
                "No records");
            return;
        }

        Procesando = true;

        try
        {
            await using var db =
                await DbFactory.CreateDbContextAsync();

            var assignmentIds = AssignmentSeleccionados.ToList();

            var asignacionesActivas = await db.Asignaciones
                .AsNoTracking()
                .Include(x => x.Libro)
                .ApplyScope(Scope)
                .Where(x =>
                    assignmentIds.Contains(x.Id) &&
                    !x.Finalizado &&
                    x.Libro != null &&
                    !x.Libro.Finalizado)
                .Select(x => x.Id)
                .ToListAsync();

            if (asignacionesActivas.Count != assignmentIds.Count)
            {
                MostrarError(
                    "One or more selected assignments are no longer available or are outside your scope.",
                    "Assignments unavailable");
                return;
            }

            var lateWorkIds = filasValidas
                .Select(x => x.LateWorkId)
                .Distinct()
                .ToList();

            var clientIds = filasValidas
                .Select(x => x.ClientId)
                .Distinct()
                .ToList();

            var existentes = await ScopedLateWorkQuery(db)
                .Where(x =>
                    assignmentIds.Contains(x.AssignmentId) &&
                    lateWorkIds.Contains(x.LateWorkId) &&
                    clientIds.Contains(x.ClientId))
                .Select(x => new
                {
                    x.AssignmentId,
                    x.LateWorkId,
                    x.ClientId
                })
                .ToListAsync();

            var existentesSet = existentes
                .Select(x =>
                    $"{x.AssignmentId}|{x.LateWorkId}|{x.ClientId}")
                .ToHashSet();

            var nuevos = new List<LateWorkActivity>();

            foreach (var assignmentId in assignmentIds)
            {
                foreach (var lateWork in filasValidas)
                {
                    var key =
                        $"{assignmentId}|{lateWork.LateWorkId}|{lateWork.ClientId}";

                    if (existentesSet.Contains(key))
                        continue;

                    nuevos.Add(new LateWorkActivity
                    {
                        Id = Guid.NewGuid(),
                        AssignmentId = assignmentId,
                        LateWorkId = lateWork.LateWorkId,
                        ClientId = lateWork.ClientId,
                        Completed = false,
                        CreatedAt = DateTime.UtcNow
                    });
                }
            }

            if (!nuevos.Any())
            {
                MostrarError(
                    "All Late Work records already exist for all selected assignments.",
                    "No new activities");
                return;
            }

            db.LateWorkActivities.AddRange(nuevos);
            await db.SaveChangesAsync();

            TextoMasivo = string.Empty;

            await CargarDatosAsync();

            MostrarExito(
                $"{filasValidas.Count} Late Work item(s) were assigned across {assignmentIds.Count} assignment(s). {nuevos.Count} new assignment activity record(s) were created.",
                "Bulk registration completed");
        }
        catch (DbUpdateException ex)
        {
            MostrarError(
                $"The bulk registration could not be saved. Details: {ex.InnerException?.Message ?? ex.Message}",
                "Database error");
        }
        catch (Exception ex)
        {
            MostrarError(
                $"The bulk registration could not be completed. Details: {ex.Message}",
                "Bulk registration failed");
        }
        finally
        {
            Procesando = false;
        }
    }

    private async Task CompletarUnoAsync(Guid id)
    {
        if (Procesando)
            return;

        LimpiarMensaje();

        if (!PuedeCompletarLateWork)
        {
            MostrarError(
                "You do not have permission to complete Late Work activities.",
                "Permission required");
            return;
        }

        if (!CurrentEmployeeId.HasValue ||
            CurrentEmployeeId.Value == Guid.Empty)
        {
            MostrarError(
                "Your user is not linked to an employee. You cannot complete assignment Late Work.",
                "Employee link required");
            return;
        }

        Procesando = true;

        try
        {
            await using var db =
                await DbFactory.CreateDbContextAsync();

            var item = await ScopedLateWorkQuery(db)
                .FirstOrDefaultAsync(x => x.Id == id);

            if (item is null)
            {
                MostrarError(
                    "Late work activity not found.",
                    "Activity not found");
                return;
            }

            var empleadoResponsableId =
                await ObtenerEmpleadoResponsableLateWorkAsync(
                    db,
                    item.AssignmentId,
                    item.Assignment?.IdEmpleado);

            if (empleadoResponsableId != CurrentEmployeeId.Value)
            {
                MostrarError(
                    "You can only complete Late Work for your own assignment.",
                    "Read-only assignment");
                return;
            }

            if (item.Completed)
            {
                MostrarError(
                    "This assignment is already completed for this Late Work.",
                    "Already completed");
                return;
            }

            item.Completed = true;
            item.CompletedAt = DateTime.UtcNow;
            item.UpdatedAt = DateTime.UtcNow;

            await db.SaveChangesAsync();

            var lateWorkId = item.LateWorkId;
            var clientId = item.ClientId;

            var total = await ScopedLateWorkQuery(db)
                .CountAsync(x =>
                    x.LateWorkId == lateWorkId &&
                    x.ClientId == clientId);

            var completados = await ScopedLateWorkQuery(db)
                .CountAsync(x =>
                    x.LateWorkId == lateWorkId &&
                    x.ClientId == clientId &&
                    x.Completed);

            await CargarDatosAsync();

            MostrarExito(
                total > 0 && total == completados
                    ? $"Your book was completed. Late Work ID {lateWorkId} is now Completed Total ({completados}/{total})."
                    : $"Your book was completed. Late Work ID {lateWorkId} progress: {completados}/{total}.",
                total > 0 && total == completados
                    ? "Late Work completed total"
                    : "Assignment completed");
        }
        catch (Exception ex)
        {
            MostrarError(
                $"The activity could not be completed. Details: {ex.Message}",
                "Unable to complete activity");
        }
        finally
        {
            Procesando = false;
        }
    }

    private async Task CompletarSeleccionadosAsync()
    {
        if (Procesando)
            return;

        LimpiarMensaje();

        if (!PuedeCompletarLateWork)
        {
            MostrarError(
                "You do not have permission to complete Late Work activities.",
                "Permission required");
            return;
        }

        if (!CurrentEmployeeId.HasValue ||
            CurrentEmployeeId.Value == Guid.Empty)
        {
            MostrarError(
                "Your user is not linked to an employee. You cannot complete assignment Late Work.",
                "Employee link required");
            return;
        }

        var ids = LateWorksFiltrados
            .Where(x =>
                x.Seleccionado &&
                !x.Completed &&
                x.EsAsignacionPropia)
            .Select(x => x.Id)
            .ToList();

        if (!ids.Any())
        {
            MostrarError(
                "You must select at least one of your pending assignments.",
                "Selection required");
            return;
        }

        Procesando = true;

        try
        {
            await using var db =
                await DbFactory.CreateDbContextAsync();

            var registros = await ScopedLateWorkQuery(db)
                .Where(x =>
                    ids.Contains(x.Id) &&
                    !x.Completed)
                .ToListAsync();

            if (registros.Count != ids.Count)
            {
                MostrarError(
                    "One or more selected records could not be loaded.",
                    "Selection changed");
                return;
            }

            var assignmentIds = registros
                .Select(x => x.AssignmentId)
                .Distinct()
                .ToList();

            var temporalesFinalPO = await db.TemporaryAssignments
                .AsNoTracking()
                .Where(x =>
                    x.Active &&
                    x.FinalPO &&
                    assignmentIds.Contains(x.AssignmentId))
                .OrderByDescending(x => x.CreatedAt)
                .ToListAsync();

            var employeeId =
                CurrentEmployeeId.Value;

            foreach (var item in registros)
            {
                var temporal = temporalesFinalPO
                    .FirstOrDefault(x =>
                        x.AssignmentId == item.AssignmentId);

                var empleadoResponsableId =
                    temporal?.TemporaryEmployeeId ??
                    item.Assignment?.IdEmpleado ??
                    Guid.Empty;

                if (empleadoResponsableId != employeeId)
                {
                    MostrarError(
                        "One or more selected records are not your assignments. No unauthorized assignment was completed.",
                        "Read-only assignment");
                    return;
                }
            }

            foreach (var item in registros)
            {
                item.Completed = true;
                item.CompletedAt = DateTime.UtcNow;
                item.UpdatedAt = DateTime.UtcNow;
            }

            await db.SaveChangesAsync();

            TodosSeleccionados = false;
            await CargarDatosAsync();

            MostrarExito(
                $"{registros.Count} of your Late Work assignment(s) were marked as completed.",
                registros.Count == 1
                    ? "Assignment completed"
                    : "Assignments completed");
        }
        catch (Exception ex)
        {
            MostrarError(
                $"The selected activities could not be completed. Details: {ex.Message}",
                "Unable to complete activities");
        }
        finally
        {
            Procesando = false;
        }
    }

    private async Task<Guid> ObtenerEmpleadoResponsableLateWorkAsync(
        AppDbContext db,
        Guid assignmentId,
        Guid? empleadoOriginalId = null)
    {
        var temporalEmployeeId =
            await db.TemporaryAssignments
                .AsNoTracking()
                .Where(x =>
                    x.Active &&
                    x.FinalPO &&
                    x.AssignmentId == assignmentId)
                .OrderByDescending(x => x.CreatedAt)
                .Select(x => (Guid?)x.TemporaryEmployeeId)
                .FirstOrDefaultAsync();

        if (temporalEmployeeId.HasValue &&
            temporalEmployeeId.Value != Guid.Empty)
        {
            return temporalEmployeeId.Value;
        }

        if (empleadoOriginalId.HasValue &&
            empleadoOriginalId.Value != Guid.Empty)
        {
            return empleadoOriginalId.Value;
        }

        return await db.Asignaciones
            .AsNoTracking()
            .Where(x => x.Id == assignmentId)
            .Select(x => x.IdEmpleado)
            .FirstOrDefaultAsync();
    }

    private void PrepararEliminacion(LateWorkListItem item)
    {
        LimpiarMensaje();

        if (!PuedeEliminarLateWork)
        {
            MostrarError(
                "You do not have permission to delete Late Work activities.",
                "Permission required");
            return;
        }

        LateWorkPendienteEliminar = item;
        MostrarConfirmacionEliminar = true;
    }

    private void CancelarEliminacion()
    {
        if (Procesando)
            return;

        MostrarConfirmacionEliminar = false;
        LateWorkPendienteEliminar = null;
    }

    private async Task ConfirmarEliminacionAsync()
    {
        if (Procesando || LateWorkPendienteEliminar is null)
            return;

        if (!PuedeEliminarLateWork)
        {
            CancelarEliminacion();
            MostrarError(
                "You do not have permission to delete Late Work activities.",
                "Permission required");
            return;
        }

        var id = LateWorkPendienteEliminar.Id;
        Procesando = true;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            var item = await ScopedLateWorkQuery(db)
                .FirstOrDefaultAsync(x => x.Id == id);

            if (item is null)
            {
                MostrarConfirmacionEliminar = false;
                LateWorkPendienteEliminar = null;
                MostrarError("Late work activity not found.", "Activity not found");
                return;
            }

            db.LateWorkActivities.Remove(item);
            await db.SaveChangesAsync();

            if (LateWorkEditandoId == id)
            {
                LateWorkEditandoId = null;
                AssignmentSeleccionadoId = null;
                LateWorkIdTexto = string.Empty;
                ClientIdTexto = string.Empty;
            }

            MostrarConfirmacionEliminar = false;
            LateWorkPendienteEliminar = null;

            await CargarDatosAsync();

            MostrarExito(
                "Late work activity deleted successfully.",
                "Activity deleted");
        }
        catch (Exception ex)
        {
            MostrarConfirmacionEliminar = false;
            LateWorkPendienteEliminar = null;

            MostrarError(
                $"The activity could not be deleted. Details: {ex.Message}",
                "Unable to delete activity");
        }
        finally
        {
            Procesando = false;
        }
    }

    private void PrepararEdicion(LateWorkListItem item)
    {
        LimpiarMensaje();

        if (!PuedeEditarLateWork)
        {
            MostrarError(
                "You do not have permission to edit Late Work activities.",
                "Permission required");
            return;
        }

        AssignmentSeleccionados.Clear();
        BusquedaAsignacionesRegistro = string.Empty;
        LateWorkEditandoId = item.Id;
        AssignmentSeleccionadoId = item.AssignmentId;
        LateWorkIdTexto = item.LateWorkId.ToString();
        ClientIdTexto = item.ClientId.ToString();

        MostrarExito(
            "The activity was loaded into the form. Update the values and select Update Activity.",
            "Activity loaded for editing");
    }

    private void SeleccionarTodos(ChangeEventArgs e)
    {
        if (!PuedeCompletarLateWork)
            return;

        TodosSeleccionados =
            e.Value is bool value && value;

        foreach (var item in LateWorksFiltrados)
        {
            item.Seleccionado =
                TodosSeleccionados &&
                !item.Completed &&
                item.EsAsignacionPropia;
        }
    }


    private IQueryable<LateWorkActivity> ScopedLateWorkQuery(
        AppDbContext db)
    {
        var query = db.LateWorkActivities
            .Include(x => x.Assignment)
                .ThenInclude(x => x!.Libro)
            .Where(x =>
                x.Assignment != null &&
                x.Assignment.Libro != null);

        return Scope.ViewAllEmployeeTypes
            ? query
            : query.Where(x =>
                x.Assignment!.Libro!.EmployeeTypeId ==
                Scope.EmployeeTypeId);
    }

    private void AplicarFiltro()
    {
        IEnumerable<LateWorkListItem> query = LateWorks;

        if (!string.IsNullOrWhiteSpace(FiltroAssignmentId) &&
            Guid.TryParse(
                FiltroAssignmentId,
                out var assignmentId))
        {
            query = query.Where(
                x => x.AssignmentId == assignmentId);
        }

        if (FiltroEstado == "pending")
        {
            query = query.Where(
                x => !EstaCompletadoTotal(x));
        }
        else if (FiltroEstado == "partial")
        {
            query = query.Where(x =>
            {
                var progreso = ObtenerProgresoLateWork(x);

                return progreso.Completed > 0 &&
                       progreso.Completed < progreso.Total;
            });
        }
        else if (FiltroEstado == "completed")
        {
            query = query.Where(EstaCompletadoTotal);
        }

        if (!string.IsNullOrWhiteSpace(TextoBuscar))
        {
            var buscar =
                TextoBuscar.Trim().ToLowerInvariant();

            query = query.Where(x =>
                x.LateWorkId
                    .ToString()
                    .Contains(buscar) ||
                x.ClientId
                    .ToString()
                    .Contains(buscar) ||
                x.KgenCode
                    .ToLowerInvariant()
                    .Contains(buscar) ||
                x.LsaCode
                    .ToLowerInvariant()
                    .Contains(buscar) ||
                x.BookName
                    .ToLowerInvariant()
                    .Contains(buscar) ||
                x.EmployeeName
                    .ToLowerInvariant()
                    .Contains(buscar) ||
                x.AssignmentName
                    .ToLowerInvariant()
                    .Contains(buscar));
        }

        LateWorksFiltrados = query
            .OrderByDescending(x => x.CreatedAt)
            .ThenBy(x => x.LateWorkId)
            .ThenBy(x => x.AssignmentName)
            .ToList();

        TodosSeleccionados =
            PuedeCompletarLateWork &&
            LateWorksFiltrados.Any(x =>
                !x.Completed &&
                x.EsAsignacionPropia) &&
            LateWorksFiltrados
                .Where(x =>
                    !x.Completed &&
                    x.EsAsignacionPropia)
                .All(x => x.Seleccionado);
    }

    private void ToggleAssignmentRegistro(
        Guid assignmentId,
        ChangeEventArgs e)
    {
        var selected =
            e.Value is bool value && value;

        if (selected)
            AssignmentSeleccionados.Add(assignmentId);
        else
            AssignmentSeleccionados.Remove(assignmentId);
    }

    private void SeleccionarTodasAsignacionesRegistro(
        ChangeEventArgs e)
    {
        var selected =
            e.Value is bool value && value;

        foreach (var item in AsignacionesRegistroFiltradas)
        {
            if (selected)
                AssignmentSeleccionados.Add(item.Id);
            else
                AssignmentSeleccionados.Remove(item.Id);
        }
    }

    private void LimpiarAsignacionesRegistro()
    {
        AssignmentSeleccionados.Clear();
    }

    private (int Completed, int Total)
        ObtenerProgresoLateWork(
            LateWorkListItem item)
    {
        var key =
            (item.LateWorkId, item.ClientId);

        if (ProgresoGlobalLateWork.TryGetValue(
                key,
                out var progreso))
        {
            return progreso;
        }

        var grupo = LateWorks.Where(x =>
            x.LateWorkId == item.LateWorkId &&
            x.ClientId == item.ClientId);

        var total = grupo.Count();
        var completed = grupo.Count(x => x.Completed);

        return (completed, total);
    }

    private bool EstaCompletadoTotal(
        LateWorkListItem item)
    {
        var progreso = ObtenerProgresoLateWork(item);

        return progreso.Total > 0 &&
               progreso.Completed == progreso.Total;
    }

    private void LimpiarFormulario()
    {
        LateWorkEditandoId = null;
        AssignmentSeleccionadoId = null;
        AssignmentSeleccionados.Clear();
        BusquedaAsignacionesRegistro = string.Empty;
        LateWorkIdTexto = string.Empty;
        ClientIdTexto = string.Empty;
        TextoMasivo = string.Empty;
        LimpiarMensaje();
    }

    private void LimpiarMensaje()
    {
        Mensaje = string.Empty;
        EsError = false;
    }

    private void MostrarExito(
        string mensaje,
        string titulo = "Operation completed")
    {
        Mensaje = mensaje;
        EsError = false;
        MostrarResultadoLateWork(titulo, mensaje, "success");
    }

    private void MostrarError(
        string mensaje,
        string titulo = "Unable to continue")
    {
        Mensaje = mensaje;
        EsError = true;
        MostrarResultadoLateWork(titulo, mensaje, "error");
    }

    private void MostrarResultadoLateWork(
        string titulo,
        string mensaje,
        string tipo)
    {
        TituloModalResultadoLateWork = titulo;
        MensajeModalResultadoLateWork = mensaje;
        TipoModalResultadoLateWork = string.Equals(
            tipo,
            "error",
            StringComparison.OrdinalIgnoreCase)
                ? "error"
                : "success";

        MostrarModalResultadoLateWork = true;
    }

    private void CerrarModalResultadoLateWork()
    {
        MostrarModalResultadoLateWork = false;
        TituloModalResultadoLateWork = string.Empty;
        MensajeModalResultadoLateWork = string.Empty;
        TipoModalResultadoLateWork = "success";
    }

