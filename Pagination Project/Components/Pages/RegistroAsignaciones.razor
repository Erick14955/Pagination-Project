    private async Task ImportAssignmentsFromXlsxAsync(InputFileChangeEventArgs e)
    {
        if (!CreateAssignations)
        {
            MostrarMensaje("You do not have permission to import assignments.", "error");
            return;
        }

        try
        {
            ImportandoXlsx = true;
            LimpiarMensaje();

            ResultadoImportacion = new ImportacionAsignacionesResultado();

            await JS.InvokeVoidAsync("assignmentImportModal.close");

            await InvokeAsync(StateHasChanged);
            await Task.Yield();

            if (!BindPlants.Any() ||
                !Databases.Any() ||
                !LegacyCodes.Any() ||
                !PrintFeet.Any() ||
                !TrimSizes.Any())
            {
                await CargarCatalogosAsync();
            }

            var file = e.File;

            if (file is null)
            {
                ResultadoImportacion.Errores.Add("No file was selected.");

                await MostrarModalImportacionJsAsync(
                    "XLSX import failed",
                    "No file was selected.",
                    "error");

                return;
            }

            if (!file.Name.EndsWith(".xlsx", StringComparison.OrdinalIgnoreCase))
            {
                ResultadoImportacion.Errores.Add($"The selected file '{file.Name}' is not valid. Only .xlsx files are allowed.");

                await MostrarModalImportacionJsAsync(
                    "XLSX import failed",
                    "Only .xlsx files are allowed.",
                    "error");

                return;
            }

            await using var stream = file.OpenReadStream(MaxXlsxSize);
            using var memoryStream = new MemoryStream();

            await stream.CopyToAsync(memoryStream);
            memoryStream.Position = 0;

            using var workbook = new XLWorkbook(memoryStream);
            var worksheet = workbook.Worksheets.FirstOrDefault();

            if (worksheet is null)
            {
                ResultadoImportacion.Errores.Add("The XLSX file does not contain any worksheet.");

                await MostrarModalImportacionJsAsync(
                    "XLSX import failed",
                    "The XLSX file does not contain any worksheet.",
                    "error");

                return;
            }

            var headerRow = worksheet.FirstRowUsed();

            if (headerRow is null)
            {
                ResultadoImportacion.Errores.Add("The XLSX file is empty.");

                await MostrarModalImportacionJsAsync(
                    "XLSX import failed",
                    "The XLSX file is empty.",
                    "error");

                return;
            }

            var headerMap = BuildHeaderMap(headerRow);

            if (!HeaderExists(headerMap, "employee_type", "Employee Type"))
            {
                ResultadoImportacion.Errores.Add("Missing required column: 'employee_type'.");

                await MostrarModalImportacionJsAsync(
                    "XLSX import failed",
                    "The file is missing the required employee_type column.",
                    "error");

                return;
            }

            if (!HeaderExists(headerMap, "Employee", "Employee Name") &&
                !HeaderExists(headerMap, "Employee ID", "Employee_ID"))
            {
                ResultadoImportacion.Errores.Add("Missing required column: 'Employee', 'Employee Name', or 'Employee ID'.");

                await MostrarModalImportacionJsAsync(
                    "XLSX import failed",
                    "The file is missing required columns.",
                    "error");

                return;
            }

            if (!HeaderExists(headerMap, "Product Name"))
            {
                ResultadoImportacion.Errores.Add("Missing required column: 'Product Name'.");

                await MostrarModalImportacionJsAsync(
                    "XLSX import failed",
                    "The file is missing required columns.",
                    "error");

                return;
            }

            if (!HeaderExists(headerMap, "KGen Product Code", "KGEN Product Code", "KGEN Code"))
            {
                ResultadoImportacion.Errores.Add("Missing required column: 'KGen Product Code', 'KGEN Product Code' or 'KGEN Code'.");

                await MostrarModalImportacionJsAsync(
                    "XLSX import failed",
                    "The file is missing required columns.",
                    "error");

                return;
            }

            await using var db = await DbFactory.CreateDbContextAsync();

            var empleadosPermitidosIds =
                await ObtenerEmpleadosPermitidosParaAsignacionesAsync(db);

            var empleadosDb = await db.Empleados
                .AsNoTracking()
                .ApplyScope(Scope)
                .Where(x => x.Activo &&
                            empleadosPermitidosIds.Contains(x.Id))
                .ToListAsync();

            var librosDb = await db.Libros
                .Where(x => !x.Finalizado)
                .ToListAsync();

            /*
             * Índices O(1) para el importador.
             *
             * Evitan recorrer empleados y libros completos por cada fila.
             */
            var empleadosPorCodigo =
                empleadosDb
                    .GroupBy(x => (
                        x.EmployeeTypeId,
                        x.IdEmpleado))
                    .ToDictionary(
                        g => g.Key,
                        g => g.First());

            var empleadosPorNombre =
                empleadosDb
                    .GroupBy(x => (
                        x.EmployeeTypeId,
                        Nombre: Normalizar(x.Nombre)))
                    .ToDictionary(
                        g => g.Key,
                        g => g.ToList());

            var librosPorKgen =
                librosDb
                    .Where(x =>
                        !string.IsNullOrWhiteSpace(
                            x.KGENCode))
                    .GroupBy(x =>
                        Normalizar(
                            x.KGENCode))
                    .ToDictionary(
                        g => g.Key,
                        g => g.First(),
                        StringComparer.Ordinal);

            var librosAsignadosActivos =
                (await db.Asignaciones
                    .AsNoTracking()
                    .Where(x => !x.Finalizado)
                    .Select(x => x.IdLibro)
                    .ToListAsync())
                .ToHashSet();

            var today =
                ObtenerFechaHoyRepublicaDominicana();

            foreach (var row in worksheet.RowsUsed().Where(r => r.RowNumber() > headerRow.RowNumber()))
            {
                var rowNumber = row.RowNumber();

                var employeeTypeCode = ReadText(row, headerMap, "employee_type", "Employee Type");
                var employeeType = ResolveEmployeeType(employeeTypeCode);
                var employeeIdText = ReadText(row, headerMap, "Employee ID", "Employee_ID");
                var employeeName = ReadText(row, headerMap, "Employee", "Employee Name");
                var bookName = ReadText(row, headerMap, "Product Name");
                var kgenCode = ReadText(row, headerMap, "KGen Product Code", "KGEN Product Code", "KGEN Code");
                var lsaCode = ReadText(row, headerMap, "LSA Code", "LSA");

                if (string.IsNullOrWhiteSpace(employeeName) &&
                    string.IsNullOrWhiteSpace(bookName) &&
                    string.IsNullOrWhiteSpace(kgenCode) &&
                    string.IsNullOrWhiteSpace(lsaCode))
                {
                    ResultadoImportacion.FilasOmitidas++;
                    continue;
                }

                if (employeeType is null)
                {
                    ResultadoImportacion.FilasOmitidas++;
                    ResultadoImportacion.Errores.Add($"Row {rowNumber}: employee_type must be DR or ECLERX.");
                    continue;
                }

                if (!Scope.CanAccess(employeeType.Id))
                {
                    ResultadoImportacion.FilasOmitidas++;
                    ResultadoImportacion.Errores.Add($"Row {rowNumber}: You cannot import assignments for {employeeType.Code}.");
                    continue;
                }

                if (string.IsNullOrWhiteSpace(employeeName) && string.IsNullOrWhiteSpace(employeeIdText))
                {
                    ResultadoImportacion.FilasOmitidas++;
                    ResultadoImportacion.Errores.Add($"Row {rowNumber}: Employee or Employee ID is required.");
                    continue;
                }

                Empleados? empleado = null;

                if (int.TryParse(
                        employeeIdText,
                        NumberStyles.Integer,
                        CultureInfo.InvariantCulture,
                        out var employeeId))
                {
                    empleadosPorCodigo.TryGetValue(
                        (
                            employeeType.Id,
                            employeeId
                        ),
                        out empleado);
                }

                if (empleado is null &&
                    !string.IsNullOrWhiteSpace(
                        employeeName))
                {
                    empleadosPorNombre.TryGetValue(
                        (
                            employeeType.Id,
                            Normalizar(employeeName)
                        ),
                        out var matches);

                    if (matches is not null &&
                        matches.Count > 1)
                    {
                        ResultadoImportacion.FilasOmitidas++;

                        ResultadoImportacion.Errores.Add(
                            $"Row {rowNumber}: More than one employee named '{employeeName}' exists in {employeeType.Code}. Use Employee ID.");

                        continue;
                    }

                    empleado =
                        matches?.FirstOrDefault();
                }

                if (empleado is null)
                {
                    ResultadoImportacion.FilasOmitidas++;
                    ResultadoImportacion.Errores.Add($"Row {rowNumber}: Employee '{employeeName}' / ID '{employeeIdText}' was not found as an active {employeeType.Code} employee.");
                    continue;
                }

                if (string.IsNullOrWhiteSpace(bookName) &&
                    string.IsNullOrWhiteSpace(kgenCode) &&
                    string.IsNullOrWhiteSpace(lsaCode))
                {
                    ResultadoImportacion.FilasOmitidas++;
                    ResultadoImportacion.Errores.Add($"Row {rowNumber}: Book information is empty. Fill at least Product Name, KGEN Code or LSA Code.");
                    continue;
                }

                if (string.IsNullOrWhiteSpace(kgenCode))
                {
                    ResultadoImportacion.FilasOmitidas++;
                    ResultadoImportacion.Errores.Add($"Row {rowNumber}: KGEN Code is required and is globally unique.");
                    continue;
                }

                librosPorKgen.TryGetValue(
                    Normalizar(kgenCode),
                    out var libro);

                if (libro is not null && libro.EmployeeTypeId != employeeType.Id)
                {
                    ResultadoImportacion.FilasOmitidas++;
                    ResultadoImportacion.Errores.Add(
                        $"Row {rowNumber}: KGEN '{kgenCode}' belongs to {GetEmployeeTypeCode(libro.EmployeeTypeId)}, not {employeeType.Code}.");
                    continue;
                }

                if (libro is null)
                {
                    if (string.IsNullOrWhiteSpace(bookName))
                    {
                        ResultadoImportacion.FilasOmitidas++;
                        ResultadoImportacion.Errores.Add($"Row {rowNumber}: Book was not found and the column 'Product Name' is empty.");
                        continue;
                    }

                    var footPrintText = ReadText(row, headerMap, "Foot Print");
                    var legacyCoText = ReadText(row, headerMap, "Legacy Co");
                    var stateText = ReadText(row, headerMap, "State");
                    var graphicsDatabaseText = ReadText(row, headerMap, "Graphics Database");
                    var trimSizeText = ReadText(row, headerMap, "Trim Size");
                    var bindPlantText = ReadText(row, headerMap, "Bind Plant");

                    var printFootId = FindPrintFootId(footPrintText);
                    var legacyCodeId = FindLegacyCodeId(legacyCoText);
                    var stateId = FindStateId(stateText);
                    var databaseId = FindDatabaseId(graphicsDatabaseText);
                    var trimSizeId = FindTrimSizeId(trimSizeText);
                    var bindPlantId = FindBindPlantId(bindPlantText);

                    AddCatalogWarningIfNeeded(ResultadoImportacion.Advertencias, rowNumber, "Foot Print", footPrintText, printFootId);
                    AddCatalogWarningIfNeeded(ResultadoImportacion.Advertencias, rowNumber, "Legacy Co", legacyCoText, legacyCodeId);
                    AddCatalogWarningIfNeeded(ResultadoImportacion.Advertencias, rowNumber, "State", stateText, stateId);
                    AddCatalogWarningIfNeeded(ResultadoImportacion.Advertencias, rowNumber, "Graphics Database", graphicsDatabaseText, databaseId);
                    AddCatalogWarningIfNeeded(ResultadoImportacion.Advertencias, rowNumber, "Trim Size", trimSizeText, trimSizeId);
                    AddCatalogWarningIfNeeded(ResultadoImportacion.Advertencias, rowNumber, "Bind Plant", bindPlantText, bindPlantId);

                    var erroresAntesDeFechas = ResultadoImportacion.Errores.Count;

                    var firstDuePrinterDate = ReadDateWithValidation(
                        row,
                        headerMap,
                        today,
                        ResultadoImportacion.Errores,
                        rowNumber,
                        false,
                        "Shipping Date",
                        "First Due Printer");

                    var proofExtract = ReadDateWithValidation(
                        row,
                        headerMap,
                        today,
                        ResultadoImportacion.Errores,
                        rowNumber,
                        false,
                        "Proof Extract",
                        "Extract - Proof");

                    var finalExtract = ReadDateWithValidation(
                        row,
                        headerMap,
                        today,
                        ResultadoImportacion.Errores,
                        rowNumber,
                        false,
                        "Final Extract",
                        "Extract - Final");

                    var memoExtract = ReadDateWithValidation(
                        row,
                        headerMap,
                        today,
                        ResultadoImportacion.Errores,
                        rowNumber,
                        false,
                        "Memo Extract",
                        "Extract - Memo");

                    var dirxionDate = ReadDateWithValidation(
                        row,
                        headerMap,
                        today,
                        ResultadoImportacion.Errores,
                        rowNumber,
                        false,
                        "Dirxion Date",
                        "Dirxion");

                    var pubDate = ReadDateWithValidation(
                        row,
                        headerMap,
                        today,
                        ResultadoImportacion.Errores,
                        rowNumber,
                        false,
                        "Pub Date",
                        "Publication Date");

                    if (ResultadoImportacion.Errores.Count > erroresAntesDeFechas)
                    {
                        ResultadoImportacion.FilasOmitidas++;
                        ResultadoImportacion.Errores.Add($"Row {rowNumber}: The row was skipped because it contains invalid date values.");
                        continue;
                    }

                    var finalPoDate = CalculateFinalPoDate(firstDuePrinterDate);

                    libro = new Libros
                    {
                        Id = Guid.NewGuid(),
                        EmployeeTypeId = employeeType.Id,

                        BookName = bookName,
                        KGENCode = kgenCode,
                        LSACode = lsaCode,
                        ProductIssue = ReadText(row, headerMap, "Product Issue"),

                        PrintFootId = printFootId,
                        LegacyCodeId = legacyCodeId,
                        StateId = stateId,
                        DatabaseId = databaseId,
                        TrimSizeId = trimSizeId,
                        BindPlantId = bindPlantId,

                        ProofExtract = proofExtract,
                        FinalExtract = finalExtract,
                        MemoExtract = memoExtract,
                        FinalPODate = finalPoDate,
                        ShippingDate = firstDuePrinterDate,
                        DirxionDate = dirxionDate,
                        PubDate = pubDate,

                        SRLSuppression = ReadYesNoBool(row, headerMap, "SRL Suppression Flag"),
                        NWP = ReadYesNoBool(row, headerMap, "NWP"),
                        Finalizado = false
                    };

                    db.Libros.Add(libro);
                    librosDb.Add(libro);

                    librosPorKgen[
                        Normalizar(libro.KGENCode)] =
                        libro;

                    ResultadoImportacion.LibrosCreados++;
                }

                if (empleado.EmployeeTypeId != libro.EmployeeTypeId)
                {
                    ResultadoImportacion.FilasOmitidas++;
                    ResultadoImportacion.Errores.Add($"Row {rowNumber}: Employee and book belong to different employee types.");
                    continue;
                }

                if (librosAsignadosActivos.Contains(libro.Id))
                {
                    ResultadoImportacion.AsignacionesDuplicadas++;
                    continue;
                }

                db.Asignaciones.Add(new Asignaciones
                {
                    Id = Guid.NewGuid(),
                    IdEmpleado = empleado.Id,
                    IdLibro = libro.Id,
                    Finalizado = false
                });

                librosAsignadosActivos.Add(libro.Id);
                ResultadoImportacion.AsignacionesCreadas++;
            }

            await db.SaveChangesAsync();

            XlsxInputKey = Guid.NewGuid();

            var tipoResultado = ResultadoImportacion.TieneErrores ? "error" : "success";

            var tituloResultado = ResultadoImportacion.TieneErrores
                ? "XLSX imported with errors"
                : "XLSX import completed";

            var resumenResultado =
                $"Books created: {ResultadoImportacion.LibrosCreados}. " +
                $"Assignments created: {ResultadoImportacion.AsignacionesCreadas}. " +
                $"Duplicated: {ResultadoImportacion.AsignacionesDuplicadas}. " +
                $"Skipped rows: {ResultadoImportacion.FilasOmitidas}.";

            ImportandoXlsx = false;

            await CargarDatosAsync();

            await InvokeAsync(StateHasChanged);

            await JS.InvokeVoidAsync("assignmentImportModal.show", new
            {
                title = tituloResultado,
                summary = resumenResultado,
                type = tipoResultado,
                booksCreated = ResultadoImportacion.LibrosCreados,
                assignmentsCreated = ResultadoImportacion.AsignacionesCreadas,
                duplicated = ResultadoImportacion.AsignacionesDuplicadas,
                skippedRows = ResultadoImportacion.FilasOmitidas,
                errors = ResultadoImportacion.Errores,
                warnings = ResultadoImportacion.Advertencias
            });
        }
        catch (Exception ex)
        {
            ResultadoImportacion ??= new ImportacionAsignacionesResultado();

            var mensajeError = ex.InnerException?.Message ?? ex.Message;

            ResultadoImportacion.Errores.Add($"General import error: {mensajeError}");

            await JS.InvokeVoidAsync("assignmentImportModal.show", new
            {
                title = "XLSX import failed",
                summary = "The file could not be imported. Review the error details below.",
                type = "error",
                booksCreated = ResultadoImportacion.LibrosCreados,
                assignmentsCreated = ResultadoImportacion.AsignacionesCreadas,
                duplicated = ResultadoImportacion.AsignacionesDuplicadas,
                skippedRows = ResultadoImportacion.FilasOmitidas,
                errors = ResultadoImportacion.Errores,
                warnings = ResultadoImportacion.Advertencias
            });
        }
        finally
        {
            ImportandoXlsx = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private Empleados? BuscarEmpleadoSeleccionado()
    {
        if (string.IsNullOrWhiteSpace(
                EmpleadoTexto))
        {
            return null;
        }

        var texto =
            EmpleadoTexto.Trim();

        if (_empleadosPorDisplay.TryGetValue(
                texto,
                out var empleadoPorDisplay))
        {
            return empleadoPorDisplay;
        }

        if (int.TryParse(
                texto,
                NumberStyles.Integer,
                CultureInfo.InvariantCulture,
                out var codigo)
            &&
            _empleadosPorCodigo.TryGetValue(
                codigo,
                out var empleadoPorCodigo))
        {
            return empleadoPorCodigo;
        }

        var normalizado =
            Normalizar(texto);

        return _empleadosPorNombreNormalizado.TryGetValue(
            normalizado,
            out var empleadoPorNombre)
            ? empleadoPorNombre
            : null;
    }

    private Libros? BuscarLibroSeleccionado()
    {
        if (string.IsNullOrWhiteSpace(
                LibroTexto))
        {
            return null;
        }

        var texto =
            LibroTexto.Trim();

        if (_librosPorDisplay.TryGetValue(
                texto,
                out var libroPorDisplay))
        {
            return libroPorDisplay;
        }

        var normalizado =
            Normalizar(texto);

        if (_librosPorNombreNormalizado.TryGetValue(
                normalizado,
                out var libroPorNombre))
        {
            return libroPorNombre;
        }

        if (_librosPorKgenNormalizado.TryGetValue(
                normalizado,
                out var libroPorKgen))
        {
            return libroPorKgen;
        }

        return _librosPorLsaNormalizado.TryGetValue(
            normalizado,
            out var libroPorLsa)
            ? libroPorLsa
            : null;
    }

    private static Empleados? BuscarEmpleadoPorNombre(List<Empleados> empleados, string employeeName)
    {
        var normalizado = Normalizar(employeeName);

        return empleados.FirstOrDefault(x => Normalizar(x.Nombre) == normalizado);
    }



