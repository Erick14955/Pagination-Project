    private async Task UpdateBooksFromXlsxAsync(InputFileChangeEventArgs e)
    {
        if (!CreateAssignations)
        {
            MostrarMensaje("You do not have permission to update books.", "error");
            return;
        }

        var resultado = new ActualizacionLibrosResultado();

        try
        {
            ActualizandoLibrosXlsx = true;
            LimpiarMensaje();

            await JS.InvokeVoidAsync("assignmentImportModal.close");

            await InvokeAsync(StateHasChanged);
            await Task.Yield();

            if (!BindPlants.Any() ||
                !Databases.Any() ||
                !LegacyCodes.Any() ||
                !PrintFeet.Any() ||
                !TrimSizes.Any() ||
                !States.Any())
            {
                await CargarCatalogosAsync();
            }

            var file = e.File;

            if (file is null)
            {
                resultado.Errores.Add("No file was selected.");

                await MostrarModalUpdateBooksJsAsync(
                    resultado,
                    "XLSX update failed",
                    "No file was selected.",
                    "error");

                return;
            }

            if (!file.Name.EndsWith(".xlsx", StringComparison.OrdinalIgnoreCase))
            {
                resultado.Errores.Add($"The selected file '{file.Name}' is not valid. Only .xlsx files are allowed.");

                await MostrarModalUpdateBooksJsAsync(
                    resultado,
                    "XLSX update failed",
                    "Only .xlsx files are allowed.",
                    "error");

                return;
            }

            await using var stream = file.OpenReadStream(MaxXlsxSize);
            using var memoryStream = new MemoryStream();

            await stream.CopyToAsync(memoryStream);
            memoryStream.Position = 0;

            using var workbook = new XLWorkbook(memoryStream);
            var worksheet = workbook.Worksheets.FirstOrDefault();

            if (worksheet is null)
            {
                resultado.Errores.Add("The XLSX file does not contain any worksheet.");

                await MostrarModalUpdateBooksJsAsync(
                    resultado,
                    "XLSX update failed",
                    "The XLSX file does not contain any worksheet.",
                    "error");

                return;
            }

            var headerRow = worksheet.FirstRowUsed();

            if (headerRow is null)
            {
                resultado.Errores.Add("The XLSX file is empty.");

                await MostrarModalUpdateBooksJsAsync(
                    resultado,
                    "XLSX update failed",
                    "The XLSX file is empty.",
                    "error");

                return;
            }

            var headerMap = BuildHeaderMap(headerRow);

            if (!HeaderExists(headerMap, "KGen Product Code", "KGEN Product Code", "KGEN Code") &&
                !HeaderExists(headerMap, "LSA Code", "LSA"))
            {
                resultado.Errores.Add("Missing required column: 'KGEN Code' or 'LSA Code'. At least one is required to find the book.");

                await MostrarModalUpdateBooksJsAsync(
                    resultado,
                    "XLSX update failed",
                    "The file is missing the required book code columns.",
                    "error");

                return;
            }

            await using var db = await DbFactory.CreateDbContextAsync();

            var librosDb = await db.Libros
                .ToListAsync();

            var today = DateOnly.FromDateTime(DateTime.Today);

            foreach (var row in worksheet.RowsUsed().Where(r => r.RowNumber() > headerRow.RowNumber()))
            {
                var rowNumber = row.RowNumber();

                var bookName = ReadText(row, headerMap, "Product Name", "Book Name");
                var kgenCode = ReadText(row, headerMap, "KGen Product Code", "KGEN Product Code", "KGEN Code");
                var lsaCode = ReadText(row, headerMap, "LSA Code", "LSA");
                var productIssue = ReadText(row, headerMap, "Product Issue");

                if (string.IsNullOrWhiteSpace(bookName) &&
                    string.IsNullOrWhiteSpace(kgenCode) &&
                    string.IsNullOrWhiteSpace(lsaCode))
                {
                    resultado.FilasOmitidas++;
                    continue;
                }

                if (string.IsNullOrWhiteSpace(kgenCode) &&
                    string.IsNullOrWhiteSpace(lsaCode))
                {
                    resultado.FilasOmitidas++;
                    resultado.Errores.Add($"Row {rowNumber}: KGEN Code or LSA Code is required to update the book.");
                    continue;
                }

                var libro = BuscarLibroPorCodigos(librosDb, kgenCode, lsaCode);

                if (libro is null)
                {
                    resultado.LibrosNoEncontrados++;
                    resultado.Advertencias.Add(
                        $"Row {rowNumber}: Book was not found. KGEN: '{kgenCode}', LSA: '{lsaCode}', Product Name: '{bookName}'.");
                    continue;
                }

                var footPrintText = ReadText(row, headerMap, "Foot Print");
                var legacyCoText = ReadText(row, headerMap, "Legacy Co");
                var stateText = ReadText(row, headerMap, "State");
                var graphicsDatabaseText = ReadText(row, headerMap, "Graphics Database", "Database");
                var trimSizeText = ReadText(row, headerMap, "Trim Size");
                var bindPlantText = ReadText(row, headerMap, "Bind Plant");

                var printFootId = FindPrintFootId(footPrintText);
                var legacyCodeId = FindLegacyCodeId(legacyCoText);
                var stateId = FindStateId(stateText);
                var databaseId = FindDatabaseId(graphicsDatabaseText);
                var trimSizeId = FindTrimSizeId(trimSizeText);
                var bindPlantId = FindBindPlantId(bindPlantText);

                AddCatalogWarningIfNeeded(resultado.Advertencias, rowNumber, "Foot Print", footPrintText, printFootId);
                AddCatalogWarningIfNeeded(resultado.Advertencias, rowNumber, "Legacy Co", legacyCoText, legacyCodeId);
                AddCatalogWarningIfNeeded(resultado.Advertencias, rowNumber, "State", stateText, stateId);
                AddCatalogWarningIfNeeded(resultado.Advertencias, rowNumber, "Graphics Database", graphicsDatabaseText, databaseId);
                AddCatalogWarningIfNeeded(resultado.Advertencias, rowNumber, "Trim Size", trimSizeText, trimSizeId);
                AddCatalogWarningIfNeeded(resultado.Advertencias, rowNumber, "Bind Plant", bindPlantText, bindPlantId);

                var erroresAntesDeFechas = resultado.Errores.Count;

                var firstDuePrinterDate = ReadDateWithValidation(
                    row,
                    headerMap,
                    today,
                    resultado.Errores,
                    rowNumber,
                    false,
                    "First Due Printer",
                    "YP First Due Printer",
                    "WP Due Printer",
                    "Shipping Date",
                    "East WP Final Due Printer");

                var proofExtract = ReadDateWithValidation(
                    row,
                    headerMap,
                    today,
                    resultado.Errores,
                    rowNumber,
                    false,
                    "Proof Extract",
                    "Extract - Proof",
                    "WP Proof Extract",
                    "YP Proof Extract");

                var finalExtract = ReadDateWithValidation(
                    row,
                    headerMap,
                    today,
                    resultado.Errores,
                    rowNumber,
                    false,
                    "Extract - Final",
                    "Final Extract",
                    "WP Extract - Final",
                    "YP Extract - Final");

                var memoExtract = ReadDateWithValidation(
                    row,
                    headerMap,
                    today,
                    resultado.Errores,
                    rowNumber,
                    false,
                    "Memo Extract",
                    "Extract - Memo");

                var dirxionDate = ReadDateWithValidation(
                    row,
                    headerMap,
                    today,
                    resultado.Errores,
                    rowNumber,
                    false,
                    "Dirxion Date", 
                    "Dirxion",
                    "File Due Online/LSA/Galley Update Summary RPT",
                    "File Due Online",
                    "Galley Update Summary RPT");

                var pubDate = ReadDateWithValidation(
                    row,
                    headerMap,
                    today,
                    resultado.Errores,
                    rowNumber,
                    false,
                    "Pub Date",
                    "Publication Date");

                if (resultado.Errores.Count > erroresAntesDeFechas)
                {
                    resultado.FilasOmitidas++;
                    resultado.Errores.Add($"Row {rowNumber}: The row was skipped because it contains invalid date values.");
                    continue;
                }

                var finalPoDate = CalculateFinalPoDate(firstDuePrinterDate);

                if (!string.IsNullOrWhiteSpace(bookName))
                    libro.BookName = bookName;

                if (!string.IsNullOrWhiteSpace(kgenCode))
                    libro.KGENCode = kgenCode;

                if (!string.IsNullOrWhiteSpace(lsaCode))
                    libro.LSACode = lsaCode;

                if (!string.IsNullOrWhiteSpace(productIssue))
                    libro.ProductIssue = productIssue;

                libro.ProofExtract = proofExtract;
                libro.FinalExtract = finalExtract;
                libro.MemoExtract = memoExtract;
                libro.FinalPODate = finalPoDate;
                libro.ShippingDate = firstDuePrinterDate;
                libro.DirxionDate = dirxionDate;
                libro.PubDate = pubDate;

                libro.PrintFootId = printFootId;
                libro.LegacyCodeId = legacyCodeId;
                libro.StateId = stateId;
                libro.DatabaseId = databaseId;
                libro.TrimSizeId = trimSizeId;
                libro.BindPlantId = bindPlantId;

                libro.SRLSuppression = ReadYesNoBool(row, headerMap, "SRL Suppression Flag");
                libro.NWP = ReadYesNoBool(row, headerMap, "NWP");

                libro.Finalizado = false;

                resultado.LibrosActualizados++;
            }

            await db.SaveChangesAsync();

            XlsxBooksUpdateInputKey = Guid.NewGuid();

            await CargarDatosAsync();

            await InvokeAsync(StateHasChanged);

            var tipoResultado = resultado.TieneErrores ? "error" : "success";

            var tituloResultado = resultado.TieneErrores
                ? "XLSX books update completed with errors"
                : "XLSX books update completed";

            var resumenResultado =
                $"Books updated: {resultado.LibrosActualizados}. " +
                $"Books not found: {resultado.LibrosNoEncontrados}. " +
                $"Skipped rows: {resultado.FilasOmitidas}.";

            await MostrarModalUpdateBooksJsAsync(
                resultado,
                tituloResultado,
                resumenResultado,
                tipoResultado);
        }
        catch (Exception ex)
        {
            var mensajeError = ex.InnerException?.Message ?? ex.Message;

            resultado.Errores.Add($"General update error: {mensajeError}");

            await MostrarModalUpdateBooksJsAsync(
                resultado,
                "XLSX books update failed",
                "The file could not be processed. Review the error details below.",
                "error");
        }
        finally
        {
            ActualizandoLibrosXlsx = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task MostrarModalUpdateBooksJsAsync(
        ActualizacionLibrosResultado resultado,
        string titulo,
        string resumen,
        string tipo)
    {
        await JS.InvokeVoidAsync("assignmentImportModal.show", new
        {
            title = titulo,
            summary = resumen,
            type = tipo,

            booksLabel = "Books Updated",
            booksCreated = resultado.LibrosActualizados,

            assignmentsLabel = "Not Found",
            assignmentsCreated = resultado.LibrosNoEncontrados,

            duplicatedLabel = "Warnings",
            duplicated = resultado.Advertencias.Count,

            skippedLabel = "Skipped Rows",
            skippedRows = resultado.FilasOmitidas,

            errors = resultado.Errores,
            warnings = resultado.Advertencias
        });
    }

