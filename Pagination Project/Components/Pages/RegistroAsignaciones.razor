@page "/asignaciones"
@page "/assignments"
@page "/registro-asignaciones"

@using System.Globalization
@using System.Text
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@using ClosedXML.Excel
@using Pagination_Project.Data
@using Pagination_Project.Models
@using Pagination_Project.Services
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Web

@inject AuthenticationStateProvider AuthenticationStateProvider

@attribute [Authorize]
@layout Pagination_Project.Components.Layout.DashboardLayout

@inject IDbContextFactory<AppDbContext> DbFactory
@inject IJSRuntime JS
@inject IUserDataScopeService UserDataScopeService

<PageTitle>Assignments</PageTitle>

@if (CargandoInicial)
{
    <div class="assignments-page assignments-skeleton-page"
         aria-busy="true"
         aria-label="Loading assignments">

        <section class="page-hero assignments-skeleton-hero">
            <div class="assignments-skeleton-hero-copy">
                <div class="assignments-skeleton-block assignments-skeleton-hero-title"></div>
                <div class="assignments-skeleton-block assignments-skeleton-hero-text"></div>
                <div class="assignments-skeleton-block assignments-skeleton-hero-text short"></div>
            </div>

            <div class="hero-stats assignments-skeleton-stats">
                @for (var statIndex = 0; statIndex < 2; statIndex++)
                {
                    <div class="stat-card assignments-skeleton-stat-card">
                        <div class="assignments-skeleton-block assignments-skeleton-stat-label"></div>
                        <div class="assignments-skeleton-block assignments-skeleton-stat-value"></div>
                    </div>
                }
            </div>
        </section>

        <section class="form-card assignments-skeleton-card">
            <div class="section-header assignments-skeleton-section-header">
                <div class="assignments-skeleton-header-copy">
                    <div class="assignments-skeleton-block assignments-skeleton-section-title"></div>
                    <div class="assignments-skeleton-block assignments-skeleton-section-description"></div>
                </div>

                <div class="assignments-skeleton-header-actions">
                    @for (var actionIndex = 0; actionIndex < 5; actionIndex++)
                    {
                        <div class="assignments-skeleton-block assignments-skeleton-action"></div>
                    }
                </div>
            </div>

            <div class="assignments-skeleton-form-grid">
                @for (var fieldIndex = 0; fieldIndex < 2; fieldIndex++)
                {
                    <div class="assignments-skeleton-field">
                        <div class="assignments-skeleton-block assignments-skeleton-label"></div>
                        <div class="assignments-skeleton-block assignments-skeleton-input"></div>
                    </div>
                }
            </div>

            <div class="assignments-skeleton-button-row">
                <div class="assignments-skeleton-block assignments-skeleton-button primary"></div>
                <div class="assignments-skeleton-block assignments-skeleton-button"></div>
            </div>
        </section>

        <section class="list-card assignments-skeleton-card assignments-skeleton-list-card">
            <div class="section-header table-header assignments-skeleton-section-header">
                <div class="assignments-skeleton-header-copy">
                    <div class="assignments-skeleton-block assignments-skeleton-section-title list-title"></div>
                    <div class="assignments-skeleton-block assignments-skeleton-section-description list-description"></div>
                </div>

                <div class="assignments-skeleton-filters">
                    @for (var filterIndex = 0; filterIndex < 7; filterIndex++)
                    {
                        <div class="assignments-skeleton-block assignments-skeleton-filter"></div>
                    }
                </div>
            </div>

            <div class="assignments-skeleton-table-container">
                <div class="assignments-skeleton-table-head">
                    @for (var columnIndex = 0; columnIndex < 12; columnIndex++)
                    {
                        <div class="assignments-skeleton-block assignments-skeleton-column"></div>
                    }
                </div>

                @for (var rowIndex = 0; rowIndex < 5; rowIndex++)
                {
                    <div class="assignments-skeleton-table-row">
                        <div class="assignments-skeleton-person-cell">
                            <div class="assignments-skeleton-block assignments-skeleton-avatar"></div>
                            <div class="assignments-skeleton-person-copy">
                                <div class="assignments-skeleton-block assignments-skeleton-person-name"></div>
                                <div class="assignments-skeleton-block assignments-skeleton-person-meta"></div>
                            </div>
                        </div>

                        @for (var cellIndex = 0; cellIndex < 11; cellIndex++)
                        {
                            <div class="assignments-skeleton-block assignments-skeleton-cell @(cellIndex % 3 == 0 ? "short" : cellIndex % 3 == 1 ? "medium" : "long")"></div>
                        }
                    </div>
                }
            </div>
        </section>
    </div>
}
else
{
    <div class="assignments-page">

        <section class="page-hero">
            <div>
                <h1>Book Assignments</h1>
                <p>
                    Assign books to employees manually or import assignments using an XLSX file.
                </p>
            </div>

            <div class="hero-stats">
                <div class="stat-card">
                    <span>Total Assignments</span>
                    <strong>@AsignacionesListado.Count</strong>
                </div>

                <div class="stat-card">
                    <span>Filtered</span>
                    <strong>@AsignacionesFiltradas.Count</strong>
                </div>
            </div>
        </section>

        @if (!string.IsNullOrWhiteSpace(Mensaje))
        {
            <div class="alert-box @TipoMensaje">
                @Mensaje
            </div>
        }

        @if (CreateAssignations)
        {
            <section class="form-card">
                <div class="section-header">
                    <div>
                        <h2>Assign Book to Employee</h2>
                        <p>Select an employee and search the book by Book Name, KGEN Code or LSA Code.</p>
                    </div>

                    <div class="header-actions">
                        @if (PuedeDescargarPlantilla)
                        {
                            <button type="button"
                                    class="btn-template-xlsx"
                                    disabled="@DescargandoPlantillaXlsx"
                                    @onclick="DownloadAssignmentsTemplateAsync">
                                @(DescargandoPlantillaXlsx ? "Downloading..." : "📄 Download Template")
                            </button>
                        }

                        <InputFile @key="XlsxInputKey"
                                   id="xlsxAssignmentsUpload"
                                   class="file-input-hidden"
                                   OnChange="ImportAssignmentsFromXlsxAsync"
                                   accept=".xlsx" />

                        <label for="xlsxAssignmentsUpload" class="btn-xlsx @(ImportandoXlsx ? "disabled" : "")">
                            @(ImportandoXlsx ? "Uploading..." : "📥 Add with XLSX")
                        </label>

                        <InputFile @key="XlsxBooksUpdateInputKey"
                                   id="xlsxBooksUpdateUpload"
                                   class="file-input-hidden"
                                   OnChange="UpdateBooksFromXlsxAsync"
                                   accept=".xlsx" />

                        <label for="xlsxBooksUpdateUpload" class="btn-update-xlsx @(ActualizandoLibrosXlsx ? "disabled" : "")">
                            @(ActualizandoLibrosXlsx ? "Updating..." : "🔄 Update Books XLSX")
                        </label>

                        <button type="button"
                                class="btn-light"
                                @onclick="AbrirFormularioAsignacionTemporal">
                            🔁 Temporary Assignment
                        </button>

                        <button type="button" class="btn-light" @onclick="LimpiarFormulario">
                            ✨ New
                        </button>
                    </div>
                </div>

                <form @onsubmit="GuardarAsignacionAsync" @onsubmit:preventDefault>
                    <div class="form-grid">

                        <div class="form-group large">
                            <label>Employee</label>

                            <div class="assignment-combobox">
                                <input class="form-control assignment-combobox-input"
                                       value="@EmpleadoTexto"
                                       placeholder="Search employee by name or employee ID"
                                       autocomplete="off"
                                       autocapitalize="none"
                                       spellcheck="false"
                                       role="combobox"
                                       aria-autocomplete="list"
                                       aria-expanded="@MostrarSugerenciasEmpleado"
                                       aria-controls="employeesSuggestions"
                                       @oninput="OnEmpleadoTextoInput"
                                       @onfocus="AbrirSugerenciasEmpleado"
                                       @onblur="CerrarSugerenciasEmpleado"
                                       required />

                                @if (MostrarSugerenciasEmpleado)
                                {
                                    <div id="employeesSuggestions"
                                         class="assignment-combobox-menu"
                                         role="listbox">

                                        @if (EmpleadosSugeridos.Count == 0)
                                        {
                                            <div class="assignment-combobox-empty">
                                                No matching employees.
                                            </div>
                                        }
                                        else
                                        {
                                            @foreach (var empleado in EmpleadosSugeridos)
                                            {
                                                <button type="button"
                                                        class="assignment-combobox-option"
                                                        role="option"
                                                        @key="empleado.Id"
                                                        @onmousedown:preventDefault="true"
                                                        @onclick="() => SeleccionarEmpleado(empleado)">

                                                    <span class="assignment-combobox-option-title">
                                                        @empleado.Nombre
                                                    </span>

                                                    <span class="assignment-combobox-option-meta">
                                                        ID: @empleado.IdEmpleado · @GetEmployeeTypeCode(empleado.EmployeeTypeId)
                                                    </span>
                                                </button>
                                            }
                                        }
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="form-group large">
                            <label>Book</label>

                            <div class="assignment-combobox">
                                <input class="form-control assignment-combobox-input"
                                       value="@LibroTexto"
                                       placeholder="Search by Book Name, KGEN Code or LSA Code"
                                       autocomplete="off"
                                       autocapitalize="none"
                                       spellcheck="false"
                                       role="combobox"
                                       aria-autocomplete="list"
                                       aria-expanded="@MostrarSugerenciasLibro"
                                       aria-controls="booksSuggestions"
                                       @oninput="OnLibroTextoInput"
                                       @onfocus="AbrirSugerenciasLibro"
                                       @onblur="CerrarSugerenciasLibro"
                                       required />

                                @if (MostrarSugerenciasLibro)
                                {
                                    <div id="booksSuggestions"
                                         class="assignment-combobox-menu"
                                         role="listbox">

                                        @if (LibrosSugeridos.Count == 0)
                                        {
                                            <div class="assignment-combobox-empty">
                                                No matching books.
                                            </div>
                                        }
                                        else
                                        {
                                            @foreach (var libro in LibrosSugeridos)
                                            {
                                                <button type="button"
                                                        class="assignment-combobox-option"
                                                        role="option"
                                                        @key="libro.Id"
                                                        @onmousedown:preventDefault="true"
                                                        @onclick="() => SeleccionarLibro(libro)">

                                                    <span class="assignment-combobox-option-title">
                                                        @libro.BookName
                                                    </span>

                                                    <span class="assignment-combobox-option-meta">
                                                        KGEN: @libro.KGENCode · LSA: @libro.LSACode · @GetEmployeeTypeCode(libro.EmployeeTypeId)
                                                    </span>
                                                </button>
                                            }
                                        }
                                    </div>
                                }
                            </div>
                        </div>

                    </div>

                    @if (EmpleadoSeleccionado is not null || LibroSeleccionado is not null)
                    {
                        <div class="preview-grid">
                            <div class="preview-card">
                                <span>Selected Employee</span>
                                <strong>@(EmpleadoSeleccionado?.Nombre ?? "-")</strong>
                                <small>@(EmpleadoSeleccionado is null ? "No valid employee selected" : $"Employee ID: {EmpleadoSeleccionado.IdEmpleado}")</small>
                            </div>

                            <div class="preview-card">
                                <span>Selected Book</span>
                                <strong>@(LibroSeleccionado?.BookName ?? "-")</strong>
                                <small>
                                    @(LibroSeleccionado is null
                                                            ? "No valid book selected"
                                                            : $"KGEN: {LibroSeleccionado.KGENCode} | LSA: {LibroSeleccionado.LSACode}")
                    </small>
                </div>
            </div>
                        }

                    <div class="button-row">
                        <button type="submit" class="btn-primary" disabled="@Guardando">
                            @(Guardando ? "Saving..." : "Save Assignment")
                        </button>

                        <button type="button" class="btn-secondary" @onclick="LimpiarFormulario">
                            Clear
                        </button>
                    </div>
                </form>
            </section>
        }

        <section class="list-card">
            <div class="section-header table-header">
                <div>
                    <h2>Assignment List</h2>
                    <p>View and manage all employee-book assignments.</p>
                </div>

                <div class="list-filters">

                    <select class="employee-filter-select"
                            value="@EmpleadoFiltroId"
                            @onchange="OnEmpleadoFiltroChanged">

                        <option value="">All Employees</option>

                        @foreach (var empleado in EmpleadosParaFiltro)
                        {
                            <option value="@empleado.EmpleadoId">
                                @empleado.EmpleadoNombre
                            </option>
                        }
                    </select>

                    <div class="month-filter">
                        <label>Pub Date Month</label>
                        <select class="form-control filter-select" @bind="SelectedPubMonth">
                            <option value="">All Pub Dates</option>

                            @foreach (var month in PubDateMonths)
                            {
                                <option value="@month.Value">@month.Label (@month.Count)</option>
                            }
                        </select>
                    </div>

                    <div class="month-filter">
                        <label>From</label>
                        <InputDate class="form-control filter-select"
                                   @bind-Value="FechaDesdeFiltro" />
                    </div>

                    <div class="month-filter">
                        <label>To</label>
                        <InputDate class="form-control filter-select"
                                   @bind-Value="FechaHastaFiltro" />
                    </div>

                    <div class="search-box">
                        <span>🔎</span>
                        <input placeholder="Search by employee, book, KGEN, LSA, state, database..."
                               @bind="Busqueda"
                               @bind:event="oninput" />
                    </div>

                    <button type="button"
                            class="btn-export-xlsx"
                            @onclick="ExportarAsignacionesXlsxAsync">
                        📤 Export XLSX
                    </button>

                    <button type="button"
                            class="btn-status-books"
                            disabled="@GenerandoStatusBooks"
                            @onclick="ExportarStatusOfBooksXlsxAsync">
                        @(GenerandoStatusBooks ? "Generating..." : "📊 Status of Books")
                    </button>

                    <button type="button" class="btn-filter-clear" @onclick="LimpiarFiltros">
                        Clear
                    </button>
                </div>
            </div>

            @if (Cargando)
            {
                <div class="loading-state">
                    Loading assignments...
                </div>
            }
            else if (AsignacionesFiltradas.Count == 0)
            {
                <div class="empty-state">
                    <strong>No assignments to display.</strong>
                    <span>Create a new assignment or change the search filter.</span>
                </div>
            }
            else
            {
                <div class="table-container">
                    <table class="assignments-table">
                        <thead>
                            <tr>
                                <th>Employee</th>
                                @if (Scope.ViewAllEmployeeTypes)
                                {
                                    <th>Department</th>
                                }
                                <th>Temporary Assignment</th>
                                <th>Book Name</th>
                                <th>KGEN</th>
                                <th>LSA</th>
                                <th>State</th>
                                <th>Database</th>
                                <th>Legacy Code</th>
                                <th>Print Foot</th>
                                <th>Trim Size</th>
                                <th>Bind Plant</th>
                                <th>Pub Date</th>
                                <th>Last Stage Worked</th>
                                <th>Next Stage</th>
                                @if (CreateAssignations)
                                {
                                    <th></th>
                                }
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in AsignacionesFiltradas)
                            {
                                <tr @key="item.Id">
                                    <td data-label="Employee">
                                        <div class="employee-title">
                                            <strong>@item.EmpleadoNombre</strong>
                                            <span>@item.EmpleadoEmail</span>
                                        </div>
                                    </td>

                                    @if (Scope.ViewAllEmployeeTypes)
                                    {
                                        <td data-label="Department"><span class="pill">@item.EmployeeTypeCode</span></td>
                                    }

                                    <td data-label="Temporary">
                                        @if (item.TieneAsignacionTemporal)
                                        {
                                            <div class="employee-title">
                                                <strong>@item.EmpleadoTemporalNombre</strong>
                                                <span>Covering: @item.EtapasTemporales</span>
                                                <span>Original: @item.EmpleadoOriginalNombre</span>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="pill">No temporary assignment</span>
                                        }
                                    </td>

                                    <td data-label="Book">
                                        <div class="book-title">
                                            <strong>@item.BookName</strong>
                                            <span>@item.ProductIssue</span>
                                        </div>
                                    </td>

                                    <td data-label="KGEN">@item.KGENCode</td>
                                    <td data-label="LSA">@item.LSACode</td>

                                    <td data-label="State">
                                        <span class="pill">@item.StateName</span>
                                    </td>

                                    <td data-label="Database">@item.DatabaseName</td>
                                    <td data-label="Legacy">@item.LegacyCodeName</td>
                                    <td data-label="Print Foot">@item.PrintFootName</td>
                                    <td data-label="Trim Size">@item.TrimSizeName</td>
                                    <td data-label="Bind Plant">@item.BindPlantName</td>
                                    <td data-label="Pub Date">@FormatoFecha(item.PubDate)</td>

                                    <td data-label="Last Stage Worked">
                                        <div class="stage-status-cell">
                                            <span class="@GetLastStageChipClass(item)">
                                                @item.LastStageWorked
                                            </span>

                                            @if (item.LastStageWorkedDate.HasValue)
                                            {
                                                <small>Worked: @FormatoFecha(item.LastStageWorkedDate.Value)</small>
                                            }
                                        </div>
                                    </td>

                                    <td data-label="Next Stage">
                                        <span class="@GetNextStageChipClass(item.NextStage)">
                                            @item.NextStage
                                        </span>
                                    </td>

                                    @if (CreateAssignations)
                                    {
                                        <td data-label="Actions" class="actions-cell">
                                            <button type="button"
                                                    class="icon-btn danger"
                                                    title="Delete"
                                                    @onclick="() => AbrirModalEliminarAsignacion(item)">
                                                🗑️
                                            </button>
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    </div>
}

@if (MostrarModalEmpleadoRequerido)
{
    <div class="status-books-modal-backdrop"
         role="presentation"
         @onclick="CerrarModalEmpleadoRequerido">

        <div class="status-books-modal"
             role="dialog"
             aria-modal="true"
             aria-labelledby="statusBooksEmployeeRequiredTitle"
             @onclick:stopPropagation="true">

            <div class="status-books-modal-icon">👤</div>

            <div class="status-books-modal-content">
                <h2 id="statusBooksEmployeeRequiredTitle">Employee Required</h2>
                <p>
                    Please select an employee from the employee filter before generating
                    the Status of Books report.
                </p>
            </div>

            <div class="status-books-modal-actions">
                <button type="button"
                        class="status-books-modal-ok"
                        @onclick="CerrarModalEmpleadoRequerido">
                    OK
                </button>
            </div>
        </div>
    </div>
}

@if (MostrarFormularioTemporal)
{
    <div id="temporaryAssignmentModalBackdrop"
         class="temporary-modal-backdrop"
         @onclick="CerrarFormularioAsignacionTemporal">

        <div class="temporary-modal" @onclick:stopPropagation="true">

            <div class="temporary-modal-header">
                <div>
                    <h2>Temporary Assignment</h2>
                    <p>Search an existing assignment by KGEN or LSA code, confirm the assignment and select the temporary employee.</p>
                </div>

                <button type="button"
                        class="temporary-modal-close"
                        @onclick="CerrarFormularioAsignacionTemporal">
                    ✕
                </button>
            </div>

            <div class="temporary-modal-scroll">

                <div class="temporary-assignment-top-grid">

                    <div class="form-group temporary-search-field">
                        <label>Search Assignment</label>

                        <div class="temporary-assignment-search-box">
                            <input class="form-control"
                                   value="@TextoBusquedaAsignacionTemporal"
                                   placeholder="Search by KGEN Code or LSA Code..."
                                   @oninput="OnTextoBusquedaAsignacionTemporalInput"
                                   @onkeydown="BuscarAsignacionTemporalConEnter" />

                            <button type="button"
                                    class="btn-primary temporary-search-button"
                                    @onclick="BuscarAsignacionTemporalAsync">
                                Search
                            </button>
                        </div>

                        <small class="temporary-field-hint">
                            Type the KGEN or LSA code to find the assignment.
                        </small>
                    </div>

                    <div class="form-group temporary-employee-field">
                        <label>Temporary Employee</label>

                        <select class="form-control"
                                @bind="EmpleadoTemporalSeleccionadoId"
                                disabled="@(AsignacionTemporalSeleccionadaId is null)">
                            <option value="">Select employee</option>

                            @foreach (var empleado in EmpleadosDisponiblesParaTemporal)
                            {
                                <option value="@empleado.Id">
                                    @empleado.Nombre | ID: @empleado.IdEmpleado
                                </option>
                            }
                        </select>
                    </div>

                </div>

                @if (AsignacionTemporalSeleccionada is not null)
                {
                    <div class="temporary-assignment-cards-grid">

                        <div class="temporary-assignment-card-fixed">
                            <span>Employee</span>
                            <strong>@AsignacionTemporalSeleccionada.EmpleadoNombre</strong>
                            <small>Assigned employee</small>
                            <small>ID: @AsignacionTemporalSeleccionada.EmpleadoCodigo</small>
                        </div>

                        <div class="temporary-assignment-card-fixed">
                            <span>Book Information</span>
                            <strong>@AsignacionTemporalSeleccionada.KGENCode</strong>
                            <small>@AsignacionTemporalSeleccionada.BookName</small>
                            <small>LSA: @AsignacionTemporalSeleccionada.LSACode</small>
                        </div>

                        <div class="temporary-assignment-card-fixed">
                            <span>Production Info</span>
                            <strong>@AsignacionTemporalSeleccionada.DatabaseName</strong>
                            <small>Bind Plant: @AsignacionTemporalSeleccionada.BindPlantName</small>
                            <small>State: @AsignacionTemporalSeleccionada.StateName</small>
                        </div>

                        <div class="temporary-assignment-card-fixed">
                            <span>Current Status</span>

                            <strong>
                                @(AsignacionTemporalSeleccionada.TieneAsignacionTemporal
                                                        ? "Has temporary assignment"
                                                        : "No temporary assignment")
                    </strong>

                    @if (AsignacionTemporalSeleccionada.TieneAsignacionTemporal)
                            {
                                <small>Covering: @AsignacionTemporalSeleccionada.EtapasTemporales</small>
                                <small>Temporary: @AsignacionTemporalSeleccionada.EmpleadoTemporalNombre</small>
                            }
                            else
                            {
                                <small>Ready to assign temporary coverage</small>
                            }
                        </div>

                    </div>
                }

                @if (AsignacionTemporalSeleccionadaId is null)
                {
                    <div class="empty-state" style="margin-top: 18px;">
                        <strong>Select an assignment first.</strong>
                        <span>The pending stages will appear here.</span>
                    </div>
                }
                else if (!EtapasDisponiblesParaTemporal.Any())
                {
                    <div class="empty-state" style="margin-top: 18px;">
                        <strong>No pending stages available.</strong>
                        <span>All stages for this book have already passed or are not applicable.</span>
                    </div>
                }
                else
                {
                    <div class="temporary-stages">
                        @foreach (var etapa in EtapasDisponiblesParaTemporal)
                        {
                            <label class="temporary-stage-card">
                                <input type="checkbox"
                                       checked="@EtapaSeleccionada(etapa.Codigo)"
                                       @onchange="(e) => CambiarEtapaTemporal(etapa.Codigo, e)" />
                                <strong>@etapa.Nombre</strong>
                            </label>
                        }
                    </div>
                }

                <div class="form-grid" style="margin-top: 18px;">
                    <div class="form-group large">
                        <label>Reason</label>
                        <input class="form-control"
                               placeholder="Example: Vacation coverage, sick leave, temporary support..."
                               @bind="MotivoTemporal"
                               @bind:event="oninput" />
                    </div>
                </div>

            </div>

            <div class="temporary-modal-actions">
                <button type="button"
                        class="btn-primary"
                        @onclick="GuardarAsignacionTemporalAsync">
                    Save Temporary Assignment
                </button>

