    private async Task ExportarStatusOfBooksXlsxAsync()
    {
        if (string.IsNullOrWhiteSpace(EmpleadoFiltroId) ||
            !Guid.TryParse(EmpleadoFiltroId, out var empleadoId))
        {
            MostrarModalEmpleadoRequerido = true;
            await InvokeAsync(StateHasChanged);
            return;
        }

        var empleado = AsignacionesListado
            .FirstOrDefault(x => x.EmpleadoId == empleadoId);

        if (empleado is null)
        {
            MostrarModalEmpleadoRequerido = true;
            await InvokeAsync(StateHasChanged);
            return;
        }

        try
        {
            GenerandoStatusBooks = true;
            LimpiarMensaje();

            var datos = AsignacionesListado
                .Where(x => x.EmpleadoId == empleadoId)
                .OrderBy(x => x.BookName)
                .ThenBy(x => x.KGENCode)
                .ToList();

            if (!datos.Any())
            {
                MostrarMensaje(
                    "The selected employee does not have active book assignments.",
                    "error");
                return;
            }

            using var workbook = new XLWorkbook();
            var worksheet = workbook.Worksheets.Add("Status of Books");

            const int lastColumn = 14;
            const int headerRow = 5;

            worksheet.Cell(1, 1).Value = "Status of Books";
            worksheet.Range(1, 1, 1, lastColumn).Merge();

            worksheet.Cell(2, 1).Value = $"Employee: {empleado.EmpleadoNombre}";
            worksheet.Range(2, 1, 2, lastColumn).Merge();

            worksheet.Cell(3, 1).Value =
                $"Generated: {DateTime.Now:MM/dd/yyyy hh:mm tt} | " +
                $"Total Books: {datos.Count}";
            worksheet.Range(3, 1, 3, lastColumn).Merge();

            worksheet.Cell(headerRow, 1).Value = "Employee Name";
            worksheet.Cell(headerRow, 2).Value = "KGEN Code";
            worksheet.Cell(headerRow, 3).Value = "LSA Code";
            worksheet.Cell(headerRow, 4).Value = "Book Name";
            worksheet.Cell(headerRow, 5).Value = "Bind Plant";
            worksheet.Cell(headerRow, 6).Value = "Database";
            worksheet.Cell(headerRow, 7).Value = "Status of Proof Extract";
            worksheet.Cell(headerRow, 8).Value = "Status of Final Extract";
            worksheet.Cell(headerRow, 9).Value = "Status of Memo Extract";
            worksheet.Cell(headerRow, 10).Value = "Final PO Sent";
            worksheet.Cell(headerRow, 11).Value = "Shipped Pages";
            worksheet.Cell(headerRow, 12).Value = "Dirxion Sent";
            worksheet.Cell(headerRow, 13).Value = "Last Stage Worked";
            worksheet.Cell(headerRow, 14).Value = "Next Stage";

            var row = headerRow + 1;

            foreach (var item in datos)
            {
                worksheet.Cell(row, 1).Value = item.EmpleadoNombre;
                worksheet.Cell(row, 2).Value = item.KGENCode;
                worksheet.Cell(row, 3).Value = item.LSACode;
                worksheet.Cell(row, 4).Value = item.BookName;
                worksheet.Cell(row, 5).Value = item.BindPlantName;
                worksheet.Cell(row, 6).Value = item.DatabaseName;

                worksheet.Cell(row, 7).Value =
                    item.ProofExtractWorked ? "Completed" : "Pending";

                worksheet.Cell(row, 8).Value =
                    item.FinalExtractWorked ? "Completed" : "Pending";

                worksheet.Cell(row, 9).Value =
                    !item.MemoApplicable
                        ? "N/A"
                        : item.MemoExtractWorked
                            ? "Completed"
                            : "Pending";

                worksheet.Cell(row, 10).Value =
                    item.FinalPOWorked ? "Sent" : "Pending";

                worksheet.Cell(row, 11).Value =
                    item.ShippingWorked ? "Completed" : "Pending";

                worksheet.Cell(row, 12).Value =
                    item.DirxionWorked ? "Sent" : "Pending";

                worksheet.Cell(row, 13).Value =
                    item.LastStageWorked == "Not Started"
                        ? string.Empty
                        : item.LastStageWorked;

                worksheet.Cell(row, 14).Value =
                    item.DirxionWorked
                        ? string.Empty
                        : item.NextStage;

                AplicarEstiloEstadoStatusBooks(
                    worksheet.Cell(row, 7),
                    item.ProofExtractWorked ? "Completed" : "Pending");

                AplicarEstiloEstadoStatusBooks(
                    worksheet.Cell(row, 8),
                    item.FinalExtractWorked ? "Completed" : "Pending");

                AplicarEstiloEstadoStatusBooks(
                    worksheet.Cell(row, 9),
                    !item.MemoApplicable
                        ? "N/A"
                        : item.MemoExtractWorked
                            ? "Completed"
                            : "Pending");

                AplicarEstiloEstadoStatusBooks(
                    worksheet.Cell(row, 10),
                    item.FinalPOWorked ? "Sent" : "Pending");

                AplicarEstiloEstadoStatusBooks(
                    worksheet.Cell(row, 11),
                    item.ShippingWorked ? "Completed" : "Pending");

                AplicarEstiloEstadoStatusBooks(
                    worksheet.Cell(row, 12),
                    item.DirxionWorked ? "Sent" : "Pending");

                row++;
            }

            var titleRange = worksheet.Range(1, 1, 1, lastColumn);
            titleRange.Style.Font.Bold = true;
            titleRange.Style.Font.FontSize = 17;
            titleRange.Style.Font.FontColor = XLColor.White;
            titleRange.Style.Fill.BackgroundColor = XLColor.FromHtml("#0F766E");
            titleRange.Style.Alignment.Horizontal = XLAlignmentHorizontalValues.Center;
            titleRange.Style.Alignment.Vertical = XLAlignmentVerticalValues.Center;
            worksheet.Row(1).Height = 28;

            worksheet.Range(2, 1, 3, lastColumn).Style.Font.Italic = true;
            worksheet.Range(2, 1, 3, lastColumn).Style.Alignment.Horizontal =
                XLAlignmentHorizontalValues.Center;

            var header = worksheet.Range(headerRow, 1, headerRow, lastColumn);
            header.Style.Font.Bold = true;
            header.Style.Font.FontColor = XLColor.White;
            header.Style.Fill.BackgroundColor = XLColor.FromHtml("#111827");
            header.Style.Alignment.Horizontal = XLAlignmentHorizontalValues.Center;
            header.Style.Alignment.Vertical = XLAlignmentVerticalValues.Center;
            header.Style.Alignment.WrapText = true;
            worksheet.Row(headerRow).Height = 38;

            var dataRange = worksheet.Range(headerRow, 1, row - 1, lastColumn);
            dataRange.Style.Border.OutsideBorder = XLBorderStyleValues.Thin;
            dataRange.Style.Border.InsideBorder = XLBorderStyleValues.Thin;
            dataRange.Style.Border.OutsideBorderColor = XLColor.FromHtml("#CBD5E1");
            dataRange.Style.Border.InsideBorderColor = XLColor.FromHtml("#E2E8F0");
            dataRange.Style.Alignment.Vertical = XLAlignmentVerticalValues.Center;

            worksheet.Range(headerRow + 1, 5, row - 1, 14)
                .Style.Alignment.Horizontal = XLAlignmentHorizontalValues.Center;

            worksheet.Range(headerRow + 1, 13, row - 1, 14)
                .Style.Font.Bold = true;

            worksheet.SheetView.FreezeRows(headerRow);
            worksheet.Range(headerRow, 1, row - 1, lastColumn).SetAutoFilter();

            worksheet.Column(1).Width = 26;
            worksheet.Column(2).Width = 16;
            worksheet.Column(3).Width = 16;
            worksheet.Column(4).Width = 38;
            worksheet.Column(5).Width = 18;
            worksheet.Column(6).Width = 18;
            worksheet.Columns(7, 12).Width = 21;
            worksheet.Columns(13, 14).Width = 20;

            using var stream = new MemoryStream();
            workbook.SaveAs(stream);

            var base64 = Convert.ToBase64String(stream.ToArray());
            var employeeNameFile = LimpiarNombreArchivo(empleado.EmpleadoNombre);
            var fileName =
                $"Status_of_Books_{employeeNameFile}_{DateTime.Now:yyyyMMdd_HHmmss}.xlsx";

            await JS.InvokeVoidAsync(
                "downloadFileFromBase64",
                fileName,
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
                base64);

            MostrarMensaje(
                $"Status of Books report generated successfully for {empleado.EmpleadoNombre}. " +
                $"Total: {datos.Count}.",
                "success");
        }
        catch (Exception ex)
        {
            MostrarMensaje(
                $"Error generating Status of Books report: {ex.Message}",
                "error");
        }
        finally
        {
            GenerandoStatusBooks = false;
        }
    }

