    private EmployeeType? ResolveEmployeeType(string? code)
    {
        if (string.IsNullOrWhiteSpace(code))
            return null;

        return _employeeTypesByCode.TryGetValue(
            code.Trim(),
            out var employeeType)
            ? employeeType
            : null;
    }

    private string GetEmployeeTypeCode(short employeeTypeId)
    {
        if (_employeeTypeCodes.TryGetValue(
                employeeTypeId,
                out var value))
        {
            return value;
        }

        return employeeTypeId == Scope.EmployeeTypeId
            ? Scope.EmployeeTypeCode
            : string.Empty;
    }

