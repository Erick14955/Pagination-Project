    private void CambiarEtapaTemporal(string etapa, ChangeEventArgs e)
    {
        var seleccionado = e.Value is bool value && value;

        switch (etapa)
        {
            case "Proof":
                TempProof = seleccionado;
                break;

            case "Final":
                TempFinal = seleccionado;
                break;

            case "Memo":
                TempMemo = seleccionado;
                break;

            case "FinalPO":
                TempFinalPO = seleccionado;
                break;

            case "Shipping":
                TempShipping = seleccionado;
                break;

            case "Dirxion":
                TempDirxion = seleccionado;
                break;

            case "PubDate":
                TempPubDate = seleccionado;
                break;
        }
    }


