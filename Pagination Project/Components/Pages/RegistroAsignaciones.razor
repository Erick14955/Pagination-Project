    private void RebuildAssignmentDerivedState()
    {
        EmpleadosParaFiltro =
            AsignacionesListado
                .Where(x =>
                    EmpleadosPermitidosAsignacionesIds.Contains(
                        x.EmpleadoId))
                .GroupBy(x =>
                    x.EmpleadoId)
                .Select(g =>
                    g.First())
                .OrderBy(x =>
                    x.EmpleadoNombre,
                    StringComparer.OrdinalIgnoreCase)
                .ToList();

        if (!string.IsNullOrWhiteSpace(_empleadoFiltroId) &&
            (!Guid.TryParse(_empleadoFiltroId, out var empleadoId) ||
             EmpleadosParaFiltro.All(x => x.EmpleadoId != empleadoId)))
        {
            _empleadoFiltroId = string.Empty;
            _selectedPubMonth = string.Empty;
        }

        RebuildPubDateMonths();

        if (!string.IsNullOrWhiteSpace(_selectedPubMonth) &&
            PubDateMonths.All(x =>
                !string.Equals(
                    x.Value,
                    _selectedPubMonth,
                    StringComparison.Ordinal)))
        {
            _selectedPubMonth = string.Empty;
        }

        RebuildAsignacionesFiltradas();
    }

    private void RebuildPubDateMonths()
    {
        IEnumerable<AsignacionViewModel> query =
            AsignacionesListado;

        if (!string.IsNullOrWhiteSpace(
                _empleadoFiltroId)
            &&
            Guid.TryParse(
                _empleadoFiltroId,
                out var empleadoId))
        {
            query =
                query.Where(x =>
                    x.EmpleadoId ==
                    empleadoId);
        }

        PubDateMonths =
            query
                .Where(x =>
                    x.PubDate != default)
                .GroupBy(x =>
                    GetPubMonthValue(
                        x.PubDate))
                .Select(g =>
                {
                    var firstDate =
                        g.First().PubDate;

                    return new PubMonthOption
                    {
                        Value = g.Key,
                        Label =
                            GetPubMonthLabel(
                                firstDate),
                        Count = g.Count()
                    };
                })
                .OrderByDescending(x =>
                    x.Value)
                .ToList();
    }

    private void RebuildAsignacionesFiltradas()
    {
        IEnumerable<AsignacionViewModel> query =
            AsignacionesListado;

        if (!string.IsNullOrWhiteSpace(
                _empleadoFiltroId)
            &&
            Guid.TryParse(
                _empleadoFiltroId,
                out var empleadoId))
        {
            query =
                query.Where(x =>
                    x.EmpleadoId ==
                    empleadoId);
        }

        if (!string.IsNullOrWhiteSpace(
                _selectedPubMonth))
        {
            query =
                query.Where(x =>
                    GetPubMonthValue(
                        x.PubDate)
                    ==
                    _selectedPubMonth);
        }

        var fechaDesde =
            _fechaDesdeFiltro;

        var fechaHasta =
            _fechaHastaFiltro;

        if (fechaDesde.HasValue &&
            fechaHasta.HasValue &&
            fechaDesde.Value >
            fechaHasta.Value)
        {
            (fechaDesde, fechaHasta) =
                (fechaHasta, fechaDesde);
        }

        if (fechaDesde.HasValue ||
            fechaHasta.HasValue)
        {
            query =
                query.Where(x =>
                    FechaEtapaDentroDelRango(
                        x.ProofExtract,
                        fechaDesde,
                        fechaHasta)
                    ||
                    FechaEtapaDentroDelRango(
                        x.FinalExtract,
                        fechaDesde,
                        fechaHasta)
                    ||
                    FechaEtapaDentroDelRango(
                        x.MemoExtract,
                        fechaDesde,
                        fechaHasta)
                    ||
                    FechaEtapaDentroDelRango(
                        x.FinalPODate,
                        fechaDesde,
                        fechaHasta)
                    ||
                    FechaEtapaDentroDelRango(
                        x.ShippingDate,
                        fechaDesde,
                        fechaHasta)
                    ||
                    FechaEtapaDentroDelRango(
                        x.DirxionDate,
                        fechaDesde,
                        fechaHasta));
        }

        if (!string.IsNullOrWhiteSpace(
                _busqueda))
        {
            var filtro =
                Normalizar(
                    _busqueda);

            query =
                query.Where(x =>
                    x.SearchIndex.Contains(
                        filtro,
                        StringComparison.Ordinal));
        }

        AsignacionesFiltradas =
            query.ToList();
    }

