    }

    private static DateOnly? MaxDate(
        DateOnly? current,
        DateOnly candidate)
    {
        if (!current.HasValue ||
            candidate > current.Value)
        {
            return candidate;
        }

        return current;
    }

    private static DateOnly ObtenerFechaHoyRepublicaDominicana()
    {
        var localDate =
            TimeZoneInfo.ConvertTimeFromUtc(
                DateTime.UtcNow,
                DominicanTimeZone);

        return DateOnly.FromDateTime(
            localDate);
    }

    private static TimeZoneInfo ResolveDominicanTimeZone()
    {
        try
        {
            return TimeZoneInfo.FindSystemTimeZoneById(
                "America/Santo_Domingo");
        }
        catch (
            TimeZoneNotFoundException)
        {
        }
        catch (
            InvalidTimeZoneException)
        {
        }

        try
        {
            return TimeZoneInfo.FindSystemTimeZoneById(
                "SA Western Standard Time");
        }
        catch (
            TimeZoneNotFoundException)
        {
        }
        catch (
            InvalidTimeZoneException)
        {
        }

        return TimeZoneInfo.CreateCustomTimeZone(
            "Dominican Republic Fallback",
            TimeSpan.FromHours(-4),
            "Dominican Republic",
            "Dominican Republic");
    }

    private static bool FechaEtapaDentroDelRango(
    DateOnly fecha,
    DateOnly? fechaDesde,
    DateOnly? fechaHasta)
    {
        if (fecha == default)
            return false;

        if (fechaDesde.HasValue && fecha < fechaDesde.Value)
            return false;

        if (fechaHasta.HasValue && fecha > fechaHasta.Value)
            return false;

        return true;
    }

    private async Task GuardarAsignacionAsync()
    {
        if (!CreateAssignations)
        {
            MostrarMensaje("You do not have permission to create assignments.", "error");
            return;
        }

        try
        {
            Guardando = true;
            LimpiarMensaje();
            ResultadoImportacion = null;

            var empleado =
                EmpleadoSeleccionado ??
                BuscarEmpleadoSeleccionado();

            var libro =
                LibroSeleccionado ??
                BuscarLibroSeleccionado();

            if (empleado is null)
            {
                MostrarMensaje("Select a valid employee.", "error");
                return;
            }

            if (libro is null)
            {
                MostrarMensaje("Select a valid book. You can search by Book Name, KGEN Code or LSA Code.", "error");
                return;
            }

            if (empleado.EmployeeTypeId != libro.EmployeeTypeId)
            {
                MostrarMensaje("The employee and book belong to different employee types.", "error");
                return;
            }

            if (!Scope.CanAccess(libro.EmployeeTypeId))
            {
                MostrarMensaje("You cannot create assignments for this employee type.", "error");
                return;
            }

            await using var db = await DbFactory.CreateDbContextAsync();

            var libroYaAsignado = await db.Asignaciones
                .AsNoTracking()
                .AnyAsync(x =>
                    x.IdLibro == libro.Id &&
                    !x.Finalizado);

            if (libroYaAsignado)
            {
                MostrarMensaje("This book is already assigned to another employee.", "error");
                return;
            }

            var asignacion = new Asignaciones
            {
                Id = Guid.NewGuid(),
                IdEmpleado = empleado.Id,
                IdLibro = libro.Id,
                Finalizado = false
            };

            db.Asignaciones.Add(asignacion);
            await db.SaveChangesAsync();

            MostrarResultado(
                "Assignment created",
                "The assignment was created successfully.",
                $"{empleado.Nombre} was assigned to {libro.BookName} (KGEN: {libro.KGENCode}).",
                "success");

            LimpiarFormulario();
            await CargarDatosAsync();
        }
        catch (Exception ex)
        {
            MostrarMensaje($"Error saving assignment: {ex.Message}", "error");
        }
        finally
        {
            Guardando = false;
        }
    }

