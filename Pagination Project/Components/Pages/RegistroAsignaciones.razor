    private async Task ExportarStatusOfBooksXlsxAsync()
    {
        if (string.IsNullOrWhiteSpace(EmpleadoFiltroId) ||
            !Guid.TryParse(EmpleadoFiltroId, out var empleadoId))
        {
            MostrarModalEmpleadoRequerido = true;
            await InvokeAsync(StateHasChanged);
            return;
        }

        var empleado = AsignacionesListado
            .FirstOrDefault(x => x.EmpleadoId == empleadoId);

        if (empleado is null)
        {
            MostrarModalEmpleadoRequerido = true;
            await InvokeAsync(StateHasChanged);
            return;
        }

        try
        {
            GenerandoStatusBooks = true;
            LimpiarMensaje();

            var datos = AsignacionesListado
                .Where(x => x.EmpleadoId == empleadoId)
                .OrderBy(x => x.BookName)
                .ThenBy(x => x.KGENCode)
                .ToList();

            if (!datos.Any())
            {
                MostrarMensaje(
                    "The selected employee does not have active book assignments.",
                    "error");
                return;
