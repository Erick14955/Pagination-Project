@page "/asignaciones"
@page "/assignments"
@page "/registro-asignaciones"

@using System.Globalization
@using System.Text
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@using ClosedXML.Excel
@using Pagination_Project.Data
@using Pagination_Project.Models
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization

@inject AuthenticationStateProvider AuthenticationStateProvider

@attribute [Authorize]
@layout Pagination_Project.Components.Layout.DashboardLayout

@inject IDbContextFactory<AppDbContext> DbFactory
@inject IJSRuntime JS

<PageTitle>Assignments</PageTitle>

<link href="style/asignaciones.css" rel="stylesheet" />

<div class="assignments-page">

    <section class="page-hero">
        <div>
            <h1>Book Assignments</h1>
            <p>
                Assign books to employees manually or import assignments using an XLSX file.
            </p>
        </div>

        <div class="hero-stats">
            <div class="stat-card">
                <span>Total Assignments</span>
                <strong>@AsignacionesListado.Count</strong>
            </div>

            <div class="stat-card">
                <span>Filtered</span>
                <strong>@AsignacionesFiltradas.Count()</strong>
            </div>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(Mensaje))
    {
        <div class="alert-box @TipoMensaje">
            @Mensaje
        </div>
    }

    @if (CreateAssignations)
    {
        <section class="form-card">
            <div class="section-header">
                <div>
                    <h2>Assign Book to Employee</h2>
                    <p>Select an employee and search the book by Book Name, KGEN Code or LSA Code.</p>
                </div>

                <div class="header-actions">
                    <InputFile @key="XlsxInputKey"
                               id="xlsxAssignmentsUpload"
                               class="file-input-hidden"
                               OnChange="ImportAssignmentsFromXlsxAsync"
                               accept=".xlsx" />

                    <label for="xlsxAssignmentsUpload" class="btn-xlsx @(ImportandoXlsx ? "disabled" : "")">
                        @(ImportandoXlsx ? "Uploading..." : "📥 Add with XLSX")
                    </label>

                    <button type="button" class="btn-light" @onclick="LimpiarFormulario">
                        ✨ New
                    </button>
                </div>
            </div>

            <form @onsubmit="GuardarAsignacionAsync" @onsubmit:preventDefault>
                <div class="form-grid">

                    <div class="form-group large">
                        <label>Employee</label>

                        <input class="form-control"
                               list="employeesList"
                               placeholder="Search employee by name or employee ID"
                               @bind="EmpleadoTexto"
                               @bind:event="oninput"
                               required />

                        <datalist id="employeesList">
                            @foreach (var empleado in EmpleadosFiltrados)
                            {
                                <option value="@GetEmpleadoDisplay(empleado)"></option>
                            }
                        </datalist>
                    </div>

                    <div class="form-group large">
                        <label>Book</label>

                        <input class="form-control"
                               list="booksList"
                               placeholder="Search by Book Name, KGEN Code or LSA Code"
                               @bind="LibroTexto"
                               @bind:event="oninput"
                               required />

                        <datalist id="booksList">
                            @foreach (var libro in LibrosFiltradosParaCombo)
                            {
                                <option value="@GetLibroDisplay(libro)"></option>
                            }
                        </datalist>
                    </div>

                </div>

                @if (EmpleadoSeleccionado is not null || LibroSeleccionado is not null)
                {
                    <div class="preview-grid">
                        <div class="preview-card">
                            <span>Selected Employee</span>
                            <strong>@(EmpleadoSeleccionado?.Nombre ?? "-")</strong>
                            <small>@(EmpleadoSeleccionado is null ? "No valid employee selected" : $"Employee ID: {EmpleadoSeleccionado.IdEmpleado}")</small>
                        </div>

                        <div class="preview-card">
                            <span>Selected Book</span>
                            <strong>@(LibroSeleccionado?.BookName ?? "-")</strong>
                            <small>
                                @(LibroSeleccionado is null
                                                        ? "No valid book selected"
                                                        : $"KGEN: {LibroSeleccionado.KGENCode} | LSA: {LibroSeleccionado.LSACode}")
                            </small>
                        </div>
                    </div>
                }

                <div class="button-row">
                    <button type="submit" class="btn-primary" disabled="@Guardando">
                        @(Guardando ? "Saving..." : "Save Assignment")
                    </button>

                    <button type="button" class="btn-secondary" @onclick="LimpiarFormulario">
                        Clear
                    </button>
                </div>
            </form>
        </section>
    }

    <section class="list-card">
        <div class="section-header table-header">
            <div>
                <h2>Assignment List</h2>
                <p>View and manage all employee-book assignments.</p>
            </div>

            <div class="list-filters">

                <select class="employee-filter-select"
                        @bind="EmpleadoFiltroId">
                    <option value="">All Employees</option>

                    @foreach (var empleado in EmpleadosParaFiltro)
                    {
                        <option value="@empleado.EmpleadoId">
                            @empleado.EmpleadoNombre
                        </option>
                    }
                </select>

                <div class="search-box">
                    <span>🔎</span>
                    <input placeholder="Search by employee, book, KGEN, LSA, state, database..."
                           @bind="Busqueda"
                           @bind:event="oninput" />
                </div>

                <button type="button"
                        class="btn-export-xlsx"
                        @onclick="ExportarAsignacionesXlsxAsync">
                    📤 Export XLSX
                </button>

                <button type="button" class="btn-filter-clear" @onclick="LimpiarFiltros">
                    Clear
                </button>
            </div>
        </div>

        @if (Cargando)
        {
            <div class="loading-state">
                Loading assignments...
            </div>
        }
        else if (!AsignacionesFiltradas.Any())
        {
            <div class="empty-state">
                <strong>No assignments to display.</strong>
                <span>Create a new assignment or change the search filter.</span>
            </div>
        }
        else
        {
            <div class="table-container">
                <table class="assignments-table">
                    <thead>
                        <tr>
                            <th>Employee</th>
                            <th>Book Name</th>
                            <th>KGEN</th>
                            <th>LSA</th>
                            <th>State</th>
                            <th>Database</th>
                            <th>Legacy Code</th>
                            <th>Print Foot</th>
                            <th>Trim Size</th>
                            <th>Bind Plant</th>
                            <th>Pub Date</th>
                            @if (CreateAssignations)
                            {
                                <th></th>
                            }
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in AsignacionesFiltradas)
                        {
                            <tr>
                                <td>
                                    <div class="employee-title">
                                        <strong>@item.EmpleadoNombre</strong>
                                        <span>@item.EmpleadoEmail</span>
                                    </div>
                                </td>

                                <td>
                                    <div class="book-title">
                                        <strong>@item.BookName</strong>
                                        <span>@item.ProductIssue</span>
                                    </div>
                                </td>

                                <td>@item.KGENCode</td>
                                <td>@item.LSACode</td>
                                <td><span class="pill">@item.StateName</span></td>
                                <td>@item.DatabaseName</td>
                                <td>@item.LegacyCodeName</td>
                                <td>@item.PrintFootName</td>
                                <td>@item.TrimSizeName</td>
                                <td>@item.BindPlantName</td>
                                <td>@FormatoFecha(item.PubDate)</td>

                                @if (CreateAssignations)
                                {
                                    <td class="actions-cell">
                                        <button type="button"
                                                class="icon-btn danger"
                                                title="Delete"
                                                @onclick="() => EliminarAsignacionAsync(item.Id)">
                                            🗑️
                                        </button>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>

@code {
    private List<Empleados> Empleados { get; set; } = new();
    private List<Libros> Libros { get; set; } = new();
    private List<AsignacionViewModel> AsignacionesListado { get; set; } = new();

    private List<Bind_Plant> BindPlants { get; set; } = new();
    private List<Database> Databases { get; set; } = new();
    private List<Legacy_Code> LegacyCodes { get; set; } = new();
    private List<Print_Foot> PrintFeet { get; set; } = new();
    private List<State> States { get; set; } = new();
    private List<Trim_Size> TrimSizes { get; set; } = new();

    private string EmpleadoTexto { get; set; } = string.Empty;
    private string LibroTexto { get; set; } = string.Empty;
    private string Busqueda { get; set; } = string.Empty;

    private string Mensaje { get; set; } = string.Empty;
    private string TipoMensaje { get; set; } = "success";

    private ClaimsPrincipal? UsuarioActual { get; set; }
    private bool CreateAssignations { get; set; } = false;

    private bool Cargando { get; set; } = true;
    private bool Guardando { get; set; } = false;
    private bool ImportandoXlsx { get; set; } = false;

    // private bool MostrarModalImportacion { get; set; } = false;
    // private string TituloModalImportacion { get; set; } = string.Empty;
    // private string ResumenModalImportacion { get; set; } = string.Empty;
    // private string TipoModalImportacion { get; set; } = "success";

    private int XlsxInputKey { get; set; } = 0;
    private const long MaxXlsxSize = 20 * 1024 * 1024;

    private ImportacionAsignacionesResultado? ResultadoImportacion { get; set; }

    private Empleados? EmpleadoSeleccionado => BuscarEmpleadoSeleccionado();
    private Libros? LibroSeleccionado => BuscarLibroSeleccionado();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();

        UsuarioActual = authState.User;
        CreateAssignations = HasPermission(UsuarioActual, "CreateAssignations");

        await CargarCatalogosAsync();
        await CargarDatosAsync();
    }

    private static bool HasPermission(ClaimsPrincipal? user, string claimType)
    {
        if (user is null)
            return false;

        return string.Equals(
            user.FindFirst(claimType)?.Value,
            "True",
            StringComparison.OrdinalIgnoreCase);
    }

    private async Task CargarDatosAsync()
    {
        try
        {
            Cargando = true;

            await using var db = await DbFactory.CreateDbContextAsync();

            await ActualizarFinalizadosPorDirxionAsync(db);

            Empleados = await db.Empleados
                .AsNoTracking()
                .Where(x => x.Activo)
                .OrderBy(x => x.Nombre)
                .ToListAsync();

            Libros = await db.Libros
                .AsNoTracking()
                .Where(x => !x.Finalizado)
                .OrderBy(x => x.BookName)
                .ToListAsync();

            var asignacionesDb = await db.Asignaciones
                .AsNoTracking()
                .Include(x => x.Empleado)
                .Include(x => x.Libro)
                .Where(x => !x.Finalizado &&
                            x.Libro != null &&
                            !x.Libro.Finalizado)
                .OrderBy(x => x.Empleado!.Nombre)
                .ThenBy(x => x.Libro!.BookName)
                .ToListAsync();

            AsignacionesListado = asignacionesDb.Select(x => new AsignacionViewModel
            {
                Id = x.Id,

                EmpleadoId = x.IdEmpleado,
                EmpleadoNombre = x.Empleado?.Nombre ?? string.Empty,
                EmpleadoCodigo = x.Empleado?.IdEmpleado ?? 0,
                EmpleadoEmail = x.Empleado?.Email ?? string.Empty,

                LibroId = x.IdLibro,
                BookName = x.Libro?.BookName ?? string.Empty,
                KGENCode = x.Libro?.KGENCode ?? string.Empty,
                LSACode = x.Libro?.LSACode ?? string.Empty,
                ProductIssue = x.Libro?.ProductIssue ?? string.Empty,

                StateName = GetStateName(x.Libro?.StateId),
                DatabaseName = GetDatabaseName(x.Libro?.DatabaseId),
                LegacyCodeName = GetLegacyCodeName(x.Libro?.LegacyCodeId),
                PrintFootName = GetPrintFootName(x.Libro?.PrintFootId),
                TrimSizeName = GetTrimSizeName(x.Libro?.TrimSizeId),
                BindPlantName = GetBindPlantName(x.Libro?.BindPlantId),

                PubDate = x.Libro?.PubDate ?? default
            }).ToList();
        }
        catch (Exception ex)
        {
            MostrarMensaje($"Error loading assignments: {ex.Message}", "error");
        }
        finally
        {
            Cargando = false;
        }
    }

    private async Task CargarCatalogosAsync()
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            BindPlants = await db.Bind_Plants
                .AsNoTracking()
                .OrderBy(x => x.Bind_Plant_Name)
                .ToListAsync();

            Databases = await db.Databases
                .AsNoTracking()
                .OrderBy(x => x.Database_Name)
                .ToListAsync();

            LegacyCodes = await db.Legacy_Codes
                .AsNoTracking()
                .OrderBy(x => x.Legacy_Code_Name)
                .ToListAsync();

            PrintFeet = await db.Print_Foots
                .AsNoTracking()
                .OrderBy(x => x.Print_Foot_Name)
                .ToListAsync();

            States = await db.States
                .AsNoTracking()
                .OrderBy(x => x.State_Name)
                .ToListAsync();

            TrimSizes = await db.Trim_Sizes
                .AsNoTracking()
                .OrderBy(x => x.Trim_Size_Name)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            MostrarMensaje($"Error loading catalogs: {ex.Message}", "error");
        }
    }

    private IEnumerable<Empleados> EmpleadosFiltrados
    {
        get
        {
            if (string.IsNullOrWhiteSpace(EmpleadoTexto))
                return Empleados.Take(100);

            var filtro = Normalizar(EmpleadoTexto);

            return Empleados
                .Where(x =>
                    Normalizar(x.Nombre).Contains(filtro) ||
                    x.IdEmpleado.ToString(CultureInfo.InvariantCulture).Contains(filtro))
                .Take(100);
        }
    }

    private IEnumerable<Libros> LibrosFiltradosParaCombo
    {
        get
        {
            if (string.IsNullOrWhiteSpace(LibroTexto))
                return Libros.Take(100);

            var filtro = Normalizar(LibroTexto);

            return Libros
                .Where(x =>
                    Normalizar(x.BookName).Contains(filtro) ||
                    Normalizar(x.KGENCode).Contains(filtro) ||
                    Normalizar(x.LSACode).Contains(filtro))
                .Take(100);
        }
    }

    private IEnumerable<AsignacionViewModel> AsignacionesFiltradas
    {
        get
        {
            IEnumerable<AsignacionViewModel> query = AsignacionesListado;

            if (!string.IsNullOrWhiteSpace(EmpleadoFiltroId) &&
                Guid.TryParse(EmpleadoFiltroId, out var empleadoId))
            {
                query = query.Where(x => x.EmpleadoId == empleadoId);
            }

            if (!string.IsNullOrWhiteSpace(Busqueda))
            {
                var filtro = Normalizar(Busqueda);

                query = query.Where(x =>
                    Normalizar(x.EmpleadoNombre).Contains(filtro) ||
                    x.EmpleadoCodigo.ToString(CultureInfo.InvariantCulture).Contains(filtro) ||
                    Normalizar(x.EmpleadoEmail).Contains(filtro) ||
                    Normalizar(x.BookName).Contains(filtro) ||
                    Normalizar(x.KGENCode).Contains(filtro) ||
                    Normalizar(x.LSACode).Contains(filtro) ||
                    Normalizar(x.StateName).Contains(filtro) ||
                    Normalizar(x.DatabaseName).Contains(filtro) ||
                    Normalizar(x.LegacyCodeName).Contains(filtro) ||
                    Normalizar(x.PrintFootName).Contains(filtro) ||
                    Normalizar(x.TrimSizeName).Contains(filtro) ||
                    Normalizar(x.BindPlantName).Contains(filtro));
            }

            return query;
        }
    }

    private async Task GuardarAsignacionAsync()
    {
        if (!CreateAssignations)
        {
            MostrarMensaje("You do not have permission to create assignments.", "error");
            return;
        }

        try
        {
            Guardando = true;
            LimpiarMensaje();
            ResultadoImportacion = null;

            var empleado = BuscarEmpleadoSeleccionado();
            var libro = BuscarLibroSeleccionado();

            if (empleado is null)
            {
                MostrarMensaje("Select a valid employee.", "error");
                return;
            }

            if (libro is null)
            {
                MostrarMensaje("Select a valid book. You can search by Book Name, KGEN Code or LSA Code.", "error");
                return;
            }

            await using var db = await DbFactory.CreateDbContextAsync();

            var existe = await db.Asignaciones
                .AnyAsync(x => x.IdEmpleado == empleado.Id && x.IdLibro == libro.Id);

            if (existe)
            {
                MostrarMensaje("This book is already assigned to this employee.", "error");
                return;
            }

            var asignacion = new Asignaciones
            {
                Id = Guid.NewGuid(),
                IdEmpleado = empleado.Id,
                IdLibro = libro.Id,
                Finalizado = false
            };

            db.Asignaciones.Add(asignacion);
            await db.SaveChangesAsync();

            MostrarMensaje("Assignment saved successfully.", "success");

            LimpiarFormulario();
            await CargarDatosAsync();
        }
        catch (Exception ex)
        {
            MostrarMensaje($"Error saving assignment: {ex.Message}", "error");
        }
        finally
        {
            Guardando = false;
        }
    }

    private async Task EliminarAsignacionAsync(Guid id)
    {
        if (!CreateAssignations)
        {
            MostrarMensaje("You do not have permission to delete assignments.", "error");
            return;
        }

        var confirmar = await JS.InvokeAsync<bool>(
            "confirm",
            "Are you sure you want to delete this assignment?");

        if (!confirmar)
            return;

        try
        {
            LimpiarMensaje();
            ResultadoImportacion = null;

            await using var db = await DbFactory.CreateDbContextAsync();

            var asignacion = await db.Asignaciones
                .FirstOrDefaultAsync(x => x.Id == id);

            if (asignacion is null)
            {
                MostrarMensaje("The selected assignment was not found.", "error");
                return;
            }

            db.Asignaciones.Remove(asignacion);
            await db.SaveChangesAsync();

            MostrarMensaje("Assignment deleted successfully.", "success");

            await CargarDatosAsync();
        }
        catch (Exception ex)
        {
            MostrarMensaje($"Error deleting assignment: {ex.Message}", "error");
        }
    }

    private async Task ActualizarFinalizadosPorDirxionAsync(AppDbContext db)
    {
        var hoy = DateOnly.FromDateTime(DateTime.Today);

        var librosParaFinalizar = await db.Libros
            .Include(x => x.Asignaciones)
                .ThenInclude(a => a.Evaluaciones)
            .Where(x => !x.Finalizado &&
                        x.DirxionDate < hoy)
            .ToListAsync();

        if (!librosParaFinalizar.Any())
            return;

        foreach (var libro in librosParaFinalizar)
        {
            libro.Finalizado = true;

            foreach (var asignacion in libro.Asignaciones)
            {
                asignacion.Finalizado = true;

                foreach (var evaluacion in asignacion.Evaluaciones)
                {
                    evaluacion.Finalizado = true;
                }
            }
        }

        await db.SaveChangesAsync();
    }

    private async Task MostrarModalImportacionJsAsync(string titulo, string resumen, string tipo)
    {
        ResultadoImportacion ??= new ImportacionAsignacionesResultado();

        await JS.InvokeVoidAsync("assignmentImportModal.show", new
        {
            title = titulo,
            summary = resumen,
            type = tipo,
            booksCreated = ResultadoImportacion.LibrosCreados,
            assignmentsCreated = ResultadoImportacion.AsignacionesCreadas,
            duplicated = ResultadoImportacion.AsignacionesDuplicadas,
            skippedRows = ResultadoImportacion.FilasOmitidas,
            errors = ResultadoImportacion.Errores,
            warnings = ResultadoImportacion.Advertencias
        });
    }

    private async Task ImportAssignmentsFromXlsxAsync(InputFileChangeEventArgs e)
    {
        if (!CreateAssignations)
        {
            MostrarMensaje("You do not have permission to import assignments.", "error");
            return;
        }

        try
        {
            ImportandoXlsx = true;
            LimpiarMensaje();

            ResultadoImportacion = new ImportacionAsignacionesResultado();

            await JS.InvokeVoidAsync("assignmentImportModal.close");

            await InvokeAsync(StateHasChanged);
            await Task.Yield();

            if (!BindPlants.Any() ||
                !Databases.Any() ||
                !LegacyCodes.Any() ||
                !PrintFeet.Any() ||
                !TrimSizes.Any())
            {
                await CargarCatalogosAsync();
            }

            var file = e.File;

            if (file is null)
            {
                ResultadoImportacion.Errores.Add("No file was selected.");

                await MostrarModalImportacionJsAsync(
                    "XLSX import failed",
                    "No file was selected.",
                    "error");

                return;
            }

            if (!file.Name.EndsWith(".xlsx", StringComparison.OrdinalIgnoreCase))
            {
                ResultadoImportacion.Errores.Add($"The selected file '{file.Name}' is not valid. Only .xlsx files are allowed.");

                await MostrarModalImportacionJsAsync(
                    "XLSX import failed",
                    "Only .xlsx files are allowed.",
                    "error");

                return;
            }

            await using var stream = file.OpenReadStream(MaxXlsxSize);
            using var memoryStream = new MemoryStream();

            await stream.CopyToAsync(memoryStream);
            memoryStream.Position = 0;

            using var workbook = new XLWorkbook(memoryStream);
            var worksheet = workbook.Worksheets.FirstOrDefault();

            if (worksheet is null)
            {
                ResultadoImportacion.Errores.Add("The XLSX file does not contain any worksheet.");

                await MostrarModalImportacionJsAsync(
                    "XLSX import failed",
                    "The XLSX file does not contain any worksheet.",
                    "error");

                return;
            }

            var headerRow = worksheet.FirstRowUsed();

            if (headerRow is null)
            {
                ResultadoImportacion.Errores.Add("The XLSX file is empty.");

                await MostrarModalImportacionJsAsync(
                    "XLSX import failed",
                    "The XLSX file is empty.",
                    "error");

                return;
            }

            var headerMap = BuildHeaderMap(headerRow);

            if (!HeaderExists(headerMap, "Employee", "Employee Name"))
            {
                ResultadoImportacion.Errores.Add("Missing required column: 'Employee' or 'Employee Name'.");

                await MostrarModalImportacionJsAsync(
                    "XLSX import failed",
                    "The file is missing required columns.",
                    "error");

                return;
            }

            if (!HeaderExists(headerMap, "Product Name"))
            {
                ResultadoImportacion.Errores.Add("Missing required column: 'Product Name'.");

                await MostrarModalImportacionJsAsync(
                    "XLSX import failed",
                    "The file is missing required columns.",
                    "error");

                return;
            }

            if (!HeaderExists(headerMap, "KGen Product Code", "KGEN Product Code", "KGEN Code"))
            {
                ResultadoImportacion.Errores.Add("Missing required column: 'KGen Product Code', 'KGEN Product Code' or 'KGEN Code'.");

                await MostrarModalImportacionJsAsync(
                    "XLSX import failed",
                    "The file is missing required columns.",
                    "error");

                return;
            }

            await using var db = await DbFactory.CreateDbContextAsync();

            var empleadosDb = await db.Empleados
                .Where(x => x.Activo)
                .ToListAsync();

            var librosDb = await db.Libros
                .Where(x => !x.Finalizado)
                .ToListAsync();

            var today = DateOnly.FromDateTime(DateTime.Today);

            foreach (var row in worksheet.RowsUsed().Where(r => r.RowNumber() > headerRow.RowNumber()))
            {
                var rowNumber = row.RowNumber();

                var employeeName = ReadText(row, headerMap, "Employee", "Employee Name");
                var bookName = ReadText(row, headerMap, "Product Name");
                var kgenCode = ReadText(row, headerMap, "KGen Product Code", "KGEN Product Code", "KGEN Code");
                var lsaCode = ReadText(row, headerMap, "LSA Code", "LSA");

                if (string.IsNullOrWhiteSpace(employeeName) &&
                    string.IsNullOrWhiteSpace(bookName) &&
                    string.IsNullOrWhiteSpace(kgenCode) &&
                    string.IsNullOrWhiteSpace(lsaCode))
                {
                    ResultadoImportacion.FilasOmitidas++;
                    continue;
                }

                if (string.IsNullOrWhiteSpace(employeeName))
                {
                    ResultadoImportacion.FilasOmitidas++;
                    ResultadoImportacion.Errores.Add($"Row {rowNumber}: The column 'Employee' is empty.");
                    continue;
                }

                var empleado = BuscarEmpleadoPorNombre(empleadosDb, employeeName);

                if (empleado is null)
                {
                    ResultadoImportacion.FilasOmitidas++;
                    ResultadoImportacion.Errores.Add($"Row {rowNumber}: Employee '{employeeName}' was not found or is not active.");
                    continue;
                }

                if (string.IsNullOrWhiteSpace(bookName) &&
                    string.IsNullOrWhiteSpace(kgenCode) &&
                    string.IsNullOrWhiteSpace(lsaCode))
                {
                    ResultadoImportacion.FilasOmitidas++;
                    ResultadoImportacion.Errores.Add($"Row {rowNumber}: Book information is empty. Fill at least Product Name, KGEN Code or LSA Code.");
                    continue;
                }

                var libro = BuscarLibroPorCodigos(librosDb, kgenCode, lsaCode);

                if (libro is null)
                {
                    if (string.IsNullOrWhiteSpace(bookName))
                    {
                        ResultadoImportacion.FilasOmitidas++;
                        ResultadoImportacion.Errores.Add($"Row {rowNumber}: Book was not found and the column 'Product Name' is empty.");
                        continue;
                    }

                    var footPrintText = ReadText(row, headerMap, "Foot Print");
                    var legacyCoText = ReadText(row, headerMap, "Legacy Co");
                    var stateText = ReadText(row, headerMap, "State");
                    var graphicsDatabaseText = ReadText(row, headerMap, "Graphics Database");
                    var trimSizeText = ReadText(row, headerMap, "Trim Size");
                    var bindPlantText = ReadText(row, headerMap, "Bind Plant");

                    var printFootId = FindPrintFootId(footPrintText);
                    var legacyCodeId = FindLegacyCodeId(legacyCoText);
                    var stateId = FindStateId(stateText);
                    var databaseId = FindDatabaseId(graphicsDatabaseText);
                    var trimSizeId = FindTrimSizeId(trimSizeText);
                    var bindPlantId = FindBindPlantId(bindPlantText);

                    AddCatalogWarningIfNeeded(ResultadoImportacion.Advertencias, rowNumber, "Foot Print", footPrintText, printFootId);
                    AddCatalogWarningIfNeeded(ResultadoImportacion.Advertencias, rowNumber, "Legacy Co", legacyCoText, legacyCodeId);
                    AddCatalogWarningIfNeeded(ResultadoImportacion.Advertencias, rowNumber, "State", stateText, stateId);
                    AddCatalogWarningIfNeeded(ResultadoImportacion.Advertencias, rowNumber, "Graphics Database", graphicsDatabaseText, databaseId);
                    AddCatalogWarningIfNeeded(ResultadoImportacion.Advertencias, rowNumber, "Trim Size", trimSizeText, trimSizeId);
                    AddCatalogWarningIfNeeded(ResultadoImportacion.Advertencias, rowNumber, "Bind Plant", bindPlantText, bindPlantId);

                    var erroresAntesDeFechas = ResultadoImportacion.Errores.Count;

                    var firstDuePrinterDate = ReadDateWithValidation(
                        row,
                        headerMap,
                        today,
                        ResultadoImportacion.Errores,
                        rowNumber,
                        false,
                        "First Due Printer");

                    var proofExtract = ReadDateWithValidation(
                        row,
                        headerMap,
                        today,
                        ResultadoImportacion.Errores,
                        rowNumber,
                        false,
                        "Proof Extract",
                        "Extract - Proof");

                    var finalExtract = ReadDateWithValidation(
                        row,
                        headerMap,
                        today,
                        ResultadoImportacion.Errores,
                        rowNumber,
                        false,
                        "Extract - Final");

                    var memoExtract = ReadDateWithValidation(
                        row,
                        headerMap,
                        today,
                        ResultadoImportacion.Errores,
                        rowNumber,
                        false,
                        "Memo Extract",
                        "Extract - Memo");

                    var dirxionDate = ReadDateWithValidation(
                        row,
                        headerMap,
                        today,
                        ResultadoImportacion.Errores,
                        rowNumber,
                        false,
                        "Dirxion");

                    var pubDate = ReadDateWithValidation(
                        row,
                        headerMap,
                        today,
                        ResultadoImportacion.Errores,
                        rowNumber,
                        false,
                        "Pub Date",
                        "Publication Date");

                    if (ResultadoImportacion.Errores.Count > erroresAntesDeFechas)
                    {
                        ResultadoImportacion.FilasOmitidas++;
                        ResultadoImportacion.Errores.Add($"Row {rowNumber}: The row was skipped because it contains invalid date values.");
                        continue;
                    }

                    var finalPoDate = CalculateFinalPoDate(firstDuePrinterDate);

                    libro = new Libros
                    {
                        Id = Guid.NewGuid(),

                        BookName = bookName,
                        KGENCode = kgenCode,
                        LSACode = lsaCode,
                        ProductIssue = ReadText(row, headerMap, "Product Issue"),

                        PrintFootId = printFootId,
                        LegacyCodeId = legacyCodeId,
                        StateId = stateId,
                        DatabaseId = databaseId,
                        TrimSizeId = trimSizeId,
                        BindPlantId = bindPlantId,

                        ProofExtract = proofExtract,
                        FinalExtract = finalExtract,
                        MemoExtract = memoExtract,
                        FinalPODate = finalPoDate,
                        ShippingDate = firstDuePrinterDate,
                        DirxionDate = dirxionDate,
                        PubDate = pubDate,

                        SRLSuppression = ReadYesNoBool(row, headerMap, "SRL Suppression Flag"),
                        NWP = ReadYesNoBool(row, headerMap, "NWP"),
                        Finalizado = false
                    };

                    db.Libros.Add(libro);
                    librosDb.Add(libro);

                    ResultadoImportacion.LibrosCreados++;
                }

                var existeAsignacion = await db.Asignaciones
                    .AnyAsync(x => x.IdEmpleado == empleado.Id && x.IdLibro == libro.Id);

                if (existeAsignacion)
                {
                    ResultadoImportacion.AsignacionesDuplicadas++;
                    continue;
                }

                db.Asignaciones.Add(new Asignaciones
                {
                    Id = Guid.NewGuid(),
                    IdEmpleado = empleado.Id,
                    IdLibro = libro.Id,
                    Finalizado = false
                });

                ResultadoImportacion.AsignacionesCreadas++;
            }

            await db.SaveChangesAsync();

            XlsxInputKey++;

            var tipoResultado = ResultadoImportacion.TieneErrores ? "error" : "success";

            var tituloResultado = ResultadoImportacion.TieneErrores
                ? "XLSX imported with errors"
                : "XLSX import completed";

            var resumenResultado =
                $"Books created: {ResultadoImportacion.LibrosCreados}. " +
                $"Assignments created: {ResultadoImportacion.AsignacionesCreadas}. " +
                $"Duplicated: {ResultadoImportacion.AsignacionesDuplicadas}. " +
                $"Skipped rows: {ResultadoImportacion.FilasOmitidas}.";

            ImportandoXlsx = false;

            await CargarDatosAsync();

            await InvokeAsync(StateHasChanged);

            await JS.InvokeVoidAsync("assignmentImportModal.show", new
            {
                title = tituloResultado,
                summary = resumenResultado,
                type = tipoResultado,
                booksCreated = ResultadoImportacion.LibrosCreados,
                assignmentsCreated = ResultadoImportacion.AsignacionesCreadas,
                duplicated = ResultadoImportacion.AsignacionesDuplicadas,
                skippedRows = ResultadoImportacion.FilasOmitidas,
                errors = ResultadoImportacion.Errores,
                warnings = ResultadoImportacion.Advertencias
            });
        }
        catch (Exception ex)
        {
            ResultadoImportacion ??= new ImportacionAsignacionesResultado();

            var mensajeError = ex.InnerException?.Message ?? ex.Message;

            ResultadoImportacion.Errores.Add($"General import error: {mensajeError}");

            await JS.InvokeVoidAsync("assignmentImportModal.show", new
            {
                title = "XLSX import failed",
                summary = "The file could not be imported. Review the error details below.",
                type = "error",
                booksCreated = ResultadoImportacion.LibrosCreados,
                assignmentsCreated = ResultadoImportacion.AsignacionesCreadas,
                duplicated = ResultadoImportacion.AsignacionesDuplicadas,
                skippedRows = ResultadoImportacion.FilasOmitidas,
                errors = ResultadoImportacion.Errores,
                warnings = ResultadoImportacion.Advertencias
            });
        }
        finally
        {
            ImportandoXlsx = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private Empleados? BuscarEmpleadoSeleccionado()
    {
        if (string.IsNullOrWhiteSpace(EmpleadoTexto))
            return null;

        var texto = EmpleadoTexto.Trim();
        var normalizado = Normalizar(texto);

        return Empleados.FirstOrDefault(x =>
            string.Equals(GetEmpleadoDisplay(x), texto, StringComparison.OrdinalIgnoreCase) ||
            Normalizar(x.Nombre) == normalizado ||
            x.IdEmpleado.ToString(CultureInfo.InvariantCulture) == texto);
    }

    private Libros? BuscarLibroSeleccionado()
    {
        if (string.IsNullOrWhiteSpace(LibroTexto))
            return null;

        var texto = LibroTexto.Trim();
        var normalizado = Normalizar(texto);

        return Libros.FirstOrDefault(x =>
            string.Equals(GetLibroDisplay(x), texto, StringComparison.OrdinalIgnoreCase) ||
            Normalizar(x.BookName) == normalizado ||
            Normalizar(x.KGENCode) == normalizado ||
            Normalizar(x.LSACode) == normalizado);
    }

    private static Empleados? BuscarEmpleadoPorNombre(List<Empleados> empleados, string employeeName)
    {
        var normalizado = Normalizar(employeeName);

        return empleados.FirstOrDefault(x => Normalizar(x.Nombre) == normalizado);
    }

    private static Libros? BuscarLibroPorCodigos(List<Libros> libros, string kgenCode, string lsaCode)
    {
        var kgen = Normalizar(kgenCode);
        var lsa = Normalizar(lsaCode);

        return libros.FirstOrDefault(x =>
            (!string.IsNullOrWhiteSpace(kgen) && Normalizar(x.KGENCode) == kgen) ||
            (!string.IsNullOrWhiteSpace(lsa) && Normalizar(x.LSACode) == lsa));
    }

    private string GetEmpleadoDisplay(Empleados empleado)
    {
        return $"{empleado.Nombre} | ID: {empleado.IdEmpleado}";
    }

    private string GetLibroDisplay(Libros libro)
    {
        return $"{libro.BookName} | KGEN: {libro.KGENCode} | LSA: {libro.LSACode}";
    }

