    private async Task DownloadAssignmentsTemplateAsync()
    {
        if (!PuedeDescargarPlantilla)
        {
            MostrarMensaje(
                "Only supervisors and administrators can download the assignments template.",
                "error");
            return;
        }

        try
        {
            DescargandoPlantillaXlsx = true;
            LimpiarMensaje();

            if (!EmployeeTypes.Any() ||
                !BindPlants.Any() ||
                !Databases.Any() ||
                !LegacyCodes.Any() ||
                !PrintFeet.Any() ||
                !States.Any() ||
                !TrimSizes.Any())
            {
                await CargarCatalogosAsync();
            }

            using var workbook = new XLWorkbook();

            // =========================================================
            // FIRST WORKSHEET: THE IMPORTER READS THE FIRST SHEET.
            // KEEP THE HEADER IN ROW 1 WITH NO TITLE ABOVE IT.
            // =========================================================
            var worksheet = workbook.Worksheets.Add("Assignments Upload");

            var headers = new[]
            {
                "employee_type",
                "Employee ID",
                "Employee",
                "Product Name",
                "KGen Product Code",
                "LSA Code",
                "Product Issue",
                "Foot Print",
                "Legacy Co",
                "State",
                "Graphics Database",
                "Trim Size",
                "Bind Plant",
                "First Due Printer",
                "Proof Extract",
                "Extract - Final",
                "Memo Extract",
                "Dirxion",
                "Pub Date",
                "SRL Suppression Flag",
                "NWP"
            };

            const int headerRow = 1;
            const int firstDataRow = 2;
            const int lastTemplateRow = 500;
            var lastColumn = headers.Length;

            for (var column = 1; column <= lastColumn; column++)
            {
                worksheet.Cell(headerRow, column).Value = headers[column - 1];
            }

            var headerRange = worksheet.Range(
                headerRow,
                1,
                headerRow,
                lastColumn);

            headerRange.Style.Font.Bold = true;
            headerRange.Style.Font.FontColor = XLColor.White;
            headerRange.Style.Fill.BackgroundColor = XLColor.FromHtml("#1F4E78");
            headerRange.Style.Alignment.Horizontal = XLAlignmentHorizontalValues.Center;
            headerRange.Style.Alignment.Vertical = XLAlignmentVerticalValues.Center;
            headerRange.Style.Alignment.WrapText = true;
            headerRange.Style.Border.OutsideBorder = XLBorderStyleValues.Thin;
            headerRange.Style.Border.InsideBorder = XLBorderStyleValues.Thin;

            // Fully required columns.
            foreach (var requiredColumn in new[] { 1, 4, 5 })
            {
                worksheet.Cell(headerRow, requiredColumn)
                    .Style.Fill.BackgroundColor = XLColor.FromHtml("#EA580C");
            }

            // Employee ID or Employee Name: at least one must be completed.
            foreach (var conditionalColumn in new[] { 2, 3 })
            {
                worksheet.Cell(headerRow, conditionalColumn)
                    .Style.Fill.BackgroundColor = XLColor.FromHtml("#D97706");
            }

            worksheet.Row(headerRow).Height = 34;
            worksheet.SheetView.FreezeRows(1);
            headerRange.SetAutoFilter();

            worksheet.Range(
                    firstDataRow,
                    14,
                    lastTemplateRow,
                    19)
                .Style.DateFormat.Format = "MM/dd/yyyy";

            worksheet.Range(
                    firstDataRow,
                    1,
                    lastTemplateRow,
                    lastColumn)
                .Style.Alignment.Vertical = XLAlignmentVerticalValues.Center;

            var widths = new double[]
            {
                18, // employee_type
                16, // Employee ID
                30, // Employee
                34, // Product Name
                22, // KGen Product Code
                18, // LSA Code
                20, // Product Issue
                20, // Foot Print
                18, // Legacy Co
                18, // State
                22, // Graphics Database
                18, // Trim Size
                18, // Bind Plant
                19, // First Due Printer
                18, // Proof Extract
                18, // Extract - Final
                18, // Memo Extract
                18, // Dirxion
                18, // Pub Date
                22, // SRL Suppression Flag
                12  // NWP
            };

            for (var column = 1; column <= widths.Length; column++)
            {
                worksheet.Column(column).Width = widths[column - 1];
            }

            // =========================================================
            // INSTRUCTIONS
            // =========================================================
            var instructionsSheet = workbook.Worksheets.Add("Instructions");

            instructionsSheet.Cell(1, 1).Value = "Assignments Upload Template";
            instructionsSheet.Range(1, 1, 1, 4).Merge();

            instructionsSheet.Cell(2, 1).Value =
                "Complete the 'Assignments Upload' worksheet. Keep the column names exactly as provided and upload the file as .xlsx.";
            instructionsSheet.Range(2, 1, 2, 4).Merge();

            instructionsSheet.Cell(3, 1).Value =
                "Use Employee ID whenever possible. If Employee ID is blank, Employee must exactly match one active employee name.";
            instructionsSheet.Range(3, 1, 3, 4).Merge();

            instructionsSheet.Cell(4, 1).Value =
                "Book catalog and date columns are used only when the KGEN does not already exist and a new book must be created. Blank dates for a new book use the current date.";
            instructionsSheet.Range(4, 1, 4, 4).Merge();

            instructionsSheet.Cell(6, 1).Value = "Column";
