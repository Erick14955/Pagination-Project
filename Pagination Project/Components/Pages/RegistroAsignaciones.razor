        var filtroNormalizado = Normalizar(filtro);

        _asignacionesPorKgen.TryGetValue(
            filtroNormalizado,
            out var asignacion);

        asignacion ??=
            _asignacionesPorLsa.TryGetValue(
                filtroNormalizado,
                out var asignacionPorLsa)
                ? asignacionPorLsa
                : null;

        asignacion ??= AsignacionesListado
            .Where(x =>
                Normalizar(x.KGENCode).Contains(
                    filtroNormalizado,
                    StringComparison.Ordinal)
                ||
                Normalizar(x.LSACode).Contains(
                    filtroNormalizado,
                    StringComparison.Ordinal))
            .OrderBy(x => x.EmpleadoNombre)
            .ThenBy(x => x.BookName)
            .FirstOrDefault();

        if (asignacion is null)
