    private void RebuildEmpleadoSuggestions()
    {
        IEnumerable<Empleados> query =
            Empleados;

        if (LibroSeleccionado is not null)
        {
            var employeeTypeId =
                LibroSeleccionado.EmployeeTypeId;

            query =
                query.Where(x =>
                    x.EmployeeTypeId ==
                    employeeTypeId);
        }

        var filtro =
            Normalizar(
                EmpleadoTexto);

        if (!string.IsNullOrWhiteSpace(
                filtro))
        {
            query =
                query.Where(x =>
                    _empleadoSearchIndex.TryGetValue(
                        x.Id,
                        out var index)
                    &&
                    index.Contains(
                        filtro,
                        StringComparison.Ordinal));
        }

        EmpleadosSugeridos =
            query
                .Take(50)
                .ToList();
    }

