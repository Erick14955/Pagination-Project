    private IEnumerable<Empleados> EmpleadosFiltrados
    {
        get
        {
            if (string.IsNullOrWhiteSpace(EmpleadoTexto))
                return Empleados.Take(100);

            var filtro = Normalizar(EmpleadoTexto);

            return Empleados
                .Where(x =>
                    Normalizar(x.Nombre).Contains(filtro) ||
                    x.IdEmpleado.ToString(CultureInfo.InvariantCulture).Contains(filtro))
                .Take(100);
        }
    }

    private IEnumerable<Libros> LibrosFiltradosParaCombo
    {
        get
        {
            if (string.IsNullOrWhiteSpace(LibroTexto))
                return Libros.Take(100);

            var filtro = Normalizar(LibroTexto);

            return Libros
                .Where(x =>
                    Normalizar(x.BookName).Contains(filtro) ||
                    Normalizar(x.KGENCode).Contains(filtro) ||
                    Normalizar(x.LSACode).Contains(filtro))
                .Take(100);
        }
    }

    private IEnumerable<AsignacionViewModel> AsignacionesFiltradas
    {
        get
        {
            IEnumerable<AsignacionViewModel> query = AsignacionesListado;

            if (!string.IsNullOrWhiteSpace(EmpleadoFiltroId) &&
                Guid.TryParse(EmpleadoFiltroId, out var empleadoId))
            {
                query = query.Where(x => x.EmpleadoId == empleadoId);
            }

            if (!string.IsNullOrWhiteSpace(SelectedPubMonth))
            {
                query = query.Where(x => GetPubMonthValue(x.PubDate) == SelectedPubMonth);
            }

            if (!string.IsNullOrWhiteSpace(Busqueda))
            {
                var filtro = Normalizar(Busqueda);

                query = query.Where(x =>
                    Normalizar(x.EmpleadoNombre).Contains(filtro) ||
                    Normalizar(x.EmpleadoOriginalNombre).Contains(filtro) ||
                    Normalizar(x.EmpleadoTemporalNombre).Contains(filtro) ||
                    Normalizar(x.EtapasTemporales).Contains(filtro) ||
                    x.EmpleadoCodigo.ToString(CultureInfo.InvariantCulture).Contains(filtro) ||
                    Normalizar(x.EmpleadoEmail).Contains(filtro) ||
                    Normalizar(x.BookName).Contains(filtro) ||
                    Normalizar(x.KGENCode).Contains(filtro) ||
                    Normalizar(x.LSACode).Contains(filtro) ||
                    Normalizar(x.StateName).Contains(filtro) ||
                    Normalizar(x.DatabaseName).Contains(filtro) ||
                    Normalizar(x.LegacyCodeName).Contains(filtro) ||
                    Normalizar(x.PrintFootName).Contains(filtro) ||
                    Normalizar(x.TrimSizeName).Contains(filtro) ||
                    Normalizar(x.BindPlantName).Contains(filtro));
            }

            return query;
        }
    }

    private async Task GuardarAsignacionAsync()
    {
        if (!CreateAssignations)
        {
            MostrarMensaje("You do not have permission to create assignments.", "error");
            return;
        }

        try
        {
            Guardando = true;
            LimpiarMensaje();
            ResultadoImportacion = null;

            var empleado = BuscarEmpleadoSeleccionado();
            var libro = BuscarLibroSeleccionado();

            if (empleado is null)
            {
                MostrarMensaje("Select a valid employee.", "error");
                return;
            }

            if (libro is null)
            {
                MostrarMensaje("Select a valid book. You can search by Book Name, KGEN Code or LSA Code.", "error");
                return;
            }

            await using var db = await DbFactory.CreateDbContextAsync();

            var libroYaAsignado = await db.Asignaciones
                .AsNoTracking()
                .Include(x => x.Empleado)
                .AnyAsync(x =>
                    x.IdLibro == libro.Id &&
                    !x.Finalizado);

            if (libroYaAsignado)
            {
                MostrarMensaje("This book is already assigned to another employee.", "error");
                return;
            }

            var asignacion = new Asignaciones
            {
                Id = Guid.NewGuid(),
                IdEmpleado = empleado.Id,
                IdLibro = libro.Id,
                Finalizado = false
            };

            db.Asignaciones.Add(asignacion);
            await db.SaveChangesAsync();

            MostrarMensaje("Assignment saved successfully.", "success");

            LimpiarFormulario();
            await CargarDatosAsync();
        }
        catch (Exception ex)
        {
            MostrarMensaje($"Error saving assignment: {ex.Message}", "error");
        }
        finally
        {
            Guardando = false;
        }
    }

    private async Task EliminarAsignacionAsync(Guid id)
    {
        if (!CreateAssignations)
        {
            MostrarMensaje("You do not have permission to delete assignments.", "error");
            return;
        }

        var confirmar = await JS.InvokeAsync<bool>(
            "confirm",
            "Are you sure you want to delete this assignment?");

        if (!confirmar)
            return;

        try
        {
            LimpiarMensaje();
            ResultadoImportacion = null;

            await using var db = await DbFactory.CreateDbContextAsync();

            var asignacion = await db.Asignaciones
                .FirstOrDefaultAsync(x => x.Id == id);

            if (asignacion is null)
            {
                MostrarMensaje("The selected assignment was not found.", "error");
                return;
            }

            db.Asignaciones.Remove(asignacion);
            await db.SaveChangesAsync();

            MostrarMensaje("Assignment deleted successfully.", "success");

            await CargarDatosAsync();
        }
        catch (Exception ex)
        {
            MostrarMensaje($"Error deleting assignment: {ex.Message}", "error");
        }
    }

    private async Task ActualizarFinalizadosPorDirxionAsync(AppDbContext db)
    {
        var hoy = DateOnly.FromDateTime(DateTime.Today);

        var librosParaFinalizar = await db.Libros
            .Include(x => x.Asignaciones)
                .ThenInclude(a => a.Evaluaciones)
            .Where(x => !x.Finalizado &&
                        x.DirxionDate < hoy)
            .ToListAsync();

        if (!librosParaFinalizar.Any())
            return;

        foreach (var libro in librosParaFinalizar)
        {
            libro.Finalizado = true;

            foreach (var asignacion in libro.Asignaciones)
            {
                asignacion.Finalizado = true;

                foreach (var evaluacion in asignacion.Evaluaciones)
                {
                    evaluacion.Finalizado = true;
                }
            }
        }

        await db.SaveChangesAsync();
    }

