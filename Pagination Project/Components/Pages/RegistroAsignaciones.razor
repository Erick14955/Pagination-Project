@if (MostrarModalEliminarAsignacion && AsignacionPendienteEliminar is not null)
{
    <div class="assignment-action-modal-backdrop"
         role="presentation"
         @onclick="CerrarModalEliminarAsignacion">

        <div class="assignment-action-modal assignment-delete-confirm-modal"
             role="dialog"
             aria-modal="true"
             aria-labelledby="assignmentDeleteTitle"
             @onclick:stopPropagation="true">

            <div class="assignment-action-modal-icon danger">!</div>

            <div class="assignment-action-modal-content">
                <h2 id="assignmentDeleteTitle">Confirm delete</h2>
                <p>Are you sure you want to delete this assignment?</p>

                <div class="assignment-action-summary">
                    <div>
                        <span>Employee</span>
                        <strong>@AsignacionPendienteEliminar.EmpleadoNombre</strong>
                    </div>

                    <div>
                        <span>Book</span>
                        <strong>@AsignacionPendienteEliminar.BookName</strong>
                        <small>KGEN: @AsignacionPendienteEliminar.KGENCode</small>
                    </div>
                </div>

                <p class="assignment-action-warning">
                    This action cannot be undone.
                </p>
            </div>

            <div class="assignment-action-modal-actions">
                <button type="button"
                        class="assignment-action-secondary"
                        disabled="@EliminandoAsignacion"
                        @onclick="CerrarModalEliminarAsignacion">
                    No, go back
                </button>

                <button type="button"
                        class="assignment-action-danger"
                        disabled="@EliminandoAsignacion"
                        @onclick="ConfirmarEliminarAsignacionAsync">
                    @(EliminandoAsignacion ? "Deleting..." : "Yes, delete")
                </button>
            </div>
        </div>
    </div>
}

@if (MostrarModalResultado)
{
    <div class="assignment-action-modal-backdrop"
         role="presentation"
         @onclick="CerrarModalResultado">

        <div class="assignment-action-modal assignment-result-modal @TipoModalResultado"
             role="dialog"
             aria-modal="true"
             aria-labelledby="assignmentResultTitle"
             @onclick:stopPropagation="true">

            <div class="assignment-action-modal-icon @TipoModalResultado">
                @(TipoModalResultado == "error" ? "!" : "✓")
            </div>

            <div class="assignment-action-modal-content">
                <h2 id="assignmentResultTitle">@TituloModalResultado</h2>
                <p>@MensajeModalResultado</p>

                @if (!string.IsNullOrWhiteSpace(DetalleModalResultado))
                {
                    <div class="assignment-result-detail">
                        @DetalleModalResultado
                    </div>
                }
            </div>

            <div class="assignment-action-modal-actions single">
                <button type="button"
                        class="assignment-action-primary"
                        @onclick="CerrarModalResultado">
                    OK
                </button>
            </div>
        </div>
    </div>
}


