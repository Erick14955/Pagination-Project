    private void CerrarModalEliminarAsignacion()
    {
        if (EliminandoAsignacion)
            return;

        MostrarModalEliminarAsignacion = false;
        AsignacionPendienteEliminar = null;
    }

    private async Task ConfirmarEliminarAsignacionAsync()
    {
        if (!CreateAssignations)
        {
            MostrarModalEliminarAsignacion = false;
            AsignacionPendienteEliminar = null;
            MostrarMensaje("You do not have permission to delete assignments.", "error");
            return;
        }

        if (AsignacionPendienteEliminar is null)
            return;

        EliminandoAsignacion = true;

        var assignmentId = AsignacionPendienteEliminar.Id;
        var employeeName = AsignacionPendienteEliminar.EmpleadoNombre;
        var bookName = AsignacionPendienteEliminar.BookName;
        var kgenCode = AsignacionPendienteEliminar.KGENCode;

        try
        {
            LimpiarMensaje();
            ResultadoImportacion = null;

            await using var db = await DbFactory.CreateDbContextAsync();

            var asignacion = await db.Asignaciones
                .ApplyScope(Scope)
                .FirstOrDefaultAsync(x => x.Id == assignmentId);

            if (asignacion is null)
            {
                MostrarModalEliminarAsignacion = false;
                AsignacionPendienteEliminar = null;
                MostrarMensaje("The selected assignment was not found.", "error");
                return;
            }

            db.Asignaciones.Remove(asignacion);
            await db.SaveChangesAsync();

            MostrarModalEliminarAsignacion = false;
            AsignacionPendienteEliminar = null;

            await CargarDatosAsync();

            MostrarResultado(
                "Assignment deleted",
                "The assignment was deleted successfully.",
                $"{employeeName} — {bookName} (KGEN: {kgenCode}).",
                "success");
        }
        catch (Exception ex)
        {
            MostrarModalEliminarAsignacion = false;
            AsignacionPendienteEliminar = null;
            MostrarMensaje($"Error deleting assignment: {ex.Message}", "error");
        }
        finally
        {
            EliminandoAsignacion = false;
        }
    }

    private async Task ActualizarFinalizadosPorDirxionAsync(AppDbContext db)
    {
        var hoy =
            ObtenerFechaHoyRepublicaDominicana();

        var tienePendientes =
            await db.Libros
                .AsNoTracking()
                .ApplyScope(Scope)
                .AnyAsync(x =>
                    !x.Finalizado &&
                    x.DirxionDate < hoy);

        if (!tienePendientes)
            return;

        await db.Evaluaciones
            .ApplyScope(Scope)
            .Where(x =>
                !x.Finalizado &&
                x.Asignacion != null &&
                x.Asignacion.Libro != null &&
                x.Asignacion.Libro.DirxionDate < hoy)
            .ExecuteUpdateAsync(setters =>
                setters.SetProperty(
                    x => x.Finalizado,
                    true));

        await db.Asignaciones
            .ApplyScope(Scope)
            .Where(x =>
                !x.Finalizado &&
                x.Libro != null &&
                x.Libro.DirxionDate < hoy)
            .ExecuteUpdateAsync(setters =>
                setters.SetProperty(
                    x => x.Finalizado,
                    true));

        await db.Libros
            .ApplyScope(Scope)
            .Where(x =>
                !x.Finalizado &&
                x.DirxionDate < hoy)
            .ExecuteUpdateAsync(setters =>
                setters.SetProperty(
                    x => x.Finalizado,
                    true));
    }

