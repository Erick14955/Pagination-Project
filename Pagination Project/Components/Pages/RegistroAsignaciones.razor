    private bool TempFinal { get; set; }
    private bool TempMemo { get; set; }
    private bool TempFinalPO { get; set; }
    private bool TempShipping { get; set; }
    private bool TempDirxion { get; set; }
    private bool TempPubDate { get; set; }

