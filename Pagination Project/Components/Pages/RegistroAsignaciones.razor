    private static bool HasPermission(ClaimsPrincipal? user, string claimType)
    {
        if (user is null)
            return false;

        return string.Equals(
            user.FindFirst(claimType)?.Value,
            "True",
            StringComparison.OrdinalIgnoreCase);
    }

    private async Task GuardarAsignacionTemporalAsync()
    {
        if (!CreateAssignations)
        {
            MostrarMensaje("You do not have permission to create temporary assignments.", "error");
            return;
        }

        if (AsignacionTemporalSeleccionadaId is null)
        {
            MostrarMensaje("Select an assignment.", "error");
            return;
        }

        if (EmpleadoTemporalSeleccionadoId is null)
        {
            MostrarMensaje("Select a temporary employee.", "error");
            return;
        }

        if (!TempProof &&
            !TempFinal &&
            !TempMemo &&
            !TempFinalPO &&
            !TempShipping &&
            !TempDirxion)
        {
            MostrarMensaje("Select at least one stage.", "error");
            return;
        }

        var etapasPermitidas = EtapasDisponiblesParaTemporal
            .Select(x => x.Codigo)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);

        if (TempProof && !etapasPermitidas.Contains("Proof"))
        {
            MostrarMensaje("Proof is no longer available for temporary assignment.", "error");
            return;
        }

        if (TempFinal && !etapasPermitidas.Contains("Final"))
        {
            MostrarMensaje("Final is no longer available for temporary assignment.", "error");
            return;
        }

        if (TempMemo && !etapasPermitidas.Contains("Memo"))
        {
            MostrarMensaje("Memo is no longer available for temporary assignment.", "error");
            return;
        }

        if (TempFinalPO && !etapasPermitidas.Contains("FinalPO"))
        {
            MostrarMensaje("Final PO is no longer available for temporary assignment.", "error");
            return;
        }

        if (TempShipping && !etapasPermitidas.Contains("Shipping"))
        {
            MostrarMensaje("Shipping is no longer available for temporary assignment.", "error");
            return;
        }

        if (TempDirxion && !etapasPermitidas.Contains("Dirxion"))
        {
            MostrarMensaje("Dirxion is no longer available for temporary assignment.", "error");
            return;
        }

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            var asignacion = await db.Asignaciones
                .ApplyScope(Scope)
                .Include(x => x.Empleado)
                .Include(x => x.Libro)
                .FirstOrDefaultAsync(x => x.Id == AsignacionTemporalSeleccionadaId.Value);

            if (asignacion is null)
            {
                MostrarMensaje("The selected assignment was not found.", "error");
                return;
            }

            if (asignacion.IdEmpleado == EmpleadoTemporalSeleccionadoId.Value)
            {
                MostrarMensaje("The temporary employee cannot be the same as the original employee.", "error");
                return;
            }

            var empleadosPermitidosIds =
                await ObtenerEmpleadosPermitidosParaAsignacionesAsync(db);

            var empleadoTemporal = await db.Empleados
                .AsNoTracking()
                .FirstOrDefaultAsync(x => x.Id == EmpleadoTemporalSeleccionadoId.Value);

            var empleadoTemporalPermitido =
                empleadosPermitidosIds.Contains(EmpleadoTemporalSeleccionadoId.Value) &&
                empleadoTemporal is not null &&
                asignacion.Libro is not null &&
                empleadoTemporal.EmployeeTypeId == asignacion.Libro.EmployeeTypeId;

            if (!empleadoTemporalPermitido)
            {
                MostrarMensaje("The temporary employee must be active, allowed, and belong to the same employee type as the book.", "error");
                return;
            }

            var temporalExistente = await db.TemporaryAssignments
                .FirstOrDefaultAsync(x => x.AssignmentId == asignacion.Id && x.Active);

            if (temporalExistente is not null)
            {
                temporalExistente.Active = false;
                temporalExistente.ClosedAt = DateTime.UtcNow;
            }

            var temporal = new TemporaryAssignment
            {
                Id = Guid.NewGuid(),
                AssignmentId = asignacion.Id,
                OriginalEmployeeId = asignacion.IdEmpleado,
                TemporaryEmployeeId = EmpleadoTemporalSeleccionadoId.Value,

                Proof = TempProof,
                Final = TempFinal,
                Memo = TempMemo,
                FinalPO = TempFinalPO,
                Shipping = TempShipping,
                Dirxion = TempDirxion,
                PubDate = false,

                Reason = MotivoTemporal,
                Active = true,
                CreatedAt = DateTime.UtcNow
            };

            db.TemporaryAssignments.Add(temporal);

            await db.SaveChangesAsync();

            var temporaryEmployeeName = empleadoTemporal?.Nombre ?? "Temporary employee";
            var temporaryBookName = asignacion.Libro?.BookName ?? "Selected book";

            MostrarResultado(
                "Temporary assignment saved",
                "The temporary assignment was saved successfully.",
                $"{temporaryEmployeeName} will cover {temporaryBookName}.",
                "success");

            await CerrarFormularioAsignacionTemporal();

            await CargarDatosAsync();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            MostrarMensaje($"Error saving temporary assignment: {ex.Message}", "error");
        }
    }

    private IEnumerable<Empleados> EmpleadosDisponiblesParaTemporal
    {
        get
        {
            IEnumerable<Empleados> query = Empleados;

            if (AsignacionTemporalSeleccionadaId is not null)
            {
                _asignacionesPorId.TryGetValue(
                    AsignacionTemporalSeleccionadaId.Value,
                    out var asignacion);

                if (asignacion is not null)
                {
                    query = query.Where(x =>
                        x.Id != asignacion.EmpleadoId &&
                        x.EmployeeTypeId == asignacion.EmployeeTypeId);
                }
            }

            return query.OrderBy(x => x.Nombre);
        }
    }

    private async Task ActualizarAsignacionesTemporalesVencidasAsync(AppDbContext db)
    {
        var hoy =
            ObtenerFechaHoyRepublicaDominicana();

        var temporales = await db.TemporaryAssignments
            .AsNoTracking()
            .Where(x =>
                x.Active &&
                x.Assignment != null &&
                x.Assignment.Libro != null &&
                (
                    Scope.ViewAllEmployeeTypes ||
                    x.Assignment.Libro.EmployeeTypeId ==
                    Scope.EmployeeTypeId
                ))
            .Select(x => new TemporaryExpirationRawDto
            {
                Id = x.Id,

                Proof = x.Proof,
                Final = x.Final,
                Memo = x.Memo,
                FinalPO = x.FinalPO,
                Shipping = x.Shipping,
                Dirxion = x.Dirxion,

                BindPlantId = x.Assignment!.Libro!.BindPlantId,

                ProofExtract = x.Assignment.Libro.ProofExtract,
                FinalExtract = x.Assignment.Libro.FinalExtract,
                MemoExtract = x.Assignment.Libro.MemoExtract,
                FinalPODate = x.Assignment.Libro.FinalPODate,
                ShippingDate = x.Assignment.Libro.ShippingDate,
                DirxionDate = x.Assignment.Libro.DirxionDate
            })
            .ToListAsync();

        if (temporales.Count == 0)
            return;

        var idsVencidos =
            new List<Guid>();

        foreach (var temporal in temporales)
        {
            var bindPlantName =
                GetBindPlantName(
                    temporal.BindPlantId);

            var esIveau =
                EsBindPlant(
                    bindPlantName,
                    "IVEAU",
                    "WSTR");

            var esAu =
                EsBindPlant(
                    bindPlantName,
                    "AU");

            var esNz =
                EsBindPlant(
                    bindPlantName,
                    "NZ");

            var excluirMemoPorBindPlant =
                EsBindPlant(
                    bindPlantName,
                    "PREM",
                    "DIRX",
                    "WSTR",
                    "IVEAU",
                    "AU",
                    "NZ");

            var proofDisplayDate =
                GetNextBusinessDay(
                    temporal.ProofExtract);

            var finalDisplayDate =
                GetNextBusinessDay(
                    temporal.FinalExtract);

            var memoDisplayDate =
                GetNextBusinessDay(
                    temporal.MemoExtract);

            var finalPODisplayDate =
                ObtenerFinalPODisplayDate(
                    temporal.ProofExtract,
                    temporal.FinalExtract,
                    temporal.MemoExtract,
                    temporal.FinalPODate,
                    esIveau,
                    esAu,
                    esNz);

            var shippingDisplayDate =
                esIveau
                    ? GetPreviousWorkDate(
                        temporal.ShippingDate,
                        1)
                    : temporal.ShippingDate;

            var tieneEtapaPendiente =
                (temporal.Proof &&
                 FechaPendiente(
                     proofDisplayDate,
                     hoy))
                ||
                (temporal.Final &&
                 FechaPendiente(
                     finalDisplayDate,
                     hoy))
                ||
                (temporal.Memo &&
                 !excluirMemoPorBindPlant &&
                 FechaPendiente(
                     memoDisplayDate,
                     hoy))
                ||
                (temporal.FinalPO &&
                 FechaPendiente(
                     finalPODisplayDate,
                     hoy))
                ||
                (temporal.Shipping &&
                 FechaPendiente(
                     shippingDisplayDate,
                     hoy))
                ||
                (temporal.Dirxion &&
                 FechaPendiente(
                     temporal.DirxionDate,
                     hoy));

            if (!tieneEtapaPendiente)
            {
                idsVencidos.Add(
                    temporal.Id);
            }
        }

        if (idsVencidos.Count == 0)
            return;

        await db.TemporaryAssignments
            .Where(x =>
                idsVencidos.Contains(x.Id))
            .ExecuteUpdateAsync(setters =>
                setters
                    .SetProperty(
                        x => x.Active,
                        false)
                    .SetProperty(
                        x => x.ClosedAt,
                        DateTime.UtcNow));
    }

    private async Task<Guid> ObtenerEmpleadoResponsableEtapaAsync(
    AppDbContext db,
    Guid assignmentId,
    string etapa)
    {
        var asignacion = await db.Asignaciones
            .AsNoTracking()
            .FirstOrDefaultAsync(x => x.Id == assignmentId);

        if (asignacion is null)
            return Guid.Empty;

        var temporal = await db.TemporaryAssignments
            .AsNoTracking()
            .Where(x => x.AssignmentId == assignmentId && x.Active)
            .OrderByDescending(x => x.CreatedAt)
            .FirstOrDefaultAsync();

        if (temporal is null)
            return asignacion.IdEmpleado;

        var aplicaTemporal = etapa switch
        {
            "Proof" => temporal.Proof,
            "Final" => temporal.Final,
            "Memo" => temporal.Memo,
            "FinalPO" => temporal.FinalPO,
            "Shipping" => temporal.Shipping,
            "Dirxion" => temporal.Dirxion,
            _ => false
        };

        return aplicaTemporal
            ? temporal.TemporaryEmployeeId
            : asignacion.IdEmpleado;
    }

    private async Task CargarDatosAsync()
    {
        try
        {
            Cargando = true;

            await using var db = await DbFactory.CreateDbContextAsync();

            await ActualizarFinalizadosPorDirxionAsync(db);
            await ActualizarAsignacionesTemporalesVencidasAsync(db);

            EmpleadosPermitidosAsignacionesIds =
                await ObtenerEmpleadosPermitidosParaAsignacionesAsync(db);

            Empleados = await db.Empleados
                .AsNoTracking()
                .Include(x => x.EmployeeType)
                .ApplyScope(Scope)
                .Where(x =>
                    x.Activo &&
                    EmpleadosPermitidosAsignacionesIds.Contains(x.Id))
                .OrderBy(x => x.Nombre)
                .ToListAsync();

            Libros = await db.Libros
                .AsNoTracking()
                .Include(x => x.EmployeeType)
                .ApplyScope(Scope)
                .Where(x =>
                    !x.Finalizado &&
                    !db.Asignaciones.Any(a =>
                        a.IdLibro == x.Id &&
                        !a.Finalizado))
                .OrderBy(x => x.BookName)
                .ToListAsync();

            var asignacionesDb = await db.Asignaciones
                .AsNoTracking()
                .ApplyScope(Scope)
                .Where(x =>
                    !x.Finalizado &&
                    x.Libro != null &&
                    !x.Libro.Finalizado)
                .OrderBy(x => x.Empleado!.Nombre)
                .ThenBy(x => x.Libro!.BookName)
                .Select(x => new AssignmentListRawDto
                {
                    Id = x.Id,

                    EmpleadoId = x.IdEmpleado,
                    EmpleadoNombre = x.Empleado != null
                        ? x.Empleado.Nombre ?? string.Empty
                        : string.Empty,
                    EmpleadoCodigo = x.Empleado != null
                        ? x.Empleado.IdEmpleado
                        : 0,
                    EmpleadoEmail = x.Empleado != null
                        ? x.Empleado.Email ?? string.Empty
                        : string.Empty,

                    LibroId = x.IdLibro,
                    BookName = x.Libro != null
                        ? x.Libro.BookName ?? string.Empty
                        : string.Empty,
                    KGENCode = x.Libro != null
                        ? x.Libro.KGENCode ?? string.Empty
                        : string.Empty,
                    LSACode = x.Libro != null
                        ? x.Libro.LSACode ?? string.Empty
                        : string.Empty,
                    ProductIssue = x.Libro != null
                        ? x.Libro.ProductIssue ?? string.Empty
                        : string.Empty,

                    EmployeeTypeId = x.Libro != null
                        ? x.Libro.EmployeeTypeId
                        : (short)0,
                    EmployeeTypeCode =
                        x.Libro != null &&
                        x.Libro.EmployeeType != null
                            ? x.Libro.EmployeeType.Code ?? string.Empty
                            : string.Empty,

                    StateId = x.Libro != null ? x.Libro.StateId : null,
                    DatabaseId = x.Libro != null ? x.Libro.DatabaseId : null,
                    LegacyCodeId = x.Libro != null ? x.Libro.LegacyCodeId : null,
                    PrintFootId = x.Libro != null ? x.Libro.PrintFootId : null,
                    TrimSizeId = x.Libro != null ? x.Libro.TrimSizeId : null,
                    BindPlantId = x.Libro != null ? x.Libro.BindPlantId : null,

                    PubDate = x.Libro != null ? x.Libro.PubDate : default,
                    ProofExtract = x.Libro != null ? x.Libro.ProofExtract : default,
                    FinalExtract = x.Libro != null ? x.Libro.FinalExtract : default,
                    MemoExtract = x.Libro != null ? x.Libro.MemoExtract : default,
                    FinalPODate = x.Libro != null ? x.Libro.FinalPODate : default,
                    ShippingDate = x.Libro != null ? x.Libro.ShippingDate : default,
                    DirxionDate = x.Libro != null ? x.Libro.DirxionDate : default
                })
                .ToListAsync();

            var asignacionIds = asignacionesDb
                .Select(x => x.Id)
                .ToList();

            var temporalesDb = asignacionIds.Count == 0
                ? new List<TemporaryAssignmentListRawDto>()
                : await db.TemporaryAssignments
                    .AsNoTracking()
                    .Where(x =>
                        x.Active &&
                        asignacionIds.Contains(x.AssignmentId))
                    .OrderByDescending(x => x.CreatedAt)
                    .Select(x => new TemporaryAssignmentListRawDto
                    {
                        AssignmentId = x.AssignmentId,
                        TemporaryEmployeeId = x.TemporaryEmployeeId,
                        TemporaryEmployeeName =
                            x.TemporaryEmployee != null
                                ? x.TemporaryEmployee.Nombre ?? string.Empty
                                : string.Empty,
                        Proof = x.Proof,
                        Final = x.Final,
                        Memo = x.Memo,
                        FinalPO = x.FinalPO,
                        Shipping = x.Shipping,
                        Dirxion = x.Dirxion,
                        CreatedAt = x.CreatedAt
                    })
                    .ToListAsync();

            var temporalPorAsignacion =
                new Dictionary<Guid, TemporaryAssignmentListRawDto>();

            foreach (var temporal in temporalesDb)
            {
                temporalPorAsignacion.TryAdd(
                    temporal.AssignmentId,
                    temporal);
            }

            var registrosTrabajados = asignacionIds.Count == 0
                ? new List<AssignmentWorkedRaw>()
                : await db.AsignacionesTrabajadas
                    .AsNoTracking()
                    .Where(x =>
                        asignacionIds.Contains(x.IdAsignacion))
                    .Select(x => new AssignmentWorkedRaw
                    {
                        AssignmentId = x.IdAsignacion,
                        WorkDate = x.FechaTrabajo,
                        ProofExtractWorked = x.ProofExtractWorked,
                        FinalExtractWorked = x.FinalExtractWorked,
                        MemoExtractWorked = x.MemoExtractWorked,
                        FinalPOWorked = x.FinalPOWorked,
                        ShippingWorked = x.ShippingWorked,
                        DirxionWorked = x.DirxionWorked
                    })
                    .ToListAsync();

            var progresoPorAsignacion =
                new Dictionary<Guid, AssignmentWorkedProgress>();

            foreach (var registro in registrosTrabajados)
            {
                if (!progresoPorAsignacion.TryGetValue(
                        registro.AssignmentId,
                        out var progreso))
                {
                    progreso = new AssignmentWorkedProgress();

                    progresoPorAsignacion.Add(
                        registro.AssignmentId,
                        progreso);
                }

                if (registro.ProofExtractWorked)
                {
                    progreso.ProofExtractWorked = true;
                    progreso.ProofWorkedDate =
                        MaxDate(
                            progreso.ProofWorkedDate,
                            registro.WorkDate);
                }

                if (registro.FinalExtractWorked)
                {
                    progreso.FinalExtractWorked = true;
                    progreso.FinalWorkedDate =
                        MaxDate(
                            progreso.FinalWorkedDate,
                            registro.WorkDate);
                }

                if (registro.MemoExtractWorked)
                {
                    progreso.MemoExtractWorked = true;
                    progreso.MemoWorkedDate =
                        MaxDate(
                            progreso.MemoWorkedDate,
                            registro.WorkDate);
                }

                if (registro.FinalPOWorked)
                {
                    progreso.FinalPOWorked = true;
                    progreso.FinalPOWorkedDate =
                        MaxDate(
                            progreso.FinalPOWorkedDate,
                            registro.WorkDate);
                }

                if (registro.ShippingWorked)
                {
                    progreso.ShippingWorked = true;
                    progreso.ShippingWorkedDate =
                        MaxDate(
                            progreso.ShippingWorkedDate,
                            registro.WorkDate);
                }

                if (registro.DirxionWorked)
                {
                    progreso.DirxionWorked = true;
                    progreso.DirxionWorkedDate =
                        MaxDate(
                            progreso.DirxionWorkedDate,
                            registro.WorkDate);
                }
            }

            var listado =
                new List<AsignacionViewModel>(
                    asignacionesDb.Count);

            foreach (var x in asignacionesDb)
            {
                temporalPorAsignacion.TryGetValue(
                    x.Id,
                    out var temporal);

                var bindPlantName =
                    GetBindPlantName(
                        x.BindPlantId);

                var progreso =
                    progresoPorAsignacion.TryGetValue(
                        x.Id,
                        out var progresoEncontrado)
                        ? progresoEncontrado
                        : new AssignmentWorkedProgress();

                var estadoEtapas =
                    ObtenerEstadoEtapas(
                        progreso,
                        bindPlantName);

                listado.Add(
                    new AsignacionViewModel
                    {
                        Id = x.Id,

                        EmpleadoId = x.EmpleadoId,
                        EmpleadoNombre = x.EmpleadoNombre,
                        EmpleadoCodigo = x.EmpleadoCodigo,
                        EmpleadoEmail = x.EmpleadoEmail,

                        EmployeeTypeId = x.EmployeeTypeId,
                        EmployeeTypeCode =
                            !string.IsNullOrWhiteSpace(
                                x.EmployeeTypeCode)
                                ? x.EmployeeTypeCode
                                : GetEmployeeTypeCode(
                                    x.EmployeeTypeId),

                        LibroId = x.LibroId,
                        BookName = x.BookName,
                        KGENCode = x.KGENCode,
                        LSACode = x.LSACode,
                        ProductIssue = x.ProductIssue,

                        StateName =
                            GetStateName(
                                x.StateId),

                        DatabaseName =
                            GetDatabaseName(
                                x.DatabaseId),

                        LegacyCodeName =
                            GetLegacyCodeName(
                                x.LegacyCodeId),

                        PrintFootName =
                            GetPrintFootName(
                                x.PrintFootId),

                        TrimSizeName =
                            GetTrimSizeName(
                                x.TrimSizeId),

                        BindPlantName =
                            bindPlantName,

                        PubDate = x.PubDate,

                        ProofExtract = x.ProofExtract,
                        FinalExtract = x.FinalExtract,
                        MemoExtract = x.MemoExtract,
                        FinalPODate = x.FinalPODate,
                        ShippingDate = x.ShippingDate,
                        DirxionDate = x.DirxionDate,
                        PubDateValue = x.PubDate,

                        BindPlantCode = bindPlantName,

                        TieneAsignacionTemporal =
                            temporal is not null,

                        EmpleadoOriginalNombre =
                            x.EmpleadoNombre,

                        EmpleadoTemporalNombre =
                            temporal?.TemporaryEmployeeName
                            ?? string.Empty,

                        EtapasTemporales =
                            temporal is null
                                ? string.Empty
                                : GetEtapasTemporalesTexto(
                                    temporal),

                        ProofExtractWorked =
                            progreso.ProofExtractWorked,

                        FinalExtractWorked =
                            progreso.FinalExtractWorked,

                        MemoExtractWorked =
                            progreso.MemoExtractWorked,

                        FinalPOWorked =
                            progreso.FinalPOWorked,

                        ShippingWorked =
                            progreso.ShippingWorked,

                        DirxionWorked =
                            progreso.DirxionWorked,

                        MemoApplicable =
                            AplicaEtapaMemo(
                                bindPlantName),

                        LastStageWorked =
                            estadoEtapas.LastStageWorked,

                        LastStageWorkedDate =
                            estadoEtapas.LastStageWorkedDate,

                        NextStage =
                            estadoEtapas.NextStage
                    });
            }

            foreach (var item in listado)
            {
                item.SearchIndex =
                    BuildAssignmentSearchIndex(
                        item);
            }

            AsignacionesListado = listado;

            RebuildLocalIndexes();
            RebuildAssignmentDerivedState();
            RebuildAutocompleteSuggestions();
        }
        catch (Exception ex)
        {
            MostrarMensaje(
                $"Error loading assignments: {ex.Message}",
                "error");
        }
        finally
        {
            Cargando = false;
        }
    }

    private sealed class EtapaTemporalDisponible
    {
        public string Codigo { get; set; } = string.Empty;
        public string Nombre { get; set; } = string.Empty;
        public DateOnly Fecha { get; set; }
    }

    private IEnumerable<EtapaTemporalDisponible> EtapasDisponiblesParaTemporal
    {
        get
        {
            if (AsignacionTemporalSeleccionadaId is null)
                return Enumerable.Empty<EtapaTemporalDisponible>();

            _asignacionesPorId.TryGetValue(
                AsignacionTemporalSeleccionadaId.Value,
                out var asignacion);

            if (asignacion is null)
                return Enumerable.Empty<EtapaTemporalDisponible>();

            var hoy =
                ObtenerFechaHoyRepublicaDominicana();

            var bindPlant = asignacion.BindPlantCode ?? string.Empty;

            var esIveau = EsBindPlant(bindPlant, "IVEAU", "WSTR");
            var esAu = EsBindPlant(bindPlant, "AU");
            var esNz = EsBindPlant(bindPlant, "NZ");

            var omitirMemo = EsBindPlant(
                bindPlant,
                "PREM",
                "DIRX",
                "WSTR",
                "IVEAU",
                "AU",
                "NZ");

            var proofDisplayDate = GetNextBusinessDay(asignacion.ProofExtract);
            var finalDisplayDate = GetNextBusinessDay(asignacion.FinalExtract);
            var memoDisplayDate = GetNextBusinessDay(asignacion.MemoExtract);

            var finalPODisplayDate = ObtenerFinalPODisplayDate(
                asignacion.ProofExtract,
                asignacion.FinalExtract,
                asignacion.MemoExtract,
                asignacion.FinalPODate,
                esIveau,
                esAu,
                esNz);

            var shippingDisplayDate = esIveau
                ? GetPreviousWorkDate(asignacion.ShippingDate, 1)
                : asignacion.ShippingDate;

            var etapas = new List<EtapaTemporalDisponible>();

            if (FechaPendiente(proofDisplayDate, hoy))
            {
                etapas.Add(new EtapaTemporalDisponible
                {
                    Codigo = "Proof",
                    Nombre = $"Proof - {FormatoFecha(proofDisplayDate)}",
                    Fecha = proofDisplayDate
                });
            }

            if (FechaPendiente(finalDisplayDate, hoy))
            {
                etapas.Add(new EtapaTemporalDisponible
                {
                    Codigo = "Final",
                    Nombre = $"Final - {FormatoFecha(finalDisplayDate)}",
                    Fecha = finalDisplayDate
                });
            }

            if (!omitirMemo && FechaPendiente(memoDisplayDate, hoy))
            {
                etapas.Add(new EtapaTemporalDisponible
                {
                    Codigo = "Memo",
                    Nombre = $"Memo - {FormatoFecha(memoDisplayDate)}",
                    Fecha = memoDisplayDate
                });
            }

            if (FechaPendiente(finalPODisplayDate, hoy))
            {
                etapas.Add(new EtapaTemporalDisponible
                {
                    Codigo = "FinalPO",
                    Nombre = $"Final PO - {FormatoFecha(finalPODisplayDate)}",
                    Fecha = finalPODisplayDate
                });
            }

            if (FechaPendiente(shippingDisplayDate, hoy))
            {
                etapas.Add(new EtapaTemporalDisponible
                {
                    Codigo = "Shipping",
                    Nombre = $"Shipping - {FormatoFecha(shippingDisplayDate)}",
                    Fecha = shippingDisplayDate
                });
            }

            if (FechaPendiente(asignacion.DirxionDate, hoy))
            {
                etapas.Add(new EtapaTemporalDisponible
                {
                    Codigo = "Dirxion",
                    Nombre = $"Dirxion - {FormatoFecha(asignacion.DirxionDate)}",
                    Fecha = asignacion.DirxionDate
                });
            }

            return etapas
                .OrderBy(x => x.Fecha)
                .ToList();
        }
    }

    private static DateOnly ObtenerFinalPODisplayDate(
    DateOnly proofExtract,
    DateOnly finalExtract,
    DateOnly memoExtract,
    DateOnly finalPODate,
    bool esIveau,
    bool esAu,
    bool esNz)
    {
        if (esNz)
        {
            return GetSameOrNextBusinessDay(memoExtract);
        }

        if (esAu)
        {
            if (memoExtract == default)
                return default;

            return GetSameOrNextBusinessDay(memoExtract.AddDays(1));
        }

        if (esIveau)
        {
            return GetPreviousWorkDate(finalPODate, 3);
        }

        return finalPODate;
    }

    private static bool EsBindPlant(string bindPlantName, params string[] codigos)
    {
        if (string.IsNullOrWhiteSpace(bindPlantName))
            return false;

        var normalizado = bindPlantName.Trim().ToUpperInvariant();

        if (codigos.Any(c => normalizado == c.Trim().ToUpperInvariant()))
            return true;

        var partes = normalizado.Split(
            new[] { ' ', '-', '_', '/', '\\', ',', ';', '.', '|', '(', ')', '[', ']' },
            StringSplitOptions.RemoveEmptyEntries);

        return partes.Any(parte =>
            codigos.Any(c => parte == c.Trim().ToUpperInvariant()));
    }

    private static DateOnly GetNextBusinessDay(DateOnly sourceDate)
    {
        if (sourceDate == default)
            return default;

        var result = sourceDate.AddDays(1);

        while (result.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday)
        {
            result = result.AddDays(1);
        }

        return result;
    }

    private static DateOnly GetSameOrNextBusinessDay(DateOnly sourceDate)
    {
        if (sourceDate == default)
            return default;

        var result = sourceDate;

        while (result.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday)
        {
            result = result.AddDays(1);
        }

        return result;
    }

    private static DateOnly GetPreviousWorkDate(DateOnly sourceDate, int daysBefore)
    {
        if (sourceDate == default)
            return default;

        var result = sourceDate.AddDays(-daysBefore);

        while (result.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday)
        {
            result = result.AddDays(-1);
        }

        return result;
    }

    private static bool FechaPendiente(DateOnly fecha, DateOnly hoy)
    {
        return fecha != default && fecha >= hoy;
    }

    private static string GetEtapasTemporalesTexto(TemporaryAssignment temporal)
    {
        var etapas = new List<string>();

        if (temporal.Proof)
            etapas.Add("Proof");

        if (temporal.Final)
            etapas.Add("Final");

        if (temporal.Memo)
            etapas.Add("Memo");

        if (temporal.FinalPO)
            etapas.Add("Final PO");

        if (temporal.Shipping)
            etapas.Add("Shipping");

        if (temporal.Dirxion)
            etapas.Add("Dirxion");

        return etapas.Any() ? string.Join(", ", etapas) : "-";
    }

    private static string GetEtapasTemporalesTexto(
        TemporaryAssignmentListRawDto temporal)
    {
        var etapas = new List<string>(6);

        if (temporal.Proof)
            etapas.Add("Proof");

        if (temporal.Final)
            etapas.Add("Final");

        if (temporal.Memo)
            etapas.Add("Memo");

        if (temporal.FinalPO)
            etapas.Add("Final PO");

        if (temporal.Shipping)
            etapas.Add("Shipping");

        if (temporal.Dirxion)
            etapas.Add("Dirxion");

        return etapas.Count > 0
            ? string.Join(", ", etapas)
            : "-";
    }



    private static AssignmentStageStatus ObtenerEstadoEtapas(
        AssignmentWorkedProgress progress,
        string bindPlantName)
    {
        var stageKeys = new List<string>
        {
            "Proof",
            "Final"
        };

        if (AplicaEtapaMemo(bindPlantName))
            stageKeys.Add("Memo");

        stageKeys.Add("FinalPO");
        stageKeys.Add("Shipping");
        stageKeys.Add("Dirxion");

        var lastWorkedIndex = -1;

        for (var index = 0; index < stageKeys.Count; index++)
        {
            if (IsStageWorked(progress, stageKeys[index]))
                lastWorkedIndex = index;
        }

        if (lastWorkedIndex < 0)
        {
            return new AssignmentStageStatus
            {
                LastStageWorked = "Not Started",
                LastStageWorkedDate = null,
                NextStage = GetStageDisplayName(stageKeys[0])
            };
        }

        var lastStageKey = stageKeys[lastWorkedIndex];
        var nextStage = lastWorkedIndex + 1 < stageKeys.Count
            ? GetStageDisplayName(stageKeys[lastWorkedIndex + 1])
            : "Completed";

        return new AssignmentStageStatus
        {
            LastStageWorked = GetStageDisplayName(lastStageKey),
            LastStageWorkedDate = GetStageWorkedDate(progress, lastStageKey),
            NextStage = nextStage
        };
    }

    private static bool AplicaEtapaMemo(string bindPlantName)
    {
        return EsBindPlant(bindPlantName, "WAUK", "SUSX", "LMRA");
    }

    private static bool IsStageWorked(AssignmentWorkedProgress progress, string stageKey)
    {
        return stageKey switch
        {
            "Proof" => progress.ProofExtractWorked,
            "Final" => progress.FinalExtractWorked,
            "Memo" => progress.MemoExtractWorked,
            "FinalPO" => progress.FinalPOWorked,
            "Shipping" => progress.ShippingWorked,
            "Dirxion" => progress.DirxionWorked,
            _ => false
        };
    }

    private static DateOnly? GetStageWorkedDate(
        AssignmentWorkedProgress progress,
        string stageKey)
    {
        return stageKey switch
        {
            "Proof" => progress.ProofWorkedDate,
            "Final" => progress.FinalWorkedDate,
            "Memo" => progress.MemoWorkedDate,
            "FinalPO" => progress.FinalPOWorkedDate,
            "Shipping" => progress.ShippingWorkedDate,
            "Dirxion" => progress.DirxionWorkedDate,
            _ => null
        };
    }

    private static string GetStageDisplayName(string stageKey)
    {
        return stageKey switch
        {
            "Proof" => "Proof",
            "Final" => "Final",
            "Memo" => "Memo",
            "FinalPO" => "Final PO",
            "Shipping" => "Shipping",
            "Dirxion" => "Dirxion",
            _ => stageKey
        };
    }

    private static string GetLastStageChipClass(AsignacionViewModel item)
    {
        return string.Equals(item.LastStageWorked, "Not Started", StringComparison.OrdinalIgnoreCase)
            ? "stage-chip stage-chip-not-started"
            : "stage-chip stage-chip-worked";
    }

    private static string GetNextStageChipClass(string nextStage)
    {
        return string.Equals(nextStage, "Completed", StringComparison.OrdinalIgnoreCase)
            ? "stage-chip stage-chip-completed"
            : "stage-chip stage-chip-next";
    }

    private async Task CargarCatalogosAsync()
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            EmployeeTypes = await db.EmployeeTypes
                .AsNoTracking()
                .Where(x => x.Active)
                .OrderBy(x => x.Code)
                .ToListAsync();

            BindPlants = await db.Bind_Plants
                .AsNoTracking()
                .OrderBy(x => x.Bind_Plant_Name)
                .ToListAsync();

            Databases = await db.Databases
                .AsNoTracking()
                .OrderBy(x => x.Database_Name)
                .ToListAsync();

            LegacyCodes = await db.Legacy_Codes
                .AsNoTracking()
                .OrderBy(x => x.Legacy_Code_Name)
                .ToListAsync();

            PrintFeet = await db.Print_Foots
                .AsNoTracking()
                .OrderBy(x => x.Print_Foot_Name)
                .ToListAsync();

            States = await db.States
                .AsNoTracking()
                .OrderBy(x => x.State_Name)
                .ToListAsync();

            TrimSizes = await db.Trim_Sizes
                .AsNoTracking()
                .OrderBy(x => x.Trim_Size_Name)
                .ToListAsync();

            RebuildCatalogLookups();
        }
        catch (Exception ex)
        {
            MostrarMensaje($"Error loading catalogs: {ex.Message}", "error");
        }
    }

    private void RebuildCatalogLookups()
    {
        _bindPlantNames = BindPlants
            .ToDictionary(
                x => x.Id,
                x => x.Bind_Plant_Name ?? string.Empty);

        _databaseNames = Databases
            .ToDictionary(
                x => x.Id,
                x => x.Database_Name ?? string.Empty);

        _legacyCodeNames = LegacyCodes
            .ToDictionary(
                x => x.Id,
                x => x.Legacy_Code_Name ?? string.Empty);

        _printFootNames = PrintFeet
            .ToDictionary(
                x => x.Id,
                x => x.Print_Foot_Name ?? string.Empty);

        _stateNames = States
            .ToDictionary(
                x => x.Id,
                x => x.State_Name ?? string.Empty);

        _trimSizeNames = TrimSizes
            .ToDictionary(
                x => x.Id,
                x => x.Trim_Size_Name ?? string.Empty);

        _bindPlantIdsByName =
            BuildCatalogIdLookup(
                BindPlants.Select(x => (
                    x.Id,
                    Name: x.Bind_Plant_Name)));

        _databaseIdsByName =
            BuildCatalogIdLookup(
                Databases.Select(x => (
                    x.Id,
                    Name: x.Database_Name)));

        _legacyCodeIdsByName =
            BuildCatalogIdLookup(
                LegacyCodes.Select(x => (
                    x.Id,
                    Name: x.Legacy_Code_Name)));

        _printFootIdsByName =
            BuildCatalogIdLookup(
                PrintFeet.Select(x => (
                    x.Id,
                    Name: x.Print_Foot_Name)));

        _stateIdsByName =
            BuildCatalogIdLookup(
                States.Select(x => (
                    x.Id,
                    Name: x.State_Name)));

        _trimSizeIdsByName =
            BuildCatalogIdLookup(
                TrimSizes.Select(x => (
                    x.Id,
                    Name: x.Trim_Size_Name)));

        _employeeTypeCodes = EmployeeTypes
            .ToDictionary(
                x => x.Id,
                x => x.Code ?? string.Empty);

        _employeeTypesByCode =
            new Dictionary<string, EmployeeType>(
                StringComparer.OrdinalIgnoreCase);

        foreach (var employeeType in EmployeeTypes)
        {
            if (!string.IsNullOrWhiteSpace(
                    employeeType.Code))
            {
                _employeeTypesByCode.TryAdd(
                    employeeType.Code.Trim(),
                    employeeType);
            }
        }
    }

    private static Dictionary<string, Guid> BuildCatalogIdLookup(
        IEnumerable<(Guid Id, string Name)> source)
    {
        var result =
            new Dictionary<string, Guid>(
                StringComparer.Ordinal);

        foreach (var item in source)
        {
            var normalized =
                Normalizar(
                    item.Name);

            if (!string.IsNullOrWhiteSpace(
                    normalized))
            {
                result.TryAdd(
                    normalized,
                    item.Id);
            }
        }

        return result;
    }

    private void RebuildLocalIndexes()
    {
        _asignacionesPorId =
            AsignacionesListado.ToDictionary(
                x => x.Id);

        _asignacionesPorKgen =
            new Dictionary<string, AsignacionViewModel>(
                StringComparer.Ordinal);

        _asignacionesPorLsa =
            new Dictionary<string, AsignacionViewModel>(
                StringComparer.Ordinal);

        foreach (var asignacion in AsignacionesListado)
        {
            var kgen =
                Normalizar(
                    asignacion.KGENCode);

            var lsa =
                Normalizar(
                    asignacion.LSACode);

            if (!string.IsNullOrWhiteSpace(kgen))
            {
                _asignacionesPorKgen.TryAdd(
                    kgen,
                    asignacion);
            }

            if (!string.IsNullOrWhiteSpace(lsa))
            {
                _asignacionesPorLsa.TryAdd(
                    lsa,
                    asignacion);
            }
        }

        _empleadosPorDisplay =
            new Dictionary<string, Empleados>(
                StringComparer.OrdinalIgnoreCase);

        _empleadosPorNombreNormalizado =
            new Dictionary<string, Empleados>(
                StringComparer.Ordinal);

        _empleadosPorCodigo =
            new Dictionary<int, Empleados>();

        _empleadoSearchIndex =
            new Dictionary<Guid, string>();

        foreach (var empleado in Empleados)
        {
            var display =
                GetEmpleadoDisplay(
                    empleado);

            _empleadosPorDisplay.TryAdd(
                display,
                empleado);

            var nombreNormalizado =
                Normalizar(
                    empleado.Nombre);

            if (!string.IsNullOrWhiteSpace(
                    nombreNormalizado))
            {
                _empleadosPorNombreNormalizado.TryAdd(
                    nombreNormalizado,
                    empleado);
            }

            _empleadosPorCodigo.TryAdd(
                empleado.IdEmpleado,
                empleado);

            _empleadoSearchIndex[empleado.Id] =
                $"{nombreNormalizado}|{empleado.IdEmpleado.ToString(CultureInfo.InvariantCulture)}";
        }

        _librosPorDisplay =
            new Dictionary<string, Libros>(
                StringComparer.OrdinalIgnoreCase);

        _librosPorNombreNormalizado =
            new Dictionary<string, Libros>(
                StringComparer.Ordinal);

        _librosPorKgenNormalizado =
            new Dictionary<string, Libros>(
                StringComparer.Ordinal);

        _librosPorLsaNormalizado =
            new Dictionary<string, Libros>(
                StringComparer.Ordinal);

        _libroSearchIndex =
            new Dictionary<Guid, string>();

        foreach (var libro in Libros)
        {
            var display =
                GetLibroDisplay(
                    libro);

            _librosPorDisplay.TryAdd(
                display,
                libro);

            var nombre =
                Normalizar(
                    libro.BookName);

            var kgen =
                Normalizar(
                    libro.KGENCode);

            var lsa =
                Normalizar(
                    libro.LSACode);

            if (!string.IsNullOrWhiteSpace(nombre))
            {
                _librosPorNombreNormalizado.TryAdd(
                    nombre,
                    libro);
            }

            if (!string.IsNullOrWhiteSpace(kgen))
            {
                _librosPorKgenNormalizado.TryAdd(
                    kgen,
                    libro);
            }

            if (!string.IsNullOrWhiteSpace(lsa))
            {
                _librosPorLsaNormalizado.TryAdd(
                    lsa,
                    libro);
            }

            _libroSearchIndex[libro.Id] =
                $"{nombre}|{kgen}|{lsa}";
        }

        EmpleadoSeleccionado =
            BuscarEmpleadoSeleccionado();

        LibroSeleccionado =
            BuscarLibroSeleccionado();
    }

