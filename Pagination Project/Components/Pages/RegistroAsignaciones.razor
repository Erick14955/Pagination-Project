                booksSheet.Cell(bookRow, 2).Value =
                    libro.BookName ?? string.Empty;

                booksSheet.Cell(bookRow, 3).Value =
                    libro.KGENCode ?? string.Empty;

                booksSheet.Cell(bookRow, 4).Value =
                    libro.LSACode ?? string.Empty;

                bookRow++;
            }

            var booksHeader = booksSheet.Range(1, 1, 1, 4);
            booksHeader.Style.Font.Bold = true;
            booksHeader.Style.Font.FontColor = XLColor.White;
            booksHeader.Style.Fill.BackgroundColor = XLColor.FromHtml("#7C3AED");
            booksHeader.Style.Alignment.Horizontal = XLAlignmentHorizontalValues.Center;

            if (bookRow > 2)
            {
                var booksRange = booksSheet.Range(1, 1, bookRow - 1, 4);
                booksRange.Style.Border.OutsideBorder = XLBorderStyleValues.Thin;
                booksRange.Style.Border.InsideBorder = XLBorderStyleValues.Thin;
                booksRange.SetAutoFilter();
