@page "/asignaciones"
@page "/assignments"
@page "/registro-asignaciones"

@using System.Globalization
@using System.Text
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@using ClosedXML.Excel
@using Pagination_Project.Data
@using Pagination_Project.Models
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization

@inject AuthenticationStateProvider AuthenticationStateProvider

@attribute [Authorize]
@layout Pagination_Project.Components.Layout.DashboardLayout

@inject IDbContextFactory<AppDbContext> DbFactory
@inject IJSRuntime JS

<PageTitle>Assignments</PageTitle>

<link href="style/asignaciones.css" rel="stylesheet" />

<div class="assignments-page">

    <section class="page-hero">
        <div>
            <h1>Book Assignments</h1>
            <p>
                Assign books to employees manually or import assignments using an XLSX file.
            </p>
        </div>

        <div class="hero-stats">
            <div class="stat-card">
                <span>Total Assignments</span>
                <strong>@AsignacionesListado.Count</strong>
            </div>

            <div class="stat-card">
                <span>Filtered</span>
                <strong>@AsignacionesFiltradas.Count()</strong>
            </div>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(Mensaje))
    {
        <div class="alert-box @TipoMensaje">
            @Mensaje
        </div>
    }

    @if (CreateAssignations)
    {
        <section class="form-card">
            <div class="section-header">
                <div>
                    <h2>Assign Book to Employee</h2>
                    <p>Select an employee and search the book by Book Name, KGEN Code or LSA Code.</p>
                </div>

                <div class="header-actions">
                    <InputFile @key="XlsxInputKey"
                               id="xlsxAssignmentsUpload"
                               class="file-input-hidden"
                               OnChange="ImportAssignmentsFromXlsxAsync"
                               accept=".xlsx" />

                    <label for="xlsxAssignmentsUpload" class="btn-xlsx @(ImportandoXlsx ? "disabled" : "")">
                        @(ImportandoXlsx ? "Uploading..." : "📥 Add with XLSX")
                    </label>

                    <InputFile @key="XlsxBooksUpdateInputKey"
                               id="xlsxBooksUpdateUpload"
                               class="file-input-hidden"
                               OnChange="UpdateBooksFromXlsxAsync"
                               accept=".xlsx" />

                    <label for="xlsxBooksUpdateUpload" class="btn-update-xlsx @(ActualizandoLibrosXlsx ? "disabled" : "")">
                        @(ActualizandoLibrosXlsx ? "Updating..." : "🔄 Update Books XLSX")
                    </label>

                    <button type="button"
                            class="btn-light"
                            @onclick="AbrirFormularioAsignacionTemporal">
                        🔁 Temporary Assignment
                    </button>

                    <button type="button" class="btn-light" @onclick="LimpiarFormulario">
                        ✨ New
                    </button>
                </div>
            </div>

            <form @onsubmit="GuardarAsignacionAsync" @onsubmit:preventDefault>
                <div class="form-grid">

                    <div class="form-group large">
                        <label>Employee</label>

                        <input class="form-control"
                               list="employeesList"
                               placeholder="Search employee by name or employee ID"
                               @bind="EmpleadoTexto"
                               @bind:event="oninput"
                               required />

                        <datalist id="employeesList">
                            @foreach (var empleado in EmpleadosFiltrados)
                            {
                                <option value="@GetEmpleadoDisplay(empleado)"></option>
                            }
                        </datalist>
                    </div>

                    <div class="form-group large">
                        <label>Book</label>

                        <input class="form-control"
                               list="booksList"
                               placeholder="Search by Book Name, KGEN Code or LSA Code"
                               @bind="LibroTexto"
                               @bind:event="oninput"
                               required />

                        <datalist id="booksList">
                            @foreach (var libro in LibrosFiltradosParaCombo)
                            {
                                <option value="@GetLibroDisplay(libro)"></option>
                            }
                        </datalist>
                    </div>

                </div>

                @if (EmpleadoSeleccionado is not null || LibroSeleccionado is not null)
                {
                    <div class="preview-grid">
                        <div class="preview-card">
                            <span>Selected Employee</span>
                            <strong>@(EmpleadoSeleccionado?.Nombre ?? "-")</strong>
                            <small>@(EmpleadoSeleccionado is null ? "No valid employee selected" : $"Employee ID: {EmpleadoSeleccionado.IdEmpleado}")</small>
                        </div>

                        <div class="preview-card">
                            <span>Selected Book</span>
                            <strong>@(LibroSeleccionado?.BookName ?? "-")</strong>
                            <small>
                                @(LibroSeleccionado is null
                                                        ? "No valid book selected"
                                                        : $"KGEN: {LibroSeleccionado.KGENCode} | LSA: {LibroSeleccionado.LSACode}")
                            </small>
                        </div>
                    </div>
                }

                <div class="button-row">
                    <button type="submit" class="btn-primary" disabled="@Guardando">
                        @(Guardando ? "Saving..." : "Save Assignment")
                    </button>

                    <button type="button" class="btn-secondary" @onclick="LimpiarFormulario">
                        Clear
                    </button>
                </div>
            </form>
        </section>
    }

    <section class="list-card">
        <div class="section-header table-header">
            <div>
                <h2>Assignment List</h2>
                <p>View and manage all employee-book assignments.</p>
            </div>

            <div class="list-filters">

                <select class="employee-filter-select"
                        value="@EmpleadoFiltroId"
                        @onchange="OnEmpleadoFiltroChanged">

                    <option value="">All Employees</option>

                    @foreach (var empleado in EmpleadosParaFiltro)
                    {
                        <option value="@empleado.EmpleadoId">
                            @empleado.EmpleadoNombre
                        </option>
                    }
                </select>

                <div class="month-filter">
                    <label>Pub Date Month</label>
                    <select class="form-control filter-select" @bind="SelectedPubMonth">
                        <option value="">All Pub Dates</option>

                        @foreach (var month in PubDateMonths)
                        {
                            <option value="@month.Value">@month.Label (@month.Count)</option>
                        }
                    </select>
                </div>

                <div class="search-box">
                    <span>🔎</span>
                    <input placeholder="Search by employee, book, KGEN, LSA, state, database..."
                           @bind="Busqueda"
                           @bind:event="oninput" />
                </div>

                <button type="button"
                        class="btn-export-xlsx"
                        @onclick="ExportarAsignacionesXlsxAsync">
                    📤 Export XLSX
                </button>

                <button type="button" class="btn-filter-clear" @onclick="LimpiarFiltros">
                    Clear
                </button>
            </div>
        </div>

        @if (Cargando)
        {
            <div class="loading-state">
                Loading assignments...
            </div>
        }
        else if (!AsignacionesFiltradas.Any())
        {
            <div class="empty-state">
                <strong>No assignments to display.</strong>
                <span>Create a new assignment or change the search filter.</span>
            </div>
        }
        else
        {
            <div class="table-container">
                <table class="assignments-table">
                    <thead>
                        <tr>
                            <th>Employee</th>
                            <th>Temporary Assignment</th>
                            <th>Book Name</th>
                            <th>KGEN</th>
                            <th>LSA</th>
                            <th>State</th>
                            <th>Database</th>
                            <th>Legacy Code</th>
                            <th>Print Foot</th>
                            <th>Trim Size</th>
                            <th>Bind Plant</th>
                            <th>Pub Date</th>
                            @if (CreateAssignations)
                            {
                                <th></th>
                            }
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in AsignacionesFiltradas)
                        {
                            <tr>
                                <td>
                                    <div class="employee-title">
                                        <strong>@item.EmpleadoNombre</strong>
                                        <span>@item.EmpleadoEmail</span>
                                    </div>
                                </td>

                                <td>
                                    @if (item.TieneAsignacionTemporal)
                                    {
                                        <div class="employee-title">
                                            <strong>@item.EmpleadoTemporalNombre</strong>
                                            <span>Covering: @item.EtapasTemporales</span>
                                            <span>Original: @item.EmpleadoOriginalNombre</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="pill">No temporary assignment</span>
                                    }
                                </td>

                                <td>
                                    <div class="book-title">
                                        <strong>@item.BookName</strong>
                                        <span>@item.ProductIssue</span>
                                    </div>
                                </td>

                                <td>@item.KGENCode</td>
                                <td>@item.LSACode</td>
                                <td><span class="pill">@item.StateName</span></td>
                                <td>@item.DatabaseName</td>
                                <td>@item.LegacyCodeName</td>
                                <td>@item.PrintFootName</td>
                                <td>@item.TrimSizeName</td>
                                <td>@item.BindPlantName</td>
                                <td>@FormatoFecha(item.PubDate)</td>

                                @if (CreateAssignations)
                                {
                                    <td class="actions-cell">
                                        <button type="button"
                                                class="icon-btn danger"
                                                title="Delete"
                                                @onclick="() => EliminarAsignacionAsync(item.Id)">
                                            🗑️
                                        </button>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>

@if (MostrarFormularioTemporal)
{
    <div class="temporary-modal-backdrop">
        <div class="temporary-modal">

            <div class="temporary-modal-header">
                <div>
                    <h2>Temporary Assignment</h2>
                    <p>Select an existing assignment, temporary employee and the stages to cover.</p>
                </div>

                <button type="button"
                        class="temporary-modal-close"
                        @onclick="CerrarFormularioAsignacionTemporal">
                    ✕
                </button>
            </div>

            <div class="form-grid">
                <div class="form-group large">
                    <label>Assignment</label>
                    <select class="form-control"
                            value="@AsignacionTemporalSeleccionadaId"
                            @onchange="OnAsignacionTemporalChanged">
                        <option value="">Select assignment</option>

                        @foreach (var item in AsignacionesListado)
                        {
                            <option value="@item.Id">
                                @item.EmpleadoNombre - @item.BookName - KGEN: @item.KGENCode
                            </option>
                        }
                    </select>
                </div>

                <div class="form-group large">
                    <label>Temporary Employee</label>
                    <select class="form-control"
                            @bind="EmpleadoTemporalSeleccionadoId"
                            disabled="@(AsignacionTemporalSeleccionadaId is null)">
                        <option value="">Select employee</option>

                        @foreach (var empleado in EmpleadosDisponiblesParaTemporal)
                        {
                            <option value="@empleado.Id">
                                @empleado.Nombre | ID: @empleado.IdEmpleado
                            </option>
                        }
                    </select>
                </div>
            </div>

            @if (AsignacionTemporalSeleccionadaId is null)
            {
                <div class="empty-state" style="margin-top: 18px;">
                    <strong>Select an assignment first.</strong>
                    <span>The pending stages will appear here.</span>
                </div>
            }
            else if (!EtapasDisponiblesParaTemporal.Any())
            {
                <div class="empty-state" style="margin-top: 18px;">
                    <strong>No pending stages available.</strong>
                    <span>All stages for this book have already passed or are not applicable.</span>
                </div>
            }
            else
            {
                <div class="temporary-stages">
                    @foreach (var etapa in EtapasDisponiblesParaTemporal)
                    {
                        <label class="temporary-stage-card">
                            <input type="checkbox"
                                   checked="@EtapaSeleccionada(etapa.Codigo)"
                                   @onchange="(e) => CambiarEtapaTemporal(etapa.Codigo, e)" />
                            <strong>@etapa.Nombre</strong>
                        </label>
                    }
                </div>
            }

            <div class="form-grid" style="margin-top: 18px;">
                <div class="form-group large">
                    <label>Reason</label>
                    <input class="form-control"
                           placeholder="Example: Vacation coverage, sick leave, temporary support..."
                           @bind="MotivoTemporal"
                           @bind:event="oninput" />
                </div>
            </div>

            <div class="temporary-modal-actions">
                <button type="button"
                        class="btn-primary"
                        @onclick="GuardarAsignacionTemporalAsync">
                    Save Temporary Assignment
                </button>

                <button type="button"
                        class="btn-secondary"
                        @onclick="CerrarFormularioAsignacionTemporal">
                    Cancel
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<Empleados> Empleados { get; set; } = new();
    private List<Libros> Libros { get; set; } = new();
    private List<AsignacionViewModel> AsignacionesListado { get; set; } = new();

    private List<Bind_Plant> BindPlants { get; set; } = new();
    private List<Database> Databases { get; set; } = new();
    private List<Legacy_Code> LegacyCodes { get; set; } = new();
    private List<Print_Foot> PrintFeet { get; set; } = new();
    private List<State> States { get; set; } = new();
    private List<Trim_Size> TrimSizes { get; set; } = new();

    private string EmpleadoTexto { get; set; } = string.Empty;
    private string LibroTexto { get; set; } = string.Empty;
    private string Busqueda { get; set; } = string.Empty;

    private string Mensaje { get; set; } = string.Empty;
    private string TipoMensaje { get; set; } = "success";

    private ClaimsPrincipal? UsuarioActual { get; set; }
    private bool CreateAssignations { get; set; } = false;

    private bool Cargando { get; set; } = true;
    private bool Guardando { get; set; } = false;
    private bool ImportandoXlsx { get; set; } = false;
    private bool ActualizandoLibrosXlsx { get; set; } = false;
    private Guid XlsxBooksUpdateInputKey { get; set; } = Guid.NewGuid();
    //private DotNetObjectReference<Asignaciones>? _dotNetRef;

    // private bool MostrarModalImportacion { get; set; } = false;
    // private string TituloModalImportacion { get; set; } = string.Empty;
    // private string ResumenModalImportacion { get; set; } = string.Empty;
    // private string TipoModalImportacion { get; set; } = "success";

    private Guid XlsxInputKey { get; set; } = Guid.NewGuid();
    private const long MaxXlsxSize = 20 * 1024 * 1024;
    private bool MostrarFormularioTemporal { get; set; } = false;

    private Guid? AsignacionTemporalSeleccionadaId { get; set; }
    private Guid? EmpleadoTemporalSeleccionadoId { get; set; }

    private bool TempProof { get; set; }
    private bool TempFinal { get; set; }
    private bool TempMemo { get; set; }
    private bool TempFinalPO { get; set; }
    private bool TempShipping { get; set; }
    private bool TempDirxion { get; set; }
    private bool TempPubDate { get; set; }

    private string MotivoTemporal { get; set; } = string.Empty;


    private ImportacionAsignacionesResultado? ResultadoImportacion { get; set; }

    private Empleados? EmpleadoSeleccionado => BuscarEmpleadoSeleccionado();
    private Libros? LibroSeleccionado => BuscarLibroSeleccionado();

    private static readonly string[] RolesPermitidosParaAsignaciones =
    {
        "EMPLOYEE",
        "ASSISTANT"
    };

    private HashSet<Guid> EmpleadosPermitidosAsignacionesIds { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();

        UsuarioActual = authState.User;
        CreateAssignations = HasPermission(UsuarioActual, "CreateAssignations");

        await CargarCatalogosAsync();
        await CargarDatosAsync();
    }

    private bool EtapaSeleccionada(string etapa)
    {
        return etapa switch
        {
            "Proof" => TempProof,
            "Final" => TempFinal,
            "Memo" => TempMemo,
            "FinalPO" => TempFinalPO,
            "Shipping" => TempShipping,
            "Dirxion" => TempDirxion,
            "PubDate" => TempPubDate,
            _ => false
        };
    }

    private async Task<HashSet<Guid>> ObtenerEmpleadosPermitidosParaAsignacionesAsync(AppDbContext db)
    {
        var empleadosIds = await (
            from usuario in db.Users.AsNoTracking()
            join nivel in db.PermissionLevels.AsNoTracking()
                on usuario.lvl_Id equals nivel.Id
            where usuario.Activo &&
                  usuario.EmployeeId != null &&
                  RolesPermitidosParaAsignaciones.Contains(
                      (nivel.Name ?? string.Empty).Trim().ToUpper())
            select usuario.EmployeeId!.Value
        )
        .Distinct()
        .ToListAsync();

        return empleadosIds.ToHashSet();
    }

    private void OnEmpleadoFiltroChanged(ChangeEventArgs e)
    {
        EmpleadoFiltroId = e.Value?.ToString() ?? string.Empty;
        SelectedPubMonth = string.Empty;
    }

    private void CambiarEtapaTemporal(string etapa, ChangeEventArgs e)
    {
        var seleccionado = e.Value is bool value && value;

        switch (etapa)
        {
            case "Proof":
                TempProof = seleccionado;
                break;

            case "Final":
                TempFinal = seleccionado;
                break;

            case "Memo":
                TempMemo = seleccionado;
                break;

            case "FinalPO":
                TempFinalPO = seleccionado;
                break;

            case "Shipping":
                TempShipping = seleccionado;
                break;

            case "Dirxion":
                TempDirxion = seleccionado;
                break;

            case "PubDate":
                TempPubDate = seleccionado;
                break;
        }
    }


    private async Task OnAsignacionTemporalChanged(ChangeEventArgs e)
    {
        EmpleadoTemporalSeleccionadoId = null;

        TempProof = false;
        TempFinal = false;
        TempMemo = false;
        TempFinalPO = false;
        TempShipping = false;
        TempDirxion = false;
        TempPubDate = false;

        var valor = e.Value?.ToString();

        if (Guid.TryParse(valor, out var asignacionId))
        {
            AsignacionTemporalSeleccionadaId = asignacionId;
        }
        else
        {
            AsignacionTemporalSeleccionadaId = null;
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task AbrirFormularioAsignacionTemporal()
    {
        LimpiarFormularioTemporal();
        MostrarFormularioTemporal = true;

        await InvokeAsync(StateHasChanged);
    }

    private async Task CerrarFormularioAsignacionTemporal()
    {
        MostrarFormularioTemporal = false;
        LimpiarFormularioTemporal();

        await InvokeAsync(StateHasChanged);
    }

    private void LimpiarFormularioTemporal()
    {
        AsignacionTemporalSeleccionadaId = null;
        EmpleadoTemporalSeleccionadoId = null;

        TempProof = false;
        TempFinal = false;
        TempMemo = false;
        TempFinalPO = false;
        TempShipping = false;
        TempDirxion = false;
        TempPubDate = false;

        MotivoTemporal = string.Empty;
    }

    // [JSInvokable]
    // public async Task OnAssignmentImportModalClosed()
    // {
    //     await CargarDatosAsync();
    //     await InvokeAsync(StateHasChanged);
    // }

    private static bool HasPermission(ClaimsPrincipal? user, string claimType)
    {
        if (user is null)
            return false;

        return string.Equals(
            user.FindFirst(claimType)?.Value,
            "True",
            StringComparison.OrdinalIgnoreCase);
    }

    private async Task GuardarAsignacionTemporalAsync()
    {
        if (!CreateAssignations)
        {
            MostrarMensaje("You do not have permission to create temporary assignments.", "error");
            return;
        }

        if (AsignacionTemporalSeleccionadaId is null)
        {
            MostrarMensaje("Select an assignment.", "error");
            return;
        }

        if (EmpleadoTemporalSeleccionadoId is null)
        {
            MostrarMensaje("Select a temporary employee.", "error");
            return;
        }

        if (!TempProof &&
            !TempFinal &&
            !TempMemo &&
            !TempFinalPO &&
            !TempShipping &&
            !TempDirxion)
        {
            MostrarMensaje("Select at least one stage.", "error");
            return;
        }

        var etapasPermitidas = EtapasDisponiblesParaTemporal
            .Select(x => x.Codigo)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);

        if (TempProof && !etapasPermitidas.Contains("Proof"))
        {
            MostrarMensaje("Proof is no longer available for temporary assignment.", "error");
            return;
        }

        if (TempFinal && !etapasPermitidas.Contains("Final"))
        {
            MostrarMensaje("Final is no longer available for temporary assignment.", "error");
            return;
        }

        if (TempMemo && !etapasPermitidas.Contains("Memo"))
        {
            MostrarMensaje("Memo is no longer available for temporary assignment.", "error");
            return;
        }

        if (TempFinalPO && !etapasPermitidas.Contains("FinalPO"))
        {
            MostrarMensaje("Final PO is no longer available for temporary assignment.", "error");
            return;
        }

        if (TempShipping && !etapasPermitidas.Contains("Shipping"))
        {
            MostrarMensaje("Shipping is no longer available for temporary assignment.", "error");
            return;
        }

        if (TempDirxion && !etapasPermitidas.Contains("Dirxion"))
        {
            MostrarMensaje("Dirxion is no longer available for temporary assignment.", "error");
            return;
        }

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            var asignacion = await db.Asignaciones
                .Include(x => x.Empleado)
                .Include(x => x.Libro)
                .FirstOrDefaultAsync(x => x.Id == AsignacionTemporalSeleccionadaId.Value);

            if (asignacion is null)
            {
                MostrarMensaje("The selected assignment was not found.", "error");
                return;
            }

            if (asignacion.IdEmpleado == EmpleadoTemporalSeleccionadoId.Value)
            {
                MostrarMensaje("The temporary employee cannot be the same as the original employee.", "error");
                return;
            }

            var empleadosPermitidosIds =
                await ObtenerEmpleadosPermitidosParaAsignacionesAsync(db);

            var empleadoTemporalPermitido =
                empleadosPermitidosIds.Contains(EmpleadoTemporalSeleccionadoId.Value);

            if (!empleadoTemporalPermitido)
            {
                MostrarMensaje("The selected temporary employee is not allowed to work assignments.", "error");
                return;
            }

            var temporalExistente = await db.TemporaryAssignments
                .FirstOrDefaultAsync(x => x.AssignmentId == asignacion.Id && x.Active);

            if (temporalExistente is not null)
            {
                temporalExistente.Active = false;
                temporalExistente.ClosedAt = DateTime.UtcNow;
            }

            var temporal = new TemporaryAssignment
            {
                Id = Guid.NewGuid(),
                AssignmentId = asignacion.Id,
                OriginalEmployeeId = asignacion.IdEmpleado,
                TemporaryEmployeeId = EmpleadoTemporalSeleccionadoId.Value,

                Proof = TempProof,
                Final = TempFinal,
                Memo = TempMemo,
                FinalPO = TempFinalPO,
                Shipping = TempShipping,
                Dirxion = TempDirxion,
                PubDate = false,

                Reason = MotivoTemporal,
                Active = true,
                CreatedAt = DateTime.UtcNow
            };

            db.TemporaryAssignments.Add(temporal);

            await db.SaveChangesAsync();

            MostrarMensaje("Temporary assignment saved successfully.", "success");

            await CerrarFormularioAsignacionTemporal();

            await CargarDatosAsync();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            MostrarMensaje($"Error saving temporary assignment: {ex.Message}", "error");
        }
    }

    private IEnumerable<Empleados> EmpleadosDisponiblesParaTemporal
    {
        get
        {
            IEnumerable<Empleados> query = Empleados;

            if (AsignacionTemporalSeleccionadaId is not null)
            {
                var asignacion = AsignacionesListado
                    .FirstOrDefault(x => x.Id == AsignacionTemporalSeleccionadaId.Value);

                if (asignacion is not null)
                {
                    query = query.Where(x => x.Id != asignacion.EmpleadoId);
                }
            }

            return query.OrderBy(x => x.Nombre);
        }
    }

    private async Task ActualizarAsignacionesTemporalesVencidasAsync(AppDbContext db)
    {
        var hoy = DateOnly.FromDateTime(DateTime.Today);

        var temporales = await db.TemporaryAssignments
            .Include(x => x.Assignment)
                .ThenInclude(a => a!.Libro)
            .Where(x => x.Active &&
                        x.Assignment != null &&
                        x.Assignment.Libro != null)
            .ToListAsync();

        foreach (var temporal in temporales)
        {
            var libro = temporal.Assignment!.Libro!;

            var tieneEtapaPendiente = false;

            if (temporal.Proof && libro.ProofExtract >= hoy)
                tieneEtapaPendiente = true;

            if (temporal.Final && libro.FinalExtract >= hoy)
                tieneEtapaPendiente = true;

            if (temporal.Memo && libro.MemoExtract >= hoy)
                tieneEtapaPendiente = true;

            if (temporal.FinalPO && libro.FinalPODate >= hoy)
                tieneEtapaPendiente = true;

            if (temporal.Shipping && libro.ShippingDate >= hoy)
                tieneEtapaPendiente = true;

            if (temporal.Dirxion && libro.DirxionDate >= hoy)
                tieneEtapaPendiente = true;

            if (!tieneEtapaPendiente)
            {
                temporal.Active = false;
                temporal.ClosedAt = DateTime.UtcNow;
            }
        }

        await db.SaveChangesAsync();
    }

    private async Task<Guid> ObtenerEmpleadoResponsableEtapaAsync(
    AppDbContext db,
    Guid assignmentId,
    string etapa)
    {
        var asignacion = await db.Asignaciones
            .AsNoTracking()
            .FirstOrDefaultAsync(x => x.Id == assignmentId);

        if (asignacion is null)
            return Guid.Empty;

        var temporal = await db.TemporaryAssignments
            .AsNoTracking()
            .Where(x => x.AssignmentId == assignmentId && x.Active)
            .OrderByDescending(x => x.CreatedAt)
            .FirstOrDefaultAsync();

        if (temporal is null)
            return asignacion.IdEmpleado;

        var aplicaTemporal = etapa switch
        {
            "Proof" => temporal.Proof,
            "Final" => temporal.Final,
            "Memo" => temporal.Memo,
            "FinalPO" => temporal.FinalPO,
            "Shipping" => temporal.Shipping,
            "Dirxion" => temporal.Dirxion,
            _ => false
        };

        return aplicaTemporal
            ? temporal.TemporaryEmployeeId
            : asignacion.IdEmpleado;
    }

    private async Task CargarDatosAsync()
    {
        try
        {
            Cargando = true;

            await using var db = await DbFactory.CreateDbContextAsync();

            await ActualizarFinalizadosPorDirxionAsync(db);
            await ActualizarAsignacionesTemporalesVencidasAsync(db);

            EmpleadosPermitidosAsignacionesIds =
                await ObtenerEmpleadosPermitidosParaAsignacionesAsync(db);

            Empleados = await db.Empleados
                .AsNoTracking()
                .Where(x => x.Activo &&
                            EmpleadosPermitidosAsignacionesIds.Contains(x.Id))
                .OrderBy(x => x.Nombre)
                .ToListAsync();

            Libros = await db.Libros
                .AsNoTracking()
                .Where(x =>
                    !x.Finalizado &&
                    !db.Asignaciones.Any(a =>
                        a.IdLibro == x.Id &&
                        !a.Finalizado))
                .OrderBy(x => x.BookName)
                .ToListAsync();

            var asignacionesDb = await db.Asignaciones
                .AsNoTracking()
                .Include(x => x.Empleado)
                .Include(x => x.Libro)
                .Where(x => !x.Finalizado &&
                            x.Libro != null &&
                            !x.Libro.Finalizado)
                .OrderBy(x => x.Empleado!.Nombre)
                .ThenBy(x => x.Libro!.BookName)
                .ToListAsync();

            var asignacionIds = asignacionesDb
                .Select(x => x.Id)
                .ToList();

            var temporalesDb = await db.TemporaryAssignments
                .AsNoTracking()
                .Include(x => x.TemporaryEmployee)
                .Where(x => x.Active && asignacionIds.Contains(x.AssignmentId))
                .ToListAsync();

            AsignacionesListado = asignacionesDb.Select(x =>
            {
                var temporal = temporalesDb
                    .Where(t => t.AssignmentId == x.Id)
                    .OrderByDescending(t => t.CreatedAt)
                    .FirstOrDefault();

                return new AsignacionViewModel
                {
                    Id = x.Id,

                    EmpleadoId = x.IdEmpleado,
                    EmpleadoNombre = x.Empleado?.Nombre ?? string.Empty,
                    EmpleadoCodigo = x.Empleado?.IdEmpleado ?? 0,
                    EmpleadoEmail = x.Empleado?.Email ?? string.Empty,

                    LibroId = x.IdLibro,
                    BookName = x.Libro?.BookName ?? string.Empty,
                    KGENCode = x.Libro?.KGENCode ?? string.Empty,
                    LSACode = x.Libro?.LSACode ?? string.Empty,
                    ProductIssue = x.Libro?.ProductIssue ?? string.Empty,

                    StateName = GetStateName(x.Libro?.StateId),
                    DatabaseName = GetDatabaseName(x.Libro?.DatabaseId),
                    LegacyCodeName = GetLegacyCodeName(x.Libro?.LegacyCodeId),
                    PrintFootName = GetPrintFootName(x.Libro?.PrintFootId),
                    TrimSizeName = GetTrimSizeName(x.Libro?.TrimSizeId),
                    BindPlantName = GetBindPlantName(x.Libro?.BindPlantId),

                    PubDate = x.Libro?.PubDate ?? default,

                    ProofExtract = x.Libro?.ProofExtract ?? default,
                    FinalExtract = x.Libro?.FinalExtract ?? default,
                    MemoExtract = x.Libro?.MemoExtract ?? default,
                    FinalPODate = x.Libro?.FinalPODate ?? default,
                    ShippingDate = x.Libro?.ShippingDate ?? default,
                    DirxionDate = x.Libro?.DirxionDate ?? default,
                    PubDateValue = x.Libro?.PubDate ?? default,

                    BindPlantCode = GetBindPlantName(x.Libro?.BindPlantId),

                    TieneAsignacionTemporal = temporal is not null,
                    EmpleadoOriginalNombre = x.Empleado?.Nombre ?? string.Empty,
                    EmpleadoTemporalNombre = temporal?.TemporaryEmployee?.Nombre ?? string.Empty,
                    EtapasTemporales = temporal is null ? string.Empty : GetEtapasTemporalesTexto(temporal)
                };
            }).ToList();
        }
        catch (Exception ex)
        {
            MostrarMensaje($"Error loading assignments: {ex.Message}", "error");
        }
        finally
        {
            Cargando = false;
        }
    }

    private sealed class EtapaTemporalDisponible
    {
        public string Codigo { get; set; } = string.Empty;
        public string Nombre { get; set; } = string.Empty;
        public DateOnly Fecha { get; set; }
    }

    private IEnumerable<EtapaTemporalDisponible> EtapasDisponiblesParaTemporal
    {
        get
        {
            if (AsignacionTemporalSeleccionadaId is null)
                return Enumerable.Empty<EtapaTemporalDisponible>();

            var asignacion = AsignacionesListado
                .FirstOrDefault(x => x.Id == AsignacionTemporalSeleccionadaId.Value);

            if (asignacion is null)
                return Enumerable.Empty<EtapaTemporalDisponible>();

            var hoy = DateOnly.FromDateTime(DateTime.Today);

            var bindPlant = Normalizar(asignacion.BindPlantCode);

            var omitirMemo =
                bindPlant.Contains("PREM") ||
                bindPlant.Contains("DIRX") ||
                bindPlant.Contains("AU") ||
                bindPlant.Contains("NZ");

            var etapas = new List<EtapaTemporalDisponible>();

            if (FechaPendiente(asignacion.ProofExtract, hoy))
            {
                etapas.Add(new EtapaTemporalDisponible
                {
                    Codigo = "Proof",
                    Nombre = $"Proof - {FormatoFecha(asignacion.ProofExtract)}",
                    Fecha = asignacion.ProofExtract
                });
            }

            if (FechaPendiente(asignacion.FinalExtract, hoy))
            {
                etapas.Add(new EtapaTemporalDisponible
                {
                    Codigo = "Final",
                    Nombre = $"Final - {FormatoFecha(asignacion.FinalExtract)}",
                    Fecha = asignacion.FinalExtract
                });
            }

            if (!omitirMemo && FechaPendiente(asignacion.MemoExtract, hoy))
            {
                etapas.Add(new EtapaTemporalDisponible
                {
                    Codigo = "Memo",
                    Nombre = $"Memo - {FormatoFecha(asignacion.MemoExtract)}",
                    Fecha = asignacion.MemoExtract
                });
            }

            if (FechaPendiente(asignacion.FinalPODate, hoy))
            {
                etapas.Add(new EtapaTemporalDisponible
                {
                    Codigo = "FinalPO",
                    Nombre = $"Final PO - {FormatoFecha(asignacion.FinalPODate)}",
                    Fecha = asignacion.FinalPODate
                });
            }

            if (FechaPendiente(asignacion.ShippingDate, hoy))
            {
                etapas.Add(new EtapaTemporalDisponible
                {
                    Codigo = "Shipping",
                    Nombre = $"Shipping - {FormatoFecha(asignacion.ShippingDate)}",
                    Fecha = asignacion.ShippingDate
                });
            }

            if (FechaPendiente(asignacion.DirxionDate, hoy))
            {
                etapas.Add(new EtapaTemporalDisponible
                {
                    Codigo = "Dirxion",
                    Nombre = $"Dirxion - {FormatoFecha(asignacion.DirxionDate)}",
                    Fecha = asignacion.DirxionDate
                });
            }

            return etapas
                .OrderBy(x => x.Fecha)
                .ToList();
        }
    }

    private static bool FechaPendiente(DateOnly fecha, DateOnly hoy)
    {
        return fecha != default && fecha >= hoy;
    }

    private static string GetEtapasTemporalesTexto(TemporaryAssignment temporal)
    {
        var etapas = new List<string>();

        if (temporal.Proof)
            etapas.Add("Proof");

        if (temporal.Final)
            etapas.Add("Final");

        if (temporal.Memo)
            etapas.Add("Memo");

        if (temporal.FinalPO)
            etapas.Add("Final PO");

        if (temporal.Shipping)
            etapas.Add("Shipping");

        if (temporal.Dirxion)
            etapas.Add("Dirxion");

        return etapas.Any() ? string.Join(", ", etapas) : "-";
    }

