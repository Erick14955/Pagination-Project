    private IEnumerable<AsignacionViewModel> EmpleadosParaFiltro
    {
        get
        {
            return AsignacionesListado
                .GroupBy(x => x.EmpleadoId)
                .Select(g => g.First())
                .OrderBy(x => x.EmpleadoNombre);
        }
    }

