    private async Task BuscarAsignacionTemporalAsync()
    {
        EmpleadoTemporalSeleccionadoId = null;
        LimpiarEtapasTemporales();

        var filtro = TextoBusquedaAsignacionTemporal?.Trim();

        if (string.IsNullOrWhiteSpace(filtro))
        {
            AsignacionTemporalSeleccionadaId = null;
            MostrarMensaje("Enter a KGEN Code or LSA Code.", "error");
            await InvokeAsync(StateHasChanged);
            return;
        }

        var filtroNormalizado = Normalizar(filtro);

        var asignacion = AsignacionesListado
            .Where(x =>
                Normalizar(x.KGENCode) == filtroNormalizado ||
                Normalizar(x.LSACode) == filtroNormalizado)
            .OrderBy(x => x.EmpleadoNombre)
            .ThenBy(x => x.BookName)
            .FirstOrDefault();

        asignacion ??= AsignacionesListado
            .Where(x =>
                Normalizar(x.KGENCode).Contains(filtroNormalizado) ||
                Normalizar(x.LSACode).Contains(filtroNormalizado))
            .OrderBy(x => x.EmpleadoNombre)
            .ThenBy(x => x.BookName)
            .FirstOrDefault();

        if (asignacion is null)
        {
            AsignacionTemporalSeleccionadaId = null;
            MostrarMensaje("No assignment was found with that KGEN Code or LSA Code.", "error");
            await InvokeAsync(StateHasChanged);
            return;
        }

        AsignacionTemporalSeleccionadaId = asignacion.Id;

        TextoBusquedaAsignacionTemporal = !string.IsNullOrWhiteSpace(asignacion.KGENCode)
            ? asignacion.KGENCode
            : asignacion.LSACode;

        LimpiarMensaje();

        await InvokeAsync(StateHasChanged);
    }

    private void LimpiarEtapasTemporales()
    {
        TempProof = false;
        TempFinal = false;
        TempMemo = false;
        TempFinalPO = false;
        TempShipping = false;
        TempDirxion = false;
        TempPubDate = false;
    }

    private async Task AbrirFormularioAsignacionTemporal()
    {
        LimpiarFormularioTemporal();

        MostrarFormularioTemporal = true;
        AbrirTemporalPortalPendiente = true;

        await InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_cargaInicialIniciada)
        {
            _cargaInicialIniciada = true;
            await CargarPaginaInicialAsync();
            return;
        }

        if (AbrirTemporalPortalPendiente && MostrarFormularioTemporal)
        {
            AbrirTemporalPortalPendiente = false;

            await JS.InvokeVoidAsync(
                "thryvModalPortal.open",
                TemporaryAssignmentModalId);
        }
    }

    private async Task CargarPaginaInicialAsync()
    {
        CargandoInicial = true;
        Cargando = true;

        try
        {
            await Task.Yield();

            var authState =
                await AuthenticationStateProvider.GetAuthenticationStateAsync();

            UsuarioActual = authState.User;

            if (UsuarioActual.Identity?.IsAuthenticated != true)
            {
                return;
            }

            Scope =
                await UserDataScopeService.GetScopeAsync(UsuarioActual);

            CreateAssignations =
                HasPermission(UsuarioActual, "CreateAssignations");

            await CargarCatalogosAsync();
            await CargarDatosAsync();
        }
        catch (Exception ex)
        {
            MostrarMensaje(
                $"Error loading assignments: {ex.Message}",
                "error");
        }
        finally
        {
            Cargando = false;
            CargandoInicial = false;

            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task CerrarFormularioAsignacionTemporal()
    {
        try
        {
            await JS.InvokeVoidAsync(
                "thryvModalPortal.close",
                TemporaryAssignmentModalId);
        }
        catch
        {
            await JS.InvokeVoidAsync("thryvModalPortal.forceClose");
        }

        MostrarFormularioTemporal = false;
        AbrirTemporalPortalPendiente = false;

        LimpiarFormularioTemporal();

        await InvokeAsync(StateHasChanged);
    }

    private void LimpiarFormularioTemporal()
    {
        TextoBusquedaAsignacionTemporal = string.Empty;

        AsignacionTemporalSeleccionadaId = null;
        EmpleadoTemporalSeleccionadoId = null;

        LimpiarEtapasTemporales();

        MotivoTemporal = string.Empty;
    }

