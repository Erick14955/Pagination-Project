    private void LimpiarFiltros()
    {
        Busqueda = string.Empty;
        EmpleadoFiltroId = string.Empty;
        SelectedPubMonth = string.Empty;
        FechaDesdeFiltro = null;
        FechaHastaFiltro = null;
    }

    private IEnumerable<PubMonthOption> PubDateMonths
    {
        get
        {
            IEnumerable<AsignacionViewModel> query = AsignacionesListado;

            if (!string.IsNullOrWhiteSpace(EmpleadoFiltroId) &&
                Guid.TryParse(EmpleadoFiltroId, out var empleadoId))
            {
                query = query.Where(x => x.EmpleadoId == empleadoId);
            }

            return query
                .Where(x => x.PubDate != default)
                .GroupBy(x => GetPubMonthValue(x.PubDate))
                .Select(g =>
                {
                    var firstDate = g.First().PubDate;

                    return new PubMonthOption
                    {
                        Value = g.Key,
                        Label = GetPubMonthLabel(firstDate),
                        Count = g.Count()
                    };
                })
                .OrderByDescending(x => x.Value)
                .ToList();
        }
    }

    private async Task ExportarAsignacionesXlsxAsync()
    {
        try
        {
            LimpiarMensaje();

            var datos = AsignacionesFiltradas.ToList();

            if (!datos.Any())
            {
                MostrarMensaje("There are no assignments to export.", "error");
                return;
            }

            await using var db = await DbFactory.CreateDbContextAsync();

            var asignacionIds = datos.Select(x => x.Id).ToList();

            var asignacionesCompletas = await db.Asignaciones
                .AsNoTracking()
                .ApplyScope(Scope)
                .Include(x => x.Empleado)
                .Include(x => x.Libro)
                    .ThenInclude(l => l!.EmployeeType)
                .Where(x => asignacionIds.Contains(x.Id))
                .OrderBy(x => x.Empleado!.Nombre)
                .ThenBy(x => x.Libro!.BookName)
                .ToListAsync();

            using var workbook = new XLWorkbook();
            var worksheet = workbook.Worksheets.Add("Assignments");

            const int lastColumn = 22;

            var empleadoFiltroTexto = "All Employees";

            if (!string.IsNullOrWhiteSpace(EmpleadoFiltroId) &&
                Guid.TryParse(EmpleadoFiltroId, out var empleadoId))
            {
                empleadoFiltroTexto = datos
                    .FirstOrDefault(x => x.EmpleadoId == empleadoId)?
                    .EmpleadoNombre ?? "Employee";
            }

            var pubDateFiltroTexto = string.IsNullOrWhiteSpace(SelectedPubMonth)
                ? "All Pub Dates"
                : PubDateMonths.FirstOrDefault(x => x.Value == SelectedPubMonth)?.Label ?? SelectedPubMonth;

            var fechaDesdeTexto = FechaDesdeFiltro.HasValue
                ? FormatoFecha(FechaDesdeFiltro.Value)
                : "All";

            var fechaHastaTexto = FechaHastaFiltro.HasValue
                ? FormatoFecha(FechaHastaFiltro.Value)
                : "All";

            worksheet.Cell(1, 1).Value = "Assignments Export";
            worksheet.Range(1, 1, 1, lastColumn).Merge();

            worksheet.Cell(2, 1).Value = $"Generated: {DateTime.Now:MM/dd/yyyy hh:mm tt}";
            worksheet.Range(2, 1, 2, lastColumn).Merge();

            worksheet.Cell(3, 1).Value =
                $"Employee: {empleadoFiltroTexto} | " +
                $"Pub Date Month: {pubDateFiltroTexto} | " +
                $"Stage Dates From: {fechaDesdeTexto} | " +
                $"Stage Dates To: {fechaHastaTexto} | " +
                $"Search: {(string.IsNullOrWhiteSpace(Busqueda) ? "All" : Busqueda)} | " +
                $"Total: {asignacionesCompletas.Count}";

            worksheet.Range(3, 1, 3, lastColumn).Merge();

            var headerRow = 5;

            worksheet.Cell(headerRow, 1).Value = "employee_type";
            worksheet.Cell(headerRow, 2).Value = "Employee ID";
            worksheet.Cell(headerRow, 3).Value = "Employee";
            worksheet.Cell(headerRow, 4).Value = "Book Name";
            worksheet.Cell(headerRow, 5).Value = "KGEN";
            worksheet.Cell(headerRow, 6).Value = "LSA";
            worksheet.Cell(headerRow, 7).Value = "Product Issue";
            worksheet.Cell(headerRow, 8).Value = "State";
            worksheet.Cell(headerRow, 9).Value = "Database";
            worksheet.Cell(headerRow, 10).Value = "Legacy Code";
            worksheet.Cell(headerRow, 11).Value = "Print Foot";
            worksheet.Cell(headerRow, 12).Value = "Trim Size";
            worksheet.Cell(headerRow, 13).Value = "Bind Plant";
            worksheet.Cell(headerRow, 14).Value = "Proof Extract";
            worksheet.Cell(headerRow, 15).Value = "Final Extract";
            worksheet.Cell(headerRow, 16).Value = "Memo Extract";
            worksheet.Cell(headerRow, 17).Value = "Final PO Date";
            worksheet.Cell(headerRow, 18).Value = "Shipping Date";
            worksheet.Cell(headerRow, 19).Value = "Dirxion Date";
            worksheet.Cell(headerRow, 20).Value = "Pub Date";
            worksheet.Cell(headerRow, 21).Value = "SRL Suppression";
            worksheet.Cell(headerRow, 22).Value = "NWP";

            var row = headerRow + 1;

            foreach (var asignacion in asignacionesCompletas)
            {
                var libro = asignacion.Libro;

                worksheet.Cell(row, 1).Value = libro is null ? string.Empty : GetEmployeeTypeCode(libro.EmployeeTypeId);
                worksheet.Cell(row, 2).Value = asignacion.Empleado?.IdEmpleado ?? 0;
                worksheet.Cell(row, 3).Value = asignacion.Empleado?.Nombre ?? "-";
                worksheet.Cell(row, 4).Value = libro?.BookName ?? "-";
                worksheet.Cell(row, 5).Value = libro?.KGENCode ?? "-";
                worksheet.Cell(row, 6).Value = libro?.LSACode ?? "-";
                worksheet.Cell(row, 7).Value = libro?.ProductIssue ?? "-";
                worksheet.Cell(row, 8).Value = GetStateName(libro?.StateId);
                worksheet.Cell(row, 9).Value = GetDatabaseName(libro?.DatabaseId);
                worksheet.Cell(row, 10).Value = GetLegacyCodeName(libro?.LegacyCodeId);
                worksheet.Cell(row, 11).Value = GetPrintFootName(libro?.PrintFootId);
                worksheet.Cell(row, 12).Value = GetTrimSizeName(libro?.TrimSizeId);
                worksheet.Cell(row, 13).Value = GetBindPlantName(libro?.BindPlantId);

                EscribirFechaExcel(worksheet.Cell(row, 14), libro?.ProofExtract);
                EscribirFechaExcel(worksheet.Cell(row, 15), libro?.FinalExtract);
                EscribirFechaExcel(worksheet.Cell(row, 16), libro?.MemoExtract);
                EscribirFechaExcel(worksheet.Cell(row, 17), libro?.FinalPODate);
                EscribirFechaExcel(worksheet.Cell(row, 18), libro?.ShippingDate);
                EscribirFechaExcel(worksheet.Cell(row, 19), libro?.DirxionDate);
                EscribirFechaExcel(worksheet.Cell(row, 20), libro?.PubDate);

                worksheet.Cell(row, 21).Value = libro?.SRLSuppression == true ? "Yes" : "No";
                worksheet.Cell(row, 22).Value = libro?.NWP == true ? "Yes" : "No";

                row++;
