        SelectedPubMonth = string.Empty;
    }

    private IEnumerable<PubMonthOption> PubDateMonths
    {
        get
        {
            IEnumerable<AsignacionViewModel> query = AsignacionesListado;

            if (!string.IsNullOrWhiteSpace(EmpleadoFiltroId) &&
                Guid.TryParse(EmpleadoFiltroId, out var empleadoId))
            {
                query = query.Where(x => x.EmpleadoId == empleadoId);
            }

            return query
                .Where(x => x.PubDate != default)
                .GroupBy(x => GetPubMonthValue(x.PubDate))
                .Select(g =>
                {
                    var firstDate = g.First().PubDate;

                    return new PubMonthOption
                    {
                        Value = g.Key,
                        Label = GetPubMonthLabel(firstDate),
                        Count = g.Count()
                    };
                })
                .OrderByDescending(x => x.Value)
                .ToList();
        }
    }

    private async Task ExportarAsignacionesXlsxAsync()
    {
        try
        {
            LimpiarMensaje();

            var datos = AsignacionesFiltradas.ToList();

            if (!datos.Any())
            {
                MostrarMensaje("There are no assignments to export.", "error");
                return;
            }

            await using var db = await DbFactory.CreateDbContextAsync();

            var asignacionIds = datos.Select(x => x.Id).ToList();

            var asignacionesCompletas = await db.Asignaciones
                .AsNoTracking()
                .Include(x => x.Empleado)
                .Include(x => x.Libro)
                .Where(x => asignacionIds.Contains(x.Id))
                .OrderBy(x => x.Empleado!.Nombre)
                .ThenBy(x => x.Libro!.BookName)
                .ToListAsync();

            using var workbook = new XLWorkbook();
            var worksheet = workbook.Worksheets.Add("Assignments");

            const int lastColumn = 20;

            var empleadoFiltroTexto = "All Employees";

            if (!string.IsNullOrWhiteSpace(EmpleadoFiltroId) &&
                Guid.TryParse(EmpleadoFiltroId, out var empleadoId))
            {
                empleadoFiltroTexto = datos
                    .FirstOrDefault(x => x.EmpleadoId == empleadoId)?
                    .EmpleadoNombre ?? "Employee";
            }

            var pubDateFiltroTexto = string.IsNullOrWhiteSpace(SelectedPubMonth)
                ? "All Pub Dates"
                : PubDateMonths.FirstOrDefault(x => x.Value == SelectedPubMonth)?.Label ?? SelectedPubMonth;

            worksheet.Cell(1, 1).Value = "Assignments Export";
            worksheet.Range(1, 1, 1, lastColumn).Merge();

            worksheet.Cell(2, 1).Value = $"Generated: {DateTime.Now:MM/dd/yyyy hh:mm tt}";
            worksheet.Range(2, 1, 2, lastColumn).Merge();

            worksheet.Cell(3, 1).Value =
                $"Employee: {empleadoFiltroTexto} | " +
                $"Pub Date Month: {pubDateFiltroTexto} | " +
                $"Search: {(string.IsNullOrWhiteSpace(Busqueda) ? "All" : Busqueda)} | " +
                $"Total: {asignacionesCompletas.Count}";

            worksheet.Range(3, 1, 3, lastColumn).Merge();

            var headerRow = 5;

            worksheet.Cell(headerRow, 1).Value = "Employee";
            worksheet.Cell(headerRow, 2).Value = "Book Name";
            worksheet.Cell(headerRow, 3).Value = "KGEN";
            worksheet.Cell(headerRow, 4).Value = "LSA";
            worksheet.Cell(headerRow, 5).Value = "Product Issue";
            worksheet.Cell(headerRow, 6).Value = "State";
            worksheet.Cell(headerRow, 7).Value = "Database";
            worksheet.Cell(headerRow, 8).Value = "Legacy Code";
            worksheet.Cell(headerRow, 9).Value = "Print Foot";
            worksheet.Cell(headerRow, 10).Value = "Trim Size";
            worksheet.Cell(headerRow, 11).Value = "Bind Plant";
            worksheet.Cell(headerRow, 12).Value = "Proof Extract";
            worksheet.Cell(headerRow, 13).Value = "Final Extract";
            worksheet.Cell(headerRow, 14).Value = "Memo Extract";
            worksheet.Cell(headerRow, 15).Value = "Final PO Date";
            worksheet.Cell(headerRow, 16).Value = "Shipping Date";
            worksheet.Cell(headerRow, 17).Value = "Dirxion Date";
            worksheet.Cell(headerRow, 18).Value = "Pub Date";
            worksheet.Cell(headerRow, 19).Value = "SRL Suppression";
            worksheet.Cell(headerRow, 20).Value = "NWP";

            var row = headerRow + 1;

            foreach (var asignacion in asignacionesCompletas)
            {
                var libro = asignacion.Libro;

                worksheet.Cell(row, 1).Value = asignacion.Empleado?.Nombre ?? "-";
                worksheet.Cell(row, 2).Value = libro?.BookName ?? "-";
                worksheet.Cell(row, 3).Value = libro?.KGENCode ?? "-";
                worksheet.Cell(row, 4).Value = libro?.LSACode ?? "-";
                worksheet.Cell(row, 5).Value = libro?.ProductIssue ?? "-";
                worksheet.Cell(row, 6).Value = GetStateName(libro?.StateId);
                worksheet.Cell(row, 7).Value = GetDatabaseName(libro?.DatabaseId);
                worksheet.Cell(row, 8).Value = GetLegacyCodeName(libro?.LegacyCodeId);
                worksheet.Cell(row, 9).Value = GetPrintFootName(libro?.PrintFootId);
                worksheet.Cell(row, 10).Value = GetTrimSizeName(libro?.TrimSizeId);
                worksheet.Cell(row, 11).Value = GetBindPlantName(libro?.BindPlantId);

                EscribirFechaExcel(worksheet.Cell(row, 12), libro?.ProofExtract);
                EscribirFechaExcel(worksheet.Cell(row, 13), libro?.FinalExtract);
                EscribirFechaExcel(worksheet.Cell(row, 14), libro?.MemoExtract);
                EscribirFechaExcel(worksheet.Cell(row, 15), libro?.FinalPODate);
                EscribirFechaExcel(worksheet.Cell(row, 16), libro?.ShippingDate);
                EscribirFechaExcel(worksheet.Cell(row, 17), libro?.DirxionDate);
                EscribirFechaExcel(worksheet.Cell(row, 18), libro?.PubDate);

                worksheet.Cell(row, 19).Value = libro?.SRLSuppression == true ? "Yes" : "No";
                worksheet.Cell(row, 20).Value = libro?.NWP == true ? "Yes" : "No";

                row++;
            }

            var titleRange = worksheet.Range(1, 1, 1, lastColumn);
            titleRange.Style.Font.Bold = true;
            titleRange.Style.Font.FontSize = 16;
            titleRange.Style.Alignment.Horizontal = XLAlignmentHorizontalValues.Center;

            worksheet.Range(2, 1, 3, lastColumn).Style.Font.Italic = true;
            worksheet.Range(2, 1, 3, lastColumn).Style.Alignment.Horizontal = XLAlignmentHorizontalValues.Center;

            var header = worksheet.Range(headerRow, 1, headerRow, lastColumn);
            header.Style.Font.Bold = true;
            header.Style.Fill.BackgroundColor = XLColor.FromHtml("#111827");
            header.Style.Font.FontColor = XLColor.White;
            header.Style.Alignment.Horizontal = XLAlignmentHorizontalValues.Center;

            var dataRange = worksheet.Range(headerRow, 1, row - 1, lastColumn);
            dataRange.Style.Border.OutsideBorder = XLBorderStyleValues.Thin;
            dataRange.Style.Border.InsideBorder = XLBorderStyleValues.Thin;
            dataRange.Style.Alignment.Vertical = XLAlignmentVerticalValues.Center;

            worksheet.Range(headerRow + 1, 12, row - 1, 18).Style.DateFormat.Format = "MM/dd/yyyy";

            worksheet.Columns().AdjustToContents();
            worksheet.SheetView.FreezeRows(headerRow);

            using var stream = new MemoryStream();
            workbook.SaveAs(stream);

            var bytes = stream.ToArray();
            var base64 = Convert.ToBase64String(bytes);

            var empleadoNombreArchivo = LimpiarNombreArchivo(empleadoFiltroTexto);
            var pubDateArchivo = string.IsNullOrWhiteSpace(SelectedPubMonth)
                ? "AllPubDates"
                : SelectedPubMonth.Replace("-", "");

            var fileName = $"Assignments_{empleadoNombreArchivo}_{pubDateArchivo}_{DateTime.Now:yyyyMMdd_HHmmss}.xlsx";

            await JS.InvokeVoidAsync(
                "downloadFileFromBase64",
                fileName,
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
                base64);

            MostrarMensaje($"XLSX file generated successfully. Total: {asignacionesCompletas.Count}.", "success");
        }
        catch (Exception ex)
        {
            MostrarMensaje($"Error exporting XLSX file: {ex.Message}", "error");
        }
    }

    private static void EscribirFechaExcel(IXLCell cell, DateOnly? fecha)
    {
        if (fecha is null || fecha.Value == default)
        {
            cell.Value = "-";
            return;
        }

        cell.Value = fecha.Value.ToDateTime(TimeOnly.MinValue);
        cell.Style.DateFormat.Format = "MM/dd/yyyy";
    }

    private static string LimpiarNombreArchivo(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return "Export";

        var invalidChars = Path.GetInvalidFileNameChars();

        var clean = new string(value
            .Where(c => !invalidChars.Contains(c))
            .ToArray());

        clean = clean.Replace(" ", "_");

        return string.IsNullOrWhiteSpace(clean) ? "Export" : clean;
    }

    private static Dictionary<string, int> BuildHeaderMap(IXLRow headerRow)
    {
        var map = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);

        foreach (var cell in headerRow.CellsUsed())
        {
            var header = NormalizeHeader(cell.GetString());

            if (!string.IsNullOrWhiteSpace(header) && !map.ContainsKey(header))
            {
                map.Add(header, cell.Address.ColumnNumber);
            }
        }

        return map;
    }

    private static bool HeaderExists(Dictionary<string, int> headerMap, params string[] names)
    {
        return names.Any(name => headerMap.ContainsKey(NormalizeHeader(name)));
    }

    private static string NormalizeHeader(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return string.Empty;

        return new string(value
            .Where(char.IsLetterOrDigit)
            .Select(char.ToLowerInvariant)
            .ToArray());
    }

    private static IXLCell? GetCell(IXLRow row, Dictionary<string, int> headerMap, params string[] names)
    {
        foreach (var name in names)
        {
            var key = NormalizeHeader(name);

            if (headerMap.TryGetValue(key, out var columnNumber))
                return row.Cell(columnNumber);
        }

        return null;
    }

    private static string ReadText(IXLRow row, Dictionary<string, int> headerMap, params string[] names)
    {
        var cell = GetCell(row, headerMap, names);

        if (cell is null || cell.IsEmpty())
            return string.Empty;

        var formatted = cell.GetFormattedString()?.Trim();

        if (!string.IsNullOrWhiteSpace(formatted))
            return formatted;

        if (cell.TryGetValue<double>(out var numberValue))
        {
            if (Math.Abs(numberValue % 1) < 0.0000001)
                return Convert.ToInt64(numberValue).ToString(CultureInfo.InvariantCulture);

            return numberValue.ToString(CultureInfo.InvariantCulture);
        }

        return cell.GetString().Trim();
    }

    private static DateOnly ReadDate(IXLRow row, Dictionary<string, int> headerMap, DateOnly defaultValue, params string[] names)
    {
        var cell = GetCell(row, headerMap, names);

        if (cell is null || cell.IsEmpty())
            return defaultValue;

        if (cell.TryGetValue<DateTime>(out var dateTime))
            return DateOnly.FromDateTime(dateTime);

        if (cell.TryGetValue<double>(out var numberValue))
        {
            try
            {
                var excelDate = DateTime.FromOADate(numberValue);
                return DateOnly.FromDateTime(excelDate);
            }
            catch
            {
                return defaultValue;
            }
        }

        var text = cell.GetFormattedString()?.Trim();

        if (string.IsNullOrWhiteSpace(text))
            text = cell.GetString().Trim();

        string[] formats =
        {
            "MM/dd/yyyy",
            "M/d/yyyy",
            "yyyy-MM-dd",
            "dd/MM/yyyy",
            "d/M/yyyy",
            "M/d/yy",
            "MM/dd/yy",
            "dd/MM/yy",
            "d/M/yy"
        };

        if (DateOnly.TryParseExact(text, formats, CultureInfo.InvariantCulture, DateTimeStyles.None, out var exactDate))
            return exactDate;

        if (DateOnly.TryParse(text, CultureInfo.InvariantCulture, DateTimeStyles.None, out var parsedDate))
            return parsedDate;

        if (DateOnly.TryParse(text, CultureInfo.CurrentCulture, DateTimeStyles.None, out var currentCultureDate))
            return currentCultureDate;

        return defaultValue;
    }

    private static DateOnly ReadDateWithValidation(
        IXLRow row,
        Dictionary<string, int> headerMap,
        DateOnly defaultValue,
        List<string> errors,
        int rowNumber,
        bool required,
        params string[] names)
    {
        var cell = GetCell(row, headerMap, names);
        var columnName = names.FirstOrDefault() ?? "Date";

        if (cell is null || cell.IsEmpty())
        {
            if (required)
            {
                errors.Add($"Row {rowNumber}: The column '{columnName}' is required and is empty.");
            }

            return defaultValue;
        }

        if (cell.TryGetValue<DateTime>(out var dateTime))
            return DateOnly.FromDateTime(dateTime);

        if (cell.TryGetValue<double>(out var numberValue))
        {
            try
            {
                var excelDate = DateTime.FromOADate(numberValue);
                return DateOnly.FromDateTime(excelDate);
            }
            catch
            {
                errors.Add($"Row {rowNumber}: The value in column '{columnName}' is not a valid Excel date.");
                return defaultValue;
            }
        }

        var text = cell.GetFormattedString()?.Trim();

        if (string.IsNullOrWhiteSpace(text))
            text = cell.GetString().Trim();

        if (string.IsNullOrWhiteSpace(text))
        {
            if (required)
            {
                errors.Add($"Row {rowNumber}: The column '{columnName}' is required and is empty.");
            }

            return defaultValue;
        }

        string[] formats =
        {
            "MM/dd/yyyy",
            "M/d/yyyy",
            "yyyy-MM-dd",
            "dd/MM/yyyy",
            "d/M/yyyy",
            "M/d/yy",
            "MM/dd/yy",
            "dd/MM/yy",
            "d/M/yy"
        };

        if (DateOnly.TryParseExact(text, formats, CultureInfo.InvariantCulture, DateTimeStyles.None, out var exactDate))
            return exactDate;

        if (DateOnly.TryParse(text, CultureInfo.InvariantCulture, DateTimeStyles.None, out var parsedDate))
            return parsedDate;

        if (DateOnly.TryParse(text, CultureInfo.CurrentCulture, DateTimeStyles.None, out var currentCultureDate))
            return currentCultureDate;

        errors.Add($"Row {rowNumber}: The value '{text}' in column '{columnName}' is not a valid date.");

        return defaultValue;
    }

    private static bool ReadYesNoBool(IXLRow row, Dictionary<string, int> headerMap, params string[] names)
    {
        var cell = GetCell(row, headerMap, names);

        if (cell is null || cell.IsEmpty())
            return false;

        if (cell.TryGetValue<bool>(out var boolValue))
            return boolValue;

        var text = cell.GetFormattedString()?.Trim().ToUpperInvariant();

        if (string.IsNullOrWhiteSpace(text))
            text = cell.GetString().Trim().ToUpperInvariant();

        return text is "Y" or "YES" or "TRUE" or "1" or "X";
    }

    private static DateOnly CalculateFinalPoDate(DateOnly firstDuePrinter)
    {
        var candidate = firstDuePrinter.AddDays(-1);

        while (candidate.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday)
        {
            candidate = candidate.AddDays(-1);
        }

        return candidate;
    }

    private void AddCatalogWarningIfNeeded(List<string> warnings, int rowNumber, string catalogName, string value, Guid? id)
    {
        if (string.IsNullOrWhiteSpace(value))
