@page "/forgot-password"
@inject NavigationManager Navigation
@inject Pagination_Project.Services.IPasswordResetService PasswordResetService
@layout Pagination_Project.Components.Layout.LoginLayout

<PageTitle>Forgot Password</PageTitle>

<div class="thryv-login-page">
    <div class="thryv-login-card">
        <div class="thryv-login-panel">
            <div class="thryv-logo-row">
                <div class="thryv-logo-mark">T</div>
                <div class="thryv-logo-text">
                    <strong>Evaluations</strong>
                    <span>Password recovery</span>
                </div>
            </div>

            <h2 class="thryv-login-title">Recover password</h2>

            <p class="thryv-login-subtitle">
                Enter your username. If the account exists, we will send a recovery link to your registered email.
            </p>

            <form @onsubmit="EnviarRecuperacion" @onsubmit:preventDefault="true">
                <div class="thryv-form-group">
                    <label>Username</label>
                    <input @bind="_username"
                           class="thryv-input"
                           placeholder="Enter your username"
                           maxlength="50"
                           autocomplete="username" />
                </div>

                @if (!string.IsNullOrWhiteSpace(_mensajeError))
                {
                    <div class="thryv-error">
                        @_mensajeError
                    </div>
                }

                <button type="submit" class="thryv-login-button" disabled="@_procesando">
                    @if (_procesando)
                    {
                        <span>Sending...</span>
                    }
                    else
                    {
                        <span>Send recovery link</span>
                    }
                </button>
            </form>

            <div class="thryv-forgot-row">
                <NavLink href="/login">
                    Back to login
                </NavLink>
            </div>

            <div class="thryv-panel-footer">
                Secure access to your evaluation workspace
            </div>
        </div>
    </div>
</div>

@if (_mostrarModal)
{
    <div class="thryv-modal-backdrop">
        <div class="thryv-modal-card">
            <div class="thryv-modal-icon">✓</div>

            <h3>Password recovery</h3>

            <p>
                If the username exists, a recovery link has been sent.
            </p>

            <button class="thryv-login-button" @onclick="IrLogin">
                OK
            </button>
        </div>
    </div>
}

@code {
    private string? _username;
    private string? _mensajeError;
    private bool _procesando;
    private bool _mostrarModal;

    private async Task EnviarRecuperacion()
    {
        _mensajeError = null;

        if (string.IsNullOrWhiteSpace(_username))
        {
            _mensajeError = "Please enter your username.";
            return;
        }

        try
        {
            _procesando = true;

            var baseUrl = Navigation.BaseUri.TrimEnd('/');

            await PasswordResetService.SolicitarRecuperacionAsync(
                _username.Trim(),
                baseUrl);

            _mostrarModal = true;
        }
        catch
        {
            _mostrarModal = true;
        }
        finally
        {
            _procesando = false;
        }
    }

    private void IrLogin()
    {
        Navigation.NavigateTo("/login", forceLoad: true);
    }
}