@page "/forgot-password"
@inject NavigationManager Navigation
@layout Pagination_Project.Components.Layout.LoginLayout

<PageTitle>Forgot Password</PageTitle>

<div class="thryv-login-page">
    <div class="thryv-login-card">
        <div class="thryv-login-panel">
            <div class="thryv-logo-row">
                <div class="thryv-logo-mark">T</div>
                <div class="thryv-logo-text">
                    <strong>Evaluations</strong>
                    <span>Password recovery</span>
                </div>
            </div>

            <h2 class="thryv-login-title">Recover password</h2>

            <p class="thryv-login-subtitle">
                Enter your username. If the account exists, we will send a recovery link to your registered email.
            </p>

            <form method="post" action="/account/forgot-password">
                <div class="thryv-form-group">
                    <label>Username</label>
                    <input name="Username"
                           class="thryv-input"
                           placeholder="Enter your username"
                           maxlength="50"
                           autocomplete="username" />
                </div>

                @if (!string.IsNullOrWhiteSpace(_mensaje))
                {
                    <div class="thryv-success">
                        @_mensaje
                    </div>
                }

                <button type="submit" class="thryv-login-button">
                    Send recovery link
                </button>
            </form>

            <div class="thryv-forgot-row">
                <NavLink href="/login">
                    Back to login
                </NavLink>
            </div>

            <div class="thryv-panel-footer">
                Secure access to your evaluation workspace
            </div>
        </div>
    </div>
</div>

@code {
    private string? _mensaje;

    protected override void OnInitialized()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);

        if (query.TryGetValue("sent", out _))
        {
            _mensaje = "If the username exists, a recovery link has been sent.";
        }
    }
}