@page "/employee-time-off"
@page "/vacations"
@page "/vacaciones-free-day"

@using System.Globalization
@using System.Text
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using Pagination_Project.Data
@using Pagination_Project.Models
@using Pagination_Project.Services

@attribute [Authorize]
@layout Pagination_Project.Components.Layout.DashboardLayout

@inject IDbContextFactory<AppDbContext> DbFactory
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IUserDataScopeService UserDataScopeService

<PageTitle>Employee Time Off</PageTitle>

<div class="timeoff-page">

    <section class="page-hero">
        <div>
            <h1>Employee Time Off</h1>
            <p>
                Register vacations, free days, sick leave and other HR absences with optional automatic temporary assignment coverage.
            </p>
        </div>

        <div class="hero-stats">
            <div class="stat-card">
                <span>Total Records</span>
                <strong>@TimeOffList.Count</strong>
            </div>

            <div class="stat-card">
                <span>Active</span>
                <strong>@TimeOffList.Count(x => x.Active)</strong>
            </div>

            <div class="stat-card">
                <span>Auto Covered</span>
                <strong>@TimeOffList.Count(x => x.AutomaticCoverage)</strong>
            </div>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(Message))
    {
        <div class="alert-box @MessageType">
            @Message
        </div>
    }

    <section class="form-card">
        <div class="section-header">
            <div>
                <h2>@(EditingId is null ? "Register Time Off" : "Edit Time Off")</h2>
                <p>
                    Select the employee, absence type, date range and choose whether the system should assign temporary coverage automatically.
                </p>
            </div>

            <button type="button" class="btn-light" @onclick="ClearForm">
                ✨ New
            </button>
        </div>

        <EditForm Model="FormModel" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />

            <div class="form-grid">

                <div class="form-group large">
                    <label>Employee</label>
                    <select class="form-control" @bind="FormModel.EmployeeIdText">
                        <option value="">Select employee</option>

                        @foreach (var employee in Employees)
                        {
                            <option value="@employee.Id">@GetEmployeeOptionText(employee)</option>
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label>Time Off Type</label>
                    <select class="form-control" @bind="FormModel.LeaveType">
                        @foreach (var type in LeaveTypes)
                        {
                            <option value="@type">@type</option>
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label>Start Date</label>
                    <InputDate class="form-control" @bind-Value="FormModel.StartDate" />
                </div>

                <div class="form-group">
                    <label>End Date</label>
                    <InputDate class="form-control" @bind-Value="FormModel.EndDate" />
                </div>

                <div class="form-group">
                    <label>Automatic Assignment</label>
                    <select class="form-control" @bind="FormModel.AutomaticCoverageText">
                        <option value="No">No</option>
                        <option value="Yes">Yes</option>
                    </select>
                </div>

                <div class="form-group full">
                    <label>Notes</label>
                    <textarea class="form-control notes"
                              placeholder="Optional notes for HR..."
                              @bind="FormModel.Notes"
                              @bind:event="oninput"></textarea>
                </div>

            </div>

            @if (FormModel.AutomaticCoverage)
            {
                <div class="coverage-info">
                    <strong>Automatic assignment is enabled.</strong>
                    <span>
                        The system will review this employee's active books. If any pending stage falls inside the selected date range,
                        it will create temporary assignments using the employees with the lowest workload for that extraction date.
                    </span>
                </div>
            }

            <div class="button-row">
                <button type="submit" class="btn-primary" disabled="@(Saving || ProcessingAction)">
                    @(Saving ? "Saving..." : EditingId is null ? "Save Time Off" : "Update Time Off")
                </button>

                <button type="button" class="btn-secondary" @onclick="ClearForm">
                    Clear
                </button>
            </div>
        </EditForm>
    </section>

    <section class="list-card">
        <div class="section-header table-header">
            <div>
                <h2>Time Off List</h2>
                <p>Review registered vacations, free days, sick leave and automatic temporary coverages.</p>
            </div>

            <div class="list-filters">
                <select class="filter-select" @bind="EmployeeFilter">
                    <option value="">All Employees</option>

                    @foreach (var employee in Employees)
                    {
                        <option value="@employee.Id">@employee.Nombre</option>
                    }
                </select>

                <select class="filter-select" @bind="TypeFilter">
                    <option value="">All Types</option>

                    @foreach (var type in LeaveTypes)
                    {
                        <option value="@type">@type</option>
                    }
                </select>

                <select class="filter-select" @bind="StatusFilter">
                    <option value="">All Status</option>
                    <option value="Active">Active</option>
                    <option value="Closed">Closed</option>
                </select>

                <div class="search-box">
                    <span>🔎</span>
                    <input placeholder="Search employee, type, notes, book..."
                           @bind="SearchText"
                           @bind:event="oninput" />
                </div>

                <button type="button" class="btn-filter-clear" @onclick="ClearFilters">
                    Clear
                </button>
            </div>
        </div>

        @if (Loading)
        {
            <div class="loading-state">
                Loading time off records...
            </div>
        }
        else if (!FilteredTimeOff.Any())
        {
            <div class="empty-state">
                <strong>No records to display.</strong>
                <span>Create a new record or change the filters.</span>
            </div>
        }
        else
        {
            <div class="table-container">
                <table class="timeoff-table">
                    <thead>
                        <tr>
                            <th>Employee</th>
                            @if (Scope.ViewAllEmployeeTypes)
                            {
                                <th>Department</th>
                            }
                            <th>Type</th>
                            <th>Date Range</th>
                            <th>Days</th>
                            <th>Auto Assignment</th>
                            <th>Coverage Details</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in FilteredTimeOff)
                        {
                            <tr class="@(EditingId == item.Id ? "selected-row" : "")">
                                <td data-label="Employee">
                                    <div class="employee-title">
                                        <strong>@item.EmployeeName</strong>
                                        <span>ID: @item.EmployeeCode</span>
                                    </div>
                                </td>

                                @if (Scope.ViewAllEmployeeTypes)
                                {
                                    <td data-label="Department"><span class="pill type">@item.EmployeeTypeCode</span></td>
                                }

                                <td data-label="Type">
                                    <span class="pill type">@item.LeaveType</span>
                                </td>

                                <td data-label="Date Range">
                                    <div class="date-title">
                                        <strong>@FormatDate(item.StartDate) - @FormatDate(item.EndDate)</strong>
                                        <span>Created: @item.CreatedAt.ToString("MM/dd/yyyy hh:mm tt", CultureInfo.InvariantCulture)</span>
                                    </div>
                                </td>

                                <td data-label="Days">
                                    <strong>@item.TotalDays</strong>
                                </td>

                                <td data-label="Auto Assignment">
                                    @if (item.AutomaticCoverage)
                                    {
                                        <span class="pill success">Enabled</span>
                                    }
                                    else
                                    {
                                        <span class="pill muted">No</span>
                                    }
                                </td>

                                <td data-label="Coverage Details">
                                    @if (!item.Details.Any())
                                    {
                                        <span class="pill muted">No temporary assignments</span>
                                    }
                                    else
                                    {
                                        <div class="coverage-details">
                                            @foreach (var detail in item.Details)
                                            {
                                                <div class="coverage-detail-card">
                                                    <strong>@detail.BookName</strong>
                                                    <span>KGEN: @detail.KGENCode | LSA: @detail.LSACode</span>
                                                    <span>Temporary: @detail.TemporaryEmployeeName</span>
                                                    <span>Stages: @detail.Stages</span>
                                                    <small>@FormatDate(detail.FirstStageDate) - @FormatDate(detail.LastStageDate)</small>
                                                </div>
                                            }
                                        </div>
                                    }
                                </td>

                                <td data-label="Status">
                                    @if (item.Active)
                                    {
                                        <span class="pill success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="pill danger">Closed</span>
                                    }
                                </td>

                                <td class="actions-cell" data-label="Actions">
                                    <button type="button"
                                            class="icon-btn"
                                            title="Edit"
                                            disabled="@(Saving || ProcessingAction)"
                                            @onclick="() => Edit(item.Id)">
                                        ✏️
                                    </button>

                                    @if (item.Active)
                                    {
                                        <button type="button"
                                                class="icon-btn warning"
                                                title="Close"
                                                disabled="@(Saving || ProcessingAction)"
                                                @onclick="() => OpenCloseConfirmation(item)">
                                            🔒
                                        </button>
                                    }

                                    <button type="button"
                                            class="icon-btn danger"
                                            title="Delete"
                                            disabled="@(Saving || ProcessingAction)"
                                            @onclick="() => OpenDeleteConfirmation(item)">
                                        🗑️
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>


@if (ShowConfirmationModal && PendingRecord is not null)
{
    <div class="timeoff-modal-backdrop"
         role="dialog"
         aria-modal="true"
         aria-labelledby="timeoffConfirmationTitle">

        <div class="timeoff-modal timeoff-confirmation-modal @ConfirmationStyle">
            <div class="timeoff-modal-icon">
                @(PendingAction == "delete" ? "!" : "↻")
            </div>

            <div class="timeoff-modal-copy">
                <span class="timeoff-modal-kicker">
                    @(PendingAction == "delete" ? "Permanent action" : "Coverage update")
                </span>

                <h2 id="timeoffConfirmationTitle">
                    @(PendingAction == "delete" ? "Delete time off record?" : "Close time off record?")
                </h2>

                <p>
                    @(PendingAction == "delete"
                                    ? "This record will be removed and all temporary assignments created by it will be closed."
                                    : "This record will be marked as closed and its active temporary assignments will be deactivated.")
                                                                                                                                   </p>
                                                                                                                               </div>

            <div class="timeoff-confirmation-summary">
                <div>
                    <span>Employee</span>
                    <strong>@PendingRecord.EmployeeName</strong>
                </div>

                <div>
                    <span>Leave Type</span>
                    <strong>@PendingRecord.LeaveType</strong>
                </div>

                <div>
                    <span>Date Range</span>
                    <strong>@FormatDate(PendingRecord.StartDate) - @FormatDate(PendingRecord.EndDate)</strong>
                </div>

                <div>
                    <span>Temporary Coverages</span>
                    <strong>@PendingRecord.Details.Count</strong>
                </div>
            </div>

            <div class="timeoff-modal-actions">
                <button type="button"
                        class="timeoff-modal-secondary"
                        disabled="@ProcessingAction"
                        @onclick="CloseConfirmationModal">
                    Cancel
                </button>

                <button type="button"
                        class="@(PendingAction == "delete" ? "timeoff-modal-danger" : "timeoff-modal-primary")"
                        disabled="@ProcessingAction"
                        @onclick="ConfirmPendingActionAsync">
                    @(ProcessingAction
                                    ? "Processing..."
                                    : PendingAction == "delete"
                                    ? "Yes, delete"
                                    : "Yes, close")
            </button>
        </div>
    </div>
</div>
}

@if (ShowResultModal)
{
    <div class="timeoff-modal-backdrop timeoff-result-backdrop"
         role="dialog"
         aria-modal="true"
         aria-labelledby="timeoffResultTitle">

        <div class="timeoff-modal timeoff-result-modal @ResultType">
            <div class="timeoff-modal-icon">
                @(ResultType == "success" ? "✓" : ResultType == "warning" ? "!" : "×")
            </div>

            <div class="timeoff-modal-copy">
                <span class="timeoff-modal-kicker">
                    @(ResultType == "success" ? "Completed" : ResultType == "warning" ? "Attention" : "Unable to complete")
                </span>

                <h2 id="timeoffResultTitle">@ResultTitle</h2>
                <p>@ResultMessage</p>

                @if (!string.IsNullOrWhiteSpace(ResultDetail))
                {
                    <div class="timeoff-result-detail">@ResultDetail</div>
                }
            </div>

            <div class="timeoff-modal-actions">
                <button type="button"
                        class="timeoff-modal-primary"
                        @onclick="CloseResultModal">
                    Close
                </button>
            </div>
        </div>
    </div>
}


@code {
    private List<Empleados> Employees { get; set; } = new();
    private List<Bind_Plant> BindPlants { get; set; } = new();
    private List<TimeOffViewModel> TimeOffList { get; set; } = new();
    private UserDataScope Scope { get; set; } = new();

    private TimeOffFormModel FormModel { get; set; } = new();

    private bool Loading { get; set; } = true;
    private bool Saving { get; set; }
    private bool ProcessingAction { get; set; }

    private bool ShowResultModal { get; set; }
    private string ResultTitle { get; set; } = string.Empty;
    private string ResultMessage { get; set; } = string.Empty;
    private string ResultDetail { get; set; } = string.Empty;
    private string ResultType { get; set; } = "success";

    private bool ShowConfirmationModal { get; set; }
    private string PendingAction { get; set; } = string.Empty;
    private TimeOffViewModel? PendingRecord { get; set; }

    private string ConfirmationStyle =>
        PendingAction == "delete" ? "danger" : "warning";

    private Guid? EditingId { get; set; }

    private string Message { get; set; } = string.Empty;
    private string MessageType { get; set; } = "success";

    private string EmployeeFilter { get; set; } = string.Empty;
    private string TypeFilter { get; set; } = string.Empty;
    private string StatusFilter { get; set; } = string.Empty;
    private string SearchText { get; set; } = string.Empty;

    private readonly List<string> LeaveTypes = new()
    {
        "Vacation",
        "Free Day",
        "Sick Leave",
        "Medical Appointment",
        "Personal Leave",
        "Family Emergency",
        "Maternity Leave",
        "Paternity Leave",
        "Bereavement",
        "Training",
        "Administrative Leave",
        "Other"
    };

    private static readonly string[] RolesPermitidosParaAsignaciones =
    {
        "EMPLOYEE",
        "ASSISTANT"
    };

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        Scope = await UserDataScopeService.GetScopeAsync(authState.User);

        await LoadCatalogsAsync();
        await LoadDataAsync();
    }

    private async Task LoadCatalogsAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        var empleadosPermitidosIds =
            await ObtenerEmpleadosPermitidosParaAsignacionesAsync(db);

        Employees = await db.Empleados
            .AsNoTracking()
            .Include(x => x.EmployeeType)
            .ApplyScope(Scope)
            .Where(x =>
                x.Activo &&
                empleadosPermitidosIds.Contains(x.Id))
            .OrderBy(x => x.Nombre)
            .ToListAsync();

        BindPlants = await db.Bind_Plants
            .AsNoTracking()
            .OrderBy(x => x.Bind_Plant_Name)
            .ToListAsync();
    }

    private async Task LoadDataAsync()
    {
        try
        {
            Loading = true;

            await using var db = await DbFactory.CreateDbContextAsync();

            await UpdateExpiredTemporaryAssignmentsAsync(db);

            var records = await ScopedCoverageQuery(db)
                .AsNoTracking()
                .Include(x => x.Employee)
                    .ThenInclude(x => x!.EmployeeType)
                .Include(x => x.Details)
                .OrderByDescending(x => x.CreatedAt)
                .ToListAsync();

            var temporaryEmployeeIds = records
                .SelectMany(x => x.Details)
                .Select(x => x.TemporaryEmployeeId)
                .Distinct()
                .ToList();

            var temporaryEmployees = await db.Empleados
                .AsNoTracking()
                .Where(x => temporaryEmployeeIds.Contains(x.Id))
                .ToDictionaryAsync(x => x.Id, x => x.Nombre);

            TimeOffList = records.Select(x => new TimeOffViewModel
            {
                Id = x.Id,
                EmployeeId = x.EmployeeId,
                EmployeeName = x.Employee?.Nombre ?? "-",
                EmployeeCode = x.Employee?.IdEmpleado ?? 0,
                EmployeeTypeCode = x.Employee?.EmployeeType?.Code ?? "",
                LeaveType = x.LeaveType,
                StartDate = x.StartDate,
                EndDate = x.EndDate,
                AutomaticCoverage = x.AutomaticCoverage,
                Notes = x.Notes ?? string.Empty,
                Active = x.Active,
                CreatedAt = x.CreatedAt,
                TotalDays = CalculateDays(x.StartDate, x.EndDate),
                Details = x.Details
                    .OrderBy(d => d.FirstStageDate)
                    .Select(d => new TimeOffDetailViewModel
                    {
                        BookName = d.BookName ?? "-",
                        KGENCode = d.KGENCode ?? "-",
                        LSACode = d.LSACode ?? "-",
                        Stages = d.Stages,
                        FirstStageDate = d.FirstStageDate,
                        LastStageDate = d.LastStageDate,
                        TemporaryEmployeeName = temporaryEmployees.TryGetValue(d.TemporaryEmployeeId, out var name)
                            ? name
                            : "-"
                    })
                    .ToList()
            }).ToList();
        }
        catch (Exception ex)
        {
            ShowMessage($"Error loading time off records: {ex.Message}", "error");
        }
        finally
        {
            Loading = false;
        }
    }

    private async Task<HashSet<Guid>> ObtenerEmpleadosPermitidosParaAsignacionesAsync(
    AppDbContext db)
    {
        var empleadosIds = await (
            from usuario in db.Users.AsNoTracking()
            join nivel in db.PermissionLevels.AsNoTracking()
                on usuario.lvl_Id equals nivel.Id
            where usuario.Activo &&
                  usuario.EmployeeId != null &&
                  RolesPermitidosParaAsignaciones.Contains(
                      (nivel.Name ?? string.Empty)
                          .Trim()
                          .ToUpper())
            select usuario.EmployeeId!.Value
        )
        .Distinct()
        .ToListAsync();

        return empleadosIds.ToHashSet();
    }

    private IEnumerable<TimeOffViewModel> FilteredTimeOff
    {
        get
        {
            IEnumerable<TimeOffViewModel> query = TimeOffList;

            if (!string.IsNullOrWhiteSpace(EmployeeFilter) &&
                Guid.TryParse(EmployeeFilter, out var employeeId))
            {
                query = query.Where(x => x.EmployeeId == employeeId);
            }

            if (!string.IsNullOrWhiteSpace(TypeFilter))
            {
                query = query.Where(x => string.Equals(x.LeaveType, TypeFilter, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(StatusFilter))
            {
                if (StatusFilter == "Active")
                    query = query.Where(x => x.Active);

                if (StatusFilter == "Closed")
                    query = query.Where(x => !x.Active);
            }

            if (!string.IsNullOrWhiteSpace(SearchText))
            {
                var filter = Normalize(SearchText);

                query = query.Where(x =>
                    Normalize(x.EmployeeName).Contains(filter) ||
                    x.EmployeeCode.ToString(CultureInfo.InvariantCulture).Contains(filter) ||
                    Normalize(x.LeaveType).Contains(filter) ||
                    Normalize(x.Notes).Contains(filter) ||
                    x.Details.Any(d =>
                        Normalize(d.BookName).Contains(filter) ||
                        Normalize(d.KGENCode).Contains(filter) ||
                        Normalize(d.LSACode).Contains(filter) ||
                        Normalize(d.TemporaryEmployeeName).Contains(filter) ||
                        Normalize(d.Stages).Contains(filter)));
            }

            return query;
        }
    }

    private async Task SaveAsync()
    {
        if (!Guid.TryParse(FormModel.EmployeeIdText, out var employeeId))
        {
            ShowMessage("Select a valid employee.", "error");
            return;
        }

        if (FormModel.EndDate < FormModel.StartDate)
        {
            ShowMessage("End date cannot be earlier than start date.", "error");
            return;
        }

        var wasEditing = EditingId.HasValue;
        var selectedLeaveType = FormModel.LeaveType;
        var selectedStartDate = FormModel.StartDate;
        var selectedEndDate = FormModel.EndDate;
        var automaticCoverage = FormModel.AutomaticCoverage;

        try
        {
            Saving = true;
            ClearMessage();

            await using var db = await DbFactory.CreateDbContextAsync();

            var employee = await db.Empleados
                .AsNoTracking()
                .ApplyScope(Scope)
                .FirstOrDefaultAsync(x => x.Id == employeeId && x.Activo);

            if (employee is null)
                throw new InvalidOperationException("The selected employee is outside your department scope.");

            EmployeeLeaveCoverage record;

            if (!wasEditing)
            {
                record = new EmployeeLeaveCoverage
                {
                    Id = Guid.NewGuid(),
                    EmployeeId = employeeId,
                    LeaveType = FormModel.LeaveType,
                    StartDate = FormModel.StartDate,
                    EndDate = FormModel.EndDate,
                    AutomaticCoverage = FormModel.AutomaticCoverage,
                    Notes = FormModel.Notes,
                    Active = true,
                    CreatedAt = DateTime.UtcNow
                };

                db.EmployeeLeaveCoverages.Add(record);
                await db.SaveChangesAsync();
            }
            else
            {
                record = await ScopedCoverageQuery(db)
                    .Include(x => x.Details)
                    .FirstOrDefaultAsync(x => x.Id == EditingId!.Value)
                    ?? throw new InvalidOperationException("The selected record was not found.");

                await CloseTemporaryAssignmentsFromRecordAsync(db, record.Id);

                if (record.Details.Any())
                    db.EmployeeLeaveCoverageDetails.RemoveRange(record.Details);

                record.EmployeeId = employeeId;
                record.LeaveType = FormModel.LeaveType;
                record.StartDate = FormModel.StartDate;
                record.EndDate = FormModel.EndDate;
                record.AutomaticCoverage = FormModel.AutomaticCoverage;
                record.Notes = FormModel.Notes;
                record.Active = true;
                record.UpdatedAt = DateTime.UtcNow;
                record.ClosedAt = null;

                await db.SaveChangesAsync();
            }

            var autoResult = new AutoCoverageResult();

            if (record.AutomaticCoverage)
            {
                autoResult = await CreateAutomaticCoverageAsync(db, record);
                await db.SaveChangesAsync();
            }

            ClearForm();
            await LoadDataAsync();

            var title = wasEditing
                ? "Time off updated"
                : "Time off registered";

            var message = wasEditing
                ? $"The time off record for {employee.Nombre} was updated successfully."
                : $"The time off record for {employee.Nombre} was registered successfully.";

            var detail = automaticCoverage
                ? $"{selectedLeaveType} · {FormatDate(selectedStartDate)} - {FormatDate(selectedEndDate)} · Temporary assignments created: {autoResult.Created} · Skipped books: {autoResult.Skipped}."
                : $"{selectedLeaveType} · {FormatDate(selectedStartDate)} - {FormatDate(selectedEndDate)} · Automatic coverage was not requested.";

            ShowResult(
                title,
                message,
                automaticCoverage && autoResult.Created == 0 ? "warning" : "success",
                detail);
        }
        catch (Exception ex)
        {
            var error = ex.InnerException?.Message ?? ex.Message;
            ShowMessage($"Error saving time off: {error}", "error");
        }
        finally
        {
            Saving = false;
        }
    }

    private async Task<AutoCoverageResult> CreateAutomaticCoverageAsync(
        AppDbContext db,
        EmployeeLeaveCoverage record)
    {
        var result = new AutoCoverageResult();

        var assignments = await db.Asignaciones
            .Include(x => x.Empleado)
            .Include(x => x.Libro)
            .ApplyScope(Scope)
            .Where(x =>
                !x.Finalizado &&
                x.IdEmpleado == record.EmployeeId &&
                x.Libro != null &&
                !x.Libro.Finalizado)
            .OrderBy(x => x.Libro!.DirxionDate)
            .ThenBy(x => x.Libro!.BookName)
            .ToListAsync();

        var localWorkload = new Dictionary<string, int>();

        foreach (var assignment in assignments)
        {
            if (assignment.Libro is null)
                continue;

            var stages = GetStagesToCover(assignment.Libro, record.StartDate, record.EndDate);

            if (!stages.Any())
            {
                result.Skipped++;
                continue;
            }

            var firstStage = stages.First();

            var temporaryEmployeeId = await GetBestTemporaryEmployeeAsync(
                db,
                record.EmployeeId,
                firstStage.StageDate,
                firstStage.Code,
                assignment.Libro.EmployeeTypeId,
                localWorkload);

            if (temporaryEmployeeId is null)
            {
                result.Skipped++;
                continue;
            }

            var empleadosPermitidosIds =
                await ObtenerEmpleadosPermitidosParaAsignacionesAsync(db);

            if (!empleadosPermitidosIds.Contains(temporaryEmployeeId.Value))
            {
                result.Skipped++;
                continue;
            }

            var existingTemporaryAssignments = await db.TemporaryAssignments
                .Where(x => x.AssignmentId == assignment.Id && x.Active)
                .ToListAsync();

            foreach (var temp in existingTemporaryAssignments)
            {
                temp.Active = false;
                temp.ClosedAt = DateTime.UtcNow;
            }

            var temporary = new TemporaryAssignment
            {
                Id = Guid.NewGuid(),
                AssignmentId = assignment.Id,
                OriginalEmployeeId = assignment.IdEmpleado,
                TemporaryEmployeeId = temporaryEmployeeId.Value,

                Proof = stages.Any(x => x.Code == "Proof"),
                Final = stages.Any(x => x.Code == "Final"),
                Memo = stages.Any(x => x.Code == "Memo"),
                FinalPO = stages.Any(x => x.Code == "FinalPO"),
                Shipping = stages.Any(x => x.Code == "Shipping"),
                Dirxion = stages.Any(x => x.Code == "Dirxion"),
                PubDate = false,

                Reason = $"{record.LeaveType} automatic coverage: {FormatDate(record.StartDate)} - {FormatDate(record.EndDate)}",
                Active = true,
                CreatedAt = DateTime.UtcNow
            };

            db.TemporaryAssignments.Add(temporary);

            var detail = new EmployeeLeaveCoverageDetail
            {
                Id = Guid.NewGuid(),
                EmployeeLeaveCoverageId = record.Id,
                AssignmentId = assignment.Id,
                TemporaryAssignmentId = temporary.Id,
                OriginalEmployeeId = assignment.IdEmpleado,
                TemporaryEmployeeId = temporaryEmployeeId.Value,
                BookId = assignment.IdLibro,

                BookName = assignment.Libro.BookName,
                KGENCode = assignment.Libro.KGENCode,
                LSACode = assignment.Libro.LSACode,

                Stages = string.Join(", ", stages.Select(x => x.Name)),
                FirstStageDate = stages.Min(x => x.StageDate),
                LastStageDate = stages.Max(x => x.StageDate),
                CreatedAt = DateTime.UtcNow
            };

            db.EmployeeLeaveCoverageDetails.Add(detail);

            foreach (var stage in stages)
            {
                AddLocalWorkload(localWorkload, temporaryEmployeeId.Value, stage.StageDate, stage.Code);
            }

            result.Created++;
        }

        return result;
    }

    private List<BookStageInfo> GetStagesToCover(Libros book, DateOnly startDate, DateOnly endDate)
    {
        var today = DateOnly.FromDateTime(DateTime.Today);
        var bindPlant = Normalize(GetBindPlantName(book.BindPlantId));

        var omitMemo =
            bindPlant.Contains("PREM") ||
            bindPlant.Contains("DIRX") ||
            bindPlant.Contains("IVEAU") ||
            bindPlant.Contains("WSTR");

        var stages = new List<BookStageInfo>();

        AddStageIfValid(stages, "Proof", "Proof", book.ProofExtract, today);
        AddStageIfValid(stages, "Final", "Final", book.FinalExtract, today);

        if (!omitMemo)
            AddStageIfValid(stages, "Memo", "Memo", book.MemoExtract, today);

        AddStageIfValid(stages, "FinalPO", "Final PO", book.FinalPODate, today);
        AddStageIfValid(stages, "Shipping", "Shipping", book.ShippingDate, today);
        AddStageIfValid(stages, "Dirxion", "Dirxion", book.DirxionDate, today);

        stages = stages
            .Where(x => x.StageDate <= book.DirxionDate)
            .OrderBy(x => x.StageDate)
            .ThenBy(x => GetStageOrder(x.Code))
            .ToList();

        var firstAffectedIndex = stages.FindIndex(x =>
            x.StageDate >= startDate &&
            x.StageDate <= endDate);

        if (firstAffectedIndex < 0)
            return new List<BookStageInfo>();

        return stages
            .Skip(firstAffectedIndex)
            .ToList();
    }

    private static void AddStageIfValid(
        List<BookStageInfo> stages,
        string code,
        string name,
        DateOnly date,
        DateOnly today)
    {
        if (date == default)
            return;

        if (date < today)
            return;

        stages.Add(new BookStageInfo
        {
            Code = code,
            Name = name,
            StageDate = date
        });
    }

    private async Task<Guid?> GetBestTemporaryEmployeeAsync(
        AppDbContext db,
        Guid originalEmployeeId,
        DateOnly stageDate,
        string stageCode,
        short employeeTypeId,
        Dictionary<string, int> localWorkload)
    {
        var absentEmployees = await db.EmployeeLeaveCoverages
            .AsNoTracking()
            .Where(x =>
                x.Active &&
                x.StartDate <= stageDate &&
                x.EndDate >= stageDate)
            .Select(x => x.EmployeeId)
            .ToListAsync();

        var empleadosPermitidosIds =
            await ObtenerEmpleadosPermitidosParaAsignacionesAsync(db);

        var candidates = await db.Empleados
            .AsNoTracking()
            .ApplyScope(Scope)
            .Where(x =>
                x.Activo &&
                x.EmployeeTypeId == employeeTypeId &&
                empleadosPermitidosIds.Contains(x.Id) &&
                x.Id != originalEmployeeId &&
                !absentEmployees.Contains(x.Id))
            .OrderBy(x => x.Nombre)
            .ToListAsync();

        if (!candidates.Any())
            return null;

        var candidateIds = candidates.Select(x => x.Id).ToHashSet();

        var activeAssignments = await db.Asignaciones
            .AsNoTracking()
            .Include(x => x.Libro)
            .ApplyScope(Scope)
            .Where(x =>
                !x.Finalizado &&
                x.Libro != null &&
                x.Libro.EmployeeTypeId == employeeTypeId &&
                !x.Libro.Finalizado)
            .ToListAsync();

        activeAssignments = activeAssignments
            .Where(x => GetStageDate(x.Libro!, stageCode) == stageDate)
            .ToList();

        var assignmentIds = activeAssignments.Select(x => x.Id).ToList();

        var temporaries = await db.TemporaryAssignments
            .AsNoTracking()
            .Where(x => x.Active && assignmentIds.Contains(x.AssignmentId))
            .OrderByDescending(x => x.CreatedAt)
            .ToListAsync();

        var workload = candidates.ToDictionary(x => x.Id, _ => 0);

        foreach (var assignment in activeAssignments)
        {
            var responsibleEmployeeId = assignment.IdEmpleado;

            var temporary = temporaries
                .Where(x => x.AssignmentId == assignment.Id)
                .OrderByDescending(x => x.CreatedAt)
                .FirstOrDefault();

            if (temporary is not null && TemporaryAppliesToStage(temporary, stageCode))
            {
                responsibleEmployeeId = temporary.TemporaryEmployeeId;
            }

            if (candidateIds.Contains(responsibleEmployeeId))
            {
                workload[responsibleEmployeeId]++;
            }
        }

        var topTwo = candidates
            .Select(x => new EmployeeWorkload
            {
                EmployeeId = x.Id,
                EmployeeName = x.Nombre,
                ExistingWorkload = workload.TryGetValue(x.Id, out var count) ? count : 0,
                LocalWorkload = GetLocalWorkload(localWorkload, x.Id, stageDate, stageCode)
            })
            .OrderBy(x => x.ExistingWorkload)
            .ThenBy(x => x.LocalWorkload)
            .ThenBy(x => x.EmployeeName)
            .Take(2)
            .ToList();

        var selected = topTwo
            .OrderBy(x => x.ExistingWorkload + x.LocalWorkload)
            .ThenBy(x => x.LocalWorkload)
            .ThenBy(x => x.EmployeeName)
            .FirstOrDefault();

        return selected?.EmployeeId;
    }

    private static bool TemporaryAppliesToStage(TemporaryAssignment temporary, string stageCode)
    {
        return stageCode switch
        {
            "Proof" => temporary.Proof,
            "Final" => temporary.Final,
            "Memo" => temporary.Memo,
            "FinalPO" => temporary.FinalPO,
            "Shipping" => temporary.Shipping,
            "Dirxion" => temporary.Dirxion,
            _ => false
        };
    }

    private static DateOnly GetStageDate(Libros book, string stageCode)
    {
        return stageCode switch
        {
            "Proof" => book.ProofExtract,
            "Final" => book.FinalExtract,
            "Memo" => book.MemoExtract,
            "FinalPO" => book.FinalPODate,
            "Shipping" => book.ShippingDate,
            "Dirxion" => book.DirxionDate,
            _ => default
        };
    }

    private static int GetStageOrder(string stageCode)
    {
        return stageCode switch
        {
            "Proof" => 1,
            "Final" => 2,
            "Memo" => 3,
            "FinalPO" => 4,
            "Shipping" => 5,
            "Dirxion" => 6,
            _ => 99
        };
    }

    private static void AddLocalWorkload(
        Dictionary<string, int> localWorkload,
        Guid employeeId,
        DateOnly stageDate,
        string stageCode)
    {
        var key = GetLocalWorkloadKey(employeeId, stageDate, stageCode);

        if (!localWorkload.ContainsKey(key))
            localWorkload[key] = 0;

        localWorkload[key]++;
    }

    private static int GetLocalWorkload(
        Dictionary<string, int> localWorkload,
        Guid employeeId,
        DateOnly stageDate,
        string stageCode)
    {
        var key = GetLocalWorkloadKey(employeeId, stageDate, stageCode);

        return localWorkload.TryGetValue(key, out var count) ? count : 0;
    }

    private static string GetLocalWorkloadKey(Guid employeeId, DateOnly stageDate, string stageCode)
    {
        return $"{employeeId:N}|{stageDate:yyyyMMdd}|{stageCode}";
    }


    private string GetEmployeeOptionText(Empleados employee)
    {
        var text = $"{employee.Nombre} | ID: {employee.IdEmpleado}";

        if (Scope.ViewAllEmployeeTypes)
            text += $" | {employee.EmployeeType?.Code ?? "-"}";

        return text;
    }

    private IQueryable<EmployeeLeaveCoverage> ScopedCoverageQuery(AppDbContext db)
    {
        var query = db.EmployeeLeaveCoverages
            .Where(x => x.Employee != null);

        return Scope.ViewAllEmployeeTypes
            ? query
            : query.Where(x => x.Employee!.EmployeeTypeId == Scope.EmployeeTypeId);
    }

    private async Task CloseTemporaryAssignmentsFromRecordAsync(AppDbContext db, Guid recordId)
    {
        var temporaryIds = await db.EmployeeLeaveCoverageDetails
            .Where(x => x.EmployeeLeaveCoverageId == recordId && x.TemporaryAssignmentId != null)
            .Select(x => x.TemporaryAssignmentId!.Value)
            .ToListAsync();

        if (!temporaryIds.Any())
            return;

        var temporaries = await db.TemporaryAssignments
            .Where(x => temporaryIds.Contains(x.Id) && x.Active)
            .ToListAsync();

        foreach (var temporary in temporaries)
        {
            temporary.Active = false;
            temporary.ClosedAt = DateTime.UtcNow;
        }
    }

    private void OpenCloseConfirmation(TimeOffViewModel item)
    {
        if (!item.Active || ProcessingAction)
            return;

        PendingRecord = item;
        PendingAction = "close";
        ShowConfirmationModal = true;
        ClearMessage();
    }

    private void OpenDeleteConfirmation(TimeOffViewModel item)
    {
        if (ProcessingAction)
            return;

        PendingRecord = item;
        PendingAction = "delete";
        ShowConfirmationModal = true;
        ClearMessage();
    }

    private void CloseConfirmationModal()
    {
        if (ProcessingAction)
            return;

        ShowConfirmationModal = false;
        PendingAction = string.Empty;
        PendingRecord = null;
    }

    private async Task ConfirmPendingActionAsync()
    {
        if (PendingRecord is null || ProcessingAction)
            return;

        var record = PendingRecord;
        var action = PendingAction;

        ShowConfirmationModal = false;
        ProcessingAction = true;
        ClearMessage();

        try
        {
            if (action == "delete")
            {
                await DeleteConfirmedAsync(record);
            }
            else
            {
                await CloseConfirmedAsync(record);
            }
        }
        finally
        {
            ProcessingAction = false;
            PendingAction = string.Empty;
            PendingRecord = null;
        }
    }

    private async Task CloseConfirmedAsync(TimeOffViewModel selectedRecord)
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            var record = await ScopedCoverageQuery(db)
                .FirstOrDefaultAsync(x => x.Id == selectedRecord.Id);

            if (record is null)
            {
                ShowMessage("The selected record was not found.", "error");
                return;
            }

            await CloseTemporaryAssignmentsFromRecordAsync(db, selectedRecord.Id);

            record.Active = false;
            record.ClosedAt = DateTime.UtcNow;
            record.UpdatedAt = DateTime.UtcNow;

            await db.SaveChangesAsync();
            await LoadDataAsync();

            ShowResult(
                "Time off closed",
                $"The time off record for {selectedRecord.EmployeeName} was closed successfully.",
                "success",
                $"{selectedRecord.LeaveType} · {FormatDate(selectedRecord.StartDate)} - {FormatDate(selectedRecord.EndDate)} · {selectedRecord.Details.Count} temporary coverage record(s) were closed.");
        }
        catch (Exception ex)
        {
            ShowMessage($"Error closing record: {ex.Message}", "error");
        }
    }

    private async Task DeleteConfirmedAsync(TimeOffViewModel selectedRecord)
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            var record = await ScopedCoverageQuery(db)
                .Include(x => x.Details)
                .FirstOrDefaultAsync(x => x.Id == selectedRecord.Id);

            if (record is null)
            {
                ShowMessage("The selected record was not found.", "error");
                return;
            }

            await CloseTemporaryAssignmentsFromRecordAsync(db, selectedRecord.Id);

            db.EmployeeLeaveCoverages.Remove(record);
            await db.SaveChangesAsync();

            if (EditingId == selectedRecord.Id)
                ClearForm();

            await LoadDataAsync();

            ShowResult(
                "Time off deleted",
                $"The time off record for {selectedRecord.EmployeeName} was deleted successfully.",
                "success",
                $"{selectedRecord.LeaveType} · {FormatDate(selectedRecord.StartDate)} - {FormatDate(selectedRecord.EndDate)} · Temporary assignments created by this record were closed.");
        }
        catch (Exception ex)
        {
            ShowMessage($"Error deleting record: {ex.Message}", "error");
        }
    }

