@page "/"
@page "/login"
@inject NavigationManager Navigation
@layout Pagination_Project.Components.Layout.LoginLayout
@inject IJSRuntime JS

<PageTitle>Iniciar Sesión</PageTitle>

<div class="thryv-login-page">
    <div class="thryv-login-card">
        <div class="thryv-login-panel">
            <div class="thryv-logo-row">
                <div class="thryv-logo-mark">T</div>
                <div class="thryv-logo-text">
                    <strong>Evaluations</strong>
                    <span>Pagination evaluation system</span>
                </div>
            </div>

            <h2 class="thryv-login-title">Welcome back</h2>

            <p class="thryv-login-subtitle">
                Sign in to continue to your dashboard.
            </p>

            <form method="post" action="/account/login">
                <input type="hidden" name="ReturnUrl" value="/dashboard" />

                <div class="thryv-form-group">
                    <label>User</label>
                    <input name="Username"
                           class="thryv-input"
                           placeholder="Enter your username"
                           maxlength="50"
                           autocomplete="username" />
                </div>

                <div class="thryv-form-group">
                    <label>Password</label>
                    <input name="Password"
                           type="password"
                           class="thryv-input"
                           placeholder="••••••••"
                           maxlength="100"
                           autocomplete="current-password" />
                </div>

                @if (!string.IsNullOrWhiteSpace(_mensajeError))
                {
                    <div class="thryv-error">
                        @_mensajeError
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(_mensajeExito))
                {
                    <div class="thryv-success">
                        @_mensajeExito
                    </div>
                }

                <button type="submit" class="thryv-login-button">
                    Login
                </button>

                @*Se utilizara mas adelante cuando se tenga un dominio oficial*@
@*                 <div class="thryv-forgot-row">
                    <NavLink href="/forgot-password">
                        Forgot your password?
                    </NavLink>
                </div> *@
            </form>

            <div class="thryv-panel-footer">
                Secure access to your evaluation workspace
            </div>
        </div>
    </div>
</div>

@code {
    private string? _mensajeError;
    private string? _mensajeExito;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("thryvTheme.applySavedTheme");
        }
    }

    protected override void OnInitialized()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);

        if (query.TryGetValue("changed", out var changed))
        {
            _mensajeExito = "Password changed successfully. Please sign in again.";
        }

        if (query.TryGetValue("error", out var error))
        {
            _mensajeError = error.ToString() switch
            {
                "usuario" => "Incorrect user or password.",
                "password" => "Incorrect user or password.",
                "inactivo" => "This user is not active. Please contact the administrator.",
                "bloqueado" => "This account has been locked due to multiple failed login attempts. Please contact the administrator.",
                "general" => "Incorrect user or password.",
                "1" => "Incorrect user or password.",
                _ => "Incorrect user or password."
            };
        }
    }
}