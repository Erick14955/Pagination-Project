@page "/registro-usuarios"
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using Pagination_Project.Models
@using Pagination_Project.Services
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization

@inject IUsuarioService UsuarioService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation

@layout Pagination_Project.Components.Layout.DashboardLayout
@rendermode InteractiveServer

<PageTitle>Users - Evaluations</PageTitle>

<link href="style/registrousuarios.css" rel="stylesheet" />

<div class="thryv-users-page">

    <section class="thryv-users-header">
        <div>
            <h2>Users Management</h2>
            <p>Create, edit and delete system users.</p>
        </div>

        <button type="button" class="thryv-secondary-btn thryv-header-btn" @onclick="LimpiarFormulario">
            @(Editando ? "Cancel edit" : "New user")
        </button>
    </section>

    <div class="thryv-users-card thryv-form-card-full">
        <div class="thryv-card-top">
            <h3>@(Editando ? "Edit user" : "Register new user")</h3>
            <span>@(Editando ? "Update the selected user's information." : "Fill in the fields to create a user.")</span>
        </div>

        <EditForm Model="modelo" OnValidSubmit="GuardarUsuarioAsync">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="thryv-form-grid-large">
                <div class="thryv-form-group">
                    <label class="thryv-floating-field">
                        <span class="thryv-input-icon thryv-svg-icon">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M20 21a8 8 0 0 0-16 0"></path>
                                <circle cx="12" cy="7" r="4"></circle>
                            </svg>
                        </span>
                        <InputText class="thryv-input modern"
                                   @bind-Value="modelo.Username"
                                   placeholder=" " />
                        <span class="thryv-floating-label">Username</span>
                    </label>
                </div>

                <div class="thryv-form-group">
                    <label class="thryv-floating-field">
                        <span class="thryv-input-icon thryv-svg-icon">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M20 21a8 8 0 0 0-16 0"></path>
                                <circle cx="12" cy="7" r="4"></circle>
                            </svg>
                        </span>
                        <InputText class="thryv-input modern"
                                   @bind-Value="modelo.Name"
                                   placeholder=" " />
                        <span class="thryv-floating-label">Full Name</span>
                    </label>
                </div>

                <div class="thryv-form-group">
                    <label class="thryv-floating-field">
                        <span class="thryv-input-icon thryv-svg-icon">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M4 6h16v12H4z"></path>
                                <path d="m4 7 8 6 8-6"></path>
                            </svg>
                        </span>
                        <InputText class="thryv-input modern"
                                   @bind-Value="modelo.Email"
                                   placeholder=" " />
                        <span class="thryv-floating-label">Email</span>
                    </label>
                </div>

                <div class="thryv-form-group">
                    <label class="thryv-floating-field">
                        <span class="thryv-input-icon thryv-svg-icon">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <rect x="3" y="11" width="18" height="10" rx="2"></rect>
                                <path d="M7 11V8a5 5 0 0 1 10 0v3"></path>
                            </svg>
                        </span>
                        <InputText type="password"
                                   class="thryv-input modern"
                                   @bind-Value="modelo.Password"
                                   placeholder=" " />
                        <span class="thryv-floating-label">@(Editando ? "New Password (optional)" : "Password")</span>
                    </label>
                </div>

                <div class="thryv-form-group">
                    <label class="thryv-floating-field thryv-select-field">
                        <span class="thryv-input-icon thryv-svg-icon">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path d="m12 2 2.4 4.9 5.4.8-3.9 3.8.9 5.5L12 14.9 7.2 17l.9-5.5L4.2 7.7l5.4-.8Z"></path>
                            </svg>
                        </span>
                        <InputSelect class="thryv-input modern thryv-select-input" @bind-Value="modelo.Lvl_Id">
                            <option value="0">Select a user type</option>
                            @foreach (var permiso in permisos)
                            {
                                <option value="@permiso.Id">@permiso.Name</option>
                            }
                        </InputSelect>
                        <span class="thryv-floating-label always-float">User Type</span>
                    </label>
                </div>

                <div class="thryv-form-group">
                    <label class="thryv-floating-field thryv-select-field thryv-linked-employee-field">
                        <span class="thryv-input-icon thryv-svg-icon">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M20 21a8 8 0 0 0-16 0"></path>
                                <circle cx="12" cy="7" r="4"></circle>
                            </svg>
                        </span>

                        <InputSelect TValue="Guid?"
                                     class="thryv-input modern thryv-select-input thryv-linked-employee-select"
                                     @bind-Value="modelo.EmployeeId">
                            <option value="">No linked employee</option>

                            @foreach (var empleado in empleadosDisponibles)
                            {
                                <option value="@empleado.Id">
                                    @empleado.DisplayName
                                </option>
                            }
                        </InputSelect>

                        <span class="thryv-floating-label always-float">Linked Employee</span>

                        @if (modelo.EmployeeId.HasValue)
                        {
                            <button type="button"
                                    class="thryv-unlink-inline-btn"
                                    title="Unlink employee"
                                    @onclick="DesvincularEmpleado"
                                    @onclick:stopPropagation="true">
                                Unlink
                            </button>
                        }
                    </label>
                </div>

                <div class="thryv-form-group">
                    <div class="thryv-switch-card">
                        <div class="thryv-switch-text">
                            <span class="thryv-switch-title">User Status</span>
                            <span class="thryv-switch-subtitle">
                                @(modelo.Activo ? "This user is active" : "This user is inactive")
                            </span>
                        </div>

                        <label class="thryv-switch">
                            <InputCheckbox @bind-Value="modelo.Activo" />
                            <span class="thryv-slider"></span>
                        </label>
                    </div>
                </div>

                <div class="thryv-form-group">
                    <div class="thryv-switch-card password-change">
                        <div class="thryv-switch-text">
                            <span class="thryv-switch-title">Require Password Change</span>
                            <span class="thryv-switch-subtitle">
                                @(modelo.RequirePasswordChange
                                                                ? "The user must change the password at next login"
                                                                : "The user can login normally")
                            </span>
                        </div>

                        <label class="thryv-switch">
                            <InputCheckbox @bind-Value="modelo.RequirePasswordChange" />
                            <span class="thryv-slider"></span>
                        </label>
                    </div>
                </div>
            </div>

            <div class="thryv-form-actions">
                <AuthorizeView>
                    <Authorized Context="auth">
                        @if (HasPermission(auth.User, "CreateUser"))
                        {
                            <button type="submit" class="thryv-primary-btn" disabled="@Guardando">
                                @(Guardando ? "Saving..." : (Editando ? "Update User" : "Register User"))
                            </button>
                        }
                    </Authorized>
                </AuthorizeView>

                <AuthorizeView>
                    <Authorized Context="auth">
                        @if (HasPermission(auth.User, "DeleteUser"))
                        {
                            <button type="button"
                                    class="thryv-danger-btn"
                                    @onclick="AbrirModalEliminar"
                                    disabled="@(!Editando || Guardando)">
                                Delete
                            </button>
                        }
                    </Authorized>
                </AuthorizeView>
            </div>
        </EditForm>
    </div>

    <div class="thryv-users-card thryv-list-large">
        <div class="thryv-list-header">
            <div>
                <h3>User List</h3>
                <span>@usuariosFiltrados.Count record(s)</span>
            </div>

            <input class="thryv-search-input"
                   placeholder="Search..."
                   @bind="textoBusqueda"
                   @bind:event="oninput" />
        </div>

        <div class="thryv-table-wrap large">
            <table class="thryv-users-table large">
                <thead>
                    <tr>
                        <th>Username</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Employee</th>
                        <th>Permission</th>
                        <th>Status</th>
                        <AuthorizeView>
                            <Authorized Context="auth">
                                @if (HasPermission(auth.User, "EditUser"))
                                {
                                    <th>Action</th>
                                }
                            </Authorized>
                        </AuthorizeView>
                    </tr>
                </thead>

                <tbody>
                    @{
                        var totalColumnas = (_user != null && HasPermission(_user, "EditUser")) ? 7 : 6;
                    }

                    @if (Cargando)
                    {
                        <tr>
                            <td colspan="@totalColumnas" class="thryv-empty-row">Loading users...</td>
                        </tr>
                    }
                    else if (!usuariosFiltrados.Any())
                    {
                        <tr>
                            <td colspan="@totalColumnas" class="thryv-empty-row">No users found.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var user in usuariosFiltrados)
                        {
                            <tr class="@(modelo.Id == user.Id ? "selected" : "")"
                                @ondblclick="async () => await OnDobleClickUsuario(user)">
                                <td>@user.Username</td>
                                <td>@user.Name</td>
                                <td>@user.Email</td>
                                <td>
                                    <span class="thryv-role-badge">@user.NivelNombre</span>
                                </td>
                                <td>
                                    @if (user.EmployeeId.HasValue)
                                    {
                                        <span class="thryv-role-badge">@user.EmployeeDisplay</span>
                                    }
                                    else
                                    {
                                        <span class="thryv-status-badge inactive">Not linked</span>
                                    }
                                </td>
                                <td>
                                    @if (user.Activo)
                                    {
                                        <span class="thryv-status-badge active">● Active</span>
                                    }
                                    else
                                    {
                                        <span class="thryv-status-badge inactive">● Inactive</span>
                                    }
                                </td>

                                <AuthorizeView>
                                    <Authorized Context="auth">
                                        @if (HasPermission(auth.User, "EditUser"))
                                        {
                                            <td>
                                                <button type="button"
                                                        class="thryv-table-btn"
                                                        @onclick="async () => await SeleccionarUsuario(user)">
                                                    Edit
                                                </button>
                                            </td>
                                        }
                                    </Authorized>
                                </AuthorizeView>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (MostrarModalEliminar)
{
    <div class="thryv-modal-overlay" @onclick="CerrarModalEliminar">
        <div class="thryv-modal-card" @onclick:stopPropagation="true">
            <div class="thryv-modal-header">
                <h3>Confirm delete</h3>
            </div>

            <div class="thryv-modal-body">
                <p>Are you sure you want to delete this user?</p>

                <div class="thryv-modal-userbox">
                    <strong>@modelo.Username</strong>
                    @if (!string.IsNullOrWhiteSpace(modelo.Name))
                    {
                        <span>- @modelo.Name</span>
                    }
                </div>

                <p class="thryv-modal-warning">
                    This action cannot be undone.
                </p>
            </div>

            <div class="thryv-modal-actions">
                <button type="button"
                        class="thryv-secondary-btn"
                        @onclick="CerrarModalEliminar"
                        disabled="@Guardando">
                    No, go back
                </button>

                <button type="button"
                        class="thryv-danger-btn"
                        @onclick="ConfirmarEliminarUsuarioAsync"
                        disabled="@Guardando">
                    @(Guardando ? "Deleting..." : "Yes, delete")
                </button>
            </div>
        </div>
    </div>
}

@if (MostrarModalResultado)
{
    <div class="thryv-modal-overlay" @onclick="CerrarModalResultado">
        <div class="thryv-modal-card thryv-result-modal" @onclick:stopPropagation="true">
            <div class="thryv-modal-header">
                <h3>@TituloModalResultado</h3>
            </div>

            <div class="thryv-modal-body">
                <p>@MensajeModalResultado</p>
            </div>

            <div class="thryv-modal-actions">
                <button type="button"
                        class="thryv-primary-btn"
                        @onclick="CerrarModalResultado">
                    OK
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<UsuarioListDto> usuarios = new();
    private List<PermisoComboDto> permisos = new();

    private UsuarioFormModel modelo = new();
    private ClaimsPrincipal? _user;

    private bool Cargando = true;
    private bool Guardando = false;
    private bool MostrarModalEliminar = false;
    private bool MostrarModalResultado = false;

    private string textoBusqueda = string.Empty;
    private string TituloModalResultado = string.Empty;
    private string MensajeModalResultado = string.Empty;

    private bool Editando => modelo.Id != Guid.Empty;
    private List<EmpleadoUsuarioComboDto> empleadosDisponibles = new();

    private List<UsuarioListDto> usuariosFiltrados =>
        usuarios
            .Where(u =>
                string.IsNullOrWhiteSpace(textoBusqueda) ||
                u.Username.Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase) ||
                u.Name.Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase) ||
                u.Email.Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase) ||
                u.NivelNombre.Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase) ||
                u.EmployeeName.Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase) ||
                (u.EmployeeCode.HasValue && u.EmployeeCode.Value.ToString().Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase)))
            .OrderBy(u => u.Username)
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        await CargarDatosAsync();
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _user = authState.User;
    }

    private static bool HasPermission(ClaimsPrincipal user, string claimType)
    {
        return string.Equals(user.FindFirst(claimType)?.Value, "True", StringComparison.OrdinalIgnoreCase);
    }

    private void DesvincularEmpleado()
    {
        modelo.EmployeeId = null;
    }

    private async Task CargarDatosAsync()
    {
        Cargando = true;

        try
        {
            permisos = await UsuarioService.ObtenerPermisosAsync();
            usuarios = await UsuarioService.ObtenerTodosAsync();
            empleadosDisponibles = await UsuarioService.ObtenerEmpleadosDisponiblesAsync(Editando ? modelo.Id : null);
        }
        catch (Exception ex)
        {
            MostrarResultado("Error", $"Error loading data: {ex.Message}");
        }
        finally
        {
            Cargando = false;
        }
    }

    private async Task CargarEmpleadosDisponiblesAsync(Guid? usuarioActualId = null)
    {
        empleadosDisponibles = await UsuarioService.ObtenerEmpleadosDisponiblesAsync(usuarioActualId);
    }

    private async Task GuardarUsuarioAsync()
    {
        Guardando = true;

        try
        {
            if (Editando)
            {
                var dto = new UsuarioUpdateDto
                {
                    Id = modelo.Id,
                    Username = modelo.Username,
                    Email = modelo.Email,
                    Password = string.IsNullOrWhiteSpace(modelo.Password) ? null : modelo.Password,
                    Name = modelo.Name,
                    Lvl_Id = modelo.Lvl_Id,
                    Activo = modelo.Activo,
                    EmployeeId = modelo.EmployeeId,
                    RequirePasswordChange = modelo.RequirePasswordChange
                };

                var result = await UsuarioService.ActualizarAsync(dto);

                if (result == null)
                {
                    MostrarResultado("Not found", "User not found.");
                    return;
                }

                await CargarDatosAsync();
                await LimpiarFormulario();
                MostrarResultado("User updated", "The user was updated successfully.");
            }
            else
            {
                var dto = new UsuarioCreateDto
                {
                    Username = modelo.Username,
                    Email = modelo.Email,
                    Password = modelo.Password,
                    Name = modelo.Name,
                    Lvl_Id = modelo.Lvl_Id,
                    Activo = modelo.Activo,
                    EmployeeId = modelo.EmployeeId,
                    RequirePasswordChange = modelo.RequirePasswordChange
                };

                await UsuarioService.CrearAsync(dto);
                await CargarDatosAsync();
                await LimpiarFormulario();
                MostrarResultado("User created", "The user was created successfully.");
            }
        }
        catch (Exception ex)
        {
            MostrarResultado("Error", ex.Message);
        }
        finally
        {
            Guardando = false;
        }
    }

    private async Task OnDobleClickUsuario(UsuarioListDto user)
    {
        if (_user == null)
            return;

        if (HasPermission(_user, "EditUser"))
        {
            await SeleccionarUsuario(user);
        }
    }

    private async Task SeleccionarUsuario(UsuarioListDto user)
    {
        modelo = new UsuarioFormModel
        {
            Id = user.Id,
            Username = user.Username,
            Email = user.Email,
            Name = user.Name,
            Password = string.Empty,
            Lvl_Id = user.Lvl_Id,
            Activo = user.Activo,
            EmployeeId = user.EmployeeId,
            RequirePasswordChange = user.RequirePasswordChange
        };

        await CargarEmpleadosDisponiblesAsync(user.Id);

        MostrarModalEliminar = false;
    }

    private void AbrirModalEliminar()
    {
        if (!Editando)
            return;

        MostrarModalEliminar = true;
    }

    private void CerrarModalEliminar()
    {
        MostrarModalEliminar = false;
    }

    private async Task ConfirmarEliminarUsuarioAsync()
    {
        if (!Editando)
            return;

        Guardando = true;

        try
        {
            var eliminado = await UsuarioService.EliminarAsync(modelo.Id);

            if (!eliminado)
            {
                MostrarModalEliminar = false;
                MostrarResultado("Not found", "User not found.");
                return;
            }

            MostrarModalEliminar = false;
            await CargarDatosAsync();
            await LimpiarFormulario();
            MostrarResultado("User deleted", "The user was deleted successfully.");
        }
        catch (Exception ex)
        {
            MostrarModalEliminar = false;
            MostrarResultado("Error", $"Error deleting user: {ex.Message}");
        }
        finally
        {
            Guardando = false;
        }
    }

    private async Task LimpiarFormulario()
    {
        modelo = new UsuarioFormModel
        {
            Activo = true
        };

        MostrarModalEliminar = false;

        await CargarEmpleadosDisponiblesAsync();
    }

    private void MostrarResultado(string titulo, string mensaje)
    {
        TituloModalResultado = titulo;
        MensajeModalResultado = mensaje;
        MostrarModalResultado = true;
    }

    private void CerrarModalResultado()
    {
        MostrarModalResultado = false;
        TituloModalResultado = string.Empty;
        MensajeModalResultado = string.Empty;
    }

    public class UsuarioFormModel
    {
        public Guid Id { get; set; }

        public string Username { get; set; } = string.Empty;

        public string Email { get; set; } = string.Empty;

        public string Password { get; set; } = string.Empty;

        public string Name { get; set; } = string.Empty;

        public int Lvl_Id { get; set; }

        public bool Activo { get; set; } = true;

        public Guid? EmployeeId { get; set; }
        public bool RequirePasswordChange { get; set; } = false;
    }
}