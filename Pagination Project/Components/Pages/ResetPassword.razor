@page "/reset-password"
@inject NavigationManager Navigation
@layout Pagination_Project.Components.Layout.LoginLayout

<PageTitle>Reset Password</PageTitle>

<div class="thryv-login-page">
    <div class="thryv-login-card">
        <div class="thryv-login-panel">
            <div class="thryv-logo-row">
                <div class="thryv-logo-mark">T</div>
                <div class="thryv-logo-text">
                    <strong>Evaluations</strong>
                    <span>Reset password</span>
                </div>
            </div>

            <h2 class="thryv-login-title">Create new password</h2>

            <p class="thryv-login-subtitle">
                Enter and confirm your new password.
            </p>

            <form method="post" action="/account/reset-password">
                <input type="hidden" name="Token" value="@_token" />

                <div class="thryv-form-group">
                    <label>New Password</label>
                    <input name="NewPassword"
                           type="password"
                           class="thryv-input"
                           placeholder="Enter new password"
                           maxlength="100"
                           autocomplete="new-password" />
                </div>

                <div class="thryv-form-group">
                    <label>Confirm Password</label>
                    <input name="ConfirmPassword"
                           type="password"
                           class="thryv-input"
                           placeholder="Confirm new password"
                           maxlength="100"
                           autocomplete="new-password" />
                </div>

                @if (!string.IsNullOrWhiteSpace(_mensajeError))
                {
                    <div class="thryv-error">
                        @_mensajeError
                    </div>
                }

                <div class="thryv-password-rules">
                    Minimum 6 characters. After resetting your password, you will need to sign in again.
                </div>

                <button type="submit" class="thryv-login-button">
                    Reset Password
                </button>
            </form>

            <div class="thryv-forgot-row">
                <NavLink href="/login">
                    Back to login
                </NavLink>
            </div>

            <div class="thryv-panel-footer">
                Secure access to your evaluation workspace
            </div>
        </div>
    </div>
</div>

@code {
    private string? _token;
    private string? _mensajeError;

    protected override void OnInitialized()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);

        if (query.TryGetValue("token", out var token))
        {
            _token = token.ToString();
        }

        if (string.IsNullOrWhiteSpace(_token))
        {
            _mensajeError = "Invalid or expired recovery link.";
        }

        if (query.TryGetValue("error", out var error))
        {
            _mensajeError = error.ToString() switch
            {
                "short" => "The password must have at least 6 characters.",
                "mismatch" => "Passwords do not match.",
                "invalid" => "Invalid or expired recovery link.",
                "general" => "Unable to reset password.",
                _ => "Unable to reset password."
            };
        }
    }
}