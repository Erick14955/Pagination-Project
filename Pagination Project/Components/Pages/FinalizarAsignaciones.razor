@page "/finalizar-asignaciones"

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using Pagination_Project.Data
@using Pagination_Project.Models
@using Pagination_Project.Services

@attribute [Authorize]
@layout Pagination_Project.Components.Layout.DashboardLayout

@inject IDbContextFactory<AppDbContext> DbFactory
@inject AuthenticationStateProvider AuthStateProvider
@inject IUserDataScopeService UserDataScopeService

<PageTitle>Finish Assignments</PageTitle>

<div class="finish-assignments-page">

    <section class="finish-hero">
        <div>
            <span class="hero-kicker">Daily Work</span>
            <h1>Finish Assignments</h1>
            <p>
                View today’s assignments and mark the corresponding stage as completed.
            </p>
        </div>

        <div class="hero-stats">
            <div class="hero-stat">
                <span>Today’s Assignments</span>
                <strong>@AsignacionesFiltradas.Count</strong>
            </div>

            <div class="hero-stat">
                <span>Selected</span>
                <strong>@Seleccionadas.Count</strong>
            </div>

            <div class="hero-stat">
                <span>Completed</span>
                <strong>@TotalCompletadas</strong>
            </div>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(Mensaje))
    {
        <div class="finish-alert @(MensajeEsError ? "finish-alert-error" : "finish-alert-success")">
            @Mensaje
        </div>
    }

    <section class="finish-panel">

        <div class="finish-toolbar">

            <div class="filter-group employee-filter">
                <label>Employee</label>

                <select class="finish-input"
                        value="@EmpleadoFiltro"
                        disabled="@FiltroEmpleadoBloqueado"
                        @onchange="OnEmpleadoChanged">

                    <option value="">All Employees</option>

                    @foreach (var emp in Empleados)
                    {
                        <option value="@emp.Id">@emp.Nombre</option>
                    }
                </select>
            </div>

            <div class="filter-group search-filter">
                <label>Search</label>

                <input class="finish-input"
                       placeholder="Search by employee, book, KGEN or LSA..."
                       value="@Busqueda"
                       @oninput="OnBusquedaChanged" />
            </div>

            <div class="filter-group stage-filter">
                <label>Stage</label>

                <select class="finish-input"
                        value="@EtapaFiltro"
                        @onchange="OnEtapaChanged">

                    <option value="">All Stages</option>
                    <option value="ProofExtract">Proof Extract</option>
                    <option value="FinalExtract">Final Extract</option>
                    <option value="MemoExtract">Memo Extract</option>
                    <option value="Dirxion">Dirxion Date</option>
                    <option value="FinalPO">Final PO Date</option>
                    <option value="Shipping">Shipping Date</option>

                </select>
            </div>

        </div>

        <div class="finish-actions">

            <button type="button"
                    class="btn-soft"
                    @onclick="SeleccionarTodas">
                Select Visible
            </button>

            <button type="button"
                    class="btn-soft"
                    @onclick="LimpiarSeleccion">
                Clear Selection
            </button>

            <button type="button"
                    class="btn-primary"
                    disabled="@(Seleccionadas.Count == 0 || Guardando)"
                    @onclick="PrepararGuardadoAsync">

                @(Guardando ? "Saving..." : "Mark as Completed")

            </button>

        </div>

        @if (Cargando)
        {
            <div class="empty-state">
                <div class="loader"></div>

                <h3>Loading assignments...</h3>

                <p>
                    Checking the active stages for today.
                </p>
            </div>
        }
        else if (!AsignacionesFiltradas.Any())
        {
            <div class="empty-state">

                <div class="empty-icon">✓</div>

                <h3>No pending assignments for today</h3>

                <p>
                    No active assignments were found for the current day.
                </p>

            </div>
        }
        else
        {
            <div class="finish-table-wrapper">

                <table class="finish-table">

                    <thead>
                        <tr>
                            <th class="check-col"></th>
                            <th>Employee</th>

                            @if (Scope.ViewAllEmployeeTypes)
                            {
                                <th>Department</th>
                            }

                            <th>Book</th>
                            <th>KGEN</th>
                            <th>LSA</th>
                            <th>Stage</th>
                            <th>Date</th>
                            <th>Status</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in AsignacionesFiltradas)
                        {
                            var rowKey = GetRowKey(item);
                            var checkedValue = Seleccionadas.Contains(rowKey);

                            <tr class="@GetRowClass(item, checkedValue)">

                                <td class="check-col" data-label="Select">

                                    <input type="checkbox"
                                           checked="@checkedValue"
                                           disabled="@item.YaCompletada"
                                           @onchange="e => ToggleSeleccion(item, e)" />

                                </td>

                                <td data-label="Employee">

                                    <div class="employee-cell">
                                        <strong>@item.EmployeeName</strong>
                                    </div>

                                </td>

                                @if (Scope.ViewAllEmployeeTypes)
                                {
                                    <td data-label="Department">
                                        <span class="code-pill">
                                            @item.EmployeeTypeCode
                                        </span>
                                    </td>
                                }

                                <td data-label="Book">

                                    <div class="book-cell">

                                        <strong>
                                            @item.BookName
                                        </strong>

                                        <span>
                                            Assignment ID: @item.AssignmentId
                                        </span>

                                    </div>

                                </td>

                                <td data-label="KGEN">
                                    <span class="code-pill">
                                        @item.KgenCode
                                    </span>
                                </td>

                                <td data-label="LSA">
                                    <span class="code-muted">
                                        @item.LsaCode
                                    </span>
                                </td>

                                <td data-label="Stage">

                                    <span class="stage-pill stage-@item.StageKey.ToLowerInvariant()">
                                        @item.StageName
                                    </span>

                                </td>

                                <td data-label="Date">
                                    @item.StageDate.ToString("dd/MM/yyyy")
                                </td>

                                <td data-label="Status">

                                    @if (item.YaCompletada)
                                    {
                                        <span class="status-badge status-done">
                                            Completed
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-pending">
                                            Pending
                                        </span>
                                    }

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </section>

</div>

@if (MostrarModalResultadoFinalizacion)
{
    <div class="finish-result-modal-overlay"
         role="presentation"
         @onclick="CerrarModalResultadoFinalizacion">

        <div class="finish-result-modal-card @TipoModalResultadoFinalizacion"
             role="dialog"
             aria-modal="true"
             aria-labelledby="finishResultModalTitle"
             @onclick:stopPropagation="true">

            <div class="finish-result-modal-accent"></div>

            <div class="finish-result-modal-content">

                <div class="finish-result-modal-icon"
                     aria-hidden="true">

                    @if (TipoModalResultadoFinalizacion == "success")
                    {
                        <svg viewBox="0 0 24 24">
                            <path d="M20 6 9 17l-5-5"></path>
                        </svg>
                    }
                    else
                    {
                        <svg viewBox="0 0 24 24">
                            <circle cx="12"
                                    cy="12"
                                    r="9">
                            </circle>

                            <path d="M12 7v6"></path>
                            <path d="M12 17h.01"></path>
                        </svg>
                    }

                </div>

                <div class="finish-result-modal-copy">

                    <span class="finish-result-modal-eyebrow">
                        Finish Assignments
                    </span>

                    <h3 id="finishResultModalTitle">
                        @TituloModalResultadoFinalizacion
                    </h3>

                    <p>
                        @MensajeModalResultadoFinalizacion
                    </p>

                </div>

            </div>

            <div class="finish-result-modal-actions">

                <button type="button"
                        class="finish-result-modal-ok"
                        @onclick="CerrarModalResultadoFinalizacion">
                    OK
                </button>

            </div>

        </div>

    </div>
}

@if (MostrarModalVerificacionFinalPO)
{
    <div class="finish-verification-backdrop"
         role="dialog"
         aria-modal="true"
         aria-labelledby="finalPoVerificationTitle">

        <div class="finish-verification-modal">

            <div class="finish-verification-header">

                <div class="finish-verification-icon">
                    ✓
                </div>

                <div>

                    <span class="finish-verification-kicker">
                        Required verification
                    </span>

                    <h2 id="finalPoVerificationTitle">
                        Final PO completion
                    </h2>

                    <p>
                        Complete both confirmations before these Final PO assignments can be marked as completed.
                    </p>

                </div>

            </div>

            <div class="finish-verification-books">

                @foreach (var item in AsignacionesFinalPOPendientesVerificacion)
                {
                    <div class="finish-verification-book">

                        <div>

                            <strong>
                                @item.BookName
                            </strong>

                            <span>
                                @item.KgenCode · @item.EmployeeName
                            </span>

                        </div>

                        <span class="finish-verification-plant">
                            @item.BindPlantName
                        </span>

                    </div>
                }

            </div>

            <div class="finish-verification-checks">

                <label class="finish-verification-check">

                    <input type="checkbox"
                           @bind="ClosingCorrectionsConfirmed" />

                    <span class="finish-verification-check-box"></span>

                    <span>

                        <strong>
                            Closing corrections verified
                        </strong>

                        <small>
                            I confirm that closing corrections were reviewed and,
                            when received, were completed.
                        </small>

                    </span>

                </label>

                <label class="finish-verification-check">

                    <input type="checkbox"
                           @bind="LateWorkConfirmed" />

                    <span class="finish-verification-check-box"></span>

                    <span>

                        <strong>
                            All late work completed
                        </strong>

                        <small>
                            I confirm that all late work associated with these books
                            has been completed.
                        </small>

                    </span>

                </label>

            </div>

            @if (!string.IsNullOrWhiteSpace(MensajeVerificacionFinalPO))
            {
                <div class="finish-verification-error">
                    @MensajeVerificacionFinalPO
                </div>
            }

        <div class="finish-verification-actions">

            <button type="button"
                    class="btn-soft"
                    disabled="@Guardando"
                    @onclick="CancelarVerificacionFinalPO">
                Cancel
            </button>

            <button type="button"
                    class="btn-primary"
                    disabled="@(!ClosingCorrectionsConfirmed || !LateWorkConfirmed || Guardando)"
                    @onclick="ConfirmarVerificacionesFinalPOAsync">

                @(Guardando
                                ? "Saving..."
                                : "Confirm and complete")

            </button>

            </div>

        </div>

    </div>
}

@code {
    private bool Cargando = true;
    private bool Guardando;

    private string Busqueda = string.Empty;
    private string EtapaFiltro = string.Empty;
    private string EmpleadoFiltro = string.Empty;

    private string Mensaje = string.Empty;
    private bool MensajeEsError;

    private UserDataScope Scope { get; set; } = new();

    private bool FiltroEmpleadoBloqueado;

    private bool MostrarModalResultadoFinalizacion;

    private string TituloModalResultadoFinalizacion =
        string.Empty;

    private string MensajeModalResultadoFinalizacion =
        string.Empty;

    private string TipoModalResultadoFinalizacion =
        "success";

    private bool MostrarModalVerificacionFinalPO;

    private bool ClosingCorrectionsConfirmed;
    private bool LateWorkConfirmed;

    private string MensajeVerificacionFinalPO =
        string.Empty;

    private DateOnly Hoy =>
        DateOnly.FromDateTime(DateTime.Today);

    private List<EmployeeOptionVm> Empleados = new();

    private List<AsignacionDiaVm> AsignacionesDia = new();

    private List<AsignacionDiaVm> AsignacionesFiltradas = new();

    private List<AsignacionDiaVm>
        AsignacionesFinalPOPendientesVerificacion = new();

    private readonly HashSet<string> Seleccionadas =
        new(StringComparer.Ordinal);


    private int TotalCompletadas =>
        AsignacionesDia.Count(x => x.YaCompletada);

    protected override async Task OnInitializedAsync()
    {
        var authState =
            await AuthStateProvider.GetAuthenticationStateAsync();

        Scope =
            await UserDataScopeService.GetScopeAsync(
                authState.User);

        DetectarEmpleadoDelUsuario(authState.User);

        await CargarDatosAsync();
    }

    private void DetectarEmpleadoDelUsuario(
        System.Security.Claims.ClaimsPrincipal user)
    {
        if (Scope.ViewAllEmployeeTypes)
            return;

        var employeeClaim =
            user.FindFirst("EmployeeId")?.Value ??
            user.FindFirst("Employee_Id")?.Value ??
            user.FindFirst("EmpleadoId")?.Value ??
            user.FindFirst("IdEmpleado")?.Value;

        if (!Guid.TryParse(
                employeeClaim,
                out var employeeId) ||
            employeeId == Guid.Empty)
        {
            return;
        }

        EmpleadoFiltro = employeeId.ToString();

        FiltroEmpleadoBloqueado = true;
    }

    private async Task CargarDatosAsync()
    {
        Cargando = true;

        Mensaje = string.Empty;
        MensajeEsError = false;

        Seleccionadas.Clear();

        try
        {
            await using var db =
                await DbFactory.CreateDbContextAsync();

            var hoy = Hoy;

            await ActualizarFinalizadosPorDirxionAsync(
                db,
                hoy);

            Empleados = await db.Empleados
                .AsNoTracking()
                .ApplyScope(Scope)
                .OrderBy(e => e.Nombre)
                .Select(e => new EmployeeOptionVm
                {
                    Id = e.Id,
                    Nombre = e.Nombre ?? string.Empty
                })
                .ToListAsync();

            var data = await (
                from a in db.Asignaciones.AsNoTracking()

                join l in db.Libros.AsNoTracking()
                    on a.IdLibro equals l.Id

                join e in db.Empleados.AsNoTracking()
                    on a.IdEmpleado equals e.Id

                join et in db.EmployeeTypes.AsNoTracking()
                    on l.EmployeeTypeId equals et.Id

                join bpJoin in db.Bind_Plants.AsNoTracking()
                    on l.BindPlantId equals bpJoin.Id
                    into bindPlantGroup

                from bp in bindPlantGroup.DefaultIfEmpty()

                where
                    !a.Finalizado &&
                    !l.Finalizado &&
                    l.DirxionDate >= hoy &&
                    (
                        Scope.ViewAllEmployeeTypes ||
                        l.EmployeeTypeId ==
                        Scope.EmployeeTypeId
                    )

                select new RawAssignmentVm
                {
                    AssignmentId = a.Id,
                    EmployeeId = e.Id,
                    BookId = l.Id,

                    EmployeeName =
                        e.Nombre ?? string.Empty,

                    EmployeeTypeId =
                        l.EmployeeTypeId,

                    EmployeeTypeCode =
                        et.Code ?? string.Empty,

                    KgenCode =
                        l.KGENCode ?? string.Empty,

                    LsaCode =
                        l.LSACode ?? string.Empty,

                    BookName =
                        l.BookName ?? string.Empty,

                    ProofExtract =
                        l.ProofExtract,

                    FinalExtract =
                        l.FinalExtract,

                    MemoExtract =
                        l.MemoExtract,

                    DirxionDate =
                        l.DirxionDate,

                    FinalPODate =
                        l.FinalPODate,

                    ShippingDate =
                        l.ShippingDate,

                    BindPlantName =
                        bp != null
                            ? bp.Bind_Plant_Name ?? string.Empty
                            : string.Empty
                }
            )
            .ToListAsync();


            AsignacionesDia.Clear();

            if (data.Count == 0)
            {
                AplicarFiltros();
                return;
            }


            var assignmentIds = data
                .Select(x => x.AssignmentId)
                .Distinct()
                .ToList();

            var temporalesActivas =
                await db.TemporaryAssignments
                    .AsNoTracking()

                    .Where(x =>
                        x.Active &&
                        assignmentIds.Contains(
                            x.AssignmentId))

                    .OrderByDescending(
                        x => x.CreatedAt)

                    .Select(x =>
                        new TemporaryAssignmentLookupVm
                        {
                            AssignmentId =
                                x.AssignmentId,

                            TemporaryEmployeeId =
                                x.TemporaryEmployeeId,

                            TemporaryEmployeeName =
                                x.TemporaryEmployee != null
                                    ? x.TemporaryEmployee.Nombre
                                        ?? string.Empty
                                    : string.Empty,

                            Proof = x.Proof,
                            Final = x.Final,
                            Memo = x.Memo,
                            FinalPO = x.FinalPO,
                            Shipping = x.Shipping,
                            Dirxion = x.Dirxion
                        })

                    .ToListAsync();


            var temporalesPorAsignacion =
                temporalesActivas
                    .GroupBy(
                        x => x.AssignmentId)
                    .ToDictionary(
                        g => g.Key,
                        g => g.ToList());

            var registrosTrabajadosRaw =
                await db.AsignacionesTrabajadas
                    .AsNoTracking()

                    .Where(x =>
                        assignmentIds.Contains(
                            x.IdAsignacion))

                    .Select(x =>
                        new WorkedStateVm
                        {
                            AssignmentId =
                                x.IdAsignacion,

                            ProofExtractWorked =
                                x.ProofExtractWorked,

                            FinalExtractWorked =
                                x.FinalExtractWorked,

                            MemoExtractWorked =
                                x.MemoExtractWorked,

                            FinalPOWorked =
                                x.FinalPOWorked,

                            ShippingWorked =
                                x.ShippingWorked,

                            DirxionWorked =
                                x.DirxionWorked
                        })

                    .ToListAsync();

            var registrosTrabajados =
                registrosTrabajadosRaw
                    .GroupBy(
                        x => x.AssignmentId)

                    .ToDictionary(
                        g => g.Key,
                        g => new WorkedStateVm
                        {
                            AssignmentId = g.Key,

                            ProofExtractWorked =
                                g.Any(x =>
                                    x.ProofExtractWorked),

                            FinalExtractWorked =
                                g.Any(x =>
                                    x.FinalExtractWorked),

                            MemoExtractWorked =
                                g.Any(x =>
                                    x.MemoExtractWorked),

                            FinalPOWorked =
                                g.Any(x =>
                                    x.FinalPOWorked),

                            ShippingWorked =
                                g.Any(x =>
                                    x.ShippingWorked),

                            DirxionWorked =
                                g.Any(x =>
                                    x.DirxionWorked)
                        });

            foreach (var item in data)
            {
                var etapa =
                    ObtenerEtapaDelDia(
                        item,
                        hoy);

                if (etapa is null)
                    continue;


                TemporaryAssignmentLookupVm?
                    temporalAplicable = null;


                if (temporalesPorAsignacion.TryGetValue(
                        item.AssignmentId,
                        out var temporales))
                {
                    temporalAplicable =
                        temporales.FirstOrDefault(
                            x =>
                                AsignacionTemporalAplicaEtapa(
                                    x,
                                    etapa.Key));
                }


                var empleadoResponsableId =
                    temporalAplicable
                        ?.TemporaryEmployeeId
                    ?? item.EmployeeId;


                var empleadoResponsableNombre =
                    temporalAplicable
                        ?.TemporaryEmployeeName;


                if (string.IsNullOrWhiteSpace(
                        empleadoResponsableNombre))
                {
                    empleadoResponsableNombre =
                        item.EmployeeName;
                }


                registrosTrabajados.TryGetValue(
                    item.AssignmentId,
                    out var registroTrabajado);


                AsignacionesDia.Add(
                    new AsignacionDiaVm
                    {
                        AssignmentId =
                            item.AssignmentId,

                        EmployeeId =
                            empleadoResponsableId,

                        BookId =
                            item.BookId,

                        EmployeeName =
                            empleadoResponsableNombre,

                        EmployeeTypeId =
                            item.EmployeeTypeId,

                        EmployeeTypeCode =
                            item.EmployeeTypeCode,

                        KgenCode =
                            item.KgenCode,

                        LsaCode =
                            item.LsaCode,

                        BookName =
                            item.BookName,

                        BindPlantName =
                            item.BindPlantName,

                        StageKey =
                            etapa.Key,

                        StageName =
                            etapa.Name,

                        StageDate =
                            etapa.Date,

                        YaCompletada =
                            EstaEtapaCompletada(
                                registroTrabajado,
                                etapa.Key)
                    });
            }


            AplicarFiltros();
        }
        catch (Exception ex)
        {
            MensajeEsError = true;
            Mensaje = string.Empty;

            MostrarResultadoFinalizacion(
                "Unable to load assignments",
                $"Assignments could not be loaded. Details: {ex.Message}",
                "error");
        }
        finally
        {
            Cargando = false;
        }
    }

    private static bool AsignacionTemporalAplicaEtapa(
        TemporaryAssignmentLookupVm temporal,
        string etapaKey)
    {
        return etapaKey switch
        {
            "ProofExtract" =>
                temporal.Proof,

            "FinalExtract" =>
                temporal.Final,

            "MemoExtract" =>
                temporal.Memo,

            "FinalPO" =>
                temporal.FinalPO,

            "Shipping" =>
                temporal.Shipping,

            "Dirxion" =>
                temporal.Dirxion,

            _ => false
        };
    }

    private EtapaDia? ObtenerEtapaDelDia(
        RawAssignmentVm item,
        DateOnly hoy)
    {
        var bindPlantName =
            (item.BindPlantName ?? string.Empty)
                .Trim()
                .ToUpperInvariant();


        var esIveauOWstr =
            EsBindPlant(
                bindPlantName,
                "IVEAU",
                "WSTR");


        var esNzShipping =
            EsBindPlant(
                bindPlantName,
                "WSTR",
                "NZ");


        var excluirMemoPorBindPlant =
            EsBindPlant(
                bindPlantName,
                "PREM",
                "DIRX",
                "WSTR",
                "IVEAU");


        var proofDisplayDate =
            GetNextBusinessDay(
                item.ProofExtract);


        var finalDisplayDate =
            GetNextBusinessDay(
                item.FinalExtract);


        var memoDisplayDate =
            GetNextBusinessDay(
                item.MemoExtract);


        var finalPODisplayDate =
            esIveauOWstr
                ? GetPreviousWorkDate(
                    item.FinalPODate,
                    3)
                : item.FinalPODate;


        var shippingDisplayDate =
            esNzShipping
                ? GetPreviousWorkDate(
                    item.ShippingDate,
                    1)
                : item.ShippingDate;


        if (proofDisplayDate == hoy)
        {
            return new EtapaDia(
                "ProofExtract",
                "Proof Extract",
                proofDisplayDate);
        }


        if (finalDisplayDate == hoy)
        {
            return new EtapaDia(
                "FinalExtract",
                "Final Extract",
                finalDisplayDate);
        }


        if (memoDisplayDate == hoy &&
            !excluirMemoPorBindPlant)
        {
            return new EtapaDia(
                "MemoExtract",
                "Memo Extract",
                memoDisplayDate);
        }


        if (finalPODisplayDate == hoy)
        {
            return new EtapaDia(
                "FinalPO",
                "Final PO Date",
                finalPODisplayDate);
        }


        if (shippingDisplayDate == hoy)
        {
            return new EtapaDia(
                "Shipping",
                "Shipping Date",
                shippingDisplayDate);
        }


        if (item.DirxionDate == hoy)
        {
            return new EtapaDia(
                "Dirxion",
                "Dirxion Date",
                item.DirxionDate);
        }


        return null;
    }

    private static DateOnly GetNextBusinessDay(
        DateOnly sourceDate)
    {
        if (sourceDate == default)
            return default;


        var result =
            sourceDate.AddDays(1);


        while (
            result.DayOfWeek is
                DayOfWeek.Saturday or
                DayOfWeek.Sunday)
        {
            result =
                result.AddDays(1);
        }


        return result;
    }


    private static DateOnly GetPreviousWorkDate(
        DateOnly sourceDate,
        int daysBefore)
    {
        if (sourceDate == default)
            return default;


        var result =
            sourceDate.AddDays(
                -daysBefore);


        while (
            result.DayOfWeek is
                DayOfWeek.Saturday or
                DayOfWeek.Sunday)
        {
            result =
                result.AddDays(-1);
        }


        return result;
    }

    private async Task ActualizarFinalizadosPorDirxionAsync(
        AppDbContext db,
        DateOnly today)
    {
        var librosParaFinalizar =
            await db.Libros
                .ApplyScope(Scope)

                .AsSplitQuery()

                .Include(l =>
                    l.Asignaciones)

                .ThenInclude(a =>
                    a.Evaluaciones)

                .Where(l =>
                    !l.Finalizado &&
                    l.DirxionDate < today)

                .ToListAsync();


        if (librosParaFinalizar.Count == 0)
            return;


        foreach (var libro in librosParaFinalizar)
        {
            libro.Finalizado = true;


            foreach (var asignacion
                     in libro.Asignaciones)
            {
                asignacion.Finalizado = true;


                foreach (var evaluacion
                         in asignacion.Evaluaciones)
                {
                    evaluacion.Finalizado = true;
                }
            }
        }


        await db.SaveChangesAsync();
    }

    private static bool EstaEtapaCompletada(
        WorkedStateVm? registro,
        string etapaKey)
    {
        if (registro is null)
            return false;


        return etapaKey switch
        {
            "ProofExtract" =>
                registro.ProofExtractWorked,

            "FinalExtract" =>
                registro.FinalExtractWorked,

            "MemoExtract" =>
                registro.MemoExtractWorked,

            "FinalPO" =>
                registro.FinalPOWorked,

            "Shipping" =>
                registro.ShippingWorked,

            "Dirxion" =>
                registro.DirxionWorked,

            _ => false
        };
    }

    private void AplicarFiltros()
    {
        IEnumerable<AsignacionDiaVm> query =
            AsignacionesDia;

        if (Guid.TryParse(
                EmpleadoFiltro,
                out var empleadoId) &&
            empleadoId != Guid.Empty)
        {
            query =
                query.Where(
                    x =>
                        x.EmployeeId ==
                        empleadoId);
        }

        if (!string.IsNullOrWhiteSpace(
                EtapaFiltro))
        {
            query =
                query.Where(
                    x =>
                        string.Equals(
                            x.StageKey,
                            EtapaFiltro,
                            StringComparison.Ordinal));
        }

        if (!string.IsNullOrWhiteSpace(
                Busqueda))
        {
            var term =
                Busqueda.Trim();


            query =
                query.Where(x =>
                    Contiene(
                        x.EmployeeName,
                        term) ||

                    Contiene(
                        x.BookName,
                        term) ||

                    Contiene(
                        x.KgenCode,
                        term) ||

                    Contiene(
                        x.LsaCode,
                        term));
        }


        AsignacionesFiltradas =
            query
                .OrderBy(x =>
                    x.StageDate)

                .ThenBy(x =>
                    x.EmployeeName)

                .ThenBy(x =>
                    x.BookName)

                .ToList();

        if (Seleccionadas.Count > 0)
        {
            var keysVisibles =
                AsignacionesFiltradas
                    .Select(GetRowKey)
                    .ToHashSet(
                        StringComparer.Ordinal);


            Seleccionadas.RemoveWhere(
                key =>
                    !keysVisibles.Contains(
                        key));
        }
    }


    private static bool Contiene(
        string? valor,
        string term)
    {
        if (string.IsNullOrEmpty(valor))
            return false;


        return valor.Contains(
            term,
            StringComparison.OrdinalIgnoreCase);
    }

    private void OnEmpleadoChanged(
        ChangeEventArgs e)
    {
        EmpleadoFiltro =
            e.Value?.ToString()
            ?? string.Empty;


        AplicarFiltros();
    }


    private void OnBusquedaChanged(
        ChangeEventArgs e)
    {
        Busqueda =
            e.Value?.ToString()
            ?? string.Empty;


        AplicarFiltros();
    }


    private void OnEtapaChanged(
        ChangeEventArgs e)
    {
        EtapaFiltro =
            e.Value?.ToString()
            ?? string.Empty;


        AplicarFiltros();
    }

    private void ToggleSeleccion(
        AsignacionDiaVm item,
        ChangeEventArgs e)
    {
        var isChecked =
            e.Value is bool b && b;


        var key =
            GetRowKey(item);


        if (isChecked)
        {
            Seleccionadas.Add(key);
        }
        else
        {
            Seleccionadas.Remove(key);
        }
    }


    private void SeleccionarTodas()
    {
        foreach (
            var item in
            AsignacionesFiltradas.Where(
                x => !x.YaCompletada))
        {
            Seleccionadas.Add(
                GetRowKey(item));
        }
    }


    private void LimpiarSeleccion()
    {
        Seleccionadas.Clear();
    }

    private async Task PrepararGuardadoAsync()
    {
        if (Seleccionadas.Count == 0 ||
            Guardando)
        {
            return;
        }


        Mensaje = string.Empty;

        MensajeVerificacionFinalPO =
            string.Empty;


        var seleccion =
            ObtenerSeleccionPendiente();


        if (seleccion.Count == 0)
        {
            MostrarResultadoFinalizacion(
                "No pending assignments",
                "There are no pending assignments selected.",
                "error");

            return;
        }


        AsignacionesFinalPOPendientesVerificacion =
            seleccion
                .Where(
                    RequiereVerificacionFinalPO)

                .OrderBy(x =>
                    x.EmployeeName)

                .ThenBy(x =>
                    x.BookName)

                .ToList();


        if (AsignacionesFinalPOPendientesVerificacion.Count > 0)
        {
            ClosingCorrectionsConfirmed =
                false;

            LateWorkConfirmed =
                false;

            MostrarModalVerificacionFinalPO =
                true;

            return;
        }


        await GuardarSeleccionadasAsync(
            verificacionesFinalPOConfirmadas: false);
    }

    private async Task ConfirmarVerificacionesFinalPOAsync()
    {
        MensajeVerificacionFinalPO =
            string.Empty;


        if (!ClosingCorrectionsConfirmed ||
            !LateWorkConfirmed)
        {
            MensajeVerificacionFinalPO =
                "Both confirmations are required before completing the Final PO assignments.";

            return;
        }


        await GuardarSeleccionadasAsync(
            verificacionesFinalPOConfirmadas: true);
    }

    private List<AsignacionDiaVm>
        ObtenerSeleccionPendiente()
    {
        if (Seleccionadas.Count == 0)
            return new();


        return AsignacionesDia
            .Where(x =>
                Seleccionadas.Contains(
                    GetRowKey(x)) &&
                !x.YaCompletada)

            .ToList();
    }

    private async Task GuardarSeleccionadasAsync(
        bool verificacionesFinalPOConfirmadas)
    {
        if (Seleccionadas.Count == 0 ||
            Guardando)
        {
            return;
        }


        Guardando = true;

        Mensaje = string.Empty;

        MensajeVerificacionFinalPO =
            string.Empty;


        try
        {
            var seleccion =
                ObtenerSeleccionPendiente();


            if (seleccion.Count == 0)
            {
                MostrarResultadoFinalizacion(
                    "No pending assignments",
                    "There are no pending assignments selected.",
                    "error");

                return;
            }


            var totalSeleccionadas =
                seleccion.Count;

            var finalPOQueRequiereVerificacion =
                seleccion
                    .Where(
                        RequiereVerificacionFinalPO)

                    .ToList();


            if (
                finalPOQueRequiereVerificacion.Count > 0 &&
                (
                    !verificacionesFinalPOConfirmadas ||
                    !ClosingCorrectionsConfirmed ||
                    !LateWorkConfirmed
                ))
            {
                AsignacionesFinalPOPendientesVerificacion =
                    finalPOQueRequiereVerificacion;


                MostrarModalVerificacionFinalPO =
                    true;


                MensajeVerificacionFinalPO =
                    "Both confirmations are required before completing the Final PO assignments.";

                return;
            }


            await using var db =
                await DbFactory.CreateDbContextAsync();


            var asignacionIds =
                seleccion
                    .Select(x =>
                        x.AssignmentId)

                    .Distinct()

                    .ToList();

            var accessibleAssignmentIds =
                await db.Asignaciones
                    .AsNoTracking()

                    .ApplyScope(Scope)

                    .Where(x =>
                        asignacionIds.Contains(
                            x.Id))

                    .Select(x =>
                        x.Id)

                    .ToListAsync();


            if (accessibleAssignmentIds.Count !=
                asignacionIds.Count)
            {
                throw new UnauthorizedAccessException(
                    "One or more assignments are outside your employee type scope.");
            }

            var registrosExistentes =
                await db.AsignacionesTrabajadas

                    .Where(x =>
                        asignacionIds.Contains(
                            x.IdAsignacion))

                    .ToListAsync();

            var registrosPorAsignacion =
                registrosExistentes

                    .GroupBy(x =>
                        x.IdAsignacion)

                    .ToDictionary(
                        g => g.Key,
                        g => g.First());


            var verifiedAt =
                DateTime.UtcNow;

            foreach (var item in seleccion)
            {
                if (!registrosPorAsignacion.TryGetValue(
                        item.AssignmentId,
                        out var registro))
                {
                    registro =
                        new AsignacionTrabajada
                        {
                            Id =
                                Guid.NewGuid(),

                            IdAsignacion =
                                item.AssignmentId,

                            FechaTrabajo =
                                Hoy
                        };


                    db.AsignacionesTrabajadas.Add(
                        registro);


                    registrosPorAsignacion[
                        item.AssignmentId] =
                        registro;
                }

                if (RequiereVerificacionFinalPO(
                        item))
                {
                    registro.ClosingCorrectionsVerified =
                        true;

                    registro.LateWorkVerified =
                        true;

                    registro.FinalPOVerifiedAt =
                        verifiedAt;

                    registro.FinalPOVerifiedByUserId =
                        Scope.UserId;
                }

                MarcarEtapa(
                    registro,
                    item.StageKey);
            }

            await db.SaveChangesAsync();

            foreach (var item in seleccion)
            {
                item.YaCompletada = true;
            }


            Seleccionadas.Clear();

            ResetearModalVerificacionFinalPO();

            AplicarFiltros();


            MensajeEsError = false;
            Mensaje = string.Empty;


            MostrarResultadoFinalizacion(
                totalSeleccionadas == 1
                    ? "Assignment completed"
                    : "Assignments completed",

                totalSeleccionadas == 1
                    ? "The selected assignment was marked as completed successfully."
                    : $"{totalSeleccionadas} selected assignments were marked as completed successfully.",

                "success");
        }
        catch (Exception ex)
        {
            MensajeEsError = true;
            Mensaje = string.Empty;


            if (MostrarModalVerificacionFinalPO)
            {
                MensajeVerificacionFinalPO =
                    ex.Message;
            }
            else
            {
                MostrarResultadoFinalizacion(
                    "Unable to complete assignments",

                    $"The information could not be saved. Details: {ex.Message}",

                    "error");
            }
        }
        finally
        {
            Guardando = false;
        }
    }

    private static bool RequiereVerificacionFinalPO(
        AsignacionDiaVm item)
    {
        return
            string.Equals(
                item.StageKey,
                "FinalPO",
                StringComparison.OrdinalIgnoreCase)

            &&

            !EsBindPlant(
                item.BindPlantName,
                "IVEAU");
    }

    private static bool EsBindPlant(
        string? bindPlantName,
        params string[] codigos)
    {
        if (string.IsNullOrWhiteSpace(
                bindPlantName))
        {
            return false;
        }


        var normalizado =
            bindPlantName
                .Trim()
                .ToUpperInvariant();


        foreach (var codigo in codigos)
        {
            if (normalizado ==
                codigo
                    .Trim()
                    .ToUpperInvariant())
            {
                return true;
            }
        }


        var partes =
            normalizado.Split(
                new[]
                {
                    ' ',
                    '-',
                    '_',
                    '/',
                    '\\',
                    ',',
                    ';',
                    '.',
                    '|',
                    '(',
                    ')',
                    '[',
                    ']'
                },
                StringSplitOptions.RemoveEmptyEntries);


        foreach (var parte in partes)
        {
            foreach (var codigo in codigos)
            {
                if (parte ==
                    codigo
                        .Trim()
                        .ToUpperInvariant())
                {
                    return true;
                }
            }
        }


        return false;
    }

    private void CancelarVerificacionFinalPO()
    {
        if (Guardando)
            return;


        ResetearModalVerificacionFinalPO();
    }


    private void ResetearModalVerificacionFinalPO()
    {
        MostrarModalVerificacionFinalPO =
            false;

        ClosingCorrectionsConfirmed =
            false;

        LateWorkConfirmed =
            false;

        MensajeVerificacionFinalPO =
            string.Empty;

        AsignacionesFinalPOPendientesVerificacion.Clear();
    }

    private void MostrarResultadoFinalizacion(
        string titulo,
        string mensaje,
        string tipo)
    {
        TituloModalResultadoFinalizacion =
            titulo;

        MensajeModalResultadoFinalizacion =
            mensaje;


        TipoModalResultadoFinalizacion =
            string.Equals(
                tipo,
                "error",
                StringComparison.OrdinalIgnoreCase)
                    ? "error"
                    : "success";


        MostrarModalResultadoFinalizacion =
            true;
    }


    private void CerrarModalResultadoFinalizacion()
    {
        MostrarModalResultadoFinalizacion =
            false;

        TituloModalResultadoFinalizacion =
            string.Empty;

        MensajeModalResultadoFinalizacion =
            string.Empty;

        TipoModalResultadoFinalizacion =
            "success";
    }

    private static string GetRowClass(
        AsignacionDiaVm item,
        bool selected)
    {
        if (item.YaCompletada)
        {
            return "row-completed";
        }


        if (selected)
        {
            return "row-selected";
        }


        return string.Empty;
    }

    private static void MarcarEtapa(
        AsignacionTrabajada registro,
        string etapaKey)
    {
        switch (etapaKey)
        {
            case "ProofExtract":

                registro.ProofExtractWorked =
                    true;

                break;


            case "FinalExtract":

                registro.FinalExtractWorked =
                    true;

                break;


            case "MemoExtract":

                registro.MemoExtractWorked =
                    true;

                break;


            case "FinalPO":

                registro.FinalPOWorked =
                    true;

                break;


            case "Shipping":

                registro.ShippingWorked =
                    true;

                break;


            case "Dirxion":

                registro.DirxionWorked =
                    true;

                break;
        }
    }

    private static string GetRowKey(
        AsignacionDiaVm item)
    {
        return string.Concat(
            item.AssignmentId,
            "-",
            item.StageKey,
            "-",
            item.StageDate.ToString("yyyyMMdd"));
    }

