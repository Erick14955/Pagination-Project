@page "/dashboard"
@attribute [Authorize]

@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Pagination_Project.Models
@using Pagination_Project.Services

@inject IDashboardService DashboardService
@inject AuthenticationStateProvider AuthenticationStateProvider

@layout Pagination_Project.Components.Layout.DashboardLayout
@rendermode InteractiveServer

<PageTitle>Dashboard - Evaluations</PageTitle>

<link href="style/dashboard.css" rel="stylesheet" />

<div class="thryv-dashboard-page">

    <section class="thryv-dashboard-header">
        <div class="thryv-dashboard-hero-content">
            <h2 class="thryv-dashboard-title">General Dashboard</h2>
            <p class="thryv-dashboard-subtitle">
                Quick system summary and current list of assigned books.
            </p>
        </div>

        <div class="thryv-dashboard-hero-stats">
            @if (loading)
            {
                <div class="thryv-hero-stat-card">
                    <span>LOADING</span>
                    <strong>...</strong>
                </div>
            }
            else
            {
                @if (PuedeVerUsuarios)
                {
                    <div class="thryv-hero-stat-card">
                        <span>TOTAL USERS</span>
                        <strong>@stats.TotalUsers</strong>
                    </div>
                }

                @if (PuedeVerEmpleados)
                {
                    <div class="thryv-hero-stat-card">
                        <span>EMPLOYEES</span>
                        <strong>@stats.TotalEmployees</strong>
                    </div>
                }

                @if (PuedeVerLibros)
                {
                    <div class="thryv-hero-stat-card">
                        <span>ACTIVE BOOKS</span>
                        <strong>@stats.TotalBooks</strong>
                    </div>
                }

                @if (PuedeVerEvaluaciones)
                {
                    <div class="thryv-hero-stat-card">
                        <span>EVALUATIONS</span>
                        <strong>@stats.TotalEvaluations</strong>
                    </div>

                    <div class="thryv-hero-stat-card">
                        <span>LAST WEEK EVALUATIONS</span>
                        <strong>@weeklyEvaluations.Count</strong>
                    </div>
                }

                @if (PuedeVerAsignaciones)
                {
                    <div class="thryv-hero-stat-card">
                        <span>PENDING TODAY</span>
                        <strong>@assignedBooks.Count</strong>
                    </div>

                    <div class="thryv-hero-stat-card">
                        <span>COMPLETED TODAY</span>
                        <strong>@completedAssignments.Count</strong>
                    </div>
                }
            }
        </div>
    </section>

    @if (PuedeVerAsignaciones)
    {
        <div class="thryv-section-card">
            <div class="thryv-section-header">
                <div>
                    <h3>Assigned Books</h3>
                    <p>Live view of pending assignments based on the current stage of the day.</p>
                </div>

                <div class="thryv-section-actions">
                    <div class="thryv-filter-group">
                        <label>Filter by employee</label>

                        <select class="thryv-filter-select" @bind="SelectedAssignedEmployeeFilter">
                            <option value="">All Employees</option>

                            @foreach (var employee in AssignedEmployeeFilterOptions)
                            {
                                <option value="@employee">@employee</option>
                            }
                        </select>
                    </div>

                    <div class="thryv-filter-group">
                        <label>Filter by stage</label>

                        <select class="thryv-filter-select" @bind="SelectedAssignedStageFilter">
                            <option value="">All Stages</option>

                            @foreach (var stage in StageFilterOptions)
                            {
                                <option value="@stage.Key">@stage.Label</option>
                            }
                        </select>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(SelectedAssignedEmployeeFilter) ||
                                    !string.IsNullOrWhiteSpace(SelectedAssignedStageFilter))
                    {
                        <button type="button"
                                class="thryv-clear-filter-btn"
                                @onclick="ClearAssignedFilters">
                            Clear
                        </button>
                    }

                    <div class="thryv-section-badge">
                        @AssignedBooksFiltered.Count records
                    </div>
                </div>
            </div>

            <div class="thryv-table-wrapper">
                <table class="thryv-custom-table">
                    <thead>
                        <tr>
                            <th>Employee</th>
                            <th>KGEN Code</th>
                            <th>LSA Code</th>
                            <th>Book</th>
                            <th>Stage</th>
                            <th>Stage Date</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (loading)
                        {
                            <tr>
                                <td colspan="6" class="thryv-empty-row">
                                    Loading statistics...
                                </td>
                            </tr>
                        }
                        else if (AssignedBooksFiltered.Count == 0)
                        {
                            <tr>
                                <td colspan="6" class="thryv-empty-row">
                                    No pending assignments for today.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in AssignedBooksFiltered)
                            {
                                <tr>
                                    <td>
                                        <div class="thryv-employee-cell">
                                            <div class="thryv-employee-avatar">👤</div>
                                            <div>
                                                <div class="thryv-employee-name">@item.EmployeeName</div>
                                            </div>
                                        </div>
                                    </td>

                                    <td>
                                        <span class="thryv-code-pill">@item.KgenCode</span>
                                    </td>

                                    <td>
                                        <span class="thryv-code-pill secondary">@item.LsaCode</span>
                                    </td>

                                    <td>@item.BookName</td>

                                    <td>
                                        <span class="thryv-stage-pill">
                                            @item.Stage
                                        </span>
                                    </td>

                                    <td>@(item.StageDate?.ToString("dd/MM/yyyy") ?? "-")</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="thryv-section-card completed-section-card">
            <div class="thryv-section-header">
                <div>
                    <h3>Completed Assignments</h3>
                    <p>Assignments completed today by employees, grouped by completion status.</p>
                </div>

                <div class="thryv-section-actions">
                    <div class="thryv-filter-group">
                        <label>Filter by employee</label>

                        <select class="thryv-filter-select" @bind="SelectedCompletedEmployeeFilter">
                            <option value="">All Employees</option>

                            @foreach (var employee in CompletedEmployeeFilterOptions)
                            {
                                <option value="@employee">@employee</option>
                            }
                        </select>
                    </div>

                    <div class="thryv-filter-group">
                        <label>Filter by completed stage</label>

                        <select class="thryv-filter-select" @bind="SelectedCompletedStageFilter">
                            <option value="">All Completed Stages</option>

                            @foreach (var stage in CompletedStageFilterOptions)
                            {
                                <option value="@stage.Key">@stage.Label</option>
                            }
                        </select>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(SelectedCompletedEmployeeFilter) ||
                                    !string.IsNullOrWhiteSpace(SelectedCompletedStageFilter))
                    {
                        <button type="button"
                                class="thryv-clear-filter-btn"
                                @onclick="ClearCompletedFilters">
                            Clear
                        </button>
                    }

                    <div class="thryv-section-badge">
                        @CompletedAssignmentsFiltered.Count records
                    </div>
                </div>
            </div>

            <div class="thryv-table-wrapper">
                <table class="thryv-custom-table">
                    <thead>
                        <tr>
                            <th>Employee</th>
                            <th>KGEN Code</th>
                            <th>LSA Code</th>
                            <th>Book</th>
                            <th>Completion Status</th>
                            <th>Stage Date</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (loading)
                        {
                            <tr>
                                <td colspan="6" class="thryv-empty-row">
                                    Loading completed assignments...
                                </td>
                            </tr>
                        }
                        else if (CompletedAssignmentsFiltered.Count == 0)
                        {
                            <tr>
                                <td colspan="6" class="thryv-empty-row">
                                    No completed assignments for today.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in CompletedAssignmentsFiltered)
                            {
                                <tr>
                                    <td>
                                        <div class="thryv-employee-cell">
                                            <div class="thryv-employee-avatar completed-avatar">✅</div>
                                            <div>
                                                <div class="thryv-employee-name">@item.EmployeeName</div>
                                            </div>
                                        </div>
                                    </td>

                                    <td>
                                        <span class="thryv-code-pill">@item.KgenCode</span>
                                    </td>

                                    <td>
                                        <span class="thryv-code-pill secondary">@item.LsaCode</span>
                                    </td>

                                    <td>@item.BookName</td>

                                    <td>
                                        <span class="thryv-stage-pill completed-stage-pill">
                                            @item.CompletionStatus
                                        </span>
                                    </td>

                                    <td>@(item.StageDate?.ToString("dd/MM/yyyy") ?? "-")</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <div class="thryv-section-card weekly-evaluations-section-card">
        <div class="thryv-section-header">
            <div>
                <h3>Weekly Evaluations</h3>
                <p>Evaluations from last week based on the book shipping date.</p>
            </div>

            <div class="thryv-section-actions">
                <div class="thryv-filter-group">
                    <label>Filter by employee</label>

                    <select class="thryv-filter-select" @bind="SelectedWeeklyEmployeeFilter">
                        <option value="">All Employees</option>

                        @foreach (var employee in WeeklyEmployeeFilterOptions)
                        {
                            <option value="@employee">@employee</option>
                        }
                    </select>
                </div>

                <div class="thryv-search-box">
                    <span>🔎</span>
                    <input placeholder="Search by KGEN or book..."
                            @bind="WeeklySearch"
                            @bind:event="oninput" />
                </div>

                @if (!string.IsNullOrWhiteSpace(SelectedWeeklyEmployeeFilter) ||
                                !string.IsNullOrWhiteSpace(WeeklySearch))
                {
                    <button type="button"
                            class="thryv-clear-filter-btn"
                            @onclick="ClearWeeklyFilters">
                        Clear
                    </button>
                }

                <div class="thryv-section-badge">
                    @WeeklyEvaluationsFiltered.Count records
                </div>
            </div>
        </div>

        <div class="thryv-table-wrapper">
            <table class="thryv-custom-table">
                <thead>
                    <tr>
                        <th>Employee</th>
                        <th>KGEN Code</th>
                        <th>Book</th>
                        <th>Shipping Date</th>
                        <th>Total Accuracy</th>
                        <th>Details</th>
                    </tr>
                </thead>

                <tbody>
                    @if (loading)
                    {
                        <tr>
                            <td colspan="6" class="thryv-empty-row">
                                Loading weekly evaluations...
                            </td>
                        </tr>
                    }
                    else if (WeeklyEvaluationsFiltered.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="thryv-empty-row">
                                No weekly evaluations to display.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in WeeklyEvaluationsFiltered)
                        {
                            <tr>
                                <td>
                                    <div class="thryv-employee-cell">
                                        <div class="thryv-employee-avatar weekly-avatar">📊</div>
                                        <div>
                                            <div class="thryv-employee-name">@item.EmployeeName</div>
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    <span class="thryv-code-pill">@item.KgenCode</span>
                                </td>

                                <td>@item.BookName</td>

                                <td>@item.ShippingDate.ToString("dd/MM/yyyy")</td>

                                <td>
                                    <span class="thryv-percent-pill @GetAccuracyClass(item.PercentageAverage)">
                                        @item.PercentageAverage.ToString("0.00")%
                                    </span>
                                </td>

                                <td>
                                    <button type="button"
                                            class="thryv-paper-btn"
                                            title="View evaluation details"
                                            @onclick="() => OpenWeeklyEvaluationModal(item)">
                                        📄
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (showWeeklyEvaluationModal && selectedWeeklyEvaluation is not null)
{
    <div class="weekly-evaluation-modal-backdrop" @onclick="CloseWeeklyEvaluationModal">
        <div class="weekly-evaluation-modal" @onclick:stopPropagation="true">

            <div class="weekly-evaluation-modal-header">
                <div>
                    <span class="weekly-modal-eyebrow">Evaluation Details</span>
                    <h3>@selectedWeeklyEvaluation.BookName</h3>
                    <p>
                        @selectedWeeklyEvaluation.EmployeeName · KGEN:
                        <strong>@selectedWeeklyEvaluation.KgenCode</strong>
                    </p>
                </div>

                <button type="button"
                        class="weekly-modal-close"
                        @onclick="CloseWeeklyEvaluationModal">
                    ✕
                </button>
            </div>

            <div class="weekly-evaluation-summary-grid">
                <div class="weekly-summary-card">
                    <span>Employee</span>
                    <strong>@selectedWeeklyEvaluation.EmployeeName</strong>
                </div>

                <div class="weekly-summary-card">
                    <span>KGEN Code</span>
                    <strong>@selectedWeeklyEvaluation.KgenCode</strong>
                </div>

                <div class="weekly-summary-card">
                    <span>Shipping Date</span>
                    <strong>@selectedWeeklyEvaluation.ShippingDate.ToString("dd/MM/yyyy")</strong>
                </div>

                <div class="weekly-summary-card total">
                    <span>Total Accuracy</span>
                    <strong>@selectedWeeklyEvaluation.PercentageAverage.ToString("0.00")%</strong>
                </div>
            </div>

            <div class="weekly-evaluation-percent-grid">
                <div class="weekly-percent-mini-card">
                    <span>Motif YP</span>
                    <strong>@selectedWeeklyEvaluation.MotifYp.ToString("0.00")%</strong>
                </div>

                <div class="weekly-percent-mini-card">
                    <span>Motif WP</span>
                    <strong>@selectedWeeklyEvaluation.MotifWp.ToString("0.00")%</strong>
                </div>

                <div class="weekly-percent-mini-card">
                    <span>Inventory</span>
                    <strong>@selectedWeeklyEvaluation.InventoryReport.ToString("0.00")%</strong>
                </div>

                <div class="weekly-percent-mini-card">
                    <span>Shipping Folder</span>
                    <strong>@selectedWeeklyEvaluation.ProductShippingFolder.ToString("0.00")%</strong>
                </div>

                <div class="weekly-percent-mini-card">
                    <span>Task Memo</span>
                    <strong>@selectedWeeklyEvaluation.TaskMemo.ToString("0.00")%</strong>
                </div>
            </div>

            <div class="weekly-evaluation-detail-grid">

                <div class="weekly-detail-card">
                    <div class="weekly-detail-card-header">
                        <h4>📌 Motif YP</h4>
                        <span>@CountErrors(GetMotifYpOptions(selectedWeeklyEvaluation)) errors</span>
                    </div>

                    @foreach (var option in GetMotifYpOptions(selectedWeeklyEvaluation))
                    {
                        <label class="weekly-radio-row @(option.HasError ? "failed" : "ok")">
                            <input type="radio" checked="@option.HasError" disabled />
                            <span>@option.Label</span>
                            <small>@(option.HasError ? "Failed" : "OK")</small>
                        </label>
                    }
                </div>

                <div class="weekly-detail-card">
                    <div class="weekly-detail-card-header">
                        <h4>⚙️ Motif WP</h4>
                        <span>@CountErrors(GetMotifWpOptions(selectedWeeklyEvaluation)) errors</span>
                    </div>

                    @foreach (var option in GetMotifWpOptions(selectedWeeklyEvaluation))
                    {
                        <label class="weekly-radio-row @(option.HasError ? "failed" : "ok")">
                            <input type="radio" checked="@option.HasError" disabled />
                            <span>@option.Label</span>
                            <small>@(option.HasError ? "Failed" : "OK")</small>
                        </label>
                    }
                </div>

                <div class="weekly-detail-card">
                    <div class="weekly-detail-card-header">
                        <h4>📦 Inventory Report</h4>
                        <span>@CountErrors(GetInventoryOptions(selectedWeeklyEvaluation)) errors</span>
                    </div>

                    @foreach (var option in GetInventoryOptions(selectedWeeklyEvaluation))
                    {
                        <label class="weekly-radio-row @(option.HasError ? "failed" : "ok")">
                            <input type="radio" checked="@option.HasError" disabled />
                            <span>@option.Label</span>
                            <small>@(option.HasError ? "Failed" : "OK")</small>
                        </label>
                    }
                </div>

                <div class="weekly-detail-card">
                    <div class="weekly-detail-card-header">
                        <h4>📎 Product Shipping Folder</h4>
                        <span>@CountErrors(GetShippingOptions(selectedWeeklyEvaluation)) errors</span>
                    </div>

                    @foreach (var option in GetShippingOptions(selectedWeeklyEvaluation))
                    {
                        <label class="weekly-radio-row @(option.HasError ? "failed" : "ok")">
                            <input type="radio" checked="@option.HasError" disabled />
                            <span>@option.Label</span>
                            <small>@(option.HasError ? "Failed" : "OK")</small>
                        </label>
                    }
                </div>

                <div class="weekly-detail-card">
                    <div class="weekly-detail-card-header">
                        <h4>📋 Task Memo</h4>
                        <span>@CountErrors(GetTaskMemoOptions(selectedWeeklyEvaluation)) errors</span>
                    </div>

                    @foreach (var option in GetTaskMemoOptions(selectedWeeklyEvaluation))
                    {
                        <label class="weekly-radio-row @(option.HasError ? "failed" : "ok")">
                            <input type="radio" checked="@option.HasError" disabled />
                            <span>@option.Label</span>
                            <small>@(option.HasError ? "Failed" : "OK")</small>
                        </label>
                    }
                </div>

            </div>
        </div>
    </div>
}

@code {
    private DashboardStatsDto stats = new DashboardStatsDto();

    private List<AssignedBookDashboardDto> assignedBooks = new();
    private List<AssignedBookDashboardDto> completedAssignments = new();
    private List<WeeklyEvaluationDashboardDto> weeklyEvaluations = new();

    private string SelectedAssignedEmployeeFilter { get; set; } = string.Empty;
    private string SelectedAssignedStageFilter { get; set; } = string.Empty;

    private string SelectedCompletedEmployeeFilter { get; set; } = string.Empty;
    private string SelectedCompletedStageFilter { get; set; } = string.Empty;

    private string SelectedWeeklyEmployeeFilter { get; set; } = string.Empty;
    private string WeeklySearch { get; set; } = string.Empty;

    private WeeklyEvaluationDashboardDto? selectedWeeklyEvaluation;
    private bool showWeeklyEvaluationModal = false;

    private ClaimsPrincipal? _user;

    private bool loading = true;

    private bool PuedeVerUsuarios { get; set; }
    private bool PuedeVerEmpleados { get; set; }
    private bool PuedeVerLibros { get; set; }
    private bool PuedeVerEvaluaciones { get; set; }
    private bool PuedeVerAsignaciones { get; set; }

    private static readonly List<StageFilterOption> StageFilterOptions = new()
    {
        new("ProofExtract", "Proof Extract"),
        new("FinalExtract", "Final Extract"),
        new("MemoExtract", "Memo Extract"),
        new("FinalPO", "Final PO Date"),
        new("Shipping", "Shipping Date"),
        new("Dirxion", "Dirxion Date")
    };

    private static readonly List<StageFilterOption> CompletedStageFilterOptions = new()
    {
        new("ProofExtract", "Proof Extract Completed"),
        new("FinalExtract", "Final Extract Completed"),
        new("MemoExtract", "Memo Extract Completed"),
        new("FinalPO", "Final PO Sent"),
        new("Shipping", "Shipped Pages"),
        new("Dirxion", "Dirxion Sent")
    };

    private List<AssignedBookDashboardDto> AssignedBooksFiltered
    {
        get
        {
            var query = assignedBooks.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(SelectedAssignedEmployeeFilter))
            {
                query = query.Where(x => string.Equals(
                    x.EmployeeName?.Trim(),
                    SelectedAssignedEmployeeFilter.Trim(),
                    StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(SelectedAssignedStageFilter))
            {
                query = query.Where(x => string.Equals(
                    x.StageKey?.Trim(),
                    SelectedAssignedStageFilter.Trim(),
                    StringComparison.OrdinalIgnoreCase));
            }

            return query.ToList();
        }
    }

    private List<AssignedBookDashboardDto> CompletedAssignmentsFiltered
    {
        get
        {
            var query = completedAssignments.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(SelectedCompletedEmployeeFilter))
            {
                query = query.Where(x => string.Equals(
                    x.EmployeeName?.Trim(),
                    SelectedCompletedEmployeeFilter.Trim(),
                    StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(SelectedCompletedStageFilter))
            {
                query = query.Where(x => string.Equals(
                    x.StageKey?.Trim(),
                    SelectedCompletedStageFilter.Trim(),
                    StringComparison.OrdinalIgnoreCase));
            }

            return query.ToList();
        }
    }

    private List<WeeklyEvaluationDashboardDto> WeeklyEvaluationsFiltered
    {
        get
        {
            var query = weeklyEvaluations.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(SelectedWeeklyEmployeeFilter))
            {
                query = query.Where(x => string.Equals(
                    x.EmployeeName?.Trim(),
                    SelectedWeeklyEmployeeFilter.Trim(),
                    StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(WeeklySearch))
            {
                var filtro = WeeklySearch.Trim().ToUpperInvariant();

                query = query.Where(x =>
                    (x.KgenCode ?? string.Empty).ToUpperInvariant().Contains(filtro) ||
                    (x.BookName ?? string.Empty).ToUpperInvariant().Contains(filtro));
            }

            return query.ToList();
        }
    }

    private IEnumerable<string> AssignedEmployeeFilterOptions
    {
        get
        {
            return assignedBooks
                .Where(x => !string.IsNullOrWhiteSpace(x.EmployeeName))
                .Select(x => x.EmployeeName.Trim())
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(x => x);
        }
    }

    private IEnumerable<string> CompletedEmployeeFilterOptions
    {
        get
        {
            return completedAssignments
                .Where(x => !string.IsNullOrWhiteSpace(x.EmployeeName))
                .Select(x => x.EmployeeName.Trim())
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(x => x);
        }
    }

    private IEnumerable<string> WeeklyEmployeeFilterOptions
    {
        get
        {
            return weeklyEvaluations
                .Where(x => !string.IsNullOrWhiteSpace(x.EmployeeName))
                .Select(x => x.EmployeeName.Trim())
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(x => x);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            _user = authState.User;

            CargarPermisosDashboard();

            var result = await DashboardService.GetDashboardSummaryAsync();

            if (result is not null)
            {
                stats = result.Stats ?? new DashboardStatsDto();
                assignedBooks = result.AssignedBooks ?? new List<AssignedBookDashboardDto>();
                completedAssignments = result.CompletedAssignments ?? new List<AssignedBookDashboardDto>();
                weeklyEvaluations = result.WeeklyEvaluations ?? new List<WeeklyEvaluationDashboardDto>();
            }
            else
            {
                stats = new DashboardStatsDto();
                assignedBooks = new List<AssignedBookDashboardDto>();
                completedAssignments = new List<AssignedBookDashboardDto>();
                weeklyEvaluations = new List<WeeklyEvaluationDashboardDto>();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.ToString());

            stats = new DashboardStatsDto();
            assignedBooks = new List<AssignedBookDashboardDto>();
            completedAssignments = new List<AssignedBookDashboardDto>();
            weeklyEvaluations = new List<WeeklyEvaluationDashboardDto>();
        }
        finally
        {
            loading = false;
        }
    }

    private void CargarPermisosDashboard()
    {
        PuedeVerUsuarios =
            HasPermission(_user, "CreateUser") ||
            HasPermission(_user, "EditUser") ||
            HasPermission(_user, "DeleteUser");

        PuedeVerEmpleados =
            HasPermission(_user, "CreateEmployees") ||
            HasPermission(_user, "EditEmployees") ||
            HasPermission(_user, "DeleteEmployees") ||
            HasPermission(_user, "ViewEmployees");

        PuedeVerLibros =
            HasPermission(_user, "CreateBook") ||
            HasPermission(_user, "EditBook") ||
            HasPermission(_user, "DeleteBook") ||
            HasPermission(_user, "BooksView");

        PuedeVerEvaluaciones =
            HasPermission(_user, "QualifyBook");

        PuedeVerAsignaciones =
            HasPermission(_user, "CreateAssignations") ||
            HasPermission(_user, "AsignBook") ||
            HasPermission(_user, "ViewAssignations");
    }

