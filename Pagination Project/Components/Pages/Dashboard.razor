    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _dashboardLoadStarted)
        {
            return;
        }

        _dashboardLoadStarted = true;

        await LoadDashboardAsync();
    }

    private async Task LoadDashboardAsync()
    {
        loading = true;

        try
        {
            var authState =
                await AuthenticationStateProvider
                    .GetAuthenticationStateAsync();

            _user = authState.User;

            if (_user.Identity?.IsAuthenticated != true)
            {
                ResetDashboardData();
                return;
            }

            CargarPermisosDashboard();

            Scope = await UserDataScopeService.GetScopeAsync(_user);

            var result =
                await DashboardService.GetDashboardSummaryAsync(Scope);

            if (result is null)
            {
                ResetDashboardData();
                return;
            }

            stats = result.Stats ?? new DashboardStatsDto();

            assignedBooks =
                result.AssignedBooks ??
                new List<AssignedBookDashboardDto>();

            completedAssignments =
                result.CompletedAssignments ??
                new List<AssignedBookDashboardDto>();

            weeklyEvaluations =
                result.WeeklyEvaluations ??
                new List<WeeklyEvaluationDashboardDto>();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.ToString());
            ResetDashboardData();
        }
        finally
        {
            loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void ResetDashboardData()
    {
        stats = new DashboardStatsDto();
        assignedBooks = new List<AssignedBookDashboardDto>();
        completedAssignments = new List<AssignedBookDashboardDto>();
        weeklyEvaluations = new List<WeeklyEvaluationDashboardDto>();
    }

    private void CargarPermisosDashboard()
    {
        PuedeVerUsuarios =
            HasPermission(_user, "CreateUser") ||
            HasPermission(_user, "EditUser") ||
            HasPermission(_user, "DeleteUser");

        PuedeVerEmpleados =
            HasPermission(_user, "CreateEmployees") ||
            HasPermission(_user, "EditEmployees") ||
            HasPermission(_user, "DeleteEmployees") ||
            HasPermission(_user, "ViewEmployees");

        PuedeVerLibros =
            HasPermission(_user, "CreateBook") ||
            HasPermission(_user, "EditBook") ||
            HasPermission(_user, "DeleteBook") ||
            HasPermission(_user, "BooksView");

        PuedeVerEvaluaciones =
            HasPermission(_user, "QualifyBook");

        PuedeVerAsignaciones =
            HasPermission(_user, "CreateAssignations") ||
            HasPermission(_user, "AsignBook") ||
            HasPermission(_user, "ViewAssignations");
    }

