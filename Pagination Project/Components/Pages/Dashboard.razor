    private static List<string> BuildEmployeeOptions(
        IEnumerable<string?> employeeNames)
    {
        return employeeNames
            .Where(name =>
                !string.IsNullOrWhiteSpace(
                    name))
            .Select(name =>
                name!.Trim())
            .Distinct(
                StringComparer.OrdinalIgnoreCase)
            .OrderBy(
                name => name,
                StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private static int GetAssignedStageSortOrder(
        AssignedBookDashboardDto item)
    {
        var stage =
            !string.IsNullOrWhiteSpace(
                item.StageKey)
                ? item.StageKey
                : item.Stage;

        if (string.IsNullOrWhiteSpace(
                stage))
        {
            return 0;
        }

        var normalizedStage =
            stage
                .Trim()
                .Replace(
                    " ",
                    string.Empty,
                    StringComparison.Ordinal)
                .Replace(
                    "-",
                    string.Empty,
                    StringComparison.Ordinal)
                .Replace(
                    "_",
                    string.Empty,
                    StringComparison.Ordinal)
                .ToUpperInvariant();

        return normalizedStage switch
        {
            "PROOF" or
            "PROOFEXTRACT" or
            "PROOFEXTRACTDATE"
                => 1,

            "FINAL" or
            "FINALEXTRACT" or
            "FINALEXTRACTDATE"
                => 2,

            "MEMO" or
            "MEMOEXTRACT" or
            "MEMOEXTRACTDATE"
                => 3,

            "FINALPO" or
            "FINALPODATE"
                => 4,

            "SHIPPING" or
            "SHIPPINGDATE"
                => 5,

            "DIRXION" or
            "DIRXIONDATE"
                => 6,

            _ =>
                0
        };
    }

    private static string GetInitials(
        string? fullName)
    {
        if (string.IsNullOrWhiteSpace(
                fullName))
        {
            return "U";
        }

        var parts =
            fullName.Split(
                ' ',
                StringSplitOptions.RemoveEmptyEntries |
                StringSplitOptions.TrimEntries);

        if (parts.Length == 0)
        {
            return "U";
        }

        if (parts.Length == 1)
        {
            return parts[0][0]
                .ToString()
                .ToUpperInvariant();
        }

        return string.Concat(
                parts[0][0],
                parts[1][0])
            .ToUpperInvariant();
    }

    private static string GetStagePillClass(
        string? stageKey,
        bool completed = false)
    {
        var key =
            (stageKey ?? string.Empty)
                .Trim()
                .ToLowerInvariant();

        return completed
            ? $"thryv-stage-pill thryv-stage-{key} completed-stage-pill"
            : $"thryv-stage-pill thryv-stage-{key}";
    }

    private static string GetDatabaseCode(
        string? database)
    {
        if (string.IsNullOrWhiteSpace(
                database))
        {
            return "-";
        }

        return database
            .Trim()
            .ToUpperInvariant();
    }

    private static string GetDatabaseFullName(
        string? database)
    {
        if (string.IsNullOrWhiteSpace(
                database))
        {
            return "Database not available";
        }

        var normalized =
            database
                .Trim()
                .ToUpperInvariant();

        return normalized switch
        {
            "DW" =>
                "WEST",

            "SN" =>
                "vNorth",

            "SW" =>
                "vWest",

            "SS" =>
                "vSouth",

            _ =>
                database.Trim()
        };
    }

    private static string GetAccuracyClass(
        decimal value)
    {
        if (value >= 80)
        {
            return "excellent";
        }

        if (value > 50)
        {
            return "warning";
        }

        return "danger";
    }

    private static int CountErrors(
        IEnumerable<EvaluationFailureOption> options)
    {
        var count =
            0;

        foreach (var option in options)
        {
            if (option.HasError)
            {
                count++;
            }
        }

        return count;
    }

