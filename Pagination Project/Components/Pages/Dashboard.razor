                employeeFilter))
        {
            query =
                query.Where(x =>
                    string.Equals(
                        x.EmployeeName?.Trim(),
                        employeeFilter,
                        StringComparison.OrdinalIgnoreCase));
        }

        var availableStageKeys =
            query
                .Where(x =>
                    !string.IsNullOrWhiteSpace(
                        x.StageKey))
                .Select(x =>
                    x.StageKey!.Trim())
                .ToHashSet(
                    StringComparer.OrdinalIgnoreCase);

        AssignedStageFilterOptions =
            StageFilterOptions
                .Where(stage =>
                    availableStageKeys.Contains(
