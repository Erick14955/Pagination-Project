    private List<AssignedBookDashboardDto> AssignedBooksFiltered
    {
        get
        {
            var query = assignedBooks.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(SelectedAssignedEmployeeFilter))
            {
                query = query.Where(x => string.Equals(
                    x.EmployeeName?.Trim(),
                    SelectedAssignedEmployeeFilter.Trim(),
                    StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(SelectedAssignedStageFilter))
            {
                query = query.Where(x => string.Equals(
                    x.StageKey?.Trim(),
                    SelectedAssignedStageFilter.Trim(),
                    StringComparison.OrdinalIgnoreCase));
            }

            if (AssignedStageSortEnabled)
            {
                if (AssignedStageSortDescending)
                {
                    query = query
                        .OrderBy(x => GetAssignedStageSortOrder(x) == 0 ? 1 : 0)
                        .ThenByDescending(GetAssignedStageSortOrder)
                        .ThenBy(x => x.EmployeeName)
                        .ThenBy(x => x.BookName);
                }
                else
                {
                    query = query
                        .OrderBy(x => GetAssignedStageSortOrder(x) == 0 ? 1 : 0)
                        .ThenBy(GetAssignedStageSortOrder)
                        .ThenBy(x => x.EmployeeName)
                        .ThenBy(x => x.BookName);
                }
            }

            return query.ToList();
        }
    }

    private void SortAssignedBooksByStage()
    {
        if (!AssignedStageSortEnabled)
        {
            AssignedStageSortEnabled = true;
            AssignedStageSortDescending = true;
            return;
        }

        AssignedStageSortDescending = !AssignedStageSortDescending;
    }

    private static int GetAssignedStageSortOrder(
        AssignedBookDashboardDto item)
    {
        var stage = !string.IsNullOrWhiteSpace(item.StageKey)
            ? item.StageKey
            : item.Stage;

        var normalizedStage = (stage ?? string.Empty)
            .Trim()
            .Replace(" ", string.Empty)
            .Replace("-", string.Empty)
            .Replace("_", string.Empty)
            .ToLowerInvariant();

        return normalizedStage switch
        {
            "proof" or
            "proofextract" or
            "proofextractdate" => 1,

            "final" or
            "finalextract" or
            "finalextractdate" => 2,

            "memo" or
            "memoextract" or
            "memoextractdate" => 3,

            "finalpo" or
            "finalpodate" => 4,

            "shipping" or
            "shippingdate" => 5,

            "dirxion" or
            "dirxiondate" => 6,

            _ => 0
        };
    }

    private async Task DownloadChecklistDirectAsync(AssignedBookDashboardDto item)
    {
        if (DownloadingChecklistAssignmentId is not null)
            return;

        try
        {
            if (_user is null || _user.Identity?.IsAuthenticated != true)
            {
                var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
                _user = authState.User;
            }

            if (_user is null || _user.Identity?.IsAuthenticated != true)
                return;

            DownloadingChecklistAssignmentId = item.AssignmentId;
            await InvokeAsync(StateHasChanged);

            var result = await ChecklistService.GeneratePaginationChecklistAsync(
                item.BookId,
                item.AssignmentId,
                _user);

            var base64 = Convert.ToBase64String(result.Content);

            await JS.InvokeVoidAsync(
                "downloadFileFromBase64",
                result.FileName,
                result.ContentType,
                base64);
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.ToString());
        }
        finally
        {
            DownloadingChecklistAssignmentId = null;
            await InvokeAsync(StateHasChanged);
        }
    }

    private static string GetInitials(string? fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName))
            return "U";

        var parts = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);

        if (parts.Length == 1)
            return parts[0][0].ToString().ToUpper();

        return $"{parts[0][0]}{parts[1][0]}".ToUpper();
    }

    private static string GetStagePillClass(string? stageKey, bool completed = false)
    {
        var key = (stageKey ?? string.Empty)
            .Trim()
            .ToLowerInvariant();

        var completedClass = completed ? " completed-stage-pill" : string.Empty;

        return $"thryv-stage-pill thryv-stage-{key}{completedClass}";
    }

    private static string GetDatabaseCode(string? database)
    {
        if (string.IsNullOrWhiteSpace(database))
            return "-";

        return database.Trim().ToUpperInvariant();
    }

    private static string GetDatabaseFullName(string? database)
    {
        if (string.IsNullOrWhiteSpace(database))
            return "Database not available";

        var code = database.Trim().ToUpperInvariant();

        return code switch
        {
            "DW" => "WEST",
            "SN" => "vNorth",
            "SW" => "vWest",
            "SS" => "vSouth",
            _ => database.Trim()
        };
    }

