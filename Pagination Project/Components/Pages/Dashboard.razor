    private void CargarPermisosDashboard()
    {
        if (_user is null)
        {
            PuedeVerUsuarios = false;
            PuedeVerEmpleados = false;
            PuedeVerLibros = false;
            PuedeVerEvaluaciones = false;
            PuedeVerAsignaciones = false;

            return;
        }

        var permissions =
            _user.Claims
                .Where(claim =>
                    string.Equals(
                        claim.Value,
                        bool.TrueString,
                        StringComparison.OrdinalIgnoreCase))
                .Select(claim =>
                    claim.Type)
                .ToHashSet(
                    StringComparer.OrdinalIgnoreCase);

        PuedeVerUsuarios =
            permissions.Contains("CreateUser")
            ||
            permissions.Contains("EditUser")
            ||
            permissions.Contains("DeleteUser");

        PuedeVerEmpleados =
            permissions.Contains("CreateEmployees")
            ||
            permissions.Contains("EditEmployees")
            ||
            permissions.Contains("DeleteEmployees")
            ||
            permissions.Contains("ViewEmployees");

        PuedeVerLibros =
            permissions.Contains("CreateBook")
            ||
            permissions.Contains("EditBook")
            ||
            permissions.Contains("DeleteBook")
            ||
            permissions.Contains("BooksView");

        PuedeVerEvaluaciones =
            permissions.Contains("QualifyBook");

        PuedeVerAsignaciones =
            permissions.Contains("CreateAssignations")
            ||
            permissions.Contains("AsignBook")
            ||
            permissions.Contains("ViewAssignations");
    }

    private async Task DownloadChecklistDirectAsync(
        AssignedBookDashboardDto item)
    {
        if (DownloadingChecklistAssignmentId is not null)
        {
            return;
        }

        try
        {
            if (_user is null ||
                _user.Identity?.IsAuthenticated != true)
            {
                var authState =
                    await AuthenticationStateProvider
                        .GetAuthenticationStateAsync();

                _user =
                    authState.User;
            }

            if (_user is null ||
                _user.Identity?.IsAuthenticated != true)
            {
                return;
            }

            DownloadingChecklistAssignmentId =
                item.AssignmentId;

            await InvokeAsync(
                StateHasChanged);

            var result =
                await ChecklistService
                    .GeneratePaginationChecklistAsync(
                        item.BookId,
                        item.AssignmentId,
                        _user);

            var base64 =
                Convert.ToBase64String(
                    result.Content);

            await JS.InvokeVoidAsync(
                "downloadFileFromBase64",
                result.FileName,
                result.ContentType,
                base64);
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                ex.ToString());
        }
        finally
        {
            DownloadingChecklistAssignmentId =
                null;

            await InvokeAsync(
                StateHasChanged);
        }
    }

