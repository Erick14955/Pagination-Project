    protected override async Task OnAfterRenderAsync(
        bool firstRender)
    {
        if (!firstRender ||
            _dashboardLoadStarted)
        {
            return;
        }

        _dashboardLoadStarted =
            true;

        await LoadDashboardAsync();
    }

    private async Task LoadDashboardAsync()
    {
        loading =
            true;

        try
        {
            var authState =
                await AuthenticationStateProvider
                    .GetAuthenticationStateAsync();

            _user =
                authState.User;

            if (_user.Identity?.IsAuthenticated != true)
            {
                ResetDashboardData();
                return;
            }

            CargarPermisosDashboard();

            Scope =
                await UserDataScopeService
                    .GetScopeAsync(
                        _user);

            var result =
                await DashboardService
                    .GetDashboardSummaryAsync(
                        Scope);

            if (result is null)
            {
                ResetDashboardData();
                return;
            }

            stats =
                result.Stats
                ?? new DashboardStatsDto();

            assignedBooks =
                result.AssignedBooks
                ?? new List<AssignedBookDashboardDto>();

            completedAssignments =
                result.CompletedAssignments
                ?? new List<AssignedBookDashboardDto>();

            weeklyEvaluations =
                result.WeeklyEvaluations
                ?? new List<WeeklyEvaluationDashboardDto>();

            RebuildDashboardDerivedState();
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                ex.ToString());

            ResetDashboardData();
        }
        finally
        {
            loading =
                false;

            await InvokeAsync(
                StateHasChanged);
        }
    }

    private void RebuildDashboardDerivedState()
    {
        ShowChecklistColumn =
            assignedBooks.Any(x =>
                string.Equals(
                    x.StageKey,
                    "ProofExtract",
                    StringComparison.OrdinalIgnoreCase));

        ShowReadyToShipColumn =
            assignedBooks.Any(x =>
                string.Equals(
                    x.StageKey,
                    "Shipping",
                    StringComparison.OrdinalIgnoreCase));

        AssignedBooksColumnCount =
            7
            +
            (Scope.ViewAllEmployeeTypes
                ? 1
                : 0)
            +
            (ShowReadyToShipColumn
                ? 1
                : 0)
            +
            (ShowChecklistColumn
                ? 1
                : 0);

        AssignedEmployeeFilterOptions =
            BuildEmployeeOptions(
                assignedBooks.Select(
                    x => x.EmployeeName));

        CompletedEmployeeFilterOptions =
            BuildEmployeeOptions(
                completedAssignments.Select(
                    x => x.EmployeeName));

        WeeklyEmployeeFilterOptions =
            BuildEmployeeOptions(
                weeklyEvaluations.Select(
                    x => x.EmployeeName));

        RebuildAssignedStageOptions();

        RebuildCompletedStageOptions();

        RebuildAssignedView();

        RebuildCompletedView();

        RebuildWeeklyView();
    }

    private void RebuildAssignedView()
    {
        IEnumerable<AssignedBookDashboardDto> query =
            assignedBooks;

        var employeeFilter =
            SelectedAssignedEmployeeFilter.Trim();

        var stageFilter =
            SelectedAssignedStageFilter.Trim();

        if (!string.IsNullOrWhiteSpace(
                employeeFilter))
        {
            query =
                query.Where(x =>
                    string.Equals(
                        x.EmployeeName?.Trim(),
                        employeeFilter,
                        StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(
                stageFilter))
        {
            query =
                query.Where(x =>
                    string.Equals(
                        x.StageKey?.Trim(),
                        stageFilter,
                        StringComparison.OrdinalIgnoreCase));
        }

        if (AssignedStageSortEnabled)
        {
            var ranked =
                query.Select(x =>
                    new AssignedBookRank(
                        x,
                        GetAssignedStageSortOrder(x)));

            if (AssignedStageSortDescending)
            {
                query =
                    ranked
                        .OrderBy(x =>
                            x.StageOrder == 0
                                ? 1
                                : 0)
                        .ThenByDescending(x =>
                            x.StageOrder)
                        .ThenBy(x =>
                            x.Item.EmployeeName)
                        .ThenBy(x =>
                            x.Item.BookName)
                        .Select(x =>
                            x.Item);
            }
            else
            {
                query =
                    ranked
                        .OrderBy(x =>
                            x.StageOrder == 0
                                ? 1
                                : 0)
                        .ThenBy(x =>
                            x.StageOrder)
                        .ThenBy(x =>
                            x.Item.EmployeeName)
                        .ThenBy(x =>
                            x.Item.BookName)
                        .Select(x =>
                            x.Item);
            }
        }

        AssignedBooksFiltered =
            query.ToList();
    }

    private void RebuildAssignedStageOptions()
    {
        IEnumerable<AssignedBookDashboardDto> query =
            assignedBooks;

        var employeeFilter =
