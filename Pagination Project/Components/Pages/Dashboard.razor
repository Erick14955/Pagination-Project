    private static string GetAccuracyClass(decimal value)
    {
        if (value >= 90)
            return "excellent";

        if (value >= 75)
            return "warning";

        return "danger";
    }

    private static int CountErrors(IEnumerable<EvaluationFailureOption> options)
    {
        return options.Count(x => x.HasError);
    }

