@page "/dashboard"
@attribute [Authorize]

@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Pagination_Project.Models
@using Pagination_Project.Services

@inject IDashboardService DashboardService
@inject AuthenticationStateProvider AuthenticationStateProvider

@layout Pagination_Project.Components.Layout.DashboardLayout
@rendermode InteractiveServer

<PageTitle>Dashboard - Evaluations</PageTitle>

<link href="style/dashboard.css" rel="stylesheet" />

<div class="thryv-dashboard-page">

    <section class="thryv-dashboard-header">
        <div class="thryv-dashboard-hero-content">
            <h2 class="thryv-dashboard-title">General Dashboard</h2>
            <p class="thryv-dashboard-subtitle">
                Quick system summary and current list of assigned books.
            </p>
        </div>

        <div class="thryv-dashboard-hero-stats">
            @if (loading)
            {
                <div class="thryv-hero-stat-card">
                    <span>LOADING</span>
                    <strong>...</strong>
                </div>
            }
            else
            {
                @if (PuedeVerUsuarios)
                {
                    <div class="thryv-hero-stat-card">
                        <span>TOTAL USERS</span>
                        <strong>@stats.TotalUsers</strong>
                    </div>
                }

                @if (PuedeVerEmpleados)
                {
                    <div class="thryv-hero-stat-card">
                        <span>EMPLOYEES</span>
                        <strong>@stats.TotalEmployees</strong>
                    </div>
                }

                @if (PuedeVerLibros)
                {
                    <div class="thryv-hero-stat-card">
                        <span>ACTIVE BOOKS</span>
                        <strong>@stats.TotalBooks</strong>
                    </div>
                }

                @if (PuedeVerEvaluaciones)
                {
                    <div class="thryv-hero-stat-card">
                        <span>EVALUATIONS</span>
                        <strong>@stats.TotalEvaluations</strong>
                    </div>
                }

                @if (PuedeVerAsignaciones)
                {
                    <div class="thryv-hero-stat-card">
                        <span>ASSIGNMENTS TODAY</span>
                        <strong>@assignedBooks.Count</strong>
                    </div>
                }
            }
        </div>
    </section>

    <div class="thryv-section-card">
        <div class="thryv-section-header">
            <div>
                <h3>Assigned Books</h3>
                <p>Live view of active assignments based on the current stage of the day.</p>
            </div>

            <div class="thryv-section-actions">
                <div class="thryv-filter-group">
                    <label>Filter by employee</label>

                    <select class="thryv-filter-select" @bind="SelectedEmployeeFilter">
                        <option value="">All Employees</option>

                        @foreach (var employee in EmployeeFilterOptions)
                        {
                            <option value="@employee">@employee</option>
                        }
                    </select>
                </div>

                @if (!string.IsNullOrWhiteSpace(SelectedEmployeeFilter))
                {
                    <button type="button"
                            class="thryv-clear-filter-btn"
                            @onclick="ClearEmployeeFilter">
                        Clear
                    </button>
                }

                <div class="thryv-section-badge">
                    @AssignedBooksFiltered.Count records
                </div>
            </div>
        </div>

        <div class="thryv-table-wrapper">
            <table class="thryv-custom-table">
                <thead>
                    <tr>
                        <th>Employee</th>
                        <th>KGEN Code</th>
                        <th>LSA Code</th>
                        <th>Book</th>
                        <th>Stage</th>
                        <th>Stage Date</th>
                    </tr>
                </thead>

                <tbody>
                    @if (loading)
                    {
                        <tr>
                            <td colspan="6" class="thryv-empty-row">
                                Loading statistics...
                            </td>
                        </tr>
                    }
                    else if (AssignedBooksFiltered.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="thryv-empty-row">
                                No assigned books available to display today.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in AssignedBooksFiltered)
                        {
                            <tr>
                                <td>
                                    <div class="thryv-employee-cell">
                                        <div class="thryv-employee-avatar">👤</div>
                                        <div>
                                            <div class="thryv-employee-name">@item.EmployeeName</div>
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    <span class="thryv-code-pill">@item.KgenCode</span>
                                </td>

                                <td>
                                    <span class="thryv-code-pill secondary">@item.LsaCode</span>
                                </td>

                                <td>@item.BookName</td>

                                <td>
                                    <span class="thryv-stage-pill">
                                        @item.Stage
                                    </span>
                                </td>

                                <td>@(item.StageDate?.ToString("dd/MM/yyyy") ?? "-")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private DashboardStatsDto stats = new DashboardStatsDto();

    private List<AssignedBookDashboardDto> assignedBooks = new();

    private string SelectedEmployeeFilter { get; set; } = string.Empty;

    private ClaimsPrincipal? _user;

    private bool loading = true;

    private bool PuedeVerUsuarios { get; set; }
    private bool PuedeVerEmpleados { get; set; }
    private bool PuedeVerLibros { get; set; }
    private bool PuedeVerEvaluaciones { get; set; }
    private bool PuedeVerAsignaciones { get; set; }

    private List<AssignedBookDashboardDto> AssignedBooksFiltered
    {
        get
        {
            if (string.IsNullOrWhiteSpace(SelectedEmployeeFilter))
                return assignedBooks;

            return assignedBooks
                .Where(x => string.Equals(
                    x.EmployeeName?.Trim(),
                    SelectedEmployeeFilter.Trim(),
                    StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
    }

    private IEnumerable<string> EmployeeFilterOptions
    {
        get
        {
            return assignedBooks
                .Where(x => !string.IsNullOrWhiteSpace(x.EmployeeName))
                .Select(x => x.EmployeeName.Trim())
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(x => x);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            _user = authState.User;

            CargarPermisosDashboard();

            var result = await DashboardService.GetDashboardSummaryAsync();

            if (result is not null)
            {
                stats = result.Stats ?? new DashboardStatsDto();
                assignedBooks = result.AssignedBooks ?? new List<AssignedBookDashboardDto>();
            }
            else
            {
                stats = new DashboardStatsDto();
                assignedBooks = new List<AssignedBookDashboardDto>();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.ToString());

            stats = new DashboardStatsDto();
            assignedBooks = new List<AssignedBookDashboardDto>();
        }
        finally
        {
            loading = false;
        }
    }

    private void CargarPermisosDashboard()
    {
        PuedeVerUsuarios =
            HasPermission(_user, "CreateUser") ||
            HasPermission(_user, "EditUser") ||
            HasPermission(_user, "DeleteUser");

        PuedeVerEmpleados =
            HasPermission(_user, "CreateEmployees") ||
            HasPermission(_user, "EditEmployees") ||
            HasPermission(_user, "DeleteEmployees") ||
            HasPermission(_user, "ViewEmployees");

        PuedeVerLibros =
            HasPermission(_user, "CreateBook") ||
            HasPermission(_user, "EditBook") ||
            HasPermission(_user, "DeleteBook") ||
            HasPermission(_user, "BooksView");

        PuedeVerEvaluaciones =
            HasPermission(_user, "QualifyBook");

        PuedeVerAsignaciones =
            HasPermission(_user, "CreateAssignations") ||
            HasPermission(_user, "AsignBook") ||
            HasPermission(_user, "ViewAssignations");
    }

    private void ClearEmployeeFilter()
    {
        SelectedEmployeeFilter = string.Empty;
    }

    private static bool HasPermission(ClaimsPrincipal? user, string claimType)
    {
        if (user is null)
            return false;

        return string.Equals(
            user.FindFirst(claimType)?.Value,
            "True",
            StringComparison.OrdinalIgnoreCase);
    }
}