@page "/dashboard"
@attribute [Authorize]

@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop
@using Pagination_Project.Models
@using Pagination_Project.Services

@inject IDashboardService DashboardService
@inject IUserDataScopeService UserDataScopeService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IPaginationChecklistService ChecklistService
@inject IJSRuntime JS

@layout Pagination_Project.Components.Layout.DashboardLayout
@rendermode InteractiveServer

<PageTitle>Dashboard - Evaluations</PageTitle>

@if (loading)
{
    <div class="thryv-dashboard-page thryv-dashboard-skeleton"
         aria-busy="true"
         aria-label="Loading dashboard">

        <section class="thryv-dashboard-header thryv-dashboard-skeleton-hero">

            <div class="thryv-dashboard-hero-content">
                <div class="thryv-dashboard-skeleton-block
                                    thryv-dashboard-skeleton-title">
                </div>

                <div class="thryv-dashboard-skeleton-block
                                    thryv-dashboard-skeleton-subtitle">
                </div>

                <div class="thryv-dashboard-skeleton-block
                                    thryv-dashboard-skeleton-subtitle short">
                </div>
            </div>

            <div class="thryv-dashboard-hero-stats">

                @for (var statIndex = 0; statIndex < 6; statIndex++)
                {
                    <div class="thryv-hero-stat-card
                                                thryv-dashboard-skeleton-stat-card">

                        <div class="thryv-dashboard-skeleton-block
                                                    thryv-dashboard-skeleton-stat-label">
                        </div>

                        <div class="thryv-dashboard-skeleton-block
                                                    thryv-dashboard-skeleton-stat-value">
                        </div>
                    </div>
                }

            </div>
        </section>

        @for (var sectionIndex = 0; sectionIndex < 3; sectionIndex++)
        {
            <div class="thryv-section-card
                                        thryv-dashboard-skeleton-section">

                <div class="thryv-section-header">

                    <div class="thryv-dashboard-skeleton-section-copy">
                        <div class="thryv-dashboard-skeleton-block
                                                    thryv-dashboard-skeleton-section-title">
                        </div>

                        <div class="thryv-dashboard-skeleton-block
                                                    thryv-dashboard-skeleton-section-description">
                        </div>
                    </div>

                    <div class="thryv-dashboard-skeleton-actions">
                        <div class="thryv-dashboard-skeleton-block
                                                    thryv-dashboard-skeleton-filter">
                        </div>

                        <div class="thryv-dashboard-skeleton-block
                                                    thryv-dashboard-skeleton-filter">
                        </div>

                        <div class="thryv-dashboard-skeleton-block
                                                    thryv-dashboard-skeleton-badge">
                        </div>
                    </div>
                </div>

                <div class="thryv-dashboard-skeleton-table">

                    <div class="thryv-dashboard-skeleton-table-head">
                        @for (var columnIndex = 0; columnIndex < 7; columnIndex++)
                        {
                            <div class="thryv-dashboard-skeleton-block
                                                                thryv-dashboard-skeleton-column-title">
                            </div>
                        }
                    </div>

                    @for (var rowIndex = 0; rowIndex < 4; rowIndex++)
                    {
                        <div class="thryv-dashboard-skeleton-table-row">

                            <div class="thryv-dashboard-skeleton-employee">
                                <div class="thryv-dashboard-skeleton-block
                                                                    thryv-dashboard-skeleton-avatar">
                                </div>

                                <div class="thryv-dashboard-skeleton-block
                                                                    thryv-dashboard-skeleton-name">
                                </div>
                            </div>

                            <div class="thryv-dashboard-skeleton-block
                                                                thryv-dashboard-skeleton-cell medium">
                            </div>

                            <div class="thryv-dashboard-skeleton-block
                                                                thryv-dashboard-skeleton-cell small">
                            </div>

                            <div class="thryv-dashboard-skeleton-block
                                                                thryv-dashboard-skeleton-cell large">
                            </div>

                            <div class="thryv-dashboard-skeleton-block
                                                                thryv-dashboard-skeleton-cell small">
                            </div>

                            <div class="thryv-dashboard-skeleton-block
                                                                thryv-dashboard-skeleton-cell medium">
                            </div>

                            <div class="thryv-dashboard-skeleton-block
                                                                thryv-dashboard-skeleton-cell action">
                            </div>
                        </div>
                    }

                </div>
            </div>
        }

    </div>
}
else
{
    <div class="thryv-dashboard-page">

        <section class="thryv-dashboard-header">
            <div class="thryv-dashboard-hero-content">
                <h2 class="thryv-dashboard-title">General Dashboard</h2>
                <p class="thryv-dashboard-subtitle">
                    Quick system summary and current list of assigned books.
                </p>
            </div>

            <div class="thryv-dashboard-hero-stats">
                @if (loading)
                {
                    <div class="thryv-hero-stat-card">
                        <span>LOADING</span>
                        <strong>...</strong>
                    </div>
                }
                else
                {
                    @if (PuedeVerUsuarios)
                    {
                        <div class="thryv-hero-stat-card">
                            <span>TOTAL USERS</span>
                            <strong>@stats.TotalUsers</strong>
                        </div>
                    }

                    @if (PuedeVerEmpleados)
                    {
                        <div class="thryv-hero-stat-card">
                            <span>EMPLOYEES</span>
                            <strong>@stats.TotalEmployees</strong>
                        </div>
                    }

                    @if (PuedeVerLibros)
                    {
                        <div class="thryv-hero-stat-card">
                            <span>ACTIVE BOOKS</span>
                            <strong>@stats.TotalBooks</strong>
                        </div>
                    }

                    @if (PuedeVerEvaluaciones)
                    {
                        <div class="thryv-hero-stat-card">
                            <span>EVALUATIONS</span>
                            <strong>@stats.TotalEvaluations</strong>
                        </div>

                        <div class="thryv-hero-stat-card">
                            <span>LAST WEEK EVALUATIONS</span>
                            <strong>@weeklyEvaluations.Count</strong>
                        </div>
                    }

                    @if (PuedeVerAsignaciones)
                    {
                        <div class="thryv-hero-stat-card thryv-stat-pending">
                            <span>PENDING TODAY</span>
                            <strong>@assignedBooks.Count</strong>
                        </div>

                        <div class="thryv-hero-stat-card thryv-stat-completed">
                            <span>COMPLETED TODAY</span>
                            <strong>@completedAssignments.Count</strong>
                        </div>
                    }
                }
            </div>
        </section>

        @if (PuedeVerAsignaciones)
        {
            <div class="thryv-section-card">
                <div class="thryv-section-header">
                    <div>
                        <h3>Assigned Books</h3>
                        <p>Live view of pending assignments based on the current stage of the day.</p>
                    </div>

                    <div class="thryv-section-actions">
                        <div class="thryv-filter-group">
                            <label>Filter by employee</label>

                            <select class="thryv-filter-select"
                                    value="@SelectedAssignedEmployeeFilter"
                                    @onchange="OnAssignedEmployeeChanged">

                                <option value="">All Employees</option>

                                @foreach (var employee in AssignedEmployeeFilterOptions)
                                {
                                    <option value="@employee">@employee</option>
                                }
                            </select>
                        </div>

                        <div class="thryv-filter-group">
                            <label>Filter by stage</label>

                            <select class="thryv-filter-select"
                                    value="@SelectedAssignedStageFilter"
                                    @onchange="OnAssignedStageChanged">

                                <option value="">All Stages</option>

                                @foreach (var stage in AssignedStageFilterOptions)
                                {
                                    <option value="@stage.Key">@stage.Label</option>
                                }
                            </select>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(SelectedAssignedEmployeeFilter) ||
                                        !string.IsNullOrWhiteSpace(SelectedAssignedStageFilter))
                        {
                            <button type="button"
                                    class="thryv-clear-filter-btn"
                                    @onclick="ClearAssignedFilters">
                                Clear
                            </button>
                        }

                        <div class="thryv-section-badge">
                            @AssignedBooksFiltered.Count records
                        </div>
                    </div>
                </div>

                <div class="thryv-table-wrapper">
                    <table class="thryv-custom-table">
                        <thead>
                            <tr>
                                <th>Employee</th>
                                @if (Scope.ViewAllEmployeeTypes)
                                {
                                    <th>Department</th>
                                }
                            <th>KGEN Code</th>
                            <th>LSA Code</th>
                            <th>Book</th>
                            <th>Database</th>
                            <th>
                                <button type="button"
                                        class="thryv-sort-header-btn"
                                        title="Sort assigned books by stage"
                                        aria-label="Sort assigned books by stage"
                                        @onclick="SortAssignedBooksByStage">

                                    <span>Stage</span>

                                    <span class="thryv-sort-indicator">
                                        @(AssignedStageSortEnabled
                                                                            ? AssignedStageSortDescending
                                                                            ? "▼"
                                                                            : "▲"
                                                                            : "↕")
                                </span>
                            </button>
                        </th>
                        <th>Stage Date</th>

                        @if (ShowReadyToShipColumn)
                                {
                                    <th>Ready to Ship</th>
                                }

                                @if (ShowChecklistColumn)
                                {
                                    <th>Checklist</th>
                                }
                            </tr>
                        </thead>

                        <tbody>
                            @if (loading)
                            {
                                <tr>
                                    <td colspan="@AssignedBooksColumnCount" class="thryv-empty-row">
                                        Loading statistics...
                                    </td>
                                </tr>
                            }
                            else if (AssignedBooksFiltered.Count == 0)
                            {
                                <tr>
                                    <td colspan="@AssignedBooksColumnCount" class="thryv-empty-row">
                                        No pending assignments for today.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var item in AssignedBooksFiltered)
                                {
                                    <tr>
                                        <td>
                                            <div class="thryv-employee-cell">
                                                <div class="thryv-employee-avatar">@GetInitials(item.EmployeeName)</div>
                                                <div>
                                                    <div class="thryv-employee-name">@item.EmployeeName</div>
                                                </div>
                                            </div>
                                        </td>

                                        @if (Scope.ViewAllEmployeeTypes)
                                        {
                                            <td><span class="thryv-code-pill secondary">@item.EmployeeTypeCode</span></td>
                                        }

                                        <td>
                                            <span class="thryv-code-pill">@item.KgenCode</span>
                                        </td>

                                        <td>
                                            <span class="thryv-code-pill secondary">@item.LsaCode</span>
                                        </td>

                                        <td>@item.BookName</td>

                                        <td class="thryv-database-cell">
                                            @{
                                                var databaseCode = GetDatabaseCode(item.Database);
                                                var databaseFullName = GetDatabaseFullName(item.Database);
                                            }

                                            <span class="thryv-database-pill"
                                                  title="@databaseFullName"
                                                  data-db-fullname="@databaseFullName"
                                                  aria-label="@databaseFullName">
                                                <span class="thryv-database-dot"></span>
                                                <span class="thryv-database-code">@databaseCode</span>
                                            </span>
                                        </td>

                                        <td>
                                            <span class="@GetStagePillClass(item.StageKey)">
                                                @item.Stage
                                            </span>
                                        </td>

                                        <td>@(item.StageDate?.ToString("dd/MM/yyyy") ?? "-")</td>

                                        @if (ShowReadyToShipColumn)
                                        {
                                            <td class="thryv-ready-to-ship-cell">
                                                @if (string.Equals(
                                                                            item.StageKey,
                                                                            "Shipping",
                                                                            StringComparison.OrdinalIgnoreCase))
                                                {
                                                    @if (item.BookReadyToShip)
                                                    {
                                                        <span class="thryv-ready-to-ship-badge ready">
                                                            <span aria-hidden="true">✓</span>
                                                            Ready
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="thryv-ready-to-ship-badge pending">
                                                            <span aria-hidden="true">!</span>
                                                            Verification pending
                                                        </span>
                                                    }
                                                }
                                                else
                                                {
                                                    <span class="thryv-muted-cell">-</span>
                                                }
                                            </td>
                                        }

                                        @if (ShowChecklistColumn)
                                        {
                                            <td>
                                                @if (string.Equals(
                                                                            item.StageKey,
                                                                            "ProofExtract",
                                                                            StringComparison.OrdinalIgnoreCase))
                                                {
                                                    <button type="button"
                                                            class="thryv-download-checklist-btn"
                                                            disabled="@(DownloadingChecklistAssignmentId == item.AssignmentId)"
                                                            @onclick="() => DownloadChecklistDirectAsync(item)">
                                                        @(DownloadingChecklistAssignmentId == item.AssignmentId ? "..." : "⬇ Download")
                                                    </button>
                                                }
                                                else
                                                {
                                                    <span class="thryv-muted-cell">-</span>
                                                }
                                            </td>
                                        }
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="thryv-section-card completed-section-card">
                <div class="thryv-section-header">
                    <div>
                        <h3>Completed Assignments</h3>
                        <p>Assignments completed today by employees, grouped by completion status.</p>
                    </div>

                    <div class="thryv-section-actions">
                        <div class="thryv-filter-group">
                            <label>Filter by employee</label>

                            <select class="thryv-filter-select"
                                    value="@SelectedCompletedEmployeeFilter"
                                    @onchange="OnCompletedEmployeeChanged">

                                <option value="">All Employees</option>

                                @foreach (var employee in CompletedEmployeeFilterOptions)
                                {
                                    <option value="@employee">@employee</option>
                                }
                            </select>
                        </div>

                        <div class="thryv-filter-group">
                            <label>Filter by completed stage</label>

                            <select class="thryv-filter-select"
                                    value="@SelectedCompletedStageFilter"
                                    @onchange="OnCompletedStageChanged">

                                <option value="">All Completed Stages</option>

                                @foreach (var stage in CompletedStageFilterOptionsForEmployee)
                                {
                                    <option value="@stage.Key">@stage.Label</option>
                                }
                            </select>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(SelectedCompletedEmployeeFilter) ||
                                        !string.IsNullOrWhiteSpace(SelectedCompletedStageFilter))
                        {
                            <button type="button"
                                    class="thryv-clear-filter-btn"
                                    @onclick="ClearCompletedFilters">
                                Clear
                            </button>
                        }

                        <div class="thryv-section-badge">
                            @CompletedAssignmentsFiltered.Count records
                        </div>
                    </div>
                </div>

                <div class="thryv-table-wrapper">
                    <table class="thryv-custom-table">
                        <thead>
                            <tr>
                                <th>Employee</th>
                                @if (Scope.ViewAllEmployeeTypes)
                                {
                                    <th>Department</th>
                                }
                                <th>KGEN Code</th>
                                <th>LSA Code</th>
                                <th>Book</th>
                                <th>Completion Status</th>
                                <th>Stage Date</th>
                            </tr>
                        </thead>

                        <tbody>
                            @if (loading)
                            {
                                <tr>
                                    <td colspan="@(Scope.ViewAllEmployeeTypes ? 7 : 6)" class="thryv-empty-row">
                                        Loading completed assignments...
                                    </td>
                                </tr>
                            }
                            else if (CompletedAssignmentsFiltered.Count == 0)
                            {
                                <tr>
                                    <td colspan="@(Scope.ViewAllEmployeeTypes ? 7 : 6)" class="thryv-empty-row">
                                        No completed assignments for today.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var item in CompletedAssignmentsFiltered)
                                {
                                    <tr>
                                        <td>
                                            <div class="thryv-employee-cell">
                                                <div class="thryv-employee-avatar completed-avatar">✅</div>
                                                <div>
                                                    <div class="thryv-employee-name">@item.EmployeeName</div>
                                                </div>
                                            </div>
                                        </td>

                                        @if (Scope.ViewAllEmployeeTypes)
                                        {
                                            <td><span class="thryv-code-pill secondary">@item.EmployeeTypeCode</span></td>
                                        }

                                        <td>
                                            <span class="thryv-code-pill">@item.KgenCode</span>
                                        </td>

                                        <td>
                                            <span class="thryv-code-pill secondary">@item.LsaCode</span>
                                        </td>

                                        <td>@item.BookName</td>

                                        <td>
                                            <span class="@GetStagePillClass(item.StageKey, true)">
                                                @item.CompletionStatus
                                            </span>
                                        </td>

                                        <td>@(item.StageDate?.ToString("dd/MM/yyyy") ?? "-")</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        <div class="thryv-section-card weekly-evaluations-section-card">
            <div class="thryv-section-header">
                <div>
                    <h3>Weekly Evaluations</h3>
                    <p>Evaluations from last week based on the book shipping date.</p>
                </div>

                <div class="thryv-section-actions">
                    <div class="thryv-filter-group">
                        <label>Filter by employee</label>

                        <select class="thryv-filter-select" @bind="SelectedWeeklyEmployeeFilter">
                            <option value="">All Employees</option>

                            @foreach (var employee in WeeklyEmployeeFilterOptions)
                            {
                                <option value="@employee">@employee</option>
                            }
                        </select>
                    </div>

                    <div class="thryv-search-box">
                        <span>🔎</span>
                        <input placeholder="Search by KGEN or book..."
                               @bind="WeeklySearch"
                               @bind:event="oninput" />
                    </div>

                    @if (!string.IsNullOrWhiteSpace(SelectedWeeklyEmployeeFilter) ||
                                    !string.IsNullOrWhiteSpace(WeeklySearch))
                    {
                        <button type="button"
                                class="thryv-clear-filter-btn"
                                @onclick="ClearWeeklyFilters">
                            Clear
                        </button>
                    }

                    <div class="thryv-section-badge">
                        @WeeklyEvaluationsFiltered.Count records
                    </div>
                </div>
            </div>

            <div class="thryv-table-wrapper">
                <table class="thryv-custom-table">
                    <thead>
                        <tr>
                            <th>Employee</th>
                            @if (Scope.ViewAllEmployeeTypes)
                            {
                                <th>Department</th>
                            }
                            <th>KGEN Code</th>
                            <th>Book</th>
                            <th>Shipping Date</th>
                            <th>Total Accuracy</th>
                            <th>Details</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (loading)
                        {
                            <tr>
                                <td colspan="@(Scope.ViewAllEmployeeTypes ? 7 : 6)" class="thryv-empty-row">
                                    Loading weekly evaluations...
                                </td>
                            </tr>
                        }
                        else if (WeeklyEvaluationsFiltered.Count == 0)
                        {
                            <tr>
                                <td colspan="@(Scope.ViewAllEmployeeTypes ? 7 : 6)" class="thryv-empty-row">
                                    No weekly evaluations to display.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in WeeklyEvaluationsFiltered)
                            {
                                <tr>
                                    <td>
                                        <div class="thryv-employee-cell">
                                            <div class="thryv-employee-avatar weekly-avatar">📊</div>
                                            <div>
                                                <div class="thryv-employee-name">@item.EmployeeName</div>
                                            </div>
                                        </div>
                                    </td>

                                    @if (Scope.ViewAllEmployeeTypes)
                                    {
                                        <td><span class="thryv-code-pill secondary">@item.EmployeeTypeCode</span></td>
                                    }

                                    <td>
                                        <span class="thryv-code-pill">@item.KgenCode</span>
                                    </td>

                                    <td>@item.BookName</td>

                                    <td>@item.ShippingDate.ToString("dd/MM/yyyy")</td>

                                    <td>
                                        <span class="thryv-percent-pill @GetAccuracyClass(item.PercentageAverage)">
                                            @item.PercentageAverage.ToString("0.00")%
                                        </span>
                                    </td>

                                    <td>
                                        <button type="button"
                                                class="thryv-paper-btn"
                                                title="View evaluation details"
                                                @onclick="() => OpenWeeklyEvaluationModal(item)">
                                            📄
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@if (showWeeklyEvaluationModal && selectedWeeklyEvaluation is not null)
{
    <div id="weeklyEvaluationModalBackdrop"
         class="weekly-evaluation-modal-backdrop"
         @onclick="CloseWeeklyEvaluationModal">
        <div class="weekly-evaluation-modal" @onclick:stopPropagation="true">

            <div class="weekly-evaluation-modal-header">
                <div>
                    <span class="weekly-modal-eyebrow">Evaluation Details</span>
                    <h3>@selectedWeeklyEvaluation.BookName</h3>
                    <p>
                        @selectedWeeklyEvaluation.EmployeeName · KGEN:
                        <strong>@selectedWeeklyEvaluation.KgenCode</strong>
                    </p>
                </div>

                <button type="button"
                        class="weekly-modal-close"
                        @onclick="CloseWeeklyEvaluationModal">
                    ✕
                </button>
            </div>

            <div class="weekly-evaluation-modal-scroll">

                <div class="weekly-evaluation-summary-grid">
                    <div class="weekly-summary-card">
                        <span>Employee</span>
                        <strong>@selectedWeeklyEvaluation.EmployeeName</strong>
                    </div>

                    <div class="weekly-summary-card">
                        <span>KGEN Code</span>
                        <strong>@selectedWeeklyEvaluation.KgenCode</strong>
                    </div>

                    <div class="weekly-summary-card">
                        <span>Shipping Date</span>
                        <strong>@selectedWeeklyEvaluation.ShippingDate.ToString("dd/MM/yyyy")</strong>
                    </div>

                    <div class="weekly-summary-card total">
                        <span>Total Accuracy</span>
                        <strong>@selectedWeeklyEvaluation.PercentageAverage.ToString("0.00")%</strong>
                    </div>
                </div>

                <div class="weekly-evaluation-percent-grid">
                    <div class="weekly-percent-mini-card">
                        <span>Motif YP</span>
                        <strong>@selectedWeeklyEvaluation.MotifYp.ToString("0.00")%</strong>
                    </div>

                    <div class="weekly-percent-mini-card">
                        <span>Motif WP</span>
                        <strong>@selectedWeeklyEvaluation.MotifWp.ToString("0.00")%</strong>
                    </div>

                    <div class="weekly-percent-mini-card">
                        <span>Inventory</span>
                        <strong>@selectedWeeklyEvaluation.InventoryReport.ToString("0.00")%</strong>
                    </div>

                    <div class="weekly-percent-mini-card">
                        <span>Shipping Folder</span>
                        <strong>@selectedWeeklyEvaluation.ProductShippingFolder.ToString("0.00")%</strong>
                    </div>

                    <div class="weekly-percent-mini-card">
                        <span>Task Memo</span>
                        <strong>@selectedWeeklyEvaluation.TaskMemo.ToString("0.00")%</strong>
                    </div>
                </div>

                <div class="weekly-evaluation-detail-grid">

                    <div class="weekly-detail-card">
                        <div class="weekly-detail-card-header">
                            <h4>📌 Motif YP</h4>
                            <span>@CountErrors(GetMotifYpOptions(selectedWeeklyEvaluation)) errors</span>
                        </div>

                        @foreach (var option in GetMotifYpOptions(selectedWeeklyEvaluation))
                        {
                            <label class="weekly-radio-row @(option.HasError ? "failed" : "ok")">
                                <input type="radio" checked="@option.HasError" disabled />
                                <span>@option.Label</span>
                                <small>@(option.HasError ? "Failed" : "OK")</small>
                            </label>
                        }
                    </div>

                    <div class="weekly-detail-card">
                        <div class="weekly-detail-card-header">
                            <h4>⚙️ Motif WP</h4>
                            <span>@CountErrors(GetMotifWpOptions(selectedWeeklyEvaluation)) errors</span>
                        </div>

                        @foreach (var option in GetMotifWpOptions(selectedWeeklyEvaluation))
                        {
                            <label class="weekly-radio-row @(option.HasError ? "failed" : "ok")">
                                <input type="radio" checked="@option.HasError" disabled />
