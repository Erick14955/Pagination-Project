            instructionsSheet.Column(1).Width = 24;
            instructionsSheet.Column(2).Width = 12;
            instructionsSheet.Column(3).Width = 34;
            instructionsSheet.Column(4).Width = 72;
            instructionsSheet.Row(2).Height = 36;
            instructionsSheet.Row(3).Height = 42;
            instructionsSheet.SheetView.FreezeRows(5);

            var allowedValuesSheet = workbook.Worksheets.Add("Allowed Values");

            var allowedLists = new List<(string Header, IEnumerable<string> Values)>
            {
                (
                    "employee_type",
                    EmployeeTypes
                        .Where(x => x.Active)
                        .Select(x => x.Code)
                        .Where(x => !string.IsNullOrWhiteSpace(x))
                        .Distinct(StringComparer.OrdinalIgnoreCase)
                        .OrderBy(x => x)
                ),
                (
                    "Foot Print",
                    PrintFeet
                        .Select(x => x.Print_Foot_Name)
                        .Where(x => !string.IsNullOrWhiteSpace(x))
                        .Distinct(StringComparer.OrdinalIgnoreCase)
                        .OrderBy(x => x)
                ),
                (
                    "Legacy Co",
                    LegacyCodes
                        .Select(x => x.Legacy_Code_Name)
                        .Where(x => !string.IsNullOrWhiteSpace(x))
                        .Distinct(StringComparer.OrdinalIgnoreCase)
                        .OrderBy(x => x)
                ),
                (
                    "State",
                    States
                        .Select(x => x.State_Name)
                        .Where(x => !string.IsNullOrWhiteSpace(x))
                        .Distinct(StringComparer.OrdinalIgnoreCase)
                        .OrderBy(x => x)
