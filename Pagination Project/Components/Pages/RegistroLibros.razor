    {
        if (!EditBook)
            return;

        SeleccionarLibro(libro);
    }

    private IEnumerable<Libros> LibrosOrdenados => ApplySorting(LibrosFiltrados);

    private IEnumerable<PubMonthOption> PubDateMonths
    {
        get
        {
            return Libros
                .Where(l => l.PubDate != default)
                .GroupBy(l => GetPubMonthValue(l.PubDate))
                .Select(g =>
                {
                    var firstDate = g.First().PubDate;

                    return new PubMonthOption
                    {
                        Value = g.Key,
                        Label = GetPubMonthLabel(firstDate),
                        Count = g.Count()
                    };
                })
                .OrderByDescending(x => x.Value);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _cargaInicialIniciada)
            return;

        _cargaInicialIniciada = true;

        await CargarPaginaInicialAsync();
    }

    private async Task CargarPaginaInicialAsync()
    {
        CargandoInicial = true;
        Cargando = true;

        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            _user = authState.User;

            if (_user.Identity?.IsAuthenticated != true)
            {
                Libros = new List<Libros>();
                EtapasTrabajadasPorLibro = new Dictionary<Guid, BookWorkedStages>();
                Formulario = new Libros();
                return;
            }

            Scope = await UserDataScopeService.GetScopeAsync(_user);

            CreateBook = HasPermission(_user, "CreateBook");
            EditBook = HasPermission(_user, "EditBook");
            DeleteBook = HasPermission(_user, "DeleteBook");
            BooksView = HasPermission(_user, "BooksView");

            await CargarCatalogosAsync();

            Formulario = CrearNuevoLibro();

            await CargarLibrosAsync();
        }
        catch (Exception ex)
        {
            Libros = new List<Libros>();
            EtapasTrabajadasPorLibro = new Dictionary<Guid, BookWorkedStages>();
            Formulario = new Libros();

            MostrarMensaje(
                $"Error loading book management: {ex.Message}",
                "error");
        }
        finally
        {
            Cargando = false;
            CargandoInicial = false;

            await InvokeAsync(StateHasChanged);
        }
    }

    private static bool HasPermission(ClaimsPrincipal? user, string claimType)
    {
        if (user is null)
            return false;

        return string.Equals(
            user.FindFirst(claimType)?.Value,
            "True",
            StringComparison.OrdinalIgnoreCase);
    }

    private async Task CargarCatalogosAsync()
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            EmployeeTypes = await db.EmployeeTypes
                .AsNoTracking()
                .Where(x => x.Active)
                .OrderBy(x => x.Code)
                .ToListAsync();

            BindPlants = await db.Bind_Plants
                .AsNoTracking()
                .OrderBy(x => x.Bind_Plant_Name)
                .ToListAsync();

            Databases = await db.Databases
                .AsNoTracking()
                .OrderBy(x => x.Database_Name)
                .ToListAsync();

            LegacyCodes = await db.Legacy_Codes
                .AsNoTracking()
                .OrderBy(x => x.Legacy_Code_Name)
                .ToListAsync();

            PrintFeet = await db.Print_Foots
                .AsNoTracking()
                .OrderBy(x => x.Print_Foot_Name)
                .ToListAsync();

            States = await db.States
                .AsNoTracking()
                .OrderBy(x => x.State_Name)
                .ToListAsync();

            TrimSizes = await db.Trim_Sizes
                .AsNoTracking()
                .OrderBy(x => x.Trim_Size_Name)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            MostrarMensaje($"Error loading catalogs: {ex.Message}", "error");
        }
    }

    private async Task CargarLibrosAsync()
    {
        try
        {
            Cargando = true;

            await using var db = await DbFactory.CreateDbContextAsync();

            await ActualizarFinalizadosPorDirxionAsync(db);

            Libros = await db.Libros
                .AsNoTracking()
                .Include(l => l.EmployeeType)
                .ApplyScope(Scope)
                .Where(l => !l.Finalizado)
                .OrderBy(l => l.BookName)
                .ToListAsync();

            await CargarEtapasTrabajadasAsync(db);
        }
        catch (Exception ex)
        {
            MostrarMensaje($"Error loading books: {ex.Message}", "error");
        }
        finally
        {
            Cargando = false;
        }
    }

    private async Task CargarEtapasTrabajadasAsync(AppDbContext db)
    {
        EtapasTrabajadasPorLibro = new Dictionary<Guid, BookWorkedStages>();

        var bookIds = Libros
            .Select(x => x.Id)
            .Distinct()
            .ToList();

        if (!bookIds.Any())
            return;

        var registros = await (
            from trabajado in db.AsignacionesTrabajadas.AsNoTracking()
            join asignacion in db.Asignaciones.AsNoTracking()
                on trabajado.IdAsignacion equals asignacion.Id
            where bookIds.Contains(asignacion.IdLibro)
            select new
            {
                BookId = asignacion.IdLibro,
                trabajado.ProofExtractWorked,
                trabajado.FinalExtractWorked,
                trabajado.MemoExtractWorked,
                trabajado.FinalPOWorked,
                trabajado.ShippingWorked,
                trabajado.DirxionWorked
            }
        ).ToListAsync();

        EtapasTrabajadasPorLibro = registros
            .GroupBy(x => x.BookId)
            .ToDictionary(
                group => group.Key,
                group => new BookWorkedStages
                {
                    ProofExtractWorked = group.Any(x => x.ProofExtractWorked),
                    FinalExtractWorked = group.Any(x => x.FinalExtractWorked),
                    MemoExtractWorked = group.Any(x => x.MemoExtractWorked),
                    FinalPOWorked = group.Any(x => x.FinalPOWorked),
                    ShippingWorked = group.Any(x => x.ShippingWorked),
                    DirxionWorked = group.Any(x => x.DirxionWorked)
                });
    }

    private bool IsStageWorked(Guid bookId, string stageKey)
    {
        if (!EtapasTrabajadasPorLibro.TryGetValue(bookId, out var stages))
            return false;

        return stageKey switch
        {
            "ProofExtract" => stages.ProofExtractWorked,
            "FinalExtract" => stages.FinalExtractWorked,
            "MemoExtract" => stages.MemoExtractWorked,
            "FinalPO" => stages.FinalPOWorked,
            "Shipping" => stages.ShippingWorked,
            "Dirxion" => stages.DirxionWorked,
            _ => false
        };
    }

    private string GetDateTextClass(Guid bookId, string stageKey, DateOnly date)
    {
        if (date == default)
            return "book-date-text book-date-empty";

        return IsStageWorked(bookId, stageKey)
            ? "book-date-text book-date-worked"
            : "book-date-text";
    }

    private string GetDateTextTitle(Guid bookId, string stageKey, DateOnly date)
    {
        if (date == default)
            return "Date not available.";

        return IsStageWorked(bookId, stageKey)
            ? "This stage has already been worked."
            : "This stage has not been marked as worked.";
    }

    private async Task ActualizarFinalizadosPorDirxionAsync(AppDbContext db)
    {
        var hoy = DateOnly.FromDateTime(DateTime.Today);

        var librosParaFinalizar = await db.Libros
            .ApplyScope(Scope)
            .Include(l => l.Asignaciones)
                .ThenInclude(a => a.Evaluaciones)
            .Where(l => !l.Finalizado &&
                        l.DirxionDate < hoy)
            .ToListAsync();

        if (!librosParaFinalizar.Any())
            return;

        foreach (var libro in librosParaFinalizar)
        {
            libro.Finalizado = true;

            foreach (var asignacion in libro.Asignaciones)
            {
                asignacion.Finalizado = true;

                foreach (var evaluacion in asignacion.Evaluaciones)
                {
                    evaluacion.Finalizado = true;
                }
            }
        }

        await db.SaveChangesAsync();
    }

    private async Task GuardarLibroAsync()
    {
        if (!PuedeCrearOEditarLibro)
        {
            MostrarResultadoLibro(
                "Unauthorized",
                "You do not have permission to save books.",
                "error");
            return;
        }

        try
        {
            Guardando = true;
            LimpiarMensaje();

            if (string.IsNullOrWhiteSpace(Formulario.BookName))
            {
                MostrarResultadoLibro(
                    "Unable to save book",
                    "Book name is required.",
                    "error");
                return;
            }

            if (string.IsNullOrWhiteSpace(Formulario.KGENCode))
            {
                MostrarResultadoLibro(
                    "Unable to save book",
                    "KGEN Code is required.",
                    "error");
                return;
            }

            if (Formulario.EmployeeTypeId <= 0 || !Scope.CanAccess(Formulario.EmployeeTypeId))
            {
                MostrarResultadoLibro(
                    "Unable to save book",
                    "Select a valid employee type.",
                    "error");
                return;
            }

            Formulario.BookName = Formulario.BookName.Trim();
            Formulario.KGENCode = Formulario.KGENCode.Trim();

            var editando = Formulario.Id != Guid.Empty;
            var nombreLibro = Formulario.BookName;

            await using var db = await DbFactory.CreateDbContextAsync();

            var normalizedKgen = Formulario.KGENCode.ToUpperInvariant();
            var duplicatedKgen = await db.Libros.AnyAsync(l =>
                l.Id != Formulario.Id &&
                l.KGENCode.Trim().ToUpper() == normalizedKgen);

            if (duplicatedKgen)
            {
                MostrarResultadoLibro(
                    "Duplicate KGEN Code",
                    "The KGEN Code already exists. KGEN is unique across DR and Eclerx.",
                    "error");
                return;
            }

            if (!editando)
            {
                Formulario.Id = Guid.NewGuid();

                db.Libros.Add(ClonarLibro(Formulario));
                await db.SaveChangesAsync();
            }
            else
            {
                var libroDb = await db.Libros
                    .ApplyScope(Scope)
                    .FirstOrDefaultAsync(l => l.Id == Formulario.Id);

                if (libroDb is null)
                {
                    MostrarResultadoLibro(
                        "Book not found",
                        "The selected book was not found.",
                        "error");
                    return;
                }

                if (libroDb.EmployeeTypeId != Formulario.EmployeeTypeId &&
                    await db.Asignaciones.AnyAsync(a => a.IdLibro == libroDb.Id))
                {
                    MostrarResultadoLibro(
                        "Department cannot be changed",
                        "The employee type cannot be changed because this book already has assignments.",
                        "error");
                    return;
                }

                libroDb.EmployeeTypeId = Formulario.EmployeeTypeId;
                libroDb.PrintFootId = Formulario.PrintFootId;
                libroDb.LegacyCodeId = Formulario.LegacyCodeId;
                libroDb.StateId = Formulario.StateId;
                libroDb.DatabaseId = Formulario.DatabaseId;
                libroDb.TrimSizeId = Formulario.TrimSizeId;
                libroDb.BindPlantId = Formulario.BindPlantId;

                libroDb.LSACode = Formulario.LSACode;
                libroDb.KGENCode = Formulario.KGENCode;
                libroDb.BookName = Formulario.BookName;
                libroDb.ProductIssue = Formulario.ProductIssue;

                libroDb.ProofExtract = Formulario.ProofExtract;
                libroDb.FinalExtract = Formulario.FinalExtract;
                libroDb.MemoExtract = Formulario.MemoExtract;
                libroDb.FinalPODate = Formulario.FinalPODate;
                libroDb.ShippingDate = Formulario.ShippingDate;
                libroDb.DirxionDate = Formulario.DirxionDate;
                libroDb.PubDate = Formulario.PubDate;

                libroDb.SRLSuppression = Formulario.SRLSuppression;
                libroDb.NWP = Formulario.NWP;

                await db.SaveChangesAsync();
            }

            await CargarLibrosAsync();
            LimpiarFormulario();

            MostrarResultadoLibro(
                editando ? "Book updated" : "Book created",
                editando
                    ? $"The book '{nombreLibro}' was updated successfully."
                    : $"The book '{nombreLibro}' was saved successfully.",
                "success");
        }
        catch (Exception ex)
        {
            MostrarResultadoLibro(
                "Error saving book",
                $"The book could not be saved. {ex.Message}",
                "error");
        }
        finally
        {
            Guardando = false;
        }
    }

    private void SeleccionarLibro(Libros libro)
    {
        if (!EditBook)
            return;

        LibroSeleccionadoId = libro.Id;
        Formulario = ClonarLibro(libro);

        MostrarMensaje("Book loaded for editing.", "info");
    }

    private async Task EliminarLibroAsync()
    {
        if (!DeleteBook)
        {
            MostrarMensaje("You do not have permission to delete books.", "error");
            return;
        }

        if (LibroSeleccionadoId is null || Formulario.Id == Guid.Empty)
        {
            MostrarMensaje("Select a book before deleting.", "error");
            return;
        }

        var confirmar = await JS.InvokeAsync<bool>(
            "confirm",
            $"Are you sure you want to delete '{Formulario.BookName}'?");

        if (!confirmar)
            return;

        try
        {
            Guardando = true;

            await using var db = await DbFactory.CreateDbContextAsync();

            var libroDb = await db.Libros
                .ApplyScope(Scope)
                .FirstOrDefaultAsync(l => l.Id == Formulario.Id);

            if (libroDb is null)
            {
                MostrarMensaje("The selected book was not found.", "error");
                return;
            }

            db.Libros.Remove(libroDb);
            await db.SaveChangesAsync();

            MostrarMensaje("Book deleted successfully.", "success");

            await CargarLibrosAsync();
            LimpiarFormulario();
        }
        catch (Exception ex)
        {
            MostrarMensaje($"Error deleting book: {ex.Message}", "error");
        }
        finally
        {
            Guardando = false;
        }
    }

    private void LimpiarFormulario()
    {
        if (!CreateBook && !EditBook)
            return;

        Formulario = CrearNuevoLibro();
        LibroSeleccionadoId = null;
        LimpiarMensaje();
    }

