    private static string GetPubMonthValue(DateOnly date)
    {
        if (date == default)
            return string.Empty;

        return $"{date.Year:D4}-{date.Month:D2}";
    }

    private static string GetPubMonthLabel(DateOnly date)
    {
        if (date == default)
            return "No Pub Date";

        var firstDayOfMonth = new DateTime(date.Year, date.Month, 1);

        return firstDayOfMonth.ToString("MMMM yyyy", CultureInfo.InvariantCulture);
    }

