                                    <td>@GetDatabaseName(libro.DatabaseId)</td>
                                    <td>@GetLegacyCodeName(libro.LegacyCodeId)</td>
                                    <td>@GetPrintFootName(libro.PrintFootId)</td>
                                    <td>@GetTrimSizeName(libro.TrimSizeId)</td>
                                    <td>@GetBindPlantName(libro.BindPlantId)</td>
                                    <td>@libro.ProductIssue</td>
                                    <td>
