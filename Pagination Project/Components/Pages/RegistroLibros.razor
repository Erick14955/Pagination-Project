        return fecha.ToString("MM/dd/yyyy", CultureInfo.InvariantCulture);
    }

    private void MostrarResultadoLibro(string titulo, string mensaje, string tipo)
    {
        TituloModalResultadoLibro = titulo;
        MensajeModalResultadoLibro = mensaje;
        TipoModalResultadoLibro = string.Equals(
            tipo,
            "error",
            StringComparison.OrdinalIgnoreCase)
                ? "error"
                : "success";

        MostrarModalResultadoLibro = true;
    }

    private void CerrarModalResultadoLibro()
    {
        MostrarModalResultadoLibro = false;
        TituloModalResultadoLibro = string.Empty;
        MensajeModalResultadoLibro = string.Empty;
        TipoModalResultadoLibro = "success";
    }

    private void MostrarMensaje(string mensaje, string tipo)
    {
