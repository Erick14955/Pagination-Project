            instructionsTableRange.Style.Border.InsideBorder = XLBorderStyleValues.Thin;
            instructionsTableRange.Style.Alignment.Vertical = XLAlignmentVerticalValues.Top;
            instructionsTableRange.Style.Alignment.WrapText = true;

            for (var row = 6; row < instructionRow; row++)
            {
                if (string.Equals(
                    instructionsSheet.Cell(row, 2).GetString(),
                    "Yes",
                    StringComparison.OrdinalIgnoreCase))
                {
                    instructionsSheet.Cell(row, 2)
                        .Style.Fill.BackgroundColor = XLColor.FromHtml("#FFEDD5");

                    instructionsSheet.Cell(row, 2)
                        .Style.Font.FontColor = XLColor.FromHtml("#C2410C");

                    instructionsSheet.Cell(row, 2)
                        .Style.Font.Bold = true;
