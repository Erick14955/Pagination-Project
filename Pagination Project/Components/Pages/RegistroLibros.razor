@page "/books"
@page "/libros"
@page "/registro-libros"

@using System.Globalization
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@using ClosedXML.Excel
@using Pagination_Project.Data
@using Pagination_Project.Models
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization

@attribute [Authorize]
@layout Pagination_Project.Components.Layout.DashboardLayout

@inject IDbContextFactory<AppDbContext> DbFactory
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Books - BibliotecaApp</PageTitle>

<div class="books-page">

    <section class="page-hero">
        <div>
            <h1>Book Management</h1>
            <p>
                Create, update, and manage books.
            </p>
        </div>

        <div class="hero-stats">
            <div class="stat-card">
                <span>Total</span>
                <strong>@Libros.Count</strong>
            </div>

            <div class="stat-card">
                <span>Filtered</span>
                <strong>@LibrosFiltrados.Count()</strong>
            </div>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(Mensaje))
    {
        <div class="alert-box @TipoMensaje">
            @Mensaje
        </div>
    }

    @if (MostrarModalActualizacionXlsx && ResultadoActualizacionModal is not null)
    {
        <div class="xlsx-modal-backdrop">
            <div class="xlsx-modal-card @(TipoModalActualizacionXlsx == "error" ? "xlsx-modal-error" : "xlsx-modal-success")">

                <div class="xlsx-modal-header">
                    <div>
                        <h2>@TituloModalActualizacionXlsx</h2>
                        <p>
                            The XLSX update process has finished.
                        </p>
                    </div>

                    <button type="button"
                            class="xlsx-modal-close"
                            @onclick="CerrarModalActualizacionXlsx">
                        ✕
                    </button>
                </div>

                <div class="xlsx-modal-stats">
                    <div>
                        <span>Updated</span>
                        <strong>@ResultadoActualizacionModal.LibrosActualizados</strong>
                    </div>

                    <div>
                        <span>Not Found</span>
                        <strong>@ResultadoActualizacionModal.LibrosNoEncontrados</strong>
                    </div>

                    <div>
                        <span>Skipped Rows</span>
                        <strong>@ResultadoActualizacionModal.FilasOmitidas</strong>
                    </div>
                </div>

                @if (ResultadoActualizacionModal.Advertencias.Any())
                {
                    <div class="xlsx-modal-section warning">
                        <h3>Warnings</h3>

                        <ul>
                            @foreach (var warning in ResultadoActualizacionModal.Advertencias.Take(20))
                            {
                                <li>@warning</li>
                            }
                        </ul>

                        @if (ResultadoActualizacionModal.Advertencias.Count > 20)
                        {
                            <p class="xlsx-modal-more">
                                And @(ResultadoActualizacionModal.Advertencias.Count - 20) more warnings.
                            </p>
                        }
                    </div>
                }

                @if (ResultadoActualizacionModal.Errores.Any())
                {
                    <div class="xlsx-modal-section error">
                        <h3>Errors</h3>

                        <ul>
                            @foreach (var error in ResultadoActualizacionModal.Errores.Take(20))
                            {
                                <li>@error</li>
                            }
                        </ul>

                        @if (ResultadoActualizacionModal.Errores.Count > 20)
                        {
                            <p class="xlsx-modal-more">
                                And @(ResultadoActualizacionModal.Errores.Count - 20) more errors.
                            </p>
                        }
                    </div>
                }

                @if (!ResultadoActualizacionModal.Advertencias.Any() &&
                            !ResultadoActualizacionModal.Errores.Any())
                {
                    <div class="xlsx-modal-section clean">
                        <h3>Update completed successfully</h3>
                        <p>No warnings or errors were found during the update.</p>
                    </div>
                }

                <div class="xlsx-modal-actions">
                    <button type="button"
                            class="xlsx-modal-ok"
                            @onclick="CerrarModalActualizacionXlsx">
                        OK
                    </button>
                </div>
            </div>
        </div>
    }

    @if (PuedeVerFormularioLibro)
    {
        <section class="form-card">
            <div class="section-header">
                <div>
                    <h2>@(LibroSeleccionadoId is null ? "Add New Book" : "Edit Selected Book")</h2>
                    <p>Complete the book information, codes and extract dates</p>
                </div>

                <div class="header-actions">
                    @if (CreateBook || EditBook)
                    {
                        <InputFile @key="XlsxInputKey"
                                   id="xlsxUpload"
                                   class="file-input-hidden"
                                   OnChange="ImportBooksFromXlsxAsync"
                                   accept=".xlsx" />

                        <label for="xlsxUpload" class="btn-xlsx @(ImportandoXlsx ? "disabled" : "")">
                            @(ImportandoXlsx ? "Uploading..." : "📥 Add with XLSX")
                        </label>

                        <InputFile @key="XlsxUpdateInputKey"
                                   id="xlsxBooksUpdateUpload"
                                   class="file-input-hidden"
                                   OnChange="UpdateBooksFromXlsxAsync"
                                   accept=".xlsx" />

                        <label for="xlsxBooksUpdateUpload" class="btn-update-xlsx @(ActualizandoLibrosXlsx ? "disabled" : "")">
                            @(ActualizandoLibrosXlsx ? "Updating..." : "🔄 Update with XLSX")
                        </label>
                    }

                    @if (CreateBook || EditBook)
                    {
                        <button type="button" class="btn-light" @onclick="LimpiarFormulario">
                            ✨ New
                        </button>
                    }
                </div>
            </div>

            <form @onsubmit="GuardarLibroAsync" @onsubmit:preventDefault>
                <div class="form-grid">

                    <div class="form-group large">
                        <label>Book Name</label>
                        <input class="form-control"
                               @bind="Formulario.BookName"
                               placeholder="Book name"
                               required />
                    </div>

                    <div class="form-group">
                        <label>KGEN Code</label>
                        <input class="form-control"
                               @bind="Formulario.KGENCode"
                               placeholder="KGEN Code" />
                    </div>

                    <div class="form-group">
                        <label>LSA Code</label>
                        <input class="form-control"
                               @bind="Formulario.LSACode"
                               placeholder="LSA Code" />
                    </div>

                    <div class="form-group">
                        <label>Legacy Code</label>
                        <select class="form-control" @bind="Formulario.LegacyCodeId">
                            <option value="">Select legacy code</option>
                            @foreach (var item in LegacyCodes)
                            {
                                <option value="@item.Id">@item.Legacy_Code_Name</option>
                            }
                        </select>
                    </div>

                    <div class="form-group">
                        <label>State</label>
                        <select class="form-control" @bind="Formulario.StateId">
                            <option value="">Select state</option>
                            @foreach (var item in States)
                            {
                                <option value="@item.Id">@item.State_Name</option>
                            }
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Database</label>
                        <select class="form-control" @bind="Formulario.DatabaseId">
                            <option value="">Select database</option>
                            @foreach (var item in Databases)
                            {
                                <option value="@item.Id">@item.Database_Name</option>
                            }
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Product Issue</label>
                        <input class="form-control"
                               @bind="Formulario.ProductIssue"
                               placeholder="Product Issue" />
                    </div>

                    <div class="form-group">
                        <label>Trim Size</label>
                        <select class="form-control" @bind="Formulario.TrimSizeId">
                            <option value="">Select trim size</option>
                            @foreach (var item in TrimSizes)
                            {
                                <option value="@item.Id">@item.Trim_Size_Name</option>
                            }
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Bind Plant</label>
                        <select class="form-control" @bind="Formulario.BindPlantId">
                            <option value="">Select bind plant</option>
                            @foreach (var item in BindPlants)
                            {
                                <option value="@item.Id">@item.Bind_Plant_Name</option>
                            }
                        </select>
                    </div>

                    <div class="form-group large">
                        <label>Print Foot</label>
                        <select class="form-control" @bind="Formulario.PrintFootId">
                            <option value="">Select print foot</option>
                            @foreach (var item in PrintFeet)
                            {
                                <option value="@item.Id">@item.Print_Foot_Name</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="subsection-title">
                    <span>Book Dates</span>
                </div>

                <div class="form-grid dates-grid">

                    <div class="form-group">
                        <label>Proof Extract</label>
                        <input type="date"
                               class="form-control"
                               value="@ToInputDate(Formulario.ProofExtract)"
                               @onchange="e => Formulario.ProofExtract = ParseDate(e.Value)" />
                    </div>

                    <div class="form-group">
                        <label>Final Extract</label>
                        <input type="date"
                               class="form-control"
                               value="@ToInputDate(Formulario.FinalExtract)"
                               @onchange="e => Formulario.FinalExtract = ParseDate(e.Value)" />
                    </div>

                    <div class="form-group">
                        <label>Memo Extract</label>
                        <input type="date"
                               class="form-control"
                               value="@ToInputDate(Formulario.MemoExtract)"
                               @onchange="e => Formulario.MemoExtract = ParseDate(e.Value)" />
                    </div>

                    <div class="form-group">
                        <label>Final PO Date</label>
                        <input type="date"
                               class="form-control"
                               value="@ToInputDate(Formulario.FinalPODate)"
                               @onchange="e => Formulario.FinalPODate = ParseDate(e.Value)" />
                    </div>

                    <div class="form-group">
                        <label>Shipping Date</label>
                        <input type="date"
                               class="form-control"
                               value="@ToInputDate(Formulario.ShippingDate)"
                               @onchange="e => Formulario.ShippingDate = ParseDate(e.Value)" />
                    </div>

                    <div class="form-group">
                        <label>Dirxion Date</label>
                        <input type="date"
                               class="form-control"
                               value="@ToInputDate(Formulario.DirxionDate)"
                               @onchange="e => Formulario.DirxionDate = ParseDate(e.Value)" />
                    </div>

                    <div class="form-group">
                        <label>Pub Date</label>
                        <input type="date"
                               class="form-control"
                               value="@ToInputDate(Formulario.PubDate)"
                               @onchange="e => Formulario.PubDate = ParseDate(e.Value)" />
                    </div>
                </div>

                <div class="switch-row">
                    <label class="switch-card">
                        <input type="checkbox" @bind="Formulario.SRLSuppression" />
                        <span>
                            <strong>SRL Suppression</strong>
                            <small>Enable this option if SRL suppression applies.</small>
                        </span>
                    </label>

                    <label class="switch-card">
                        <input type="checkbox" @bind="Formulario.NWP" />
                        <span>
                            <strong>NWP</strong>
                            <small>Enable this option if the book applies to NWP.</small>
                        </span>
                    </label>
                </div>

                <div class="button-row">
                    @if (PuedeCrearOEditarLibro)
                    {
                        <button type="submit" class="btn-primary" disabled="@Guardando">
                            @(Guardando ? "Saving..." : LibroSeleccionadoId is null ? "Save Book" : "Save Changes")
                        </button>
                    }

                    @if (CreateBook || EditBook)
                    {
                        <button type="button" class="btn-secondary" @onclick="LimpiarFormulario">
                            Clear
                        </button>
                    }

                    @if (DeleteBook)
                    {
                        <button type="button"
                                class="btn-danger"
                                disabled="@(LibroSeleccionadoId is null || Guardando)"
                                @onclick="EliminarLibroAsync">
                            Delete
                        </button>
                    }
                </div>
            </form>
        </section>
    }

    <section class="list-card">
        <div class="section-header table-header">
            <div>
                <h2>Book List</h2>
                <p>Double-click a row to load it into the form.</p>
            </div>

            <div class="list-filters">
                <div class="search-box">
                    <span>🔎</span>
                    <input placeholder="Search by book, KGEN, LSA, state, database, legacy code, print foot..."
                           @bind="Busqueda"
                           @bind:event="oninput" />
                </div>

                <div class="month-filter">
                    <label>Pub Date Month</label>
                    <select class="form-control filter-select" @bind="SelectedPubMonth">
                        <option value="">All Pub Dates</option>
                        @foreach (var month in PubDateMonths)
                        {
                            <option value="@month.Value">@month.Label (@month.Count)</option>
                        }
                    </select>
                </div>

                <button type="button" class="btn-filter-clear" @onclick="ClearListFilters">
                    Clear
                </button>

                <button type="button"
                        class="btn-export-xlsx"
                        disabled="@(ExportandoXlsx || !LibrosFiltrados.Any())"
                        @onclick="ExportBooksToXlsxAsync">
                    @(ExportandoXlsx ? "Exporting..." : "📤 Export XLSX")
                </button>
            </div>
        </div>

        @if (Cargando)
        {
            <div class="loading-state">
                Loading books...
            </div>
        }
        else if (!LibrosFiltrados.Any())
        {
            <div class="empty-state">
                <strong>No books to display.</strong>
                <span>Add a new book or change the search filter.</span>
            </div>
        }
        else
        {
            <div class="table-container">
                <table class="books-table">
                    <thead>
                        <tr>
                            <th>
                                <button type="button" class="sortable-header" @onclick='() => SortBy("BookName")'>
                                    Book Name <span>@GetSortIcon("BookName")</span>
                                </button>
                            </th>

                            <th>
                                <button type="button" class="sortable-header" @onclick='() => SortBy("KGEN")'>
                                    KGEN <span>@GetSortIcon("KGEN")</span>
                                </button>
                            </th>

                            <th>
                                <button type="button" class="sortable-header" @onclick='() => SortBy("LSA")'>
                                    LSA <span>@GetSortIcon("LSA")</span>
                                </button>
                            </th>

                            <th>
                                <button type="button" class="sortable-header" @onclick='() => SortBy("State")'>
                                    State <span>@GetSortIcon("State")</span>
                                </button>
                            </th>

                            <th>
                                <button type="button" class="sortable-header" @onclick='() => SortBy("Database")'>
                                    Database <span>@GetSortIcon("Database")</span>
                                </button>
                            </th>

                            <th>
                                <button type="button" class="sortable-header" @onclick='() => SortBy("Legacy")'>
                                    Legacy Code <span>@GetSortIcon("Legacy")</span>
                                </button>
                            </th>

                            <th>Print Foot</th>
                            <th>Trim Size</th>
                            <th>Bind Plant</th>
                            <th>Product Issue</th>

                            <th>
                                <button type="button" class="sortable-header" @onclick='() => SortBy("Proof")'>
                                    Proof <span>@GetSortIcon("Proof")</span>
                                </button>
                            </th>

                            <th>
                                <button type="button" class="sortable-header" @onclick='() => SortBy("Final")'>
                                    Final <span>@GetSortIcon("Final")</span>
                                </button>
                            </th>

                            <th>
                                <button type="button" class="sortable-header" @onclick='() => SortBy("Memo")'>
                                    Memo <span>@GetSortIcon("Memo")</span>
                                </button>
                            </th>

                            <th>
                                <button type="button" class="sortable-header" @onclick='() => SortBy("FinalPO")'>
                                    Final PO <span>@GetSortIcon("FinalPO")</span>
                                </button>
                            </th>

                            <th>
                                <button type="button" class="sortable-header" @onclick='() => SortBy("Shipping")'>
                                    Shipping <span>@GetSortIcon("Shipping")</span>
                                </button>
                            </th>

                            <th>
                                <button type="button" class="sortable-header" @onclick='() => SortBy("Dirxion")'>
                                    Dirxion <span>@GetSortIcon("Dirxion")</span>
                                </button>
                            </th>

                            <th>
                                <button type="button" class="sortable-header" @onclick='() => SortBy("PubDate")'>
                                    Pub Date <span>@GetSortIcon("PubDate")</span>
                                </button>
                            </th>

                            <th>SRL</th>
                            <th>NWP</th>
                            @if (EditBook)
                            {
                                <th></th>
                            }
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var libro in LibrosOrdenados)
                        {
                            <tr class="@(LibroSeleccionadoId == libro.Id ? "selected-row" : "")"
                                @ondblclick="() => OnDobleClickLibro(libro)">

                                <td>
                                    <div class="book-title">
                                        <strong>@libro.BookName</strong>
                                        <span>@GetPrintFootName(libro.PrintFootId)</span>
                                    </div>
                                </td>

                                <td>@libro.KGENCode</td>
                                <td>@libro.LSACode</td>

                                <td>
                                    <span class="pill">@GetStateName(libro.StateId)</span>
                                </td>

                                <td>@GetDatabaseName(libro.DatabaseId)</td>
                                <td>@GetLegacyCodeName(libro.LegacyCodeId)</td>
                                <td>@GetPrintFootName(libro.PrintFootId)</td>
                                <td>@GetTrimSizeName(libro.TrimSizeId)</td>
                                <td>@GetBindPlantName(libro.BindPlantId)</td>
                                <td>@libro.ProductIssue</td>
                                <td>@FormatoFecha(libro.ProofExtract)</td>
                                <td>@FormatoFecha(libro.FinalExtract)</td>
                                <td>@FormatoFecha(libro.MemoExtract)</td>
                                <td>@FormatoFecha(libro.FinalPODate)</td>
                                <td>@FormatoFecha(libro.ShippingDate)</td>
                                <td>@FormatoFecha(libro.DirxionDate)</td>
                                <td>@FormatoFecha(libro.PubDate)</td>
                                <td>@(libro.SRLSuppression ? "Yes" : "No")</td>
                                <td>@(libro.NWP ? "Yes" : "No")</td>

                                @if (EditBook)
                                {
                                    <td class="actions-cell">
                                        <button type="button"
                                                class="icon-btn"
                                                title="Edit"
                                                @onclick="() => SeleccionarLibro(libro)">
                                            ✏️
                                        </button>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>

@code {
    private List<Libros> Libros { get; set; } = new();

    private ClaimsPrincipal? _user;

    private bool CreateBook { get; set; }
    private bool EditBook { get; set; }
    private bool DeleteBook { get; set; }
    private bool BooksView { get; set; }

    private bool PuedeCrearOEditarLibro => LibroSeleccionadoId is null ? CreateBook : EditBook;
    private bool PuedeVerFormularioLibro => CreateBook || EditBook;
    private bool SoloVistaLibros => BooksView && !CreateBook && !EditBook && !DeleteBook;

    private List<Bind_Plant> BindPlants { get; set; } = new();
    private List<Pagination_Project.Models.Database> Databases { get; set; } = new();
    private List<Legacy_Code> LegacyCodes { get; set; } = new();
    private List<Print_Foot> PrintFeet { get; set; } = new();
    private List<State> States { get; set; } = new();
    private List<Trim_Size> TrimSizes { get; set; } = new();

    private Libros Formulario { get; set; } = CrearNuevoLibro();

    private Guid? LibroSeleccionadoId { get; set; }

    private string Busqueda { get; set; } = string.Empty;
    private string Mensaje { get; set; } = string.Empty;
    private string TipoMensaje { get; set; } = "success";
    private bool ExportandoXlsx { get; set; } = false;

    private bool Cargando { get; set; } = true;
    private bool Guardando { get; set; } = false;
    private bool ImportandoXlsx { get; set; } = false;

    private int XlsxInputKey { get; set; } = 0;

    private bool ActualizandoLibrosXlsx { get; set; } = false;
    private Guid XlsxUpdateInputKey { get; set; } = Guid.NewGuid();

    private const long MaxXlsxSize = 20 * 1024 * 1024;

    private string SelectedPubMonth { get; set; } = string.Empty;
    private string SortColumn { get; set; } = "BookName";
    private bool SortDescending { get; set; } = false;

    private bool MostrarModalActualizacionXlsx { get; set; } = false;
    private ActualizacionLibrosResultado? ResultadoActualizacionModal { get; set; }
    private string TituloModalActualizacionXlsx { get; set; } = "XLSX Books Update";
    private string TipoModalActualizacionXlsx { get; set; } = "success";

    private IEnumerable<Libros> LibrosFiltrados
    {
        get
        {
            IEnumerable<Libros> query = Libros;

            if (!string.IsNullOrWhiteSpace(Busqueda))
            {
                var filtro = Busqueda.Trim().ToLowerInvariant();

                query = query.Where(l =>
                    (l.BookName ?? string.Empty).ToLowerInvariant().Contains(filtro) ||
                    (l.KGENCode ?? string.Empty).ToLowerInvariant().Contains(filtro) ||
                    (l.LSACode ?? string.Empty).ToLowerInvariant().Contains(filtro) ||
                    (l.ProductIssue ?? string.Empty).ToLowerInvariant().Contains(filtro) ||
                    GetStateName(l.StateId).ToLowerInvariant().Contains(filtro) ||
                    GetDatabaseName(l.DatabaseId).ToLowerInvariant().Contains(filtro) ||
                    GetLegacyCodeName(l.LegacyCodeId).ToLowerInvariant().Contains(filtro) ||
                    GetPrintFootName(l.PrintFootId).ToLowerInvariant().Contains(filtro) ||
                    GetTrimSizeName(l.TrimSizeId).ToLowerInvariant().Contains(filtro) ||
                    GetBindPlantName(l.BindPlantId).ToLowerInvariant().Contains(filtro));
            }

            if (!string.IsNullOrWhiteSpace(SelectedPubMonth))
            {
                query = query.Where(l => GetPubMonthValue(l.PubDate) == SelectedPubMonth);
            }

            return query;
        }
    }

    private void MostrarModalActualizacionLibros(ActualizacionLibrosResultado resultado)
    {
        ResultadoActualizacionModal = resultado;

        TipoModalActualizacionXlsx = resultado.TieneErrores ? "error" : "success";

        TituloModalActualizacionXlsx = resultado.TieneErrores
            ? "XLSX Books Update Completed with Errors"
            : "XLSX Books Update Completed";

        MostrarModalActualizacionXlsx = true;
    }

    private void MostrarModalErrorActualizacionLibros(string error)
    {
        ResultadoActualizacionModal = new ActualizacionLibrosResultado
        {
            Errores = new List<string> { error }
        };

        TipoModalActualizacionXlsx = "error";
        TituloModalActualizacionXlsx = "XLSX Books Update Error";
        MostrarModalActualizacionXlsx = true;
    }

    private void CerrarModalActualizacionXlsx()
    {
        MostrarModalActualizacionXlsx = false;
        ResultadoActualizacionModal = null;
    }

    private async Task ExportBooksToXlsxAsync()
    {
        try
        {
            ExportandoXlsx = true;
            LimpiarMensaje();

            var librosExportar = LibrosOrdenados.ToList();

            if (!librosExportar.Any())
            {
                MostrarMensaje("There are no books to export.", "error");
                return;
            }

            using var workbook = new XLWorkbook();
            var worksheet = workbook.Worksheets.Add("Books");

            const int lastColumn = 19;

            worksheet.Cell(1, 1).Value = "Books Export";
            worksheet.Range(1, 1, 1, lastColumn).Merge();

            worksheet.Cell(2, 1).Value = $"Generated: {DateTime.Now:MM/dd/yyyy hh:mm tt}";
            worksheet.Range(2, 1, 2, lastColumn).Merge();

            worksheet.Cell(3, 1).Value =
                $"Search: {(string.IsNullOrWhiteSpace(Busqueda) ? "All" : Busqueda)} | " +
                $"Pub Date Month: {(string.IsNullOrWhiteSpace(SelectedPubMonth) ? "All" : SelectedPubMonth)} | " +
                $"Total: {librosExportar.Count}";

            worksheet.Range(3, 1, 3, lastColumn).Merge();

            var headerRow = 5;

            worksheet.Cell(headerRow, 1).Value = "Book Name";
            worksheet.Cell(headerRow, 2).Value = "KGEN";
            worksheet.Cell(headerRow, 3).Value = "LSA";
            worksheet.Cell(headerRow, 4).Value = "State";
            worksheet.Cell(headerRow, 5).Value = "Database";
            worksheet.Cell(headerRow, 6).Value = "Legacy Code";
            worksheet.Cell(headerRow, 7).Value = "Print Foot";
            worksheet.Cell(headerRow, 8).Value = "Trim Size";
            worksheet.Cell(headerRow, 9).Value = "Bind Plant";
            worksheet.Cell(headerRow, 10).Value = "Product Issue";
            worksheet.Cell(headerRow, 11).Value = "Proof";
            worksheet.Cell(headerRow, 12).Value = "Final";
            worksheet.Cell(headerRow, 13).Value = "Memo";
            worksheet.Cell(headerRow, 14).Value = "Final PO";
            worksheet.Cell(headerRow, 15).Value = "Shipping";
            worksheet.Cell(headerRow, 16).Value = "Dirxion";
            worksheet.Cell(headerRow, 17).Value = "Pub Date";
            worksheet.Cell(headerRow, 18).Value = "SRL";
            worksheet.Cell(headerRow, 19).Value = "NWP";

            var row = headerRow + 1;

            foreach (var libro in librosExportar)
            {
                worksheet.Cell(row, 1).Value = libro.BookName ?? string.Empty;
                worksheet.Cell(row, 2).Value = libro.KGENCode ?? string.Empty;
                worksheet.Cell(row, 3).Value = libro.LSACode ?? string.Empty;
                worksheet.Cell(row, 4).Value = GetStateName(libro.StateId);
                worksheet.Cell(row, 5).Value = GetDatabaseName(libro.DatabaseId);
                worksheet.Cell(row, 6).Value = GetLegacyCodeName(libro.LegacyCodeId);
                worksheet.Cell(row, 7).Value = GetPrintFootName(libro.PrintFootId);
                worksheet.Cell(row, 8).Value = GetTrimSizeName(libro.TrimSizeId);
                worksheet.Cell(row, 9).Value = GetBindPlantName(libro.BindPlantId);
                worksheet.Cell(row, 10).Value = libro.ProductIssue ?? string.Empty;

                SetExcelDate(worksheet.Cell(row, 11), libro.ProofExtract);
                SetExcelDate(worksheet.Cell(row, 12), libro.FinalExtract);
                SetExcelDate(worksheet.Cell(row, 13), libro.MemoExtract);
                SetExcelDate(worksheet.Cell(row, 14), libro.FinalPODate);
                SetExcelDate(worksheet.Cell(row, 15), libro.ShippingDate);
                SetExcelDate(worksheet.Cell(row, 16), libro.DirxionDate);
                SetExcelDate(worksheet.Cell(row, 17), libro.PubDate);

                worksheet.Cell(row, 18).Value = libro.SRLSuppression ? "Yes" : "No";
                worksheet.Cell(row, 19).Value = libro.NWP ? "Yes" : "No";

                row++;
            }

            var titleRange = worksheet.Range(1, 1, 1, lastColumn);
            titleRange.Style.Font.Bold = true;
            titleRange.Style.Font.FontSize = 16;
            titleRange.Style.Alignment.Horizontal = XLAlignmentHorizontalValues.Center;

            worksheet.Range(2, 1, 3, lastColumn).Style.Font.Italic = true;
            worksheet.Range(2, 1, 3, lastColumn).Style.Alignment.Horizontal = XLAlignmentHorizontalValues.Center;

            var headerRange = worksheet.Range(headerRow, 1, headerRow, lastColumn);
            headerRange.Style.Font.Bold = true;
            headerRange.Style.Fill.BackgroundColor = XLColor.FromHtml("#1F4E78");
            headerRange.Style.Font.FontColor = XLColor.White;
            headerRange.Style.Alignment.Horizontal = XLAlignmentHorizontalValues.Center;

            var dataRange = worksheet.Range(headerRow, 1, row - 1, lastColumn);
            dataRange.Style.Border.OutsideBorder = XLBorderStyleValues.Thin;
            dataRange.Style.Border.InsideBorder = XLBorderStyleValues.Thin;
            dataRange.Style.Alignment.Vertical = XLAlignmentVerticalValues.Center;

            worksheet.Range(headerRow + 1, 11, row - 1, 17).Style.DateFormat.Format = "MM/dd/yyyy";

            worksheet.Columns().AdjustToContents();

            using var stream = new MemoryStream();
            workbook.SaveAs(stream);

            var bytes = stream.ToArray();
            var base64 = Convert.ToBase64String(bytes);

            var fileName = $"Books_Export_{DateTime.Now:yyyyMMdd_HHmmss}.xlsx";

            await JS.InvokeVoidAsync(
                "downloadFileFromBase64",
                fileName,
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
                base64);

            MostrarMensaje($"Books exported successfully. Total: {librosExportar.Count}.", "success");
        }
        catch (Exception ex)
        {
            MostrarMensaje($"Error exporting books to XLSX: {ex.Message}", "error");
        }
        finally
        {
            ExportandoXlsx = false;
        }
    }

    private static void SetExcelDate(IXLCell cell, DateOnly date)
    {
        if (date == default)
        {
            cell.Value = string.Empty;
            return;
        }

        cell.Value = date.ToDateTime(TimeOnly.MinValue);
    }

    private async Task UpdateBooksFromXlsxAsync(InputFileChangeEventArgs e)
    {
        if (!EditBook)
        {
            MostrarMensaje("You do not have permission to update books.", "error");
            return;
        }

        var resultado = new ActualizacionLibrosResultado();

        try
        {
            ActualizandoLibrosXlsx = true;
            LimpiarMensaje();

            if (!BindPlants.Any() ||
                !Databases.Any() ||
                !LegacyCodes.Any() ||
                !PrintFeet.Any() ||
                !TrimSizes.Any() ||
                !States.Any())
            {
                await CargarCatalogosAsync();
            }

            var file = e.File;

            if (file is null)
            {
                MostrarMensaje("No file was selected.", "error");
                return;
            }

            if (!file.Name.EndsWith(".xlsx", StringComparison.OrdinalIgnoreCase))
            {
                MostrarMensaje("Only .xlsx files are allowed.", "error");
                return;
            }

            await using var stream = file.OpenReadStream(MaxXlsxSize);
            using var memoryStream = new MemoryStream();

            await stream.CopyToAsync(memoryStream);
            memoryStream.Position = 0;

            using var workbook = new XLWorkbook(memoryStream);
            var worksheet = workbook.Worksheets.FirstOrDefault();

            if (worksheet is null)
            {
                MostrarMensaje("The XLSX file does not contain any worksheet.", "error");
                return;
            }

            var headerRow = worksheet.FirstRowUsed();

            if (headerRow is null)
            {
                MostrarMensaje("The XLSX file is empty.", "error");
                return;
            }

            var headerMap = BuildHeaderMap(headerRow);

            if (!HeaderExists(headerMap, "KGen Product Code", "KGEN Product Code", "KGEN Code") &&
                !HeaderExists(headerMap, "LSA Code", "LSA"))
            {
                MostrarMensaje("The XLSX file must contain KGEN Code or LSA Code to find the book.", "error");
                return;
            }

            await using var db = await DbFactory.CreateDbContextAsync();

            // Importante: se cargan todos, incluso finalizados, para poder reactivar si las fechas nuevas aplican.
            var librosDb = await db.Libros.ToListAsync();

            var today = DateOnly.FromDateTime(DateTime.Today);

            foreach (var row in worksheet.RowsUsed().Where(r => r.RowNumber() > headerRow.RowNumber()))
            {
                var rowNumber = row.RowNumber();

                var bookName = ReadText(row, headerMap, "Product Name", "Book Name");
                var kgenCode = ReadText(row, headerMap, "KGen Product Code", "KGEN Product Code", "KGEN Code");
                var lsaCode = ReadText(row, headerMap, "LSA Code", "LSA");
                var productIssue = ReadText(row, headerMap, "Product Issue");

                if (string.IsNullOrWhiteSpace(bookName) &&
                    string.IsNullOrWhiteSpace(kgenCode) &&
                    string.IsNullOrWhiteSpace(lsaCode))
                {
                    resultado.FilasOmitidas++;
                    continue;
                }

                if (string.IsNullOrWhiteSpace(kgenCode) &&
                    string.IsNullOrWhiteSpace(lsaCode))
                {
                    resultado.FilasOmitidas++;
                    resultado.Errores.Add($"Row {rowNumber}: KGEN Code or LSA Code is required to update the book.");
                    continue;
                }

                var libro = BuscarLibroPorCodigos(librosDb, kgenCode, lsaCode);

                if (libro is null)
                {
                    resultado.LibrosNoEncontrados++;
                    resultado.Advertencias.Add(
                        $"Row {rowNumber}: Book was not found. KGEN: '{kgenCode}', LSA: '{lsaCode}', Product Name: '{bookName}'.");
                    continue;
                }

                var erroresAntesDeFechas = resultado.Errores.Count;

                var firstDuePrinterDate = ReadOptionalDateWithValidation(
                    row,
                    headerMap,
                    resultado.Errores,
                    rowNumber,
                    "First Due Printer",
                    "YP First Due Printer",
                    "WP Due Printer",
                    "East WP Final Due Printer");

                var proofExtract = ReadOptionalDateWithValidation(
                    row,
                    headerMap,
                    resultado.Errores,
                    rowNumber,
                    "Proof Extract",
                    "Extract - Proof",
                    "WP Proof Extract",
                    "YP Proof Extract");

                var finalExtract = ReadOptionalDateWithValidation(
                    row,
                    headerMap,
                    resultado.Errores,
                    rowNumber,
                    "Extract - Final",
                    "Final Extract",
                    "WP Extract - Final",
                    "YP Extract - Final");

                var memoExtract = ReadOptionalDateWithValidation(
                    row,
                    headerMap,
                    resultado.Errores,
                    rowNumber,
                    "Memo Extract",
                    "Extract - Memo");

                var finalPoDate = ReadOptionalDateWithValidation(
                    row,
                    headerMap,
                    resultado.Errores,
                    rowNumber,
                    "Final PO Date",
                    "Final PO",
                    "Finished PO Date");

                var shippingDate = ReadOptionalDateWithValidation(
                    row,
                    headerMap,
                    resultado.Errores,
                    rowNumber,
                    "Shipping Date",
                    "Shipping",
                    "First Due Printer");

                var dirxionDate = ReadOptionalDateWithValidation(
                    row,
                    headerMap,
                    resultado.Errores,
                    rowNumber,
                    "Dirxion",
                    "Dirxion Date",
                    "File Due Online/LSA/Galley Update Summary RPT",
                    "File Due Online",
                    "Galley Update Summary RPT");

                var pubDate = ReadOptionalDateWithValidation(
                    row,
                    headerMap,
                    resultado.Errores,
                    rowNumber,
                    "Pub Date",
                    "Publication Date");

                if (resultado.Errores.Count > erroresAntesDeFechas)
                {
                    resultado.FilasOmitidas++;
                    resultado.Errores.Add($"Row {rowNumber}: The row was skipped because it contains invalid date values.");
                    continue;
                }

                // Datos principales
                if (!string.IsNullOrWhiteSpace(bookName))
                    libro.BookName = bookName;

                if (!string.IsNullOrWhiteSpace(kgenCode))
                    libro.KGENCode = kgenCode;

                if (!string.IsNullOrWhiteSpace(lsaCode))
                    libro.LSACode = lsaCode;

                if (!string.IsNullOrWhiteSpace(productIssue))
                    libro.ProductIssue = productIssue;

                // Fechas: solo actualiza si la columna existe y trae valor válido.
                if (proofExtract.HasValue)
                    libro.ProofExtract = proofExtract.Value;

                if (finalExtract.HasValue)
                    libro.FinalExtract = finalExtract.Value;

                if (memoExtract.HasValue)
                    libro.MemoExtract = memoExtract.Value;

                if (firstDuePrinterDate.HasValue)
                {
                    libro.ShippingDate = firstDuePrinterDate.Value;
                    libro.FinalPODate = CalculateFinalPoDate(firstDuePrinterDate.Value);
                }
                else
                {
                    if (shippingDate.HasValue)
                        libro.ShippingDate = shippingDate.Value;

                    if (finalPoDate.HasValue)
                        libro.FinalPODate = finalPoDate.Value;
                }

                if (dirxionDate.HasValue)
                    libro.DirxionDate = dirxionDate.Value;

                if (pubDate.HasValue)
                    libro.PubDate = pubDate.Value;

                // Catálogos: solo actualiza si el XLSX trae valor.
                var footPrintText = ReadText(row, headerMap, "Foot Print");
                var legacyCoText = ReadText(row, headerMap, "Legacy Co");
                var stateText = ReadText(row, headerMap, "State");
                var graphicsDatabaseText = ReadText(row, headerMap, "Graphics Database", "Database");
                var trimSizeText = ReadText(row, headerMap, "Trim Size");
                var bindPlantText = ReadText(row, headerMap, "Bind Plant");

                if (!string.IsNullOrWhiteSpace(footPrintText))
                {
                    var id = FindPrintFootId(footPrintText);
                    AddCatalogWarningIfNeeded(resultado.Advertencias, rowNumber, "Foot Print", footPrintText, id);
                    libro.PrintFootId = id;
                }

                if (!string.IsNullOrWhiteSpace(legacyCoText))
                {
                    var id = FindLegacyCodeId(legacyCoText);
                    AddCatalogWarningIfNeeded(resultado.Advertencias, rowNumber, "Legacy Co", legacyCoText, id);
                    libro.LegacyCodeId = id;
                }

                if (!string.IsNullOrWhiteSpace(stateText))
                {
                    var id = FindStateId(stateText);
                    AddCatalogWarningIfNeeded(resultado.Advertencias, rowNumber, "State", stateText, id);
                    libro.StateId = id;
                }

                if (!string.IsNullOrWhiteSpace(graphicsDatabaseText))
                {
                    var id = FindDatabaseId(graphicsDatabaseText);
                    AddCatalogWarningIfNeeded(resultado.Advertencias, rowNumber, "Graphics Database", graphicsDatabaseText, id);
                    libro.DatabaseId = id;
                }

                if (!string.IsNullOrWhiteSpace(trimSizeText))
                {
                    var id = FindTrimSizeId(trimSizeText);
                    AddCatalogWarningIfNeeded(resultado.Advertencias, rowNumber, "Trim Size", trimSizeText, id);
                    libro.TrimSizeId = id;
                }

                if (!string.IsNullOrWhiteSpace(bindPlantText))
                {
                    var id = FindBindPlantId(bindPlantText);
                    AddCatalogWarningIfNeeded(resultado.Advertencias, rowNumber, "Bind Plant", bindPlantText, id);
                    libro.BindPlantId = id;
                }

                if (HeaderExists(headerMap, "SRL Suppression Flag"))
                    libro.SRLSuppression = ReadYesNoBool(row, headerMap, "SRL Suppression Flag");

                if (HeaderExists(headerMap, "NWP"))
                    libro.NWP = ReadYesNoBool(row, headerMap, "NWP");

                // Si la nueva fecha Dirxion ya pasó, queda finalizado. Si se actualiza a futuro, se reactiva.
                libro.Finalizado = libro.DirxionDate != default && libro.DirxionDate < today;

                resultado.LibrosActualizados++;
            }

            await db.SaveChangesAsync();

            XlsxUpdateInputKey = Guid.NewGuid();

            await CargarLibrosAsync();

            var tipo = resultado.TieneErrores ? "error" : "success";

            var mensaje =
                $"XLSX books update completed. " +
                $"Updated: {resultado.LibrosActualizados}. " +
                $"Not found: {resultado.LibrosNoEncontrados}. " +
                $"Skipped rows: {resultado.FilasOmitidas}.";

            if (resultado.Advertencias.Any())
            {
                var preview = string.Join(" | ", resultado.Advertencias.Take(6));
                mensaje += $" Warnings: {preview}";

                if (resultado.Advertencias.Count > 6)
                    mensaje += $" and {resultado.Advertencias.Count - 6} more.";
            }

            if (resultado.Errores.Any())
            {
                var preview = string.Join(" | ", resultado.Errores.Take(6));
                mensaje += $" Errors: {preview}";

                if (resultado.Errores.Count > 6)
                    mensaje += $" and {resultado.Errores.Count - 6} more.";
            }

            MostrarMensaje(mensaje, tipo);
            MostrarModalActualizacionLibros(resultado);
        }
        catch (Exception ex)
        {
            var mensajeError = ex.InnerException?.Message ?? ex.Message;
            var mensajeCompleto = $"Error updating books from XLSX: {mensajeError}";

            MostrarMensaje(mensajeCompleto, "error");
            MostrarModalErrorActualizacionLibros(mensajeCompleto);
        }
        finally
        {
            ActualizandoLibrosXlsx = false;
        }
    }

    private static Libros? BuscarLibroPorCodigos(List<Libros> libros, string kgenCode, string lsaCode)
    {
        var kgen = kgenCode?.Trim();
        var lsa = lsaCode?.Trim();

        return libros.FirstOrDefault(x =>
            (!string.IsNullOrWhiteSpace(kgen) &&
             string.Equals(x.KGENCode?.Trim(), kgen, StringComparison.OrdinalIgnoreCase)) ||
            (!string.IsNullOrWhiteSpace(lsa) &&
             string.Equals(x.LSACode?.Trim(), lsa, StringComparison.OrdinalIgnoreCase)));
    }

    private static DateOnly? ReadOptionalDateWithValidation(
    IXLRow row,
    Dictionary<string, int> headerMap,
    List<string> errors,
    int rowNumber,
    params string[] names)
    {
        var cell = GetCell(row, headerMap, names);
        var columnName = names.FirstOrDefault() ?? "Date";

        if (cell is null || cell.IsEmpty())
            return null;

        if (cell.TryGetValue<DateTime>(out var dateTime))
            return DateOnly.FromDateTime(dateTime);

        if (cell.TryGetValue<double>(out var numberValue))
        {
            try
            {
                var excelDate = DateTime.FromOADate(numberValue);
                return DateOnly.FromDateTime(excelDate);
            }
            catch
            {
                errors.Add($"Row {rowNumber}: The value in column '{columnName}' is not a valid Excel date.");
                return null;
            }
        }

        var text = cell.GetFormattedString()?.Trim();

        if (string.IsNullOrWhiteSpace(text))
            text = cell.GetString().Trim();

        if (string.IsNullOrWhiteSpace(text))
            return null;

        string[] formats =
        {
        "MM/dd/yyyy",
        "M/d/yyyy",
        "yyyy-MM-dd",
        "dd/MM/yyyy",
        "d/M/yyyy",
        "M/d/yy",
        "MM/dd/yy",
        "dd/MM/yy",
        "d/M/yy"
    };

        if (DateOnly.TryParseExact(text, formats, CultureInfo.InvariantCulture, DateTimeStyles.None, out var exactDate))
            return exactDate;

        if (DateOnly.TryParse(text, CultureInfo.InvariantCulture, DateTimeStyles.None, out var parsedDate))
            return parsedDate;

        if (DateOnly.TryParse(text, CultureInfo.CurrentCulture, DateTimeStyles.None, out var currentCultureDate))
            return currentCultureDate;

        errors.Add($"Row {rowNumber}: The value '{text}' in column '{columnName}' is not a valid date.");

        return null;
    }

    private void OnDobleClickLibro(Libros libro)
    {
        if (!EditBook)
            return;

        SeleccionarLibro(libro);
    }

    private IEnumerable<Libros> LibrosOrdenados => ApplySorting(LibrosFiltrados);

    private IEnumerable<PubMonthOption> PubDateMonths
    {
        get
        {
            return Libros
                .Where(l => l.PubDate != default)
                .GroupBy(l => GetPubMonthValue(l.PubDate))
                .Select(g =>
                {
                    var firstDate = g.First().PubDate;

                    return new PubMonthOption
                    {
                        Value = g.Key,
                        Label = GetPubMonthLabel(firstDate),
                        Count = g.Count()
                    };
                })
                .OrderByDescending(x => x.Value);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _user = authState.User;

        CreateBook = HasPermission(_user, "CreateBook");
        EditBook = HasPermission(_user, "EditBook");
        DeleteBook = HasPermission(_user, "DeleteBook");
        BooksView = HasPermission(_user, "BooksView");

        await CargarCatalogosAsync();
        await CargarLibrosAsync();
    }

    private static bool HasPermission(ClaimsPrincipal? user, string claimType)
    {
        if (user is null)
            return false;

        return string.Equals(
            user.FindFirst(claimType)?.Value,
            "True",
            StringComparison.OrdinalIgnoreCase);
    }

    private async Task CargarCatalogosAsync()
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            BindPlants = await db.Bind_Plants
                .AsNoTracking()
                .OrderBy(x => x.Bind_Plant_Name)
                .ToListAsync();

            Databases = await db.Databases
                .AsNoTracking()
                .OrderBy(x => x.Database_Name)
                .ToListAsync();

            LegacyCodes = await db.Legacy_Codes
                .AsNoTracking()
                .OrderBy(x => x.Legacy_Code_Name)
                .ToListAsync();

            PrintFeet = await db.Print_Foots
                .AsNoTracking()
                .OrderBy(x => x.Print_Foot_Name)
                .ToListAsync();

            States = await db.States
                .AsNoTracking()
                .OrderBy(x => x.State_Name)
                .ToListAsync();

            TrimSizes = await db.Trim_Sizes
                .AsNoTracking()
                .OrderBy(x => x.Trim_Size_Name)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            MostrarMensaje($"Error loading catalogs: {ex.Message}", "error");
        }
    }

    private async Task CargarLibrosAsync()
    {
        try
        {
            Cargando = true;

            await using var db = await DbFactory.CreateDbContextAsync();

            await ActualizarFinalizadosPorDirxionAsync(db);

            Libros = await db.Libros
                .AsNoTracking()
                .Where(l => !l.Finalizado)
                .OrderBy(l => l.BookName)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            MostrarMensaje($"Error loading books: {ex.Message}", "error");
        }
        finally
        {
            Cargando = false;
        }
    }

    private async Task ActualizarFinalizadosPorDirxionAsync(AppDbContext db)
    {
        var hoy = DateOnly.FromDateTime(DateTime.Today);

        var librosParaFinalizar = await db.Libros
            .Include(l => l.Asignaciones)
                .ThenInclude(a => a.Evaluaciones)
            .Where(l => !l.Finalizado &&
                        l.DirxionDate < hoy)
            .ToListAsync();

        if (!librosParaFinalizar.Any())
            return;

        foreach (var libro in librosParaFinalizar)
        {
            libro.Finalizado = true;

            foreach (var asignacion in libro.Asignaciones)
            {
                asignacion.Finalizado = true;

                foreach (var evaluacion in asignacion.Evaluaciones)
                {
                    evaluacion.Finalizado = true;
                }
            }
        }

        await db.SaveChangesAsync();
    }

    private async Task GuardarLibroAsync()
    {
        if (!PuedeCrearOEditarLibro)
        {
            MostrarMensaje("You do not have permission to save books.", "error");
            return;
        }
        try
        {
            Guardando = true;
            LimpiarMensaje();

            if (string.IsNullOrWhiteSpace(Formulario.BookName))
            {
                MostrarMensaje("Book name is required.", "error");
                return;
            }

            await using var db = await DbFactory.CreateDbContextAsync();

            if (Formulario.Id == Guid.Empty)
            {
                Formulario.Id = Guid.NewGuid();

                db.Libros.Add(ClonarLibro(Formulario));
                await db.SaveChangesAsync();

                MostrarMensaje("Book saved successfully.", "success");
            }
            else
            {
                var libroDb = await db.Libros.FirstOrDefaultAsync(l => l.Id == Formulario.Id);

                if (libroDb is null)
                {
                    MostrarMensaje("The selected book was not found.", "error");
                    return;
                }

                libroDb.PrintFootId = Formulario.PrintFootId;
                libroDb.LegacyCodeId = Formulario.LegacyCodeId;
                libroDb.StateId = Formulario.StateId;
                libroDb.DatabaseId = Formulario.DatabaseId;
                libroDb.TrimSizeId = Formulario.TrimSizeId;
                libroDb.BindPlantId = Formulario.BindPlantId;

                libroDb.LSACode = Formulario.LSACode;
                libroDb.KGENCode = Formulario.KGENCode;
                libroDb.BookName = Formulario.BookName;
                libroDb.ProductIssue = Formulario.ProductIssue;

                libroDb.ProofExtract = Formulario.ProofExtract;
                libroDb.FinalExtract = Formulario.FinalExtract;
                libroDb.MemoExtract = Formulario.MemoExtract;
                libroDb.FinalPODate = Formulario.FinalPODate;
                libroDb.ShippingDate = Formulario.ShippingDate;
                libroDb.DirxionDate = Formulario.DirxionDate;
                libroDb.PubDate = Formulario.PubDate;

                libroDb.SRLSuppression = Formulario.SRLSuppression;
                libroDb.NWP = Formulario.NWP;

                await db.SaveChangesAsync();

                MostrarMensaje("Book updated successfully.", "success");
            }

            await CargarLibrosAsync();
            LimpiarFormulario();
        }
        catch (Exception ex)
        {
            MostrarMensaje($"Error saving book: {ex.Message}", "error");
        }
        finally
        {
            Guardando = false;
        }
    }

    private void SeleccionarLibro(Libros libro)
    {
        if (!EditBook)
            return;

        LibroSeleccionadoId = libro.Id;
        Formulario = ClonarLibro(libro);

        MostrarMensaje("Book loaded for editing.", "info");
    }

    private async Task EliminarLibroAsync()
    {
        if (!DeleteBook)
        {
            MostrarMensaje("You do not have permission to delete books.", "error");
            return;
        }

        if (LibroSeleccionadoId is null || Formulario.Id == Guid.Empty)
        {
            MostrarMensaje("Select a book before deleting.", "error");
            return;
        }

        var confirmar = await JS.InvokeAsync<bool>(
            "confirm",
            $"Are you sure you want to delete '{Formulario.BookName}'?");

        if (!confirmar)
            return;

        try
        {
            Guardando = true;

            await using var db = await DbFactory.CreateDbContextAsync();

            var libroDb = await db.Libros.FirstOrDefaultAsync(l => l.Id == Formulario.Id);

            if (libroDb is null)
            {
                MostrarMensaje("The selected book was not found.", "error");
                return;
            }

            db.Libros.Remove(libroDb);
            await db.SaveChangesAsync();

            MostrarMensaje("Book deleted successfully.", "success");

            await CargarLibrosAsync();
            LimpiarFormulario();
        }
        catch (Exception ex)
        {
            MostrarMensaje($"Error deleting book: {ex.Message}", "error");
        }
        finally
        {
            Guardando = false;
        }
    }

    private void LimpiarFormulario()
    {
        if (!CreateBook && !EditBook)
            return;

        Formulario = CrearNuevoLibro();
        LibroSeleccionadoId = null;
