    private IEnumerable<Libros> ApplySorting(IEnumerable<Libros> source)
    {
        return SortColumn switch
        {
            "BookName" => SortDescending
                ? source.OrderByDescending(x => x.BookName ?? string.Empty)
                : source.OrderBy(x => x.BookName ?? string.Empty),

            "KGEN" => SortDescending
                ? source.OrderByDescending(x => x.KGENCode ?? string.Empty)
                : source.OrderBy(x => x.KGENCode ?? string.Empty),

            "LSA" => SortDescending
                ? source.OrderByDescending(x => x.LSACode ?? string.Empty)
                : source.OrderBy(x => x.LSACode ?? string.Empty),

            "State" => SortDescending
                ? source.OrderByDescending(x => GetStateName(x.StateId))
                : source.OrderBy(x => GetStateName(x.StateId)),

            "Database" => SortDescending
                ? source.OrderByDescending(x => GetDatabaseName(x.DatabaseId))
                : source.OrderBy(x => GetDatabaseName(x.DatabaseId)),

            "Legacy" => SortDescending
                ? source.OrderByDescending(x => GetLegacyCodeName(x.LegacyCodeId))
                : source.OrderBy(x => GetLegacyCodeName(x.LegacyCodeId)),

            "Proof" => SortDescending
                ? source.OrderByDescending(x => x.ProofExtract)
                : source.OrderBy(x => x.ProofExtract),

            "Final" => SortDescending
                ? source.OrderByDescending(x => x.FinalExtract)
                : source.OrderBy(x => x.FinalExtract),

            "Memo" => SortDescending
                ? source.OrderByDescending(x => x.MemoExtract)
                : source.OrderBy(x => x.MemoExtract),

            "FinalPO" => SortDescending
                ? source.OrderByDescending(x => x.FinalPODate)
                : source.OrderBy(x => x.FinalPODate),

            "Shipping" => SortDescending
                ? source.OrderByDescending(x => x.ShippingDate)
                : source.OrderBy(x => x.ShippingDate),

            "Dirxion" => SortDescending
                ? source.OrderByDescending(x => x.DirxionDate)
                : source.OrderBy(x => x.DirxionDate),

            "PubDate" => SortDescending
                ? source.OrderByDescending(x => x.PubDate)
                : source.OrderBy(x => x.PubDate),

            _ => source.OrderBy(x => x.BookName ?? string.Empty)
        };
    }

    private void SortBy(string column)
    {
        if (SortColumn == column)
        {
            SortDescending = !SortDescending;
            return;
        }

        SortColumn = column;

        SortDescending = IsDateColumn(column);
    }

    private static bool IsDateColumn(string column)
    {
        return column is "Proof"
            or "Final"
            or "Memo"
            or "FinalPO"
            or "Shipping"
            or "Dirxion"
            or "PubDate";
    }

    private string GetSortIcon(string column)
    {
        if (SortColumn != column)
            return "↕";

        return SortDescending ? "↓" : "↑";
    }

