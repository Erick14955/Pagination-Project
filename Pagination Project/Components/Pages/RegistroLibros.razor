            headerRange.Style.Alignment.Vertical = XLAlignmentVerticalValues.Center;
            headerRange.Style.Alignment.WrapText = true;
            headerRange.Style.Border.OutsideBorder = XLBorderStyleValues.Thin;
            headerRange.Style.Border.InsideBorder = XLBorderStyleValues.Thin;

            foreach (var requiredColumn in new[] { 1, 2, 3 })
            {
                worksheet.Cell(headerRow, requiredColumn)
                    .Style.Fill.BackgroundColor = XLColor.FromHtml("#EA580C");
            }

            worksheet.Row(headerRow).Height = 32;
            worksheet.SheetView.FreezeRows(1);
            headerRange.SetAutoFilter();

            worksheet.Range(
                    firstDataRow,
                    12,
                    lastTemplateRow,
                    17)
                .Style.DateFormat.Format = "MM/dd/yyyy";

            worksheet.Range(
                    firstDataRow,
                    1,
                    lastTemplateRow,
                    lastColumn)
                .Style.Alignment.Vertical = XLAlignmentVerticalValues.Center;

            var widths = new double[]
            {
                18, 
                34, 
                22,
                18, 
                20, 
                20, 
                18, 
                18, 
                22, 
                18, 
                18, 
                19, 
                18, 
                18, 
                18, 
                18, 
                18, 
                22, 
                12  
            };

            for (var column = 1; column <= widths.Length; column++)
            {
                worksheet.Column(column).Width = widths[column - 1];
            }

            var instructionsSheet = workbook.Worksheets.Add("Instructions");

            instructionsSheet.Cell(1, 1).Value = "Books Upload Template";
            instructionsSheet.Range(1, 1, 1, 4).Merge();

            instructionsSheet.Cell(2, 1).Value =
                "Complete the 'Books Upload' worksheet. Keep the column names exactly as provided and upload the file as .xlsx.";

            instructionsSheet.Range(2, 1, 2, 4).Merge();

            instructionsSheet.Cell(3, 1).Value =
                "Important: empty date cells are imported using the current date. Leave a date blank only when today's date is intended.";

            instructionsSheet.Range(3, 1, 3, 4).Merge();

            instructionsSheet.Cell(5, 1).Value = "Column";
            instructionsSheet.Cell(5, 2).Value = "Required";
            instructionsSheet.Cell(5, 3).Value = "Accepted value / format";
            instructionsSheet.Cell(5, 4).Value = "Notes";

            var columnInstructions = new[]
            {
                new
