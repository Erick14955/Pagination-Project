    private async Task ImportBooksFromXlsxAsync(InputFileChangeEventArgs e)
    {
        if (!CreateBook)
        {
            MostrarMensaje("You do not have permission to import books.", "error");
            return;
        }

        try
        {
            ImportandoXlsx = true;
            LimpiarMensaje();

            if (!BindPlants.Any() ||
                !Databases.Any() ||
                !LegacyCodes.Any() ||
                !PrintFeet.Any() ||
                !TrimSizes.Any())
            {
                await CargarCatalogosAsync();
            }

            var file = e.File;

            if (file is null)
            {
                MostrarMensaje("No file was selected.", "error");
                return;
            }

            if (!file.Name.EndsWith(".xlsx", StringComparison.OrdinalIgnoreCase))
            {
                MostrarMensaje("Only .xlsx files are allowed.", "error");
                return;
            }

            await using var stream = file.OpenReadStream(MaxXlsxSize);
            using var memoryStream = new MemoryStream();

            await stream.CopyToAsync(memoryStream);
            memoryStream.Position = 0;

            using var workbook = new XLWorkbook(memoryStream);
            var worksheet = workbook.Worksheets.FirstOrDefault();

            if (worksheet is null)
            {
                MostrarMensaje("The XLSX file does not contain any worksheet.", "error");
                return;
            }

            var headerRow = worksheet.FirstRowUsed();

            if (headerRow is null)
            {
                MostrarMensaje("The XLSX file is empty.", "error");
                return;
            }

            var headerMap = BuildHeaderMap(headerRow);

            if (!HeaderExists(headerMap, "Product Name"))
            {
                MostrarMensaje("The XLSX file must contain the 'Product Name' column.", "error");
                return;
            }

            if (!HeaderExists(headerMap, "KGen Product Code", "KGEN Product Code"))
            {
                MostrarMensaje("The XLSX file must contain the 'KGen Product Code' column.", "error");
                return;
            }

            var importedBooks = new List<Libros>();
            var today = DateOnly.FromDateTime(DateTime.Today);
            var skippedRows = 0;
            var catalogWarnings = new List<string>();

            foreach (var row in worksheet.RowsUsed().Where(r => r.RowNumber() > headerRow.RowNumber()))
            {
                var bookName = ReadText(row, headerMap, "Product Name");
                var kgenCode = ReadText(row, headerMap, "KGen Product Code", "KGEN Product Code");

                if (string.IsNullOrWhiteSpace(bookName) && string.IsNullOrWhiteSpace(kgenCode))
                {
                    skippedRows++;
                    continue;
                }

                if (string.IsNullOrWhiteSpace(bookName))
                {
                    skippedRows++;
                    catalogWarnings.Add($"Row {row.RowNumber()}: Product Name is empty");
                    continue;
                }

                if (string.IsNullOrWhiteSpace(kgenCode))
                {
                    skippedRows++;
                    catalogWarnings.Add($"Row {row.RowNumber()}: KGen Product Code is empty");
                    continue;
                }

                var footPrintText = ReadText(row, headerMap, "Foot Print");
                var legacyCoText = ReadText(row, headerMap, "Legacy Co");
                var stateText = ReadText(row, headerMap, "State");
                var graphicsDatabaseText = ReadText(row, headerMap, "Graphics Database");
                var trimSizeText = ReadText(row, headerMap, "Trim Size");
                var bindPlantText = ReadText(row, headerMap, "Bind Plant");

                var printFootId = FindPrintFootId(footPrintText);
                var legacyCodeId = FindLegacyCodeId(legacyCoText);
                var stateId = FindStateId(stateText);
                var databaseId = FindDatabaseId(graphicsDatabaseText);
                var trimSizeId = FindTrimSizeId(trimSizeText);
                var bindPlantId = FindBindPlantId(bindPlantText);

                AddCatalogWarningIfNeeded(catalogWarnings, row.RowNumber(), "Foot Print", footPrintText, printFootId);
                AddCatalogWarningIfNeeded(catalogWarnings, row.RowNumber(), "Legacy Co", legacyCoText, legacyCodeId);
                AddCatalogWarningIfNeeded(catalogWarnings, row.RowNumber(), "State", stateText, stateId);
                AddCatalogWarningIfNeeded(catalogWarnings, row.RowNumber(), "Graphics Database", graphicsDatabaseText, databaseId);
                AddCatalogWarningIfNeeded(catalogWarnings, row.RowNumber(), "Trim Size", trimSizeText, trimSizeId);
                AddCatalogWarningIfNeeded(catalogWarnings, row.RowNumber(), "Bind Plant", bindPlantText, bindPlantId);

                var firstDuePrinterDate = ReadDate(row, headerMap, today, "First Due Printer");
                var finalPoDate = CalculateFinalPoDate(firstDuePrinterDate);
                var dirxionDate = ReadDate(row, headerMap, today, "Dirxion");

                var libro = new Libros
                {
                    Id = Guid.NewGuid(),

                    BookName = bookName,
                    KGENCode = kgenCode,
                    LSACode = ReadText(row, headerMap, "LSA Code", "LSA"),
                    ProductIssue = ReadText(row, headerMap, "Product Issue"),

                    PrintFootId = printFootId,
                    LegacyCodeId = legacyCodeId,
                    StateId = stateId,
                    DatabaseId = databaseId,
                    TrimSizeId = trimSizeId,
                    BindPlantId = bindPlantId,

                    ProofExtract = ReadDate(row, headerMap, today, "Proof Extract", "Extract - Proof"),
                    FinalExtract = ReadDate(row, headerMap, today, "Extract - Final"),
                    MemoExtract = ReadDate(row, headerMap, today, "Memo Extract", "Extract - Memo"),
                    FinalPODate = finalPoDate,
                    ShippingDate = firstDuePrinterDate,
                    DirxionDate = dirxionDate,
                    PubDate = ReadDate(row, headerMap, today, "Pub Date", "Publication Date"),

                    SRLSuppression = ReadYesNoBool(row, headerMap, "SRL Suppression Flag"),
                    NWP = ReadYesNoBool(row, headerMap, "NWP"),

                    Finalizado = dirxionDate < today
                };

                importedBooks.Add(libro);
            }

            if (!importedBooks.Any())
            {
                MostrarMensaje("No valid books were found in the XLSX file.", "error");
                return;
            }

            await using var db = await DbFactory.CreateDbContextAsync();

            var kgenCodes = importedBooks
                .Where(x => !string.IsNullOrWhiteSpace(x.KGENCode))
                .Select(x => x.KGENCode.Trim())
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList();

            var existingBooks = await db.Libros
                .Where(x => kgenCodes.Contains(x.KGENCode))
                .ToListAsync();

            var existingDictionary = existingBooks
                .Where(x => !string.IsNullOrWhiteSpace(x.KGENCode))
                .GroupBy(x => x.KGENCode.Trim(), StringComparer.OrdinalIgnoreCase)
                .ToDictionary(g => g.Key, g => g.First(), StringComparer.OrdinalIgnoreCase);

            var inserted = 0;
            var updated = 0;

            foreach (var imported in importedBooks)
            {
                if (!string.IsNullOrWhiteSpace(imported.KGENCode) &&
                    existingDictionary.TryGetValue(imported.KGENCode.Trim(), out var existing))
                {
                    CopyBookValues(existing, imported);
                    updated++;
                }
                else
                {
                    db.Libros.Add(imported);
                    inserted++;
                }
            }

            await db.SaveChangesAsync();

            await CargarLibrosAsync();

            XlsxInputKey++;

            var finalMessage = $"XLSX import completed. Inserted: {inserted}. Updated: {updated}. Skipped rows: {skippedRows}.";

            if (catalogWarnings.Any())
            {
                var warningPreview = string.Join(" | ", catalogWarnings.Take(6));
                finalMessage += $" Catalog warnings: {warningPreview}";

                if (catalogWarnings.Count > 6)
                {
                    finalMessage += $" and {catalogWarnings.Count - 6} more.";
                }
            }

            MostrarMensaje(finalMessage, "success");
        }
        catch (Exception ex)
        {
            MostrarMensaje($"Error importing XLSX file: {ex.Message}", "error");
        }
        finally
        {
            ImportandoXlsx = false;
        }
    }

    private static void CopyBookValues(Libros destination, Libros source)
    {
        destination.PrintFootId = source.PrintFootId;
        destination.LegacyCodeId = source.LegacyCodeId;
        destination.StateId = source.StateId;
        destination.DatabaseId = source.DatabaseId;
        destination.TrimSizeId = source.TrimSizeId;
        destination.BindPlantId = source.BindPlantId;

        destination.LSACode = source.LSACode;
        destination.KGENCode = source.KGENCode;
        destination.BookName = source.BookName;
        destination.ProductIssue = source.ProductIssue;

        destination.ProofExtract = source.ProofExtract;
        destination.FinalExtract = source.FinalExtract;
        destination.MemoExtract = source.MemoExtract;
        destination.FinalPODate = source.FinalPODate;
        destination.ShippingDate = source.ShippingDate;
        destination.DirxionDate = source.DirxionDate;
        destination.PubDate = source.PubDate;

        destination.SRLSuppression = source.SRLSuppression;
        destination.NWP = source.NWP;

        var hoy = DateOnly.FromDateTime(DateTime.Today);
        destination.Finalizado = source.DirxionDate < hoy;
    }

    private static DateOnly CalculateFinalPoDate(DateOnly firstDuePrinter)
    {
        var candidate = firstDuePrinter.AddDays(-1);

        while (candidate.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday)
        {
            candidate = candidate.AddDays(-1);
        }

        return candidate;
    }

    private static Dictionary<string, int> BuildHeaderMap(IXLRow headerRow)
    {
        var map = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);

        foreach (var cell in headerRow.CellsUsed())
        {
            var header = NormalizeHeader(cell.GetString());

            if (!string.IsNullOrWhiteSpace(header) && !map.ContainsKey(header))
            {
                map.Add(header, cell.Address.ColumnNumber);
            }
        }

        return map;
    }

    private static bool HeaderExists(Dictionary<string, int> headerMap, params string[] names)
    {
        return names.Any(name => headerMap.ContainsKey(NormalizeHeader(name)));
    }

    private static string NormalizeHeader(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return string.Empty;

        return new string(value
            .Where(char.IsLetterOrDigit)
            .Select(char.ToLowerInvariant)
            .ToArray());
    }

    private static IXLCell? GetCell(IXLRow row, Dictionary<string, int> headerMap, params string[] names)
    {
        foreach (var name in names)
        {
            var key = NormalizeHeader(name);

            if (headerMap.TryGetValue(key, out var columnNumber))
                return row.Cell(columnNumber);
        }

        return null;
    }

    private static string ReadText(IXLRow row, Dictionary<string, int> headerMap, params string[] names)
    {
        var cell = GetCell(row, headerMap, names);

        if (cell is null || cell.IsEmpty())
            return string.Empty;

        var formatted = cell.GetFormattedString()?.Trim();

        if (!string.IsNullOrWhiteSpace(formatted))
            return formatted;

        if (cell.TryGetValue<double>(out var numberValue))
        {
            if (Math.Abs(numberValue % 1) < 0.0000001)
                return Convert.ToInt64(numberValue).ToString(CultureInfo.InvariantCulture);

            return numberValue.ToString(CultureInfo.InvariantCulture);
        }

        return cell.GetString().Trim();
    }

    private static DateOnly ReadDate(IXLRow row, Dictionary<string, int> headerMap, DateOnly defaultValue, params string[] names)
    {
        var cell = GetCell(row, headerMap, names);

        if (cell is null || cell.IsEmpty())
            return defaultValue;

        if (cell.TryGetValue<DateTime>(out var dateTime))
            return DateOnly.FromDateTime(dateTime);

        if (cell.TryGetValue<double>(out var numberValue))
        {
            try
            {
                var excelDate = DateTime.FromOADate(numberValue);
                return DateOnly.FromDateTime(excelDate);
            }
            catch
            {
                return defaultValue;
            }
        }

        var text = cell.GetFormattedString()?.Trim();

        if (string.IsNullOrWhiteSpace(text))
            text = cell.GetString().Trim();

        string[] formats =
        {
            "MM/dd/yyyy",
            "M/d/yyyy",
            "yyyy-MM-dd",
            "dd/MM/yyyy",
            "d/M/yyyy",
            "M/d/yy",
            "MM/dd/yy",
            "dd/MM/yy",
            "d/M/yy"
        };

        if (DateOnly.TryParseExact(text, formats, CultureInfo.InvariantCulture, DateTimeStyles.None, out var exactDate))
            return exactDate;

        if (DateOnly.TryParse(text, CultureInfo.InvariantCulture, DateTimeStyles.None, out var parsedDate))
            return parsedDate;

        if (DateOnly.TryParse(text, CultureInfo.CurrentCulture, DateTimeStyles.None, out var currentCultureDate))
            return currentCultureDate;

        return defaultValue;
    }

    private static bool ReadYesNoBool(IXLRow row, Dictionary<string, int> headerMap, params string[] names)
    {
        var cell = GetCell(row, headerMap, names);

        if (cell is null || cell.IsEmpty())
            return false;

        if (cell.TryGetValue<bool>(out var boolValue))
            return boolValue;

        var text = cell.GetFormattedString()?.Trim().ToUpperInvariant();

        if (string.IsNullOrWhiteSpace(text))
            text = cell.GetString().Trim().ToUpperInvariant();

        return text is "Y" or "YES" or "TRUE" or "1" or "X";
    }

    private void AddCatalogWarningIfNeeded(List<string> warnings, int rowNumber, string catalogName, string value, Guid? id)
    {
        if (string.IsNullOrWhiteSpace(value))
            return;

        if (id is null)
        {
            warnings.Add($"Row {rowNumber}: {catalogName} '{value}' was not found");
        }
    }

