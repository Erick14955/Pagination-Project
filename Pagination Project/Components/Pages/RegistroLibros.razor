                                            @FormatoFecha(libro.FinalExtract)
                                        </span>
                                    </td>

                                    <td>
                                        <span class='@GetDateTextClass(libro.Id, "MemoExtract", libro.MemoExtract)'
                                              title='@GetDateTextTitle(libro.Id, "MemoExtract", libro.MemoExtract)'>
                                            @FormatoFecha(libro.MemoExtract)
                                        </span>
                                    </td>

                                    <td>
                                        <span class='@GetDateTextClass(libro.Id, "FinalPO", libro.FinalPODate)'
                                              title='@GetDateTextTitle(libro.Id, "FinalPO", libro.FinalPODate)'>
                                            @FormatoFecha(libro.FinalPODate)
                                        </span>
                                    </td>

                                    <td>
                                        <span class='@GetDateTextClass(libro.Id, "Shipping", libro.ShippingDate)'
                                              title='@GetDateTextTitle(libro.Id, "Shipping", libro.ShippingDate)'>
                                            @FormatoFecha(libro.ShippingDate)
                                        </span>
                                    </td>

                                    <td>
                                        <span class='@GetDateTextClass(libro.Id, "Dirxion", libro.DirxionDate)'
                                              title='@GetDateTextTitle(libro.Id, "Dirxion", libro.DirxionDate)'>
                                            @FormatoFecha(libro.DirxionDate)
                                        </span>
                                    </td>

                                    <td>
                                        <span class="book-date-text book-date-without-work-status"
                                              title="Pub Date does not have a worked flag in Assignments_Worked.">
                                            @FormatoFecha(libro.PubDate)
                                        </span>
                                    </td>
                                    <td>@(libro.SRLSuppression ? "Yes" : "No")</td>
                                    <td>@(libro.NWP ? "Yes" : "No")</td>

                                    @if (EditBook)
                                    {
                                        <td class="actions-cell">
                                            <button type="button"
                                                    class="icon-btn"
                                                    title="Edit"
                                                    @onclick="() => SeleccionarLibro(libro)">
                                                ✏️
                                            </button>
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    </div>
}

