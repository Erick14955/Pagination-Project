                    Column = "employee_type",
                    Required = "Yes",
                    Format = "DR or ECLERX",
                    Notes = "Determines the department that owns the book."
                },
                new
                {
                    Column = "Product Name",
                    Required = "Yes",
                    Format = "Text",
                    Notes = "Book name."
                },
                new
                {
                    Column = "KGen Product Code",
