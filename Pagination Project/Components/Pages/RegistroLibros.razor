                    Required = "No",
                    Format = "Use a value from 'Allowed Values'",
                    Notes = "Must match an existing Legacy Code name."
                },
                new
                {
                    Column = "State",
                    Required = "No",
                    Format = "Use a value from 'Allowed Values'",
                    Notes = "Must match an existing state."
                },
                new
                {
                    Column = "Graphics Database",
                    Required = "No",
                    Format = "Use a value from 'Allowed Values'",
                    Notes = "Must match an existing database."
                },
                new
                {
                    Column = "Trim Size",
                    Required = "No",
                    Format = "Use a value from 'Allowed Values'",
                    Notes = "Must match an existing trim size."
                },
                new
                {
                    Column = "Bind Plant",
                    Required = "No",
                    Format = "Use a value from 'Allowed Values'",
                    Notes = "Must match an existing bind plant."
                },
                new
                {
                    Column = "First Due Printer",
                    Required = "No",
                    Format = "MM/dd/yyyy",
                    Notes = "Used as Shipping Date. Final PO is calculated as the previous business day."
                },
                new
                {
                    Column = "Proof Extract",
                    Required = "No",
