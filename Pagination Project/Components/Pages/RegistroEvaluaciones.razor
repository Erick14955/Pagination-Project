@page "/evaluaciones"
@page "/evaluations"
@page "/registro-evaluaciones"

@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@using Pagination_Project.Data
@using Pagination_Project.Models
@using Pagination_Project.Services
@using Microsoft.AspNetCore.Components.Authorization

@attribute [Authorize]
@layout Pagination_Project.Components.Layout.DashboardLayout

@inject IDbContextFactory<AppDbContext> DbFactory
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IUserDataScopeService UserDataScopeService

<PageTitle>Evaluations</PageTitle>

<div class="evaluations-page">

    <section class="page-hero">
        <div>
            <h1>Evaluations Management</h1>
            <p>
                Register, review and manage assignment evaluations. Percentages are calculated automatically from the selected errors.
            </p>
        </div>

        <div class="hero-stats">
            <div class="stat-card">
                <span>Total Evaluations</span>
                <strong>@Historial.Count</strong>
            </div>

            <div class="stat-card">
                <span>Available Assignments</span>
                <strong>@TotalAsignacionesDisponibles</strong>
            </div>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(Mensaje))
    {
        <div class="alert-box @TipoMensaje">
            @Mensaje
        </div>
    }

    @if (MostrarModalResultadoEvaluacion)
    {
        <div class="evaluation-result-modal-overlay"
             role="presentation"
             @onclick="CerrarModalResultadoEvaluacion">

            <div class="evaluation-result-modal-card @TipoModalResultadoEvaluacion"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="evaluationResultModalTitle"
                 @onclick:stopPropagation="true">

                <div class="evaluation-result-modal-accent"></div>

                <div class="evaluation-result-modal-content">

                    <div class="evaluation-result-modal-icon" aria-hidden="true">
                        @if (TipoModalResultadoEvaluacion == "success")
                        {
                            <svg viewBox="0 0 24 24">
                                <path d="M20 6 9 17l-5-5"></path>
                            </svg>
                        }
                        else
                        {
                            <svg viewBox="0 0 24 24">
                                <circle cx="12" cy="12" r="9"></circle>
                                <path d="M12 7v6"></path>
                                <path d="M12 17h.01"></path>
                            </svg>
                        }
                    </div>

                    <div class="evaluation-result-modal-copy">
                        <span class="evaluation-result-modal-eyebrow">
                            Evaluation Management
                        </span>

                        <h3 id="evaluationResultModalTitle">
                            @TituloModalResultadoEvaluacion
                        </h3>

                        <p>@MensajeModalResultadoEvaluacion</p>
                    </div>

                </div>

                <div class="evaluation-result-modal-actions">
                    <button type="button"
                            class="evaluation-result-modal-ok"
                            @onclick="CerrarModalResultadoEvaluacion">
                        OK
                    </button>
                </div>

            </div>
        </div>
    }

    <section class="form-card">

        <div class="section-header">
            <div>
                <h2>Select Assignment</h2>
                <p>Select the employee and book assignment that will be evaluated.</p>
            </div>

            <div class="header-actions">
                <button type="button"
                        class="btn-light"
                        @onclick="LimpiarFormulario">
                    ✨ New
                </button>
            </div>
        </div>

        <div class="form-grid">
            <div class="form-group full">

                <label>Search Assignment</label>

                <div class="search-assignment-box">

                    <input class="form-control"
                           placeholder="Search by KGEN Code or LSA Code..."
                           @bind="TextoBusquedaAsignacion"
                           @bind:event="oninput"
                           @onkeydown="BuscarAsignacionConEnter" />

                    <button type="button"
                            class="btn-primary"
                            @onclick="BuscarAsignacionAsync">
                        Search
                    </button>

                </div>
            </div>
        </div>

        @if (AsignacionSeleccionada is not null)
        {
            <div class="assignment-cards-grid">

                <div class="assignment-card-fixed">
                    <span>Employee</span>
                    <strong>@AsignacionSeleccionada.EmpleadoNombre</strong>
                    <small>Assigned employee</small>
                </div>

                @if (Scope.ViewAllEmployeeTypes)
                {
                    <div class="assignment-card-fixed">
                        <span>Department</span>
                        <strong>@AsignacionSeleccionada.EmployeeTypeCode</strong>
                        <small>Employee type</small>
                    </div>
                }

                <div class="assignment-card-fixed">
                    <span>Book Information</span>
                    <strong>@AsignacionSeleccionada.KGENCode</strong>
                    <small>@AsignacionSeleccionada.BookName</small>
                    <small>LSA: @AsignacionSeleccionada.LSACode</small>
                </div>

            </div>
        }

    </section>

    <section class="summary-grid">

        <div class="summary-card">
            <span>Motif YP</span>
            <strong>@PorcentajeMotifYpVista.ToString("0.00")%</strong>
            <small>@TotalMotifYpVista errors marked</small>
        </div>

        <div class="summary-card">
            <span>Motif WP</span>
            <strong>@PorcentajeMotifWpVista.ToString("0.00")%</strong>
            <small>@TotalMotifWpVista errors marked</small>
        </div>

        <div class="summary-card">
            <span>Inventory Report</span>
            <strong>@PorcentajeInventoryVista.ToString("0.00")%</strong>
            <small>@TotalInventoryVista errors marked</small>
        </div>

        <div class="summary-card">
            <span>Shipping Folder</span>
            <strong>@PorcentajeShippingVista.ToString("0.00")%</strong>
            <small>@TotalShippingVista errors marked</small>
        </div>

        <div class="summary-card">
            <span>Task Memo</span>
            <strong>@PorcentajeTaskVista.ToString("0.00")%</strong>
            <small>@TotalTaskVista errors marked</small>
        </div>

        <div class="summary-card total-summary-card">
            <span>Total Average</span>
            <strong>@PorcentajeGeneralVista.ToString("0.00")%</strong>
            <small>Average of all 5 evaluation areas</small>
        </div>

    </section>

    <section class="evaluation-grid">

        <div class="evaluation-block">

            <div class="block-header">
                <div>
                    <h2>📌 Motif YP</h2>
                    <p>Quality issues related to Motif YP.</p>
                </div>

                <div class="total-box">
                    <span>Total</span>
                    <strong>@TotalMotifYpVista</strong>
                </div>
            </div>

            <div class="toggles-container">

                <div class="toggle-item">
                    <label class="switch">
                        <input type="checkbox" @bind="Evaluacion.TouchingRule" />
                        <span class="slider"></span>
                    </label>
                    <span>Touching Rule</span>
                </div>

                <div class="toggle-item">
                    <label class="switch">
                        <input type="checkbox" @bind="Evaluacion.PagesSwapped" />
                        <span class="slider"></span>
                    </label>
                    <span>Pages With Swapped</span>
                </div>

                <div class="toggle-item">
                    <label class="switch">
                        <input type="checkbox" @bind="Evaluacion.PplpWrongPlace" />
                        <span class="slider"></span>
                    </label>
                    <span>PPLP with wrong place</span>
                </div>

                <div class="toggle-item">
                    <label class="switch">
                        <input type="checkbox" @bind="Evaluacion.CouponsHeading" />
                        <span class="slider"></span>
                    </label>
                    <span>Coupons with heading</span>
                </div>

                <div class="toggle-item">
                    <label class="switch">
                        <input type="checkbox" @bind="Evaluacion.DoubleTruckWrongPlace" />
                        <span class="slider"></span>
                    </label>
                    <span>Double truck with wrong placement</span>
                </div>

                <div class="toggle-item">
                    <label class="switch">
                        <input type="checkbox" @bind="Evaluacion.FillersOutside" />
                        <span class="slider"></span>
                    </label>
                    <span>Fillers outside</span>
                </div>

                <div class="toggle-item">
                    <label class="switch">
                        <input type="checkbox" @bind="Evaluacion.MissingYspFiller" />
                        <span class="slider"></span>
                    </label>
                    <span>Missing YSP filler</span>
                </div>

                <div class="toggle-item">
                    <label class="switch">
                        <input type="checkbox" @bind="Evaluacion.GradeUnder75" />
                        <span class="slider"></span>
                    </label>
                    <span>Grade of the pages under 75%</span>
                </div>

            </div>

        </div>

        <div class="evaluation-block">

            <div class="block-header">
                <div>
                    <h2>⚙️ Motif WP</h2>
                    <p>Quality issues related to Motif WP.</p>
                </div>

                <div class="total-box">
                    <span>Total</span>
                    <strong>@TotalMotifWpVista</strong>
                </div>
            </div>

            <div class="toggles-container">

                <div class="toggle-item">
                    <label class="switch">
                        <input type="checkbox" @bind="Evaluacion.WdqcsNoAnchors" />
                        <span class="slider"></span>
                    </label>
                    <span>WDQCS no touching with anchor</span>
                </div>

                <div class="toggle-item">
                    <label class="switch">
                        <input type="checkbox" @bind="Evaluacion.WhpsNoAnchors" />
                        <span class="slider"></span>
                    </label>
                    <span>WHPS no touching with anchor</span>
                </div>

                <div class="toggle-item">
                    <label class="switch">
                        <input type="checkbox" @bind="Evaluacion.WfpsNoAnchors" />
                        <span class="slider"></span>
                    </label>
                    <span>WPFS no touching with anchor</span>
                </div>

            </div>

        </div>

        <div class="evaluation-block">

            <div class="block-header">
                <div>
                    <h2>📦 Inventory Report</h2>
                    <p>Inventory report missing elements.</p>
                </div>

                <div class="total-box">
                    <span>Total</span>
                    <strong>@TotalInventoryVista</strong>
                </div>
            </div>

            <div class="toggles-container">

                <div class="toggle-item">
                    <label class="switch">
                        <input type="checkbox" @bind="Evaluacion.MissingCornerAd" />
                        <span class="slider"></span>
                    </label>
                    <span>Missing Corner Ad</span>
                </div>

                <div class="toggle-item">
                    <label class="switch">
                        <input type="checkbox" @bind="Evaluacion.MissingBanner" />
                        <span class="slider"></span>
                    </label>
                    <span>Missing Banner</span>
                </div>

                <div class="toggle-item">
                    <label class="switch">
                        <input type="checkbox" @bind="Evaluacion.MissingRandomTab" />
                        <span class="slider"></span>
                    </label>
                    <span>Missing Random Tab</span>
                </div>

                <div class="toggle-item">
                    <label class="switch">
                        <input type="checkbox" @bind="Evaluacion.MissingForcedTab" />
                        <span class="slider"></span>
                    </label>
                    <span>Missing Forced Tab</span>
                </div>

            </div>

        </div>

        <div class="evaluation-block">

            <div class="block-header">
                <div>
                    <h2>📎 Product Shipping Folder</h2>
                    <p>Output and shipping folder validation.</p>
                </div>

                <div class="total-box">
                    <span>Total</span>
                    <strong>@TotalShippingVista</strong>
                </div>
            </div>

            <div class="toggles-container">

                <div class="toggle-item">
                    <label class="switch">
                        <input type="checkbox" @bind="Evaluacion.FileNamingIssue" />
                        <span class="slider"></span>
                    </label>
                    <span>File Naming Issue</span>
                </div>

                <div class="toggle-item">
                    <label class="switch">
                        <input type="checkbox" @bind="Evaluacion.OutputWrongDate" />
                        <span class="slider"></span>
                    </label>
                    <span>Output with wrong date</span>
                </div>

                <div class="toggle-item">
                    <label class="switch">
                        <input type="checkbox" @bind="Evaluacion.WrongPitstop" />
                        <span class="slider"></span>
                    </label>
                    <span>Wrong Pitstop</span>
                </div>

                <div class="toggle-item">
                    <label class="switch">
                        <input type="checkbox" @bind="Evaluacion.RestaurantBleedIssue" />
                        <span class="slider"></span>
                    </label>
                    <span>Restaurant Bleed Bar issue</span>
                </div>

                <div class="toggle-item">
                    <label class="switch">
                        <input type="checkbox" @bind="Evaluacion.WrongSigFiller" />
                        <span class="slider"></span>
                    </label>
                    <span>Wrong SIG fillers</span>
                </div>

                <div class="toggle-item">
                    <label class="switch">
                        <input type="checkbox" @bind="Evaluacion.FobFolder" />
                        <span class="slider"></span>
                    </label>
                    <span>FOB folder</span>
                </div>

                <div class="toggle-item">
                    <label class="switch">
                        <input type="checkbox" @bind="Evaluacion.MissingPaidItem" />
                        <span class="slider"></span>
                    </label>
                    <span>Missing paid item</span>
                </div>

                <div class="toggle-item">
                    <label class="switch">
                        <input type="checkbox" @bind="Evaluacion.MissingSelfPromo" />
                        <span class="slider"></span>
                    </label>
                    <span>Missing self promo</span>
                </div>

            </div>

        </div>

        <div class="evaluation-block">

            <div class="block-header">
                <div>
                    <h2>📋 Task Memo</h2>
                    <p>Memo correction and closing validation.</p>
                </div>

                <div class="total-box">
                    <span>Total</span>
                    <strong>@TotalTaskVista</strong>
                </div>
            </div>

            <div class="toggles-container">

                <div class="toggle-item">
                    <label class="switch">
                        <input type="checkbox" @bind="Evaluacion.Corrections" />
                        <span class="slider"></span>
                    </label>
                    <span>Corrections no properly applied</span>
                </div>

                <div class="toggle-item">
                    <label class="switch">
                        <input type="checkbox" @bind="Evaluacion.PendingCorrections" />
                        <span class="slider"></span>
                    </label>
                    <span>Pending corrections</span>
                </div>

                <div class="toggle-item">
                    <label class="switch">
                        <input type="checkbox" @bind="Evaluacion.TaskMemoWrongComment" />
                        <span class="slider"></span>
                    </label>
                    <span>Task memo closed with the wrong comment</span>
                </div>

            </div>

        </div>

    </section>

    <section class="form-card">

        <div class="section-header actions-section">

            <div>
                <h2>@(ModoEdicion ? "Update Evaluation" : "Save Evaluation")</h2>
            </div>

            <div class="header-actions">

                <button type="button"
                        class="btn-primary"
                        disabled="@Guardando"
                        @onclick="GuardarEvaluacionAsync">

                    @(Guardando
                                        ? "Saving..."
                                        : ModoEdicion
                                        ? "Update Evaluation"
                                        : "Save Evaluation")

                </button>

                <button type="button"
                        class="btn-light"
                        @onclick="LimpiarFormulario">
                    Clear
                </button>

                <button type="button"
                        class="btn-danger"
                        disabled="@(!ModoEdicion || Guardando)"
                        @onclick="EliminarEvaluacionAsync">
                    Delete
                </button>

            </div>

        </div>

    </section>

    <section class="list-card">

        <div class="section-header table-header">

            <div>
                <h2>Evaluation History</h2>
                <p>Double click on a row to load and edit an evaluation.</p>
            </div>

            <div class="list-filters">

                <select class="employee-filter-select"
                        value="@EmpleadoFiltroNombre"
                        @onchange="OnEmpleadoFiltroChanged">

                    <option value="">
                        All Employees
                    </option>

                    @foreach (var empleado in EmpleadosParaFiltro)
                    {
                        <option value="@empleado">
                            @empleado
                        </option>
                    }

                </select>

                <div class="search-box">

                    <span>🔎</span>

                    <input placeholder="Search by employee or KGEN..."
                           value="@Busqueda"
                           @oninput="OnBusquedaHistorialChanged" />

                </div>

                <button type="button"
                        class="btn-filter-clear"
                        @onclick="LimpiarFiltros">
                    Clear
                </button>

            </div>

        </div>

        @if (Cargando)
        {
            <div class="loading-state">
                Loading evaluations...
            </div>
        }
        else if (HistorialFiltrado.Count == 0)
        {
            <div class="empty-state">
                <strong>No evaluations to display.</strong>
                <span>Create a new evaluation or change the search filter.</span>
            </div>
        }
        else
        {
            <div class="table-container">

                <table class="evaluations-table">

                    <thead>
                        <tr>
                            <th>Employee</th>

                            @if (Scope.ViewAllEmployeeTypes)
                            {
                                <th>Department</th>
                            }

                            <th>KGEN</th>
                            <th>Motif YP</th>
                            <th>Motif WP</th>
                            <th>Inventory</th>
                            <th>Shipping</th>
                            <th>Task Memo</th>
                            <th>Total %</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in HistorialFiltrado)
                        {
                            <tr class="@(Evaluacion.Id == item.Id ? "selected" : string.Empty)"
                                @ondblclick="() => SeleccionarEvaluacionAsync(item.Id)">

                                <td data-label="Employee">

                                    <div class="employee-title">
                                        <strong>@item.EmpleadoNombre</strong>
                                    </div>

                                </td>

                                @if (Scope.ViewAllEmployeeTypes)
                                {
                                    <td data-label="Department">
                                        <span class="kgen-pill">
                                            @item.EmployeeTypeCode
                                        </span>
                                    </td>
                                }

                                <td data-label="KGEN">
                                    <span class="kgen-pill">
                                        @item.KGENCode
                                    </span>
                                </td>

                                <td data-label="Motif YP">
                                    @MostrarPorcentaje(item.MotifYp)
                                </td>

                                <td data-label="Motif WP">
                                    @MostrarPorcentaje(item.MotifWp)
                                </td>

                                <td data-label="Inventory">
                                    @MostrarPorcentaje(item.InventoryReport)
                                </td>

                                <td data-label="Shipping">
                                    @MostrarPorcentaje(item.ProductShippingFolder)
                                </td>

                                <td data-label="Task Memo">
                                    @MostrarPorcentaje(item.TaskMemo)
                                </td>

                                <td data-label="Total %">

                                    <strong class="total-percent">
                                        @MostrarPorcentaje(item.PorcentajeGeneral)
                                    </strong>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </section>

</div>

@code {
    private UserDataScope Scope { get; set; } = new();

    private Evaluaciones Evaluacion { get; set; } =
        CrearEvaluacionVacia();

    private bool Cargando { get; set; } = true;
    private bool Guardando { get; set; }
    private bool ModoEdicion { get; set; }

    private int TotalAsignacionesDisponibles;

    private string Mensaje { get; set; } =
        string.Empty;

    private string TipoMensaje { get; set; } =
        "success";

    private string Busqueda { get; set; } =
        string.Empty;

    private string TextoBusquedaAsignacion { get; set; } =
        string.Empty;

    private string EmpleadoFiltroNombre { get; set; } =
        string.Empty;

    private AsignacionSeleccionadaDto?
        AsignacionSeleccionada
    { get; set; }

    private List<EvaluacionListadoDto> Historial { get; set; } =
        new();

    private List<EvaluacionListadoDto> HistorialFiltrado { get; set; } =
        new();

    private List<string> EmpleadosParaFiltro { get; set; } =
        new();

    private bool MostrarModalResultadoEvaluacion { get; set; }

    private string TituloModalResultadoEvaluacion { get; set; } =
        string.Empty;

    private string MensajeModalResultadoEvaluacion { get; set; } =
        string.Empty;

    private string TipoModalResultadoEvaluacion { get; set; } =
        "success";

    protected override async Task OnInitializedAsync()
    {
        var authState =
            await AuthenticationStateProvider
                .GetAuthenticationStateAsync();

        Scope =
            await UserDataScopeService
                .GetScopeAsync(authState.User);

        await CargarDatosAsync();
    }

    private async Task CargarDatosAsync()
    {
        try
        {
            Cargando = true;
            LimpiarMensaje();

            await using var db =
                await DbFactory.CreateDbContextAsync();

            await ActualizarFinalizadosPorDirxionAsync(db);

            await CargarTotalAsignacionesDisponiblesAsync(db);

            await CargarHistorialAsync(db);
        }
        catch (Exception ex)
        {
            MostrarMensaje(
                $"Error loading evaluations: {ex.Message}",
                "error");
        }
        finally
        {
            Cargando = false;
        }
    }

    private async Task CargarTotalAsignacionesDisponiblesAsync(
        AppDbContext db)
    {
        TotalAsignacionesDisponibles =
            await db.Asignaciones
                .AsNoTracking()
                .ApplyScope(Scope)
                .CountAsync(a =>
                    !a.Finalizado &&
                    a.Libro != null &&
                    !a.Libro.Finalizado &&
                    !db.Evaluaciones.Any(
                        e => e.AssignationId == a.Id));
    }

    private async Task BuscarAsignacionConEnter(
        KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await BuscarAsignacionAsync();
        }
    }


    private async Task BuscarAsignacionAsync()
    {
        try
        {
            LimpiarMensaje();

            var filtro =
                TextoBusquedaAsignacion?.Trim();

            if (string.IsNullOrWhiteSpace(filtro))
            {
                MostrarMensaje(
                    "Enter a KGEN Code or LSA Code.",
                    "error");

                return;
            }

            await using var db =
                await DbFactory.CreateDbContextAsync();

            var patron = $"%{filtro}%";


            var asignacion =
                await db.Asignaciones
                    .AsNoTracking()
                    .ApplyScope(Scope)

                    .Where(a =>
                        !a.Finalizado &&
                        a.Libro != null &&
                        !a.Libro.Finalizado &&

                        !db.Evaluaciones.Any(
                            e =>
                                e.AssignationId ==
                                a.Id) &&

                        (
                            (
                                a.Libro.KGENCode != null &&
                                EF.Functions.ILike(
                                    a.Libro.KGENCode,
                                    patron)
                            )
                            ||
                            (
                                a.Libro.LSACode != null &&
                                EF.Functions.ILike(
                                    a.Libro.LSACode,
                                    patron)
                            )
                        ))

                    .OrderByDescending(a =>
                        a.Libro!.KGENCode == filtro ||
                        a.Libro.LSACode == filtro)

                    .ThenBy(a =>
                        a.Empleado != null
                            ? a.Empleado.Nombre
                            : string.Empty)

                    .ThenBy(a =>
                        a.Libro!.BookName)

                    .Select(a =>
                        new AssignmentSearchVm
                        {
                            Id = a.Id,

                            EmpleadoNombre =
                                a.Empleado != null
                                    ? a.Empleado.Nombre ?? "-"
                                    : "-",

                            BookName =
                                a.Libro != null
                                    ? a.Libro.BookName ?? "-"
                                    : "-",

                            KGENCode =
                                a.Libro != null
                                    ? a.Libro.KGENCode ?? "-"
                                    : "-",

                            LSACode =
                                a.Libro != null
                                    ? a.Libro.LSACode ?? "-"
                                    : "-",

                            EmployeeTypeCode =
                                a.Libro != null &&
                                a.Libro.EmployeeType != null

                                    ? a.Libro.EmployeeType.Code
                                        ?? string.Empty

                                    : string.Empty
                        })

                    .FirstOrDefaultAsync();


            if (asignacion is null)
            {
                Evaluacion =
                    CrearEvaluacionVacia();

                AsignacionSeleccionada =
                    null;

                ModoEdicion =
                    false;

                MostrarMensaje(
                    "No available assignment was found with that KGEN Code or LSA Code.",
                    "error");

                return;
            }


            var empleadoNombre =
                await ObtenerEmpleadoEvaluacionAsync(
                    db,
                    asignacion.Id,
                    asignacion.EmpleadoNombre);


            Evaluacion =
                new Evaluaciones
                {
                    Id = Guid.Empty,
                    AssignationId = asignacion.Id,
                    Finalizado = false
                };


            AsignacionSeleccionada =
                new AsignacionSeleccionadaDto
                {
                    Id =
                        asignacion.Id,

                    EmpleadoNombre =
                        empleadoNombre,

                    BookName =
                        asignacion.BookName,

                    KGENCode =
                        asignacion.KGENCode,

                    LSACode =
                        asignacion.LSACode,

                    EmployeeTypeCode =
                        asignacion.EmployeeTypeCode
                };


            ModoEdicion =
                false;
        }
        catch (Exception ex)
        {
            MostrarMensaje(
                $"Error searching assignment: {ex.Message}",
                "error");
        }
    }

    private static async Task<string>
        ObtenerEmpleadoEvaluacionAsync(
            AppDbContext db,
            Guid assignmentId,
            string empleadoOriginal)
    {
        var nombreTemporal =
            await db.TemporaryAssignments
                .AsNoTracking()

                .Where(x =>
                    x.AssignmentId == assignmentId &&
                    x.Active)

                .OrderByDescending(
                    x => x.CreatedAt)

                .Select(x =>
                    x.TemporaryEmployee != null
                        ? x.TemporaryEmployee.Nombre
                        : null)

                .FirstOrDefaultAsync();


        if (!string.IsNullOrWhiteSpace(
                nombreTemporal))
        {
            return nombreTemporal;
        }


        return string.IsNullOrWhiteSpace(
            empleadoOriginal)
                ? "-"
                : empleadoOriginal;
    }

    private async Task CargarHistorialAsync(
        AppDbContext db)
    {
        var evaluacionesDb =
            await db.Evaluaciones
                .AsNoTracking()
                .ApplyScope(Scope)

                .OrderBy(e =>
                    e.Asignacion != null &&
                    e.Asignacion.Empleado != null

                        ? e.Asignacion.Empleado.Nombre
                        : string.Empty)

                .ThenBy(e =>
                    e.Asignacion != null &&
                    e.Asignacion.Libro != null

                        ? e.Asignacion.Libro.KGENCode
                        : string.Empty)

                .Select(e =>
                    new EvaluacionHistorialRawDto
                    {
                        Id =
                            e.Id,

                        AssignationId =
                            e.AssignationId,

                        EmpleadoNombre =
                            e.Asignacion != null &&
                            e.Asignacion.Empleado != null

                                ? e.Asignacion.Empleado.Nombre ?? "-"
                                : "-",

                        KGENCode =
                            e.Asignacion != null &&
                            e.Asignacion.Libro != null

                                ? e.Asignacion.Libro.KGENCode ?? "-"
                                : "-",

                        EmployeeTypeCode =
                            e.Asignacion != null &&
                            e.Asignacion.Libro != null &&
                            e.Asignacion.Libro.EmployeeType != null

                                ? e.Asignacion.Libro.EmployeeType.Code
                                    ?? string.Empty

                                : string.Empty,

                        MotifYp =
                            e.MotifYp,

                        MotifWp =
                            e.MotifWp,

                        InventoryReport =
                            e.InventoryReport,

                        ProductShippingFolder =
                            e.ProductShippingFolder,

                        TaskMemo =
                            e.TaskMemo
                    })

                .ToListAsync();


        if (evaluacionesDb.Count == 0)
        {
            Historial.Clear();
            HistorialFiltrado.Clear();
            EmpleadosParaFiltro.Clear();

            return;
        }


        var assignmentIds =
            evaluacionesDb
                .Select(x =>
                    x.AssignationId)

                .Distinct()

                .ToList();

        var temporalesDb =
            await db.TemporaryAssignments
                .AsNoTracking()

                .Where(x =>
                    x.Active &&
                    assignmentIds.Contains(
                        x.AssignmentId))

                .OrderByDescending(
                    x => x.CreatedAt)

                .Select(x =>
                    new TemporaryEmployeeHistoryVm
                    {
                        AssignmentId =
                            x.AssignmentId,

                        EmployeeName =
                            x.TemporaryEmployee != null

                                ? x.TemporaryEmployee.Nombre
                                    ?? string.Empty

                                : string.Empty
                    })

                .ToListAsync();

        var temporalPorAsignacion =
            temporalesDb
                .GroupBy(x =>
                    x.AssignmentId)

                .ToDictionary(
                    g => g.Key,
                    g => g.First().EmployeeName);


        Historial =
            new List<EvaluacionListadoDto>(
                evaluacionesDb.Count);


        foreach (var evaluacion in evaluacionesDb)
        {
            var empleadoNombre =
                evaluacion.EmpleadoNombre;


            if (temporalPorAsignacion.TryGetValue(
                    evaluacion.AssignationId,
                    out var nombreTemporal)

                &&

                !string.IsNullOrWhiteSpace(
                    nombreTemporal))
            {
                empleadoNombre =
                    nombreTemporal;
            }


            var item =
                new EvaluacionListadoDto
                {
                    Id =
                        evaluacion.Id,

                    AssignationId =
                        evaluacion.AssignationId,

                    EmpleadoNombre =
                        empleadoNombre,

                    KGENCode =
                        evaluacion.KGENCode,

                    EmployeeTypeCode =
                        evaluacion.EmployeeTypeCode,

                    MotifYp =
                        evaluacion.MotifYp,

                    MotifWp =
                        evaluacion.MotifWp,

                    InventoryReport =
                        evaluacion.InventoryReport,

                    ProductShippingFolder =
                        evaluacion.ProductShippingFolder,

                    TaskMemo =
                        evaluacion.TaskMemo
                };


            item.PorcentajeGeneral =
                CalcularPorcentajeGeneral(
                    item);


            Historial.Add(item);
        }


        ActualizarListaEmpleadosFiltro();

        AplicarFiltrosHistorial();
    }

    private void AplicarFiltrosHistorial()
    {
        IEnumerable<EvaluacionListadoDto> query =
            Historial;


        if (!string.IsNullOrWhiteSpace(
                EmpleadoFiltroNombre))
        {
            var empleado =
                EmpleadoFiltroNombre.Trim();


            query =
                query.Where(x =>
                    string.Equals(
                        x.EmpleadoNombre,
                        empleado,
                        StringComparison.OrdinalIgnoreCase));
        }


        if (!string.IsNullOrWhiteSpace(
                Busqueda))
        {
            var filtro =
                Busqueda.Trim();


            query =
                query.Where(x =>
                    ContieneIgnorandoMayusculas(
                        x.EmpleadoNombre,
                        filtro)

                    ||

                    ContieneIgnorandoMayusculas(
                        x.KGENCode,
                        filtro)

                    ||

                    ContieneIgnorandoMayusculas(
                        x.EmployeeTypeCode,
                        filtro));
        }


        HistorialFiltrado =
            query.ToList();
    }


    private static bool ContieneIgnorandoMayusculas(
        string? source,
        string value)
    {
        return !string.IsNullOrEmpty(source) &&
               source.Contains(
                   value,
                   StringComparison.OrdinalIgnoreCase);
    }


    private void ActualizarListaEmpleadosFiltro()
    {
        EmpleadosParaFiltro =
            Historial
                .Where(x =>
                    !string.IsNullOrWhiteSpace(
                        x.EmpleadoNombre)

                    &&

                    x.EmpleadoNombre != "-")

                .Select(x =>
                    x.EmpleadoNombre)

                .Distinct(
                    StringComparer.OrdinalIgnoreCase)

                .OrderBy(x =>
                    x)

                .ToList();
    }


