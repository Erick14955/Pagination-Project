        Busqueda = string.Empty;
        EmpleadoFiltroNombre = string.Empty;
    }

    private void MostrarMensaje(string mensaje, string tipo)
    {
        Mensaje = mensaje;
        TipoMensaje = tipo;
    }

    private void LimpiarMensaje()
    {
        Mensaje = string.Empty;
        TipoMensaje = "success";
    }

    private int TotalMotifYpVista =>
        Contar(Evaluacion.TouchingRule) +
        Contar(Evaluacion.PagesSwapped) +
        Contar(Evaluacion.PplpWrongPlace) +
        Contar(Evaluacion.CouponsHeading) +
        Contar(Evaluacion.DoubleTruckWrongPlace) +
        Contar(Evaluacion.FillersOutside) +
        Contar(Evaluacion.MissingYspFiller) +
        Contar(Evaluacion.GradeUnder75);

    private int TotalMotifWpVista =>
        Contar(Evaluacion.WhpsNoAnchors) +
        Contar(Evaluacion.WfpsNoAnchors) +
        Contar(Evaluacion.WdqcsNoAnchors);

    private decimal PorcentajeMotifYpVista =>
CalcularPorcentajeVistaDecimal(TotalMotifYpVista, 8);

    private decimal PorcentajeMotifWpVista =>
        CalcularPorcentajeVistaDecimal(TotalMotifWpVista, 3);

    private decimal PorcentajeInventoryVista =>
        CalcularPorcentajeVistaDecimal(TotalInventoryVista, 4);

    private decimal PorcentajeShippingVista =>
        CalcularPorcentajeVistaDecimal(TotalShippingVista, 8);

    private decimal PorcentajeTaskVista =>
        CalcularPorcentajeVistaDecimal(TotalTaskVista, 3);

    private decimal PorcentajeGeneralVista =>
        Math.Round(new[]
        {
        PorcentajeMotifYpVista,
        PorcentajeMotifWpVista,
        PorcentajeInventoryVista,
        PorcentajeShippingVista,
        PorcentajeTaskVista
        }.Average(), 2);

    private static decimal CalcularPorcentajeVistaDecimal(int errores, int total)
    {
        if (total <= 0)
            return 0;

        var porcentaje = ((total - errores) * 100m) / total;

        if (porcentaje < 0)
            porcentaje = 0;

        return Math.Round(porcentaje, 2);
    }

    private int TotalInventoryVista =>
        Contar(Evaluacion.MissingCornerAd) +
        Contar(Evaluacion.MissingBanner) +
        Contar(Evaluacion.MissingRandomTab) +
        Contar(Evaluacion.MissingForcedTab);

    private int TotalShippingVista =>
        Contar(Evaluacion.FileNamingIssue) +
        Contar(Evaluacion.OutputWrongDate) +
        Contar(Evaluacion.WrongPitstop) +
        Contar(Evaluacion.RestaurantBleedIssue) +
        Contar(Evaluacion.WrongSigFiller) +
        Contar(Evaluacion.FobFolder) +
        Contar(Evaluacion.MissingPaidItem) +
        Contar(Evaluacion.MissingSelfPromo);

    private int TotalTaskVista =>
        Contar(Evaluacion.Corrections) +
        Contar(Evaluacion.PendingCorrections) +
        Contar(Evaluacion.TaskMemoWrongComment);

    private static int Contar(bool valor)
    {
        return valor ? 1 : 0;
    }

    private static string PorcentajeVista(int errores, int total)
    {
        if (total <= 0)
            return "0.00";

        var porcentaje = ((total - errores) * 100m) / total;

        if (porcentaje < 0)
            porcentaje = 0;

        return porcentaje.ToString("0.00");
    }

    private static string MostrarPorcentaje(decimal? valor)
    {
        return valor.HasValue ? $"{valor.Value:0.00}%" : "0.00%";
    }

    private static decimal CalcularPorcentajeGeneral(EvaluacionListadoDto item)
    {
        var valores = new List<decimal>();

        if (item.MotifYp.HasValue)
            valores.Add(item.MotifYp.Value);

        if (item.MotifWp.HasValue)
            valores.Add(item.MotifWp.Value);

        if (item.InventoryReport.HasValue)
            valores.Add(item.InventoryReport.Value);

        if (item.ProductShippingFolder.HasValue)
            valores.Add(item.ProductShippingFolder.Value);

        if (item.TaskMemo.HasValue)
            valores.Add(item.TaskMemo.Value);

        if (valores.Count == 0)
            return 0;

        return Math.Round(valores.Average(), 2);
    }

