        ChangeEventArgs e)
    {
        EmpleadoFiltroNombre =
            e.Value?.ToString()
            ?? string.Empty;


        AplicarFiltrosHistorial();
    }


    private void OnBusquedaHistorialChanged(
        ChangeEventArgs e)
    {
        Busqueda =
            e.Value?.ToString()
            ?? string.Empty;


        AplicarFiltrosHistorial();
    }

    private async Task GuardarEvaluacionAsync()
    {
        try
        {
            if (Guardando)
                return;


            Guardando = true;

            LimpiarMensaje();


            if (Evaluacion.AssignationId ==
                Guid.Empty)
            {
                MostrarResultadoEvaluacion(
                    "Unable to save evaluation",
                    "Select a valid assignment before saving the evaluation.",
                    "error");

                return;
            }


            var editando =
                Evaluacion.Id != Guid.Empty;


            var empleadoNombre =
                AsignacionSeleccionada
                    ?.EmpleadoNombre
                ?? "Selected employee";


            var kgenCode =
                AsignacionSeleccionada
                    ?.KGENCode;


            if (string.IsNullOrWhiteSpace(
                    kgenCode))
            {
                kgenCode =
                    TextoBusquedaAsignacion
                        ?.Trim();
            }


            if (string.IsNullOrWhiteSpace(
                    kgenCode))
            {
                kgenCode = "-";
            }

            Evaluacion.MotifYp =
                PorcentajeMotifYpVista;

            Evaluacion.MotifWp =
                PorcentajeMotifWpVista;

            Evaluacion.InventoryReport =
                PorcentajeInventoryVista;

            Evaluacion.ProductShippingFolder =
                PorcentajeShippingVista;

            Evaluacion.TaskMemo =
                PorcentajeTaskVista;


            await using var db =
                await DbFactory.CreateDbContextAsync();


            if (!editando)
            {
                var estadoAsignacion =
                    await db.Asignaciones
                        .AsNoTracking()
                        .ApplyScope(Scope)

                        .Where(a =>
                            a.Id ==
                            Evaluacion.AssignationId)

                        .Select(a =>
                            new AssignmentAvailabilityVm
                            {
                                Disponible =
                                    !a.Finalizado &&
                                    a.Libro != null &&
                                    !a.Libro.Finalizado,

                                TieneEvaluacion =
                                    db.Evaluaciones.Any(
                                        e =>
                                            e.AssignationId ==
                                            a.Id)
                            })

                        .FirstOrDefaultAsync();


                if (estadoAsignacion is null ||
                    !estadoAsignacion.Disponible)
                {
                    MostrarResultadoEvaluacion(
                        "Assignment unavailable",
                        "The selected assignment is no longer available or is outside your employee type scope.",
                        "error");

                    return;
                }


                if (estadoAsignacion.TieneEvaluacion)
                {
                    MostrarResultadoEvaluacion(
                        "Evaluation already exists",
                        "This assignment already has an evaluation. Open it from the history to edit it.",
                        "error");

                    return;
                }


                Evaluacion.Id =
                    Guid.NewGuid();

                Evaluacion.Finalizado =
                    false;


                db.Evaluaciones.Add(
                    Evaluacion);
            }
            else
            {
                var existente =
                    await db.Evaluaciones
                        .ApplyScope(Scope)

                        .FirstOrDefaultAsync(
                            e =>
                                e.Id ==
                                Evaluacion.Id);


                if (existente is null)
                {
                    MostrarResultadoEvaluacion(
                        "Evaluation not found",
                        "The selected evaluation was not found or is outside your employee type scope.",
                        "error");

                    return;
                }


                existente.AssignationId =
                    Evaluacion.AssignationId;

                existente.TouchingRule =
                    Evaluacion.TouchingRule;

                existente.PagesSwapped =
                    Evaluacion.PagesSwapped;

                existente.PplpWrongPlace =
                    Evaluacion.PplpWrongPlace;

                existente.CouponsHeading =
                    Evaluacion.CouponsHeading;

                existente.DoubleTruckWrongPlace =
                    Evaluacion.DoubleTruckWrongPlace;

                existente.FillersOutside =
                    Evaluacion.FillersOutside;

                existente.MissingYspFiller =
                    Evaluacion.MissingYspFiller;

                existente.GradeUnder75 =
                    Evaluacion.GradeUnder75;

                existente.WhpsNoAnchors =
                    Evaluacion.WhpsNoAnchors;

                existente.WfpsNoAnchors =
                    Evaluacion.WfpsNoAnchors;

                existente.WdqcsNoAnchors =
                    Evaluacion.WdqcsNoAnchors;

                existente.MissingCornerAd =
                    Evaluacion.MissingCornerAd;

                existente.MissingBanner =
                    Evaluacion.MissingBanner;

                existente.MissingRandomTab =
                    Evaluacion.MissingRandomTab;

                existente.MissingForcedTab =
                    Evaluacion.MissingForcedTab;

                existente.FileNamingIssue =
                    Evaluacion.FileNamingIssue;

                existente.OutputWrongDate =
                    Evaluacion.OutputWrongDate;

                existente.WrongPitstop =
                    Evaluacion.WrongPitstop;

                existente.RestaurantBleedIssue =
                    Evaluacion.RestaurantBleedIssue;

                existente.WrongSigFiller =
                    Evaluacion.WrongSigFiller;

                existente.FobFolder =
                    Evaluacion.FobFolder;

                existente.MissingPaidItem =
                    Evaluacion.MissingPaidItem;

                existente.MissingSelfPromo =
                    Evaluacion.MissingSelfPromo;

                existente.Corrections =
                    Evaluacion.Corrections;

                existente.PendingCorrections =
                    Evaluacion.PendingCorrections;

                existente.TaskMemoWrongComment =
                    Evaluacion.TaskMemoWrongComment;

                existente.MotifYp =
                    Evaluacion.MotifYp;

                existente.MotifWp =
                    Evaluacion.MotifWp;

                existente.InventoryReport =
                    Evaluacion.InventoryReport;

                existente.ProductShippingFolder =
                    Evaluacion.ProductShippingFolder;

                existente.TaskMemo =
                    Evaluacion.TaskMemo;


                existente.Finalizado =
                    Evaluacion.Finalizado;
            }


            await db.SaveChangesAsync();

            var itemHistorial =
                CrearItemHistorialActual();


            ActualizarHistorialLocal(
                itemHistorial,
                editando);

            await CargarTotalAsignacionesDisponiblesAsync(
                db);


            LimpiarFormulario();


            MostrarResultadoEvaluacion(
                editando
                    ? "Evaluation updated"
                    : "Evaluation created",

                editando
                    ? $"The evaluation for {empleadoNombre}, KGEN {kgenCode}, was updated successfully."
                    : $"The evaluation for {empleadoNombre}, KGEN {kgenCode}, was saved successfully.",

                "success");
        }
        catch (Exception ex)
        {
            MostrarResultadoEvaluacion(
                "Error saving evaluation",
                $"The evaluation could not be saved. {ex.Message}",
                "error");
        }
        finally
        {
            Guardando = false;
        }
    }

    private EvaluacionListadoDto CrearItemHistorialActual()
    {
        var anterior =
            Historial.FirstOrDefault(
                x =>
                    x.Id ==
                    Evaluacion.Id);


        var item =
            new EvaluacionListadoDto
            {
                Id =
                    Evaluacion.Id,

                AssignationId =
                    Evaluacion.AssignationId,

                EmpleadoNombre =
                    AsignacionSeleccionada
                        ?.EmpleadoNombre

                    ?? anterior
                        ?.EmpleadoNombre

                    ?? "-",

                KGENCode =
                    AsignacionSeleccionada
                        ?.KGENCode

                    ?? anterior
                        ?.KGENCode

                    ?? "-",

                EmployeeTypeCode =
                    AsignacionSeleccionada
                        ?.EmployeeTypeCode

                    ?? anterior
                        ?.EmployeeTypeCode

                    ?? string.Empty,

                MotifYp =
                    Evaluacion.MotifYp,

                MotifWp =
                    Evaluacion.MotifWp,

                InventoryReport =
                    Evaluacion.InventoryReport,

                ProductShippingFolder =
                    Evaluacion.ProductShippingFolder,

                TaskMemo =
                    Evaluacion.TaskMemo
            };


        item.PorcentajeGeneral =
            CalcularPorcentajeGeneral(
                item);


        return item;
    }


    private void ActualizarHistorialLocal(
        EvaluacionListadoDto item,
        bool editando)
    {
        if (editando)
        {
            var index =
                Historial.FindIndex(
                    x =>
                        x.Id ==
                        item.Id);


            if (index >= 0)
            {
                Historial[index] =
                    item;
            }
            else
            {
                Historial.Add(item);
            }
        }
        else
        {
            Historial.Add(item);
        }


        Historial =
            Historial
                .OrderBy(x =>
                    x.EmpleadoNombre)

                .ThenBy(x =>
                    x.KGENCode)

                .ToList();


        ActualizarListaEmpleadosFiltro();

        AplicarFiltrosHistorial();
    }

    private async Task SeleccionarEvaluacionAsync(
        Guid id)
    {
        try
        {
            LimpiarMensaje();


            await using var db =
                await DbFactory.CreateDbContextAsync();

            var item =
                await db.Evaluaciones
                    .AsNoTracking()
                    .ApplyScope(Scope)

                    .FirstOrDefaultAsync(
                        e => e.Id == id);


            if (item is null)
            {
                MostrarMensaje(
                    "The selected evaluation was not found.",
                    "error");

                return;
            }


            Evaluacion =
                item;

            ModoEdicion =
                true;

            var asignacion =
                await db.Asignaciones
                    .AsNoTracking()
                    .ApplyScope(Scope)

                    .Where(a =>
                        a.Id ==
                        item.AssignationId)

                    .Select(a =>
                        new AssignmentSearchVm
                        {
                            Id =
                                a.Id,

                            EmpleadoNombre =
                                a.Empleado != null

                                    ? a.Empleado.Nombre
                                        ?? "-"

                                    : "-",

                            BookName =
                                a.Libro != null

                                    ? a.Libro.BookName
                                        ?? "-"

                                    : "-",

                            KGENCode =
                                a.Libro != null

                                    ? a.Libro.KGENCode
                                        ?? "-"

                                    : "-",

                            LSACode =
                                a.Libro != null

                                    ? a.Libro.LSACode
                                        ?? "-"

                                    : "-",

                            EmployeeTypeCode =
                                a.Libro != null &&
                                a.Libro.EmployeeType != null

                                    ? a.Libro.EmployeeType.Code
                                        ?? string.Empty

                                    : string.Empty
                        })

                    .FirstOrDefaultAsync();


            if (asignacion is null)
            {
                TextoBusquedaAsignacion =
                    string.Empty;

                AsignacionSeleccionada =
                    null;

                return;
            }


            var empleadoNombre =
                await ObtenerEmpleadoEvaluacionAsync(
                    db,
                    item.AssignationId,
                    asignacion.EmpleadoNombre);


            TextoBusquedaAsignacion =
                !string.IsNullOrWhiteSpace(
                    asignacion.KGENCode)

                &&

                asignacion.KGENCode != "-"

                    ? asignacion.KGENCode

                    : asignacion.LSACode;


            AsignacionSeleccionada =
                new AsignacionSeleccionadaDto
                {
                    Id =
                        item.AssignationId,

                    EmpleadoNombre =
                        empleadoNombre,

                    BookName =
                        asignacion.BookName,

                    KGENCode =
                        asignacion.KGENCode,

                    LSACode =
                        asignacion.LSACode,

                    EmployeeTypeCode =
                        asignacion.EmployeeTypeCode
                };
        }
        catch (Exception ex)
        {
            MostrarMensaje(
                $"Error selecting evaluation: {ex.Message}",
                "error");
        }
    }

    private async Task EliminarEvaluacionAsync()
    {
        if (!ModoEdicion ||
            Evaluacion.Id == Guid.Empty)
        {
            MostrarResultadoEvaluacion(
                "Evaluation not selected",
                "Open an evaluation from the history before deleting it.",
                "error");

            return;
        }


        var idEvaluacion =
            Evaluacion.Id;


        var empleadoNombre =
            AsignacionSeleccionada
                ?.EmpleadoNombre
            ?? "Selected employee";


        var kgenCode =
            AsignacionSeleccionada
                ?.KGENCode
            ?? "-";


        var confirmar =
            await JS.InvokeAsync<bool>(
                "confirm",
                $"Are you sure you want to delete the evaluation for {empleadoNombre}, KGEN {kgenCode}?");


        if (!confirmar)
            return;


        try
        {
            Guardando = true;

            LimpiarMensaje();


            await using var db =
                await DbFactory.CreateDbContextAsync();


            var item =
                await db.Evaluaciones
                    .ApplyScope(Scope)

                    .FirstOrDefaultAsync(
                        e =>
                            e.Id ==
                            idEvaluacion);


            if (item is null)
            {
                MostrarResultadoEvaluacion(
                    "Evaluation not found",
                    "The selected evaluation was not found or is outside your employee type scope.",
                    "error");

                return;
            }


            db.Evaluaciones.Remove(
                item);


            await db.SaveChangesAsync();

            Historial.RemoveAll(
                x =>
                    x.Id ==
                    idEvaluacion);


            ActualizarListaEmpleadosFiltro();

            AplicarFiltrosHistorial();

            await CargarTotalAsignacionesDisponiblesAsync(
                db);


            LimpiarFormulario();


            MostrarResultadoEvaluacion(
                "Evaluation deleted",
                $"The evaluation for {empleadoNombre}, KGEN {kgenCode}, was deleted successfully.",
                "success");
        }
        catch (Exception ex)
        {
            MostrarResultadoEvaluacion(
                "Error deleting evaluation",
                $"The evaluation could not be deleted. {ex.Message}",
                "error");
        }
        finally
        {
            Guardando = false;
        }
    }

    private async Task ActualizarFinalizadosPorDirxionAsync(
        AppDbContext db)
    {
        var hoy =
            DateOnly.FromDateTime(
                DateTime.Today);


        var libroIds =
            await db.Libros
                .AsNoTracking()
                .ApplyScope(Scope)

                .Where(x =>
                    !x.Finalizado &&
                    x.DirxionDate < hoy)

                .Select(x =>
                    x.Id)

                .ToListAsync();


        if (libroIds.Count == 0)
            return;


        var assignmentIds =
            await db.Asignaciones
                .AsNoTracking()

                .Where(a =>
                    libroIds.Contains(
                        a.IdLibro))

                .Select(a =>
                    a.Id)

                .ToListAsync();

        var strategy =
            db.Database
                .CreateExecutionStrategy();


        await strategy.ExecuteAsync(
            async () =>
            {
                await using var transaction =
                    await db.Database
                        .BeginTransactionAsync();


                if (assignmentIds.Count > 0)
                {
                    await db.Evaluaciones

                        .Where(e =>
                            assignmentIds.Contains(
                                e.AssignationId)

                            &&

                            !e.Finalizado)

                        .ExecuteUpdateAsync(
                            setters =>
                                setters.SetProperty(
                                    e => e.Finalizado,
                                    true));


                    await db.Asignaciones

                        .Where(a =>
                            assignmentIds.Contains(
                                a.Id)

                            &&

                            !a.Finalizado)

                        .ExecuteUpdateAsync(
                            setters =>
                                setters.SetProperty(
                                    a => a.Finalizado,
                                    true));
                }


                await db.Libros

                    .Where(l =>
                        libroIds.Contains(
                            l.Id)

                        &&

                        !l.Finalizado)

                    .ExecuteUpdateAsync(
                        setters =>
                            setters.SetProperty(
                                l => l.Finalizado,
                                true));


                await transaction.CommitAsync();
            });
    }

