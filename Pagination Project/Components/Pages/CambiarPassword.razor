@page "/cambiar-password"
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@inject NavigationManager Navigation

@layout Pagination_Project.Components.Layout.LoginLayout

<PageTitle>Change Password</PageTitle>

<link href="/lib/css/login.css" rel="stylesheet" />

<div class="thryv-login-page">
    <div class="thryv-login-card">
        <div class="thryv-login-panel">
            <div class="thryv-logo-row">
                <div class="thryv-logo-mark">T</div>
                <div class="thryv-logo-text">
                    <strong>Evaluations</strong>
                    <span>Password update required</span>
                </div>
            </div>

            <h2 class="thryv-login-title">Change your password</h2>

            <p class="thryv-login-subtitle">
                For security reasons, you must update your password before continuing.
            </p>

            <form method="post" action="/account/change-password">
                <AntiforgeryToken />
                <div class="thryv-form-group">
                    <label>New Password</label>
                    <input name="NewPassword"
                           type="password"
                           class="thryv-input"
                           placeholder="Enter new password"
                           maxlength="100"
                           autocomplete="new-password" />
                </div>

                <div class="thryv-form-group">
                    <label>Confirm Password</label>
                    <input name="ConfirmPassword"
                           type="password"
                           class="thryv-input"
                           placeholder="Confirm new password"
                           maxlength="100"
                           autocomplete="new-password" />
                </div>

                @if (!string.IsNullOrWhiteSpace(_mensajeError))
                {
                    <div class="thryv-error">
                        @_mensajeError
                    </div>
                }

                <div class="thryv-password-rules">
                    Minimum 6 characters. After changing your password, you will need to sign in again.
                </div>

                <button type="submit" class="thryv-login-button">
                    Change Password
                </button>
            </form>

            <div class="thryv-panel-footer">
                Secure access to your evaluation workspace
            </div>
        </div>
    </div>
</div>

@code {
    private string? _mensajeError;

    protected override void OnInitialized()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);

        if (query.TryGetValue("error", out var error))
        {
            _mensajeError = error.ToString() switch
            {
                "short" => "The password must have at least 6 characters.",
                "mismatch" => "Passwords do not match.",
                "notfound" => "User not found.",
                "general" => "Unable to change password.",
                _ => "Unable to change password."
            };
        }
    }
}