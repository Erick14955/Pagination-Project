    private async Task MarcarEtapaCompletadaAsync(
        AsignacionTrackerVm item)
    {
        await using var db =
            await DbFactory.CreateDbContextAsync();

        var tieneAcceso = await db.Asignaciones
            .AsNoTracking()
            .ApplyScope(Scope)
            .AnyAsync(x =>
                x.Id == item.AssignmentId);

        if (!tieneAcceso)
        {
            throw new UnauthorizedAccessException(
                "The assignment is outside your employee type scope.");
        }

        var registro = await db.AsignacionesTrabajadas
            .FirstOrDefaultAsync(x =>
                x.IdAsignacion == item.AssignmentId &&
                x.FechaTrabajo == FechaTrabajo);

        if (registro is null)
        {
            registro = new AsignacionTrabajada
            {
                Id =
                    Guid.NewGuid(),

                IdAsignacion =
                    item.AssignmentId,

                FechaTrabajo =
                    FechaTrabajo
            };

            db.AsignacionesTrabajadas.Add(
                registro);
        }

        MarcarEtapa(
            registro,
            item.StageKey);

        await db.SaveChangesAsync();
    }

    private static void MarcarEtapa(
        AsignacionTrabajada registro,
        string etapaKey)
    {
        switch (etapaKey)
        {
            case "ProofExtract":
                registro.ProofExtractWorked = true;
                break;

            case "FinalExtract":
                registro.FinalExtractWorked = true;
                break;

            case "MemoExtract":
                registro.MemoExtractWorked = true;
                break;

            case "FinalPO":
                registro.FinalPOWorked = true;
                break;

            case "Shipping":
                registro.ShippingWorked = true;
                break;

            case "Dirxion":
                registro.DirxionWorked = true;
                break;
        }
    }

    private long ObtenerSegundosTranscurridos(
        AsignacionTrackerVm item)
    {
        var total =
            item.AccumulatedSeconds;

        if (item.IsRunning &&
            item.StartedAtUtc.HasValue)
        {
            var diferencia =
                DateTimeOffset.UtcNow -
                item.StartedAtUtc.Value;

            if (diferencia.TotalSeconds > 0)
            {
                total +=
                    (long)Math.Floor(
                        diferencia.TotalSeconds);
            }
        }

        return Math.Max(0, total);
    }

    private static string FormatoDuracion(long seconds)
    {
        var totalSeconds =
            Math.Max(0, seconds);

        var horas =
            totalSeconds / 3600;

        var minutos =
            totalSeconds % 3600 / 60;

        var segundos =
            totalSeconds % 60;

        return $"{horas:00}:{minutos:00}:{segundos:00}";
    }

    private static string FormatoHorasDecimales(
        long seconds)
    {
        var horas =
            Math.Max(0, seconds) /
            3600d;

        return horas.ToString("0.##");
    }

    private static string FormatoMinutos(
        long seconds)
    {
        var minutos =
            Math.Max(0, seconds) /
            60d;

        return minutos.ToString("0.#");
    }

    private static string FormatoHoraInicio(
        AsignacionTrackerVm item)
    {
        if (!item.StartedAtUtc.HasValue)
            return "—";

        var horaRepublicaDominicana =
            TimeZoneInfo.ConvertTime(
                item.StartedAtUtc.Value,
                ZonaHorariaRepublicaDominicana);

        return horaRepublicaDominicana
            .ToString("hh:mm tt");
    }

    private static string FormatoHoraFinalizacion(
        AsignacionTrackerVm item)
    {
        if (!item.FinishedAtUtc.HasValue)
            return "—";

        var horaRepublicaDominicana =
            TimeZoneInfo.ConvertTime(
                item.FinishedAtUtc.Value,
                ZonaHorariaRepublicaDominicana);

        return horaRepublicaDominicana
            .ToString("hh:mm tt");
    }

    private static string ValorOPlaceholder(
        string? value)
    {
        return string.IsNullOrWhiteSpace(value)
            ? "—"
            : value;
    }

    private static string ObtenerNombreEstado(
        AsignacionTrackerVm item)
    {
        if (item.YaCompletada)
            return "Completed";

        if (item.IsRunning)
            return "Running";

        if (item.AccumulatedSeconds > 0)
            return "Paused";

        return "Ready";
    }

    private static string ObtenerClaseEstado(
        AsignacionTrackerVm item)
    {
        if (item.YaCompletada)
            return "tracker-status-completed";

        if (item.IsRunning)
            return "tracker-status-running";

        if (item.AccumulatedSeconds > 0)
            return "tracker-status-paused";

        return "tracker-status-ready";
    }

    private void AplicarFiltros()
    {
        var query =
            AsignacionesDia.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(
            EtapaFiltro))
        {
            query = query.Where(x =>
                x.StageKey == EtapaFiltro);
        }

        if (!string.IsNullOrWhiteSpace(
            Busqueda))
        {
            var term =
                Busqueda
                    .Trim()
                    .ToLowerInvariant();

            query = query.Where(x =>
                x.BookName
                    .ToLowerInvariant()
                    .Contains(term) ||

                x.KgenCode
                    .ToLowerInvariant()
                    .Contains(term) ||

                x.LsaCode
                    .ToLowerInvariant()
                    .Contains(term) ||

                x.StageName
                    .ToLowerInvariant()
                    .Contains(term) ||

                x.EmployeeTypeCode
                    .ToLowerInvariant()
                    .Contains(term));
        }

        AsignacionesFiltradas = query
            .OrderBy(x => x.YaCompletada)
            .ThenByDescending(x => x.IsRunning)
            .ThenBy(x => x.StageDate)
            .ThenBy(x => x.BookName)
            .ToList();
    }

    private void OnBusquedaChanged(
        ChangeEventArgs e)
    {
        Busqueda =
            e.Value?.ToString() ??
            string.Empty;

        AplicarFiltros();
    }

    private void OnEtapaChanged(
        ChangeEventArgs e)
    {
        EtapaFiltro =
            e.Value?.ToString() ??
            string.Empty;

        AplicarFiltros();
    }

    private static bool AsignacionTemporalAplicaEtapa(
        TemporaryAssignment temporal,
        string etapaKey)
    {
        return etapaKey switch
        {
            "ProofExtract" => temporal.Proof,
            "FinalExtract" => temporal.Final,
            "MemoExtract" => temporal.Memo,
            "FinalPO" => temporal.FinalPO,
            "Shipping" => temporal.Shipping,
            "Dirxion" => temporal.Dirxion,
            _ => false
        };
    }

    private EtapaDia? ObtenerEtapaDelDia(
        RawAssignmentVm item)
    {
        var bindPlantName =
            (item.BindPlantName ?? string.Empty)
            .Trim()
            .ToUpperInvariant();

        var esIveau =
            bindPlantName == "IVEAU" ||
            bindPlantName == "WSTR";

        var excluirMemoPorBindPlant =
            bindPlantName == "PREM" ||
            bindPlantName == "DIRX" ||
            bindPlantName == "WSTR" ||
            bindPlantName == "IVEAU";

        var proofDisplayDate =
            GetNextBusinessDay(
                item.ProofExtract);

        var finalDisplayDate =
            GetNextBusinessDay(
                item.FinalExtract);

        var memoDisplayDate =
            GetNextBusinessDay(
                item.MemoExtract);

        var finalPODisplayDate =
            esIveau
                ? GetPreviousWorkDate(
                    item.FinalPODate,
                    3)
                : item.FinalPODate;

        var shippingDisplayDate =
            esIveau
                ? GetPreviousWorkDate(
                    item.ShippingDate,
                    1)
                : item.ShippingDate;

        if (proofDisplayDate == FechaTrabajo)
        {
            return new EtapaDia(
                "ProofExtract",
                "Proof Extract",
                proofDisplayDate);
        }

        if (finalDisplayDate == FechaTrabajo)
        {
            return new EtapaDia(
                "FinalExtract",
                "Final Extract",
                finalDisplayDate);
        }

        if (memoDisplayDate == FechaTrabajo &&
            !excluirMemoPorBindPlant)
        {
            return new EtapaDia(
                "MemoExtract",
                "Memo Extract",
                memoDisplayDate);
        }

        if (finalPODisplayDate == FechaTrabajo)
        {
            return new EtapaDia(
                "FinalPO",
                "Final PO Date",
                finalPODisplayDate);
        }

        if (shippingDisplayDate == FechaTrabajo)
        {
            return new EtapaDia(
                "Shipping",
                "Shipping Date",
                shippingDisplayDate);
        }

        if (item.DirxionDate == FechaTrabajo)
        {
            return new EtapaDia(
                "Dirxion",
                "Dirxion Date",
                item.DirxionDate);
        }

        return null;
    }

    private static DateOnly GetNextBusinessDay(
        DateOnly sourceDate)
    {
        if (sourceDate == default)
            return default;

        var result =
            sourceDate.AddDays(1);

        while (result.DayOfWeek is
               DayOfWeek.Saturday or
               DayOfWeek.Sunday)
        {
            result =
                result.AddDays(1);
        }

        return result;
    }

    private static DateOnly GetPreviousWorkDate(
        DateOnly sourceDate,
        int daysBefore)
    {
        if (sourceDate == default)
            return default;

        var result =
            sourceDate.AddDays(-daysBefore);

        while (result.DayOfWeek is
               DayOfWeek.Saturday or
               DayOfWeek.Sunday)
        {
            result =
                result.AddDays(-1);
        }

        return result;
    }

    private static bool EstaEtapaCompletada(
        AsignacionTrabajada? registro,
        string etapaKey)
    {
        if (registro is null)
            return false;

        return etapaKey switch
        {
            "ProofExtract" =>
                registro.ProofExtractWorked,

            "FinalExtract" =>
                registro.FinalExtractWorked,

            "MemoExtract" =>
                registro.MemoExtractWorked,

            "FinalPO" =>
                registro.FinalPOWorked,

            "Shipping" =>
                registro.ShippingWorked,

            "Dirxion" =>
                registro.DirxionWorked,

            _ => false
        };
    }

    private async Task ActualizarFinalizadosPorDirxionAsync(
        AppDbContext db,
        DateOnly today)
    {
        var librosParaFinalizar = await db.Libros
            .ApplyScope(Scope)
            .Include(l => l.Asignaciones)
                .ThenInclude(a => a.Evaluaciones)
            .Where(l =>
                !l.Finalizado &&
                l.DirxionDate < today)
            .ToListAsync();

        if (!librosParaFinalizar.Any())
            return;

        foreach (var libro in librosParaFinalizar)
        {
            libro.Finalizado = true;

            foreach (var asignacion in libro.Asignaciones)
            {
                asignacion.Finalizado = true;

                foreach (var evaluacion in asignacion.Evaluaciones)
                {
                    evaluacion.Finalizado = true;
                }
            }
        }

        await db.SaveChangesAsync();
    }

    private string GetRowKey(
        AsignacionTrackerVm item)
    {
        return
            $"{item.AssignmentId}-" +
            $"{item.StageKey}-" +
            $"{item.StageDate:yyyyMMdd}";
    }

    private void AsegurarRelojActivo()
    {
        if (ClockTask is
            { IsCompleted: false })
        {
            return;
        }

        ClockCancellation?.Dispose();

        ClockCancellation =
            new CancellationTokenSource();

        ClockTask =
            EjecutarRelojAsync(
                ClockCancellation.Token);
    }

    private async Task EjecutarRelojAsync(
        CancellationToken cancellationToken)
    {
        try
        {
            using var timer =
                new PeriodicTimer(
                    TimeSpan.FromSeconds(1));

            while (await timer.WaitForNextTickAsync(
                cancellationToken))
            {
                var fechaActual =
                    ObtenerFechaRepublicaDominicana();

                if (fechaActual != FechaTrabajo)
                {
                    await InvokeAsync(
                        () => CambiarDiaAsync(
                            fechaActual));

                    return;
                }

                await InvokeAsync(
                    StateHasChanged);

                if (!AsignacionesDia.Any(
                    x => x.IsRunning))
                {
                    return;
                }
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private void DetenerRelojSiNoEsNecesario()
    {
        if (AsignacionesDia.Any(x => x.IsRunning))
            return;

        ClockCancellation?.Cancel();
    }

    private async Task CambiarDiaAsync(
        DateOnly nuevaFecha)
    {
        ClockCancellation?.Cancel();

        await EliminarCacheAsync();

        FechaTrabajo =
            nuevaFecha;

        Busqueda =
            string.Empty;

        EtapaFiltro =
            string.Empty;

        AsignacionesDia.Clear();
        AsignacionesFiltradas.Clear();

        await CargarDatosAsync();

        MensajeEsError =
            false;

        Mensaje =
            string.Empty;

        MostrarResultadoTracker(
            "New workday started",
            "The previous local timer history was cleared and today’s assignments were loaded.",
            "warning");

        await PersistirCacheSeguroAsync();

        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        if (ClockCancellation is not null)
        {
            ClockCancellation.Cancel();
        }

        if (ClockTask is not null)
        {
            try
            {
                await ClockTask;
            }
            catch (OperationCanceledException)
            {
            }
        }

        ClockCancellation?.Dispose();
    }

