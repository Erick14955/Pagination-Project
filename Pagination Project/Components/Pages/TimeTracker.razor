@page "/time-tracker"

@using System.Security.Claims
@using System.Security.Cryptography
@using System.Text
@using System.Text.Json
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@using Pagination_Project.Data
@using Pagination_Project.Models
@using Pagination_Project.Services

@attribute [Authorize]
@layout Pagination_Project.Components.Layout.DashboardLayout
@implements IAsyncDisposable

@inject IDbContextFactory<AppDbContext> DbFactory
@inject AuthenticationStateProvider AuthStateProvider
@inject IUserDataScopeService UserDataScopeService
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>Time Tracker</PageTitle>

<div class="time-tracker-page">

    <section class="tracker-hero">
        <div class="tracker-hero-content">
            <span class="tracker-kicker">Daily Productivity</span>

            <h1>Time Tracker</h1>

            <p>
                Track the time spent working on each of today’s assignments.
                Your time is stored locally for the current day.
            </p>

            <div class="tracker-user-info">
                <span class="tracker-user-dot"></span>

                <div>
                    <small>Tracking for</small>
                    <strong>@NombreUsuarioActual</strong>
                </div>
            </div>
        </div>

        <div class="tracker-stats">
            <article class="tracker-stat-card">
                <span>Today’s Assignments</span>
                <strong>@AsignacionesDia.Count</strong>
                <small>@FechaTrabajo.ToString("dd MMM yyyy")</small>
            </article>

            <article class="tracker-stat-card">
                <span>Active Timer</span>

                @if (AsignacionActiva is not null)
                {
                    <strong class="active-stat">Running</strong>
                    <small>@AsignacionActiva.BookName</small>
                }
                else
                {
                    <strong>None</strong>
                    <small>No active assignment</small>
                }
            </article>

            <article class="tracker-stat-card">
                <span>Total Time</span>
                <strong>@FormatoDuracion(TotalSegundosDelDia)</strong>
                <small>@FormatoHorasDecimales(TotalSegundosDelDia) hours</small>
            </article>

            <article class="tracker-stat-card">
                <span>Completed</span>
                <strong>@TotalCompletadas</strong>
                <small>Marked today</small>
            </article>
        </div>
    </section>

    @if (CacheCargado && !CacheDisponible)
    {
        <div class="tracker-alert tracker-alert-warning tracker-storage-warning">
            <span class="tracker-alert-icon">!</span>

            <div class="tracker-alert-content">
                <strong>Local backup unavailable</strong>

                <span>
                    Your timer will continue working while this page remains open,
                    but it may not be restored after signing out or closing the browser.
                </span>
            </div>
        </div>
    }

    <section class="tracker-panel">

        <div class="tracker-toolbar">
            <div class="tracker-filter tracker-search-filter">
                <label for="tracker-search">Search</label>

                <div class="tracker-input-wrapper">
                    <span class="tracker-search-icon">⌕</span>

                    <input id="tracker-search"
                           class="tracker-input tracker-search-input"
                           placeholder="Search by book, KGEN, LSA or stage..."
                           value="@Busqueda"
                           @oninput="OnBusquedaChanged" />
                </div>
            </div>

            <div class="tracker-filter">
                <label for="tracker-stage">Stage</label>

                <select id="tracker-stage"
                        class="tracker-input"
                        value="@EtapaFiltro"
                        @onchange="OnEtapaChanged">

                    <option value="">All Stages</option>
                    <option value="ProofExtract">Proof Extract</option>
                    <option value="FinalExtract">Final Extract</option>
                    <option value="MemoExtract">Memo Extract</option>
                    <option value="FinalPO">Final PO Date</option>
                    <option value="Shipping">Shipping Date</option>
                    <option value="Dirxion">Dirxion Date</option>
                </select>
            </div>

            <div class="tracker-cache-status">
                <span class="cache-status-dot @(CacheDisponible ? "cache-online" : "cache-offline")"></span>

                <div>
                    <strong>
                        @(CacheDisponible
                                                ? "Saved in this browser"
                                                : "Memory only")
                    </strong>

                    <small>
                        @(CacheDisponible
                                                ? "Restored after signing in"
                                                : "Available during this session")
                    </small>
                </div>
            </div>
        </div>

        @if (Cargando || !CacheCargado)
        {
            <div class="tracker-empty-state">
                <div class="tracker-loader"></div>

                <h3>Loading today’s assignments...</h3>

                <p>
                    Restoring your assignments and locally tracked time.
                </p>
            </div>
        }
        else if (!CurrentEmployeeId.HasValue)
        {
            <div class="tracker-empty-state tracker-empty-error">
                <div class="tracker-empty-icon">!</div>

                <h3>No employee profile linked</h3>

                <p>
                    Your user account must be linked to an employee before
                    you can use the Time Tracker.
                </p>
            </div>
        }
        else if (!AsignacionesFiltradas.Any())
        {
            <div class="tracker-empty-state">
                <div class="tracker-empty-icon">✓</div>

                <h3>No assignments found</h3>

                <p>
                    You do not have pending assignments matching the selected
                    filters for today.
                </p>
            </div>
        }
        else
        {
            <div class="tracker-assignment-grid">

                @foreach (var item in AsignacionesFiltradas)
                {
                    var rowKey = GetRowKey(item);
                    var estaGuardando = GuardandoRowKey == rowKey;
                    var segundos = ObtenerSegundosTranscurridos(item);

                    <article class="tracker-assignment-card
                                                    @(item.IsRunning ? "tracker-card-running" : string.Empty)
                                                    @(item.YaCompletada ? "tracker-card-completed" : string.Empty)">

                        <div class="tracker-card-top">
                            <div class="tracker-book-information">
                                <div class="tracker-stage-row">
                                    <span class="tracker-stage-badge stage-@item.StageKey.ToLowerInvariant()">
                                        @item.StageName
                                    </span>

                                    <span class="tracker-status-badge @ObtenerClaseEstado(item)">
                                        @ObtenerNombreEstado(item)
                                    </span>
                                </div>

                                <h2>@item.BookName</h2>

                                <div class="tracker-book-codes">
                                    <span>
                                        <small>KGEN</small>
                                        <strong>@ValorOPlaceholder(item.KgenCode)</strong>
                                    </span>

                                    <span>
                                        <small>LSA</small>
                                        <strong>@ValorOPlaceholder(item.LsaCode)</strong>
                                    </span>

                                    <span>
                                        <small>Department</small>
                                        <strong>@ValorOPlaceholder(item.EmployeeTypeCode)</strong>
                                    </span>
                                </div>
                            </div>

                            <div class="tracker-stage-date">
                                <small>Work date</small>
                                <strong>@item.StageDate.ToString("dd/MM/yyyy")</strong>
                            </div>
                        </div>

                        <div class="tracker-clock-section">
                            <div class="tracker-clock @(item.IsRunning ? "clock-running" : string.Empty)">
                                <span class="tracker-clock-label">
                                    @(item.IsRunning ? "Currently tracking" : "Tracked time")
                                </span>

                                <strong>@FormatoDuracion(segundos)</strong>

                                <span class="tracker-clock-decimal">
                                    @FormatoHorasDecimales(segundos) hours
                                </span>
                            </div>

                            <div class="tracker-time-details">
                                <div>
                                    <span>Minutes</span>
                                    <strong>@FormatoMinutos(segundos)</strong>
                                </div>

                                <div>
                                    <span>Started</span>
                                    <strong>@FormatoHoraInicio(item)</strong>
                                </div>

                                <div>
                                    <span>Finished</span>
                                    <strong>@FormatoHoraFinalizacion(item)</strong>
                                </div>
                            </div>
                        </div>

                        <div class="tracker-card-actions">

                            @if (item.YaCompletada)
                            {
                                <div class="tracker-completed-message">
                                    <span>✓</span>

                                    <div>
                                        <strong>Assignment completed</strong>
                                        <small>
                                            The stage has already been marked as completed.
                                        </small>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <button type="button"
                                        class="tracker-button tracker-button-start"
                                        disabled="@(item.IsRunning || GuardandoRowKey is not null)"
                                        @onclick="() => IniciarAsync(item)">

                                    <span class="button-icon">▶</span>

                                    @(item.AccumulatedSeconds > 0
                                                            ? "Resume"
                                                            : "Start")
                    </button>

                                <button type="button"
                                        class="tracker-button tracker-button-pause"
                                        disabled="@(!item.IsRunning || GuardandoRowKey is not null)"
                                        @onclick="() => PausarAsync(item)">

                                    <span class="button-icon">Ⅱ</span>
                                    Pause
                                </button>

                                <button type="button"
                                        class="tracker-button tracker-button-finish"
                                        disabled="@(GuardandoRowKey is not null)"
                                        @onclick="() => PrepararFinalizacion(item)">

                        @if (estaGuardando)
                                    {
                                        <span class="button-spinner"></span>
                                        <span>Saving...</span>
                                    }
                                    else
                                    {
                                        <span class="button-icon">✓</span>
                                        <span>Finish &amp; Complete</span>
                                    }
                                </button>
                            }
                        </div>
                    </article>
                }

            </div>
        }
    </section>
</div>


@if (MostrarModalConfirmacionFinalizacion &&
     AsignacionPendienteFinalizar is not null)
{
    <div class="tracker-modal-backdrop"
         role="presentation"
         @onclick="CancelarFinalizacion">

        <section class="tracker-modal tracker-confirm-modal"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="tracker-confirm-title"
                 @onclick:stopPropagation="true">

            <div class="tracker-modal-icon tracker-modal-icon-warning"
                 aria-hidden="true">
                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     stroke-linecap="round"
                     stroke-linejoin="round">
                    <path d="M12 9v4"></path>
                    <path d="M12 17h.01"></path>
                    <path d="M10.3 2.9 1.8 17.2A2 2 0 0 0 3.5 20h17a2 2 0 0 0 1.7-2.8L13.7 2.9a2 2 0 0 0-3.4 0Z"></path>
                </svg>
            </div>

            <div class="tracker-modal-copy">
                <span class="tracker-modal-kicker">Finish assignment</span>

                <h2 id="tracker-confirm-title">
                    Complete this stage?
                </h2>

                <p>
                    This action will stop the timer and mark the current stage
                    as worked for today.
                </p>
            </div>

            <div class="tracker-modal-summary">
                <div>
                    <span>Book</span>
                    <strong>@AsignacionPendienteFinalizar.BookName</strong>
                </div>

                <div>
                    <span>Stage</span>
                    <strong>@AsignacionPendienteFinalizar.StageName</strong>
                </div>

                <div>
                    <span>Tracked time</span>
                    <strong>
                        @FormatoDuracion(
                        ObtenerSegundosTranscurridos(
                        AsignacionPendienteFinalizar))
                </strong>
            </div>

            <div>
                <span>Decimal hours</span>
                <strong>
                    @FormatoHorasDecimales(
                                        ObtenerSegundosTranscurridos(
                                        AsignacionPendienteFinalizar))
                </strong>
            </div>
        </div>

        <div class="tracker-modal-warning">
            After completion, this stage cannot be started again from
            the Time Tracker.
        </div>

        <div class="tracker-modal-actions">
            <button type="button"
                    class="tracker-modal-button tracker-modal-button-secondary"
                    disabled="@(GuardandoRowKey is not null)"
                    @onclick="CancelarFinalizacion">
                Cancel
            </button>

            <button type="button"
                    class="tracker-modal-button tracker-modal-button-primary"
                    disabled="@(GuardandoRowKey is not null)"
                    @onclick="ConfirmarFinalizacionAsync">

                @if (GuardandoRowKey is not null)
                    {
                        <span class="button-spinner"></span>
                        <span>Completing...</span>
                    }
                    else
                    {
                        <span>Finish &amp; Complete</span>
                    }
                </button>
            </div>
        </section>
    </div>
}

@if (MostrarModalResultado)
{
    <div class="tracker-modal-backdrop tracker-result-backdrop"
         role="presentation"
         @onclick="CerrarModalResultado">

        <section class="tracker-modal tracker-result-modal @TipoModalResultado"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="tracker-result-title"
                 @onclick:stopPropagation="true">

            <div class="tracker-modal-icon @ClaseIconoModalResultado"
                 aria-hidden="true">

                @if (TipoModalResultado == "success")
                {
                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round"
                         stroke-linejoin="round">
                        <path d="m5 12 4 4L19 6"></path>
                    </svg>
                }
                else if (TipoModalResultado == "warning")
                {
                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round"
                         stroke-linejoin="round">
                        <path d="M12 9v4"></path>
                        <path d="M12 17h.01"></path>
                        <path d="M10.3 2.9 1.8 17.2A2 2 0 0 0 3.5 20h17a2 2 0 0 0 1.7-2.8L13.7 2.9a2 2 0 0 0-3.4 0Z"></path>
                    </svg>
                }
                else
                {
                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round"
                         stroke-linejoin="round">
                        <path d="M18 6 6 18"></path>
                        <path d="m6 6 12 12"></path>
                    </svg>
                }
            </div>

            <div class="tracker-modal-copy">
                <span class="tracker-modal-kicker">
                    @EtiquetaModalResultado
                </span>

                <h2 id="tracker-result-title">
                    @TituloModalResultado
                </h2>

                <p>@MensajeModalResultado</p>
            </div>

            @if (UltimoResultadoAsignacion is not null &&
                    TipoModalResultado == "success")
            {
                <div class="tracker-modal-summary">
                    <div>
                        <span>Book</span>
                        <strong>@UltimoResultadoAsignacion.BookName</strong>
                    </div>

                    <div>
                        <span>Stage</span>
                        <strong>@UltimoResultadoAsignacion.StageName</strong>
                    </div>

                    <div>
                        <span>Total time</span>
                        <strong>
                            @FormatoDuracion(
                            ObtenerSegundosTranscurridos(
                            UltimoResultadoAsignacion))
                </strong>
            </div>

            <div>
                <span>Decimal hours</span>
                <strong>
                    @FormatoHorasDecimales(
                                        ObtenerSegundosTranscurridos(
                                        UltimoResultadoAsignacion))
                </strong>
            </div>
        </div>
                }

            <div class="tracker-modal-actions tracker-result-actions">
                <button type="button"
                        class="tracker-modal-button tracker-modal-button-primary"
                        @onclick="CerrarModalResultado">
                    Continue
                </button>
            </div>
        </section>
    </div>
}

@code {
    private static readonly JsonSerializerOptions JsonOptions =
        new(JsonSerializerDefaults.Web)
        {
            WriteIndented = false
        };

    private static readonly TimeZoneInfo ZonaHorariaRepublicaDominicana =
        ObtenerZonaHorariaRepublicaDominicana();

    private static TimeZoneInfo ObtenerZonaHorariaRepublicaDominicana()
    {
        var timezoneIds = new[]
        {
        "America/Santo_Domingo",

        "SA Western Standard Time"
    };

        foreach (var timezoneId in timezoneIds)
        {
            try
            {
                return TimeZoneInfo.FindSystemTimeZoneById(timezoneId);
            }
            catch (TimeZoneNotFoundException)
            {
            }
            catch (InvalidTimeZoneException)
            {
            }
        }

        return TimeZoneInfo.CreateCustomTimeZone(
            id: "Dominican Republic Standard Time",
            baseUtcOffset: TimeSpan.FromHours(-4),
            displayName: "Dominican Republic Time",
            standardDisplayName: "Dominican Republic Time");
    }

    private static DateTimeOffset ObtenerAhoraRepublicaDominicana()
    {
        return TimeZoneInfo.ConvertTime(
            DateTimeOffset.UtcNow,
            ZonaHorariaRepublicaDominicana);
    }

    private static DateOnly ObtenerFechaRepublicaDominicana()
    {
        return DateOnly.FromDateTime(
            ObtenerAhoraRepublicaDominicana().DateTime);
    }

    private bool Cargando = true;
    private bool CacheCargado;
    private bool CacheDisponible;

    private string Busqueda = string.Empty;
    private string EtapaFiltro = string.Empty;

    private string Mensaje = string.Empty;
    private bool MensajeEsError;

    private bool MostrarModalConfirmacionFinalizacion;
    private bool MostrarModalResultado;

    private string TituloModalResultado = string.Empty;
    private string MensajeModalResultado = string.Empty;
    private string TipoModalResultado = "success";

    private AsignacionTrackerVm? AsignacionPendienteFinalizar;
    private AsignacionTrackerVm? UltimoResultadoAsignacion;

    private string? GuardandoRowKey;

    private string NombreUsuarioActual = "Current user";
    private string CurrentUserStorageKey = string.Empty;

    private Guid? CurrentEmployeeId;

    private UserDataScope Scope { get; set; } = new();

    private DateOnly FechaTrabajo =
        ObtenerFechaRepublicaDominicana();

    private List<AsignacionTrackerVm> AsignacionesDia = new();
    private List<AsignacionTrackerVm> AsignacionesFiltradas = new();

    private CancellationTokenSource? ClockCancellation;
    private Task? ClockTask;

    private string StorageKey =>
        $"pagination-project:time-tracker:{CurrentUserStorageKey}";

    private AsignacionTrackerVm? AsignacionActiva =>
        AsignacionesDia.FirstOrDefault(x => x.IsRunning);

    private int TotalCompletadas =>
        AsignacionesDia.Count(x => x.YaCompletada);

    private long TotalSegundosDelDia =>
        AsignacionesDia.Sum(ObtenerSegundosTranscurridos);

    protected override async Task OnInitializedAsync()
    {
        var authState =
            await AuthStateProvider.GetAuthenticationStateAsync();

        var user = authState.User;

        if (!PuedeAccederAlTimeTracker(user))
        {
            Navigation.NavigateTo(
                "/dashboard",
                replace: true);

            return;
        }

        Scope =
            await UserDataScopeService.GetScopeAsync(user);

        ResolverUsuarioActual(user);

        await CargarDatosAsync();
    }

    private static bool PuedeAccederAlTimeTracker(
    ClaimsPrincipal user)
    {
        var lvlId =
            user.FindFirst("LvlId")?.Value;

        var role =
            user.FindFirst(ClaimTypes.Role)?.Value ??
            user.FindFirst("Role")?.Value ??
            user.FindFirst("RoleName")?.Value ??
            user.FindFirst("PermissionLevel")?.Value ??
            string.Empty;

        return lvlId == "4" ||
               role.Equals(
                   "Employee",
                   StringComparison.OrdinalIgnoreCase) ||
               role.Equals(
                   "Assistant",
                   StringComparison.OrdinalIgnoreCase);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        try
        {
            CacheDisponible = await VerificarLocalStorageAsync();

            if (CacheDisponible)
            {
                await CargarCacheAsync();
            }
        }
        finally
        {
            CacheCargado = true;

            if (AsignacionesDia.Any(x => x.IsRunning))
            {
                AsegurarRelojActivo();
            }

            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task<bool> VerificarLocalStorageAsync()
    {
        if (string.IsNullOrWhiteSpace(CurrentUserStorageKey))
            return false;

        var testKey = $"{StorageKey}:availability-test";

        for (var intento = 1; intento <= 3; intento++)
        {
            try
            {
                await JS.InvokeVoidAsync(
                    "localStorage.setItem",
                    testKey,
                    "available");

                var resultado = await JS.InvokeAsync<string?>(
                    "localStorage.getItem",
                    testKey);

                await JS.InvokeVoidAsync(
                    "localStorage.removeItem",
                    testKey);

                if (resultado == "available")
                    return true;
            }
            catch
            {
                if (intento == 3)
                    return false;

                await Task.Delay(200 * intento);
            }
        }

        return false;
    }

    private void ResolverUsuarioActual(ClaimsPrincipal user)
    {
        NombreUsuarioActual =
            user.Identity?.Name ??
            user.FindFirst(ClaimTypes.Name)?.Value ??
            "Current user";

        CurrentEmployeeId = Scope.EmployeeId;

        if (!CurrentEmployeeId.HasValue ||
            CurrentEmployeeId.Value == Guid.Empty)
        {
            var employeeClaim =
                user.FindFirst("EmployeeId")?.Value ??
                user.FindFirst("Employee_Id")?.Value ??
                user.FindFirst("EmpleadoId")?.Value ??
                user.FindFirst("IdEmpleado")?.Value;

            if (Guid.TryParse(employeeClaim, out var employeeId) &&
                employeeId != Guid.Empty)
            {
                CurrentEmployeeId = employeeId;
            }
        }

        var rawUserId =
            Scope.UserId != Guid.Empty
                ? Scope.UserId.ToString()
                : user.FindFirst(ClaimTypes.NameIdentifier)?.Value ??
                  user.FindFirst("sub")?.Value ??
                  user.FindFirst("UserId")?.Value ??
                  user.FindFirst("User_Id")?.Value ??
                  user.Identity?.Name ??
                  string.Empty;

        if (string.IsNullOrWhiteSpace(rawUserId))
        {
            CacheDisponible = false;
            CurrentUserStorageKey = string.Empty;
            return;
        }

        CurrentUserStorageKey = CrearHashUsuario(rawUserId);
    }

    private static string CrearHashUsuario(string value)
    {
        var bytes = Encoding.UTF8.GetBytes(value);
        var hash = SHA256.HashData(bytes);

        return Convert
            .ToHexString(hash)
            .ToLowerInvariant();
    }

    private async Task CargarDatosAsync()
    {
        Cargando = true;
        Mensaje = string.Empty;

        try
        {
            AsignacionesDia.Clear();

            if (!CurrentEmployeeId.HasValue ||
                CurrentEmployeeId.Value == Guid.Empty)
            {
                AplicarFiltros();
                return;
            }

            await using var db =
                await DbFactory.CreateDbContextAsync();

            await ActualizarFinalizadosPorDirxionAsync(
                db,
                FechaTrabajo);

            var data = await (
                from a in db.Asignaciones.AsNoTracking()
                join l in db.Libros.AsNoTracking()
                    on a.IdLibro equals l.Id
                join e in db.Empleados.AsNoTracking()
                    on a.IdEmpleado equals e.Id
                join et in db.EmployeeTypes.AsNoTracking()
                    on l.EmployeeTypeId equals et.Id

                join bpJoin in db.Bind_Plants.AsNoTracking()
                    on l.BindPlantId equals bpJoin.Id
                    into bindPlantGroup

                from bp in bindPlantGroup.DefaultIfEmpty()

                where !a.Finalizado &&
                      !l.Finalizado &&
                      l.DirxionDate >= FechaTrabajo &&
                      (
                          Scope.ViewAllEmployeeTypes ||
                          l.EmployeeTypeId == Scope.EmployeeTypeId
                      )

                select new RawAssignmentVm
                {
                    AssignmentId = a.Id,
                    EmployeeId = e.Id,
                    BookId = l.Id,

                    EmployeeName = e.Nombre ?? string.Empty,
                    EmployeeTypeId = l.EmployeeTypeId,
                    EmployeeTypeCode = et.Code ?? string.Empty,

                    KgenCode = l.KGENCode ?? string.Empty,
                    LsaCode = l.LSACode ?? string.Empty,
                    BookName = l.BookName ?? string.Empty,

                    ProofExtract = l.ProofExtract,
                    FinalExtract = l.FinalExtract,
                    MemoExtract = l.MemoExtract,
                    DirxionDate = l.DirxionDate,
                    FinalPODate = l.FinalPODate,
                    ShippingDate = l.ShippingDate,

                    BindPlantName =
                        bp != null
                            ? bp.Bind_Plant_Name ?? string.Empty
                            : string.Empty
                }
            ).ToListAsync();

            var assignmentIds = data
                .Select(x => x.AssignmentId)
                .Distinct()
                .ToList();

            var temporalesActivas = assignmentIds.Count == 0
                ? new List<TemporaryAssignment>()
                : await db.TemporaryAssignments
                    .AsNoTracking()
                    .Include(x => x.TemporaryEmployee)
                    .Where(x =>
                        x.Active &&
                        assignmentIds.Contains(x.AssignmentId))
                    .OrderByDescending(x => x.CreatedAt)
                    .ToListAsync();

            var trabajadasHoy = assignmentIds.Count == 0
                ? new List<AsignacionTrabajada>()
                : await db.AsignacionesTrabajadas
                    .AsNoTracking()
                    .Where(x =>
                        assignmentIds.Contains(x.IdAsignacion) &&
                        x.FechaTrabajo == FechaTrabajo)
                    .ToListAsync();

            foreach (var item in data)
            {
                var etapa = ObtenerEtapaDelDia(item);

                if (etapa is null)
                    continue;

                var temporalAplicable = temporalesActivas
                    .FirstOrDefault(x =>
                        x.AssignmentId == item.AssignmentId &&
                        AsignacionTemporalAplicaEtapa(
                            x,
                            etapa.Key));

                var empleadoResponsableId =
                    temporalAplicable?.TemporaryEmployeeId ??
                    item.EmployeeId;

                if (empleadoResponsableId !=
                    CurrentEmployeeId.Value)
                {
                    continue;
                }

                var empleadoResponsableNombre =
                    temporalAplicable?
                        .TemporaryEmployee?
                        .Nombre;

                if (string.IsNullOrWhiteSpace(
                    empleadoResponsableNombre))
                {
                    empleadoResponsableNombre =
                        item.EmployeeName;
                }

                var registroTrabajado = trabajadasHoy
                    .FirstOrDefault(x =>
                        x.IdAsignacion ==
                        item.AssignmentId);

                AsignacionesDia.Add(
                    new AsignacionTrackerVm
                    {
                        AssignmentId =
                            item.AssignmentId,

                        EmployeeId =
                            empleadoResponsableId,

                        BookId =
                            item.BookId,

                        EmployeeName =
                            empleadoResponsableNombre ??
                            string.Empty,

                        EmployeeTypeId =
                            item.EmployeeTypeId,

                        EmployeeTypeCode =
                            item.EmployeeTypeCode,

                        KgenCode =
                            item.KgenCode,

                        LsaCode =
                            item.LsaCode,

                        BookName =
                            item.BookName,

                        StageKey =
                            etapa.Key,

                        StageName =
                            etapa.Name,

                        StageDate =
                            etapa.Date,

                        YaCompletada =
                            EstaEtapaCompletada(
                                registroTrabajado,
                                etapa.Key)
                    });
            }

            AplicarFiltros();
        }
        catch (Exception ex)
        {
            MensajeEsError =
                true;

            Mensaje =
                string.Empty;

            MostrarResultadoTracker(
                "Assignments could not be loaded",
                $"Details: {ex.Message}",
                "error");
        }
        finally
        {
            Cargando = false;
        }
    }

    private async Task CargarCacheAsync()
    {
        if (string.IsNullOrWhiteSpace(
            CurrentUserStorageKey))
        {
            CacheDisponible = false;
            return;
        }

        try
        {
            var json = await JS.InvokeAsync<string?>(
                "localStorage.getItem",
                StorageKey);

            if (string.IsNullOrWhiteSpace(json))
            {
                CacheDisponible = true;
                return;
            }

            var estado = JsonSerializer.Deserialize<TrackerCacheState>(
                json,
                JsonOptions);

            var fechaEsperada =
                FechaTrabajo.ToString("yyyy-MM-dd");

            if (estado is null ||
                !string.Equals(
                    estado.UserKey,
                    CurrentUserStorageKey,
                    StringComparison.Ordinal) ||
                !string.Equals(
                    estado.WorkDate,
                    fechaEsperada,
                    StringComparison.Ordinal))
            {
                await EliminarCacheAsync();
                return;
            }

            var cacheFueNormalizado = false;

            foreach (var item in AsignacionesDia)
            {
                var rowKey = GetRowKey(item);

                var guardado = estado.Items
                    .FirstOrDefault(x =>
                        x.RowKey == rowKey);

                if (guardado is null)
                    continue;

                item.AccumulatedSeconds =
                    Math.Max(
                        0,
                        guardado.AccumulatedSeconds);

                item.IsRunning =
                    guardado.IsRunning;

                item.StartedAtUtc =
                    guardado.StartedAtUtc;

                item.FinishedAtUtc =
                    guardado.FinishedAtUtc;

                if (item.IsRunning &&
                    !item.StartedAtUtc.HasValue)
                {
                    item.IsRunning = false;
                    cacheFueNormalizado = true;
                }

                if (item.YaCompletada &&
                    item.IsRunning)
                {
                    PausarInternamente(
                        item,
                        DateTimeOffset.UtcNow);

                    cacheFueNormalizado = true;
                }
            }

            var cronometrosActivos = AsignacionesDia
                .Where(x => x.IsRunning)
                .OrderByDescending(x => x.StartedAtUtc)
                .ToList();

            if (cronometrosActivos.Count > 1)
            {
                var ahora =
                    DateTimeOffset.UtcNow;

                foreach (var extra in cronometrosActivos.Skip(1))
                {
                    PausarInternamente(extra, ahora);
                }

                cacheFueNormalizado = true;
            }

            if (cacheFueNormalizado)
            {
                await GuardarCacheAsync();
            }

            CacheDisponible = true;
        }
        catch (JSDisconnectedException)
        {
            CacheDisponible = false;
        }
        catch (InvalidOperationException)
        {
            CacheDisponible = false;
        }
        catch
        {
            CacheDisponible = false;
        }
    }

    private async Task GuardarCacheAsync()
    {
        if (string.IsNullOrWhiteSpace(
            CurrentUserStorageKey))
        {
            return;
        }

        var estado = new TrackerCacheState
        {
            UserKey =
                CurrentUserStorageKey,

            WorkDate =
                FechaTrabajo.ToString("yyyy-MM-dd"),

            Items = AsignacionesDia
                .Select(item =>
                    new TrackerCacheItem
                    {
                        RowKey =
                            GetRowKey(item),

                        AccumulatedSeconds =
                            item.AccumulatedSeconds,

                        IsRunning =
                            item.IsRunning,

                        StartedAtUtc =
                            item.StartedAtUtc,

                        FinishedAtUtc =
                            item.FinishedAtUtc
                    })
                .ToList()
        };

        var json = JsonSerializer.Serialize(
            estado,
            JsonOptions);

        await JS.InvokeVoidAsync(
            "localStorage.setItem",
            StorageKey,
            json);
    }

    private async Task PersistirCacheSeguroAsync()
    {
        if (!CacheDisponible)
            return;

        for (var intento = 1; intento <= 2; intento++)
        {
            try
            {
                await GuardarCacheAsync();
                CacheDisponible = true;
                return;
            }
            catch
            {
                if (intento == 2)
                {
                    CacheDisponible = false;
                    await InvokeAsync(StateHasChanged);
                    return;
                }

                await Task.Delay(150);
            }
        }
    }

    private async Task EliminarCacheAsync()
    {
        if (string.IsNullOrWhiteSpace(
            CurrentUserStorageKey))
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync(
                "localStorage.removeItem",
                StorageKey);
        }
        catch
        {
            CacheDisponible = false;
        }
    }

    private async Task IniciarAsync(
        AsignacionTrackerVm item)
    {
        if (item.YaCompletada ||
            item.IsRunning ||
            GuardandoRowKey is not null)
        {
            return;
        }

        Mensaje = string.Empty;

        var ahora =
            DateTimeOffset.UtcNow;

        foreach (var activa in AsignacionesDia
            .Where(x =>
                x.IsRunning &&
                x != item))
        {
            PausarInternamente(
                activa,
                ahora);
        }

        item.StartedAtUtc =
            ahora;

        item.FinishedAtUtc =
            null;

        item.IsRunning =
            true;

        await PersistirCacheSeguroAsync();

        AsegurarRelojActivo();
    }

    private async Task PausarAsync(
        AsignacionTrackerVm item)
    {
        if (!item.IsRunning ||
            GuardandoRowKey is not null)
        {
            return;
        }

        PausarInternamente(
            item,
            DateTimeOffset.UtcNow);

        await PersistirCacheSeguroAsync();

        DetenerRelojSiNoEsNecesario();
    }

    private void PausarInternamente(
        AsignacionTrackerVm item,
        DateTimeOffset momento)
    {
        if (!item.IsRunning)
            return;

        if (item.StartedAtUtc.HasValue)
        {
            var diferencia =
                momento -
                item.StartedAtUtc.Value;

            if (diferencia.TotalSeconds > 0)
            {
                item.AccumulatedSeconds +=
                    (long)Math.Floor(
                        diferencia.TotalSeconds);
            }
        }

        item.IsRunning =
            false;

        item.StartedAtUtc =
            null;
    }

    private void PrepararFinalizacion(
        AsignacionTrackerVm item)
    {
        if (item.YaCompletada ||
            GuardandoRowKey is not null)
        {
            return;
        }

        AsignacionPendienteFinalizar =
            item;

        MostrarModalConfirmacionFinalizacion =
            true;
    }

    private void CancelarFinalizacion()
    {
        if (GuardandoRowKey is not null)
            return;

        MostrarModalConfirmacionFinalizacion =
            false;

        AsignacionPendienteFinalizar =
            null;
    }

    private async Task ConfirmarFinalizacionAsync()
    {
        var item =
            AsignacionPendienteFinalizar;

        if (item is null ||
            GuardandoRowKey is not null)
        {
            return;
        }

        MostrarModalConfirmacionFinalizacion =
            false;

        AsignacionPendienteFinalizar =
            null;

        await FinalizarAsync(item);
    }

    private async Task FinalizarAsync(
        AsignacionTrackerVm item)
    {
        if (item.YaCompletada ||
            GuardandoRowKey is not null)
        {
            return;
        }

        var rowKey =
            GetRowKey(item);

        GuardandoRowKey =
            rowKey;

        Mensaje =
            string.Empty;

        try
        {
            var ahora =
                DateTimeOffset.UtcNow;

            if (item.IsRunning)
            {
                PausarInternamente(
                    item,
                    ahora);
            }

            await PersistirCacheSeguroAsync();

            await MarcarEtapaCompletadaAsync(item);

            item.YaCompletada =
                true;

            item.FinishedAtUtc =
                ahora;

            await PersistirCacheSeguroAsync();

            MensajeEsError =
                false;

            Mensaje =
                string.Empty;

            UltimoResultadoAsignacion =
                item;

            MostrarResultadoTracker(
                "Assignment completed",
                $"{item.BookName} was completed successfully.",
                "success");
        }
        catch (Exception ex)
        {
            MensajeEsError =
                true;

            Mensaje =
                string.Empty;

            UltimoResultadoAsignacion =
                null;

            MostrarResultadoTracker(
                "Assignment could not be completed",
                $"Details: {ex.Message}",
                "error");
        }
        finally
        {
            GuardandoRowKey =
                null;

            DetenerRelojSiNoEsNecesario();
        }
    }

