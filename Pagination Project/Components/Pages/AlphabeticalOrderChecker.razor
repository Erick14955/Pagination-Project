@page "/alphabetical-order-checker"

@using System.Globalization
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Pagination_Project.Models
@using Pagination_Project.Services

@attribute [Authorize]
@layout Pagination_Project.Components.Layout.DashboardLayout

@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation
@inject IPsAlphabeticalCheckerService CheckerService

<PageTitle>Alphabetical Order Checker</PageTitle>

<div class="alpha-checker-page">
    @if (!_accessValidated)
    {
        <section class="alpha-loading-card">
            <div class="alpha-spinner"></div>
            <span>Validating access...</span>
        </section>
    }
    else
    {
        <section class="alpha-hero">
            <div class="alpha-hero-copy">
                <span class="alpha-kicker">Pagination Quality Tool</span>

                <h1>Alphabetical Order Checker</h1>

                <p>
                    Upload one or multiple PostScript files that belong to the same book.
                    The checker reads them as one continuous book and identifies listings
                    that break the expected alphabetical sequence. Listings that start
                    with numbers are alphabetized by their English number words.
                </p>
            </div>

            <div class="alpha-hero-actions">
                <div class="alpha-user-pill">
                    <span>Authorized employee</span>
                    <strong>@_currentUsername</strong>
                </div>

                <button type="button"
                        class="alpha-button alpha-button-primary alpha-analyze-top"
                        disabled="@(_analyzing || _files.Count == 0)"
                        @onclick="AnalyzeAsync">

                    @if (_analyzing)
                    {
                        <span class="alpha-inline-spinner"></span>
                        <span>Analyzing book...</span>
                    }
                    else
                    {
                        <span>Start analysis</span>
                    }
                </button>
            </div>
        </section>

        <section class="alpha-card">
            <div class="alpha-section-heading">
                <div>
                    <span class="alpha-step">1</span>

                    <div>
                        <h2>Select the book files</h2>

                        <p>
                            Choose all .ps parts of the same book.
                            You can reorder them before analyzing.
                        </p>
                    </div>
                </div>

                @if (_files.Count > 0)
                {
                    <button type="button"
                            class="alpha-button alpha-button-ghost"
                            @onclick="ClearFiles"
                            disabled="@_analyzing">
                        Clear
                    </button>
                }
            </div>

            <label class="alpha-drop-zone @(_analyzing ? "disabled" : string.Empty)">
                <InputFile OnChange="HandleFilesSelected"
                           multiple
                           accept=".ps,application/postscript"
                           disabled="@_analyzing" />

                <span class="alpha-drop-icon">PS</span>

                <strong>Choose .ps files</strong>

                <span>Select multiple files at once</span>

                <small>Maximum 250 files, 250 MB per file</small>
            </label>

            @if (!string.IsNullOrWhiteSpace(_selectionError))
            {
                <div class="alpha-alert alpha-alert-error">
                    @_selectionError
                </div>
            }

            @if (_files.Count > 0)
            {
                <div class="alpha-book-sequence">
                    <div class="alpha-sequence-header">
                        <div>
                            <h3>Book sequence</h3>

                            <p>
                                The first file below is treated as the beginning of the book.
                            </p>
                        </div>

                        <div class="alpha-sequence-actions">
                            <span>
                                @_files.Count file@(_files.Count == 1 ? string.Empty : "s")
                            </span>

                            <button type="button"
                                    class="alpha-button alpha-button-ghost alpha-toggle-files"
                                    disabled="@_analyzing"
                                    @onclick="ToggleFileList">
                                @(_showFileList ? "Hide .PS files" : "Show .PS files")
                            </button>
                        </div>
                    </div>

                    @if (_showFileList)
                    {
                        <div class="alpha-file-list">
                            @for (var index = 0; index < _files.Count; index++)
                            {
                                var currentIndex = index;
                                var item = _files[index];

                                <div class="alpha-file-row" @key="item.Id">
                                    <div class="alpha-file-order">
                                        @(index + 1)
                                    </div>

                                    <div class="alpha-file-info">
                                        <strong>@item.File.Name</strong>
                                        <span>@FormatBytes(item.File.Size)</span>
                                    </div>

                                    <div class="alpha-file-actions">
                                        <button type="button"
                                                title="Move up"
                                                disabled="@(currentIndex == 0 || _analyzing)"
                                                @onclick="() => MoveFile(currentIndex, -1)">
                                            ↑
                                        </button>

                                        <button type="button"
                                                title="Move down"
                                                disabled="@(currentIndex == _files.Count - 1 || _analyzing)"
                                                @onclick="() => MoveFile(currentIndex, 1)">
                                            ↓
                                        </button>

                                        <button type="button"
                                                title="Remove"
                                                disabled="@_analyzing"
                                                @onclick="() => RemoveFile(currentIndex)">
                                            ×
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </section>

        @if (!string.IsNullOrWhiteSpace(_analysisError))
        {
            <section class="alpha-alert alpha-alert-error alpha-result-alert">
                <strong>Analysis could not be completed.</strong>
                <span>@_analysisError</span>
            </section>
        }

        @if (_result is not null)
        {
            <section class="alpha-results-section">

                <div class="alpha-stats-grid">
                    <article class="alpha-stat-card">
                        <span>Files</span>
                        <strong>@_result.FilesAnalyzed</strong>
                        <small>book parts analyzed</small>
                    </article>

                    <article class="alpha-stat-card">
                        <span>Pages</span>
                        <strong>@_result.PagesAnalyzed</strong>
                        <small>pages processed</small>
                    </article>

                    <article class="alpha-stat-card">
                        <span>Listings</span>
                        <strong>@_result.ListingsAnalyzed</strong>
                        <small>listings detected</small>
                    </article>

                    <article class="alpha-stat-card @(_result.Errors.Count > 0 ? "alpha-stat-error" : "alpha-stat-success")">
                        <span>Out of order</span>
                        <strong>@_result.Errors.Count</strong>
                        <small>listings to review</small>
                    </article>
                </div>

                @if (_result.Warnings.Count > 0)
                {
                    <div class="alpha-warning-box">
                        <strong>Processing notes</strong>

                        <ul>
                            @foreach (var warning in _result.Warnings)
                            {
                                <li>@warning</li>
                            }
                        </ul>
                    </div>
                }

                @if (_result.IsCorrect &&
                        _result.ListingsAnalyzed > 0)
                {
                    <div class="alpha-success-panel">
                        <div class="alpha-success-icon">✓</div>

                        <div>
                            <h2>Alphabetical order is correct</h2>

                            <p>
                                No listings were detected breaking the expected alphabetical sequence.
                            </p>
                        </div>
                    </div>
                }
                else if (_result.Errors.Count > 0)
                {
                    <div class="alpha-errors-heading">
                        <div>
                            <span class="alpha-kicker">
                                Corrections recommended
                            </span>

                            <h2>
                                @_result.Errors.Count listing@(_result.Errors.Count == 1 ? string.Empty : "s") out of order
                            </h2>
                        </div>
                    </div>

                    <section class="alpha-card" style="margin-bottom: 24px;">
                        <div style="display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; flex-wrap: wrap;">

                            <div style="display: flex; flex-direction: column; gap: 8px; min-width: 260px;">
                                <label for="alpha-page-filter"
                                       style="font-size: 13px; font-weight: 800; text-transform: uppercase; letter-spacing: .04em;">
                                    Filter by page
                                </label>

                                <select id="alpha-page-filter"
                                        @bind="_selectedPage"
                                        style="min-height: 48px; min-width: 260px; padding: 0 42px 0 14px; border: 1px solid #d7dfeb; border-radius: 12px; background: #ffffff; color: #182235; font-size: 15px; font-weight: 600; cursor: pointer; outline: none;">

                                    <option value="">
                                        All pages
                                    </option>

                                    @foreach (var pageNumber in ErrorPages)
                                    {
                                        <option value="@pageNumber">
                                            Page @pageNumber
                                        </option>
                                    }
                                </select>
                            </div>

                            <div style="min-width: 150px; padding: 12px 16px; border-radius: 12px; background: #f5f7fa; text-align: center;">
                                <span style="display: block; color: #718096; font-size: 12px; font-weight: 700; text-transform: uppercase;">
                                    Showing
                                </span>

                                <strong style="display: block; margin-top: 3px; font-size: 22px;">
                                    @FilteredErrors.Count
                                </strong>

                                <small style="color: #718096;">
                                    result@(FilteredErrors.Count == 1 ? string.Empty : "s")
                                </small>
                            </div>
                        </div>
                    </section>

                    @if (FilteredErrors.Count == 0)
                    {
                        <div class="alpha-success-panel">
                            <div class="alpha-success-icon">✓</div>

                            <div>
                                <h2>No errors on this page</h2>

                                <p>
                                    No out-of-order listings were detected for the selected page.
                                </p>
                            </div>
                        </div>
                    }
                    else
                    {
                        @foreach (var pageGroup in FilteredErrorGroups)
                        {
                            <section style="margin-bottom: 38px;">

                                <div style="display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 16px;">
                                    <div>
                                        <span class="alpha-kicker">
                                            Page
                                        </span>

                                        <h2 style="margin: 3px 0 0 0;">
                                            Page @pageGroup.Page
                                        </h2>
                                    </div>

                                    <span style="display: inline-flex; align-items: center; justify-content: center; min-width: 100px; padding: 8px 14px; border: 1px solid #ffd2d2; border-radius: 999px; background: #fff2f2; color: #c62828; font-size: 13px; font-weight: 800;">
                                        @pageGroup.Errors.Count error@(pageGroup.Errors.Count == 1 ? string.Empty : "s")
                                    </span>
                                </div>

                                <div class="alpha-error-list">

                                    @foreach (var error in pageGroup.Errors)
                                    {
                                        <article class="alpha-error-card">

                                            <div class="alpha-error-title">
                                                <span class="alpha-error-badge">
                                                    OUT OF ORDER
                                                </span>

                                                <h3>
                                                    @error.ListingName
                                                </h3>
                                            </div>

                                            <div class="alpha-location-grid">

                                                <div class="alpha-location-current">
                                                    <span class="alpha-location-label">
                                                        Current location
                                                    </span>

                                                    <dl>
                                                        <div>
                                                            <dt>File</dt>
                                                            <dd>@error.CurrentFile</dd>
                                                        </div>

                                                        <div>
                                                            <dt>Page</dt>
                                                            <dd>@error.CurrentPage</dd>
                                                        </div>

                                                        <div>
                                                            <dt>Position on page</dt>
                                                            <dd>@error.CurrentPositionInPage</dd>
                                                        </div>
                                                    </dl>
                                                </div>

                                                <div class="alpha-location-arrow">
                                                    →
                                                </div>

                                                <div class="alpha-location-recommended">
                                                    <span class="alpha-location-label">
                                                        Recommended location
                                                    </span>

                                                    <dl>
                                                        <div>
                                                            <dt>File</dt>
                                                            <dd>@error.RecommendedFile</dd>
                                                        </div>

                                                        <div>
                                                            <dt>Page</dt>
                                                            <dd>@error.RecommendedPage</dd>
                                                        </div>

                                                        <div>
                                                            <dt>Position on page</dt>
                                                            <dd>@error.RecommendedPositionInPage</dd>
                                                        </div>
                                                    </dl>
                                                </div>
                                            </div>

                                            <div class="alpha-placement-box">
                                                <span>
                                                    Recommended placement
                                                </span>

                                                @if (!string.IsNullOrWhiteSpace(error.ShouldGoAfter) &&
                                                                        !string.IsNullOrWhiteSpace(error.ShouldGoBefore))
                                                {
                                                    <p>
                                                        Place
                                                        <strong>@error.ListingName</strong>
                                                        directly below
                                                        <strong>@error.ShouldGoAfter</strong>
                                                        and before
                                                        <strong>@error.ShouldGoBefore</strong>.
                                                    </p>
                                                }
                                                else if (!string.IsNullOrWhiteSpace(error.ShouldGoAfter))
                                                {
                                                    <p>
                                                        Place
                                                        <strong>@error.ListingName</strong>
                                                        directly below
                                                        <strong>@error.ShouldGoAfter</strong>.
                                                    </p>
                                                }
                                                else if (!string.IsNullOrWhiteSpace(error.ShouldGoBefore))
                                                {
                                                    <p>
                                                        Place
                                                        <strong>@error.ListingName</strong>
                                                        before
                                                        <strong>@error.ShouldGoBefore</strong>
                                                        at the beginning of the sequence.
                                                    </p>
                                                }
                                            </div>
                                        </article>
                                    }
                                </div>
                            </section>
                        }
                    }
                }
            </section>
        }
    }

    @if (_showAnalysisModal &&
        _result is not null)
    {
        <div class="alpha-modal-backdrop"
             role="presentation">

            <section class="alpha-modal"
                     role="dialog"
                     aria-modal="true"
                     aria-labelledby="alpha-analysis-summary-title">

                <div class="alpha-modal-header">
                    <div>
                        <span class="alpha-kicker">
                            Analysis complete
                        </span>

                        <h2 id="alpha-analysis-summary-title">
                            Book analysis summary
                        </h2>
                    </div>

                    <button type="button"
                            class="alpha-modal-close"
                            title="Close"
                            @onclick="CloseAnalysisModal">
                        ×
                    </button>
                </div>

                <div class="alpha-modal-summary-grid">

                    <div>
                        <span>Files</span>
                        <strong>@_result.FilesAnalyzed</strong>
                    </div>

                    <div>
                        <span>Pages</span>
                        <strong>@_result.PagesAnalyzed</strong>
                    </div>

                    <div>
                        <span>Listings</span>
                        <strong>@_result.ListingsAnalyzed</strong>
                    </div>

                    <div class="@(_result.Errors.Count > 0 ? "alpha-modal-summary-error" : "alpha-modal-summary-success")">
                        <span>Out of order</span>
                        <strong>@_result.Errors.Count</strong>
                    </div>
                </div>

                @if (_result.Errors.Count == 0)
                {
                    <div class="alpha-modal-message alpha-modal-message-success">
                        <strong>
                            Alphabetical order looks correct.
                        </strong>

                        <span>
                            No listings were detected breaking the expected alphabetical sequence.
                        </span>
                    </div>
                }
                else
                {
                    <div class="alpha-modal-message alpha-modal-message-warning">
                        <strong>
                            @_result.Errors.Count listing@(_result.Errors.Count == 1 ? string.Empty : "s") need review.
                        </strong>

                        <span>
                            Results are grouped by page and can be filtered using the page selector.
                        </span>
                    </div>
                }

                @if (_result.Warnings.Count > 0)
                {
                    <p class="alpha-modal-note">
                        There are also @_result.Warnings.Count processing note@(_result.Warnings.Count == 1 ? string.Empty : "s") to review.
                    </p>
                }

                <div class="alpha-modal-actions">
                    <button type="button"
                            class="alpha-button alpha-button-primary"
                            @onclick="CloseAnalysisModal">
                        View results
                    </button>
                </div>

            </section>
        </div>
    }
</div>

@code {
    private const int MaxFiles = 250;

    private readonly List<SelectedPsFile> _files = [];

    private PsBookAnalysisResult? _result;

    private bool _accessValidated;
    private bool _analyzing;
    private bool _showFileList = true;
    private bool _showAnalysisModal;

    private string? _selectionError;
    private string? _analysisError;

    private string _selectedPage = string.Empty;
    private string _currentUsername = "Employee";

    private IReadOnlyList<string> ErrorPages
    {
        get
        {
            if (_result is null)
            {
                return [];
            }

            return _result.Errors
                .Select(x => x.CurrentPage)
                .Where(x => !string.IsNullOrWhiteSpace(x))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(GetPageNumberForSorting)
                .ThenBy(x => x, StringComparer.OrdinalIgnoreCase)
                .ToList();
        }
    }

    private IReadOnlyList<PsListingOrderError> FilteredErrors
    {
        get
        {
            if (_result is null)
            {
                return [];
            }

            IEnumerable<PsListingOrderError> query =
                _result.Errors;

            if (!string.IsNullOrWhiteSpace(_selectedPage))
            {
                query =
                    query.Where(
                        x =>
                            string.Equals(
                                x.CurrentPage,
                                _selectedPage,
                                StringComparison.OrdinalIgnoreCase));
            }

            return query
                .OrderBy(
                    x =>
                        GetPageNumberForSorting(
                            x.CurrentPage))
                .ThenBy(
                    x =>
                        x.CurrentPositionInPage)
                .ToList();
        }
    }

    private IReadOnlyList<PageErrorGroup> FilteredErrorGroups
    {
        get
        {
            return FilteredErrors
                .GroupBy(
                    x =>
                        x.CurrentPage)
                .Select(
                    group =>
                        new PageErrorGroup(
                            group.Key,
                            group
                                .OrderBy(
                                    x =>
                                        x.CurrentPositionInPage)
                                .ToList()))
                .OrderBy(
                    x =>
                        GetPageNumberForSorting(
                            x.Page))
                .ThenBy(
                    x =>
                        x.Page,
                    StringComparer.OrdinalIgnoreCase)
                .ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var authState =
            await AuthenticationStateProvider
                .GetAuthenticationStateAsync();

        var user =
            authState.User;

        if (user.Identity?.IsAuthenticated != true ||
            !HasAlphabeticalCheckerAccess(user))
        {
            Navigation.NavigateTo(
                "/dashboard",
                replace: true);

            return;
        }

        _currentUsername =
            user.FindFirst("Username")?.Value ??
            user.Identity?.Name ??
            "Employee";

        _accessValidated = true;
    }

    private static bool HasAlphabeticalCheckerAccess(
        ClaimsPrincipal user)
    {
        var lvlId =
            user.FindFirst("LvlId")?.Value;

        var role =
            user.FindFirst(ClaimTypes.Role)?.Value ??
            user.FindFirst("Role")?.Value ??
            user.FindFirst("RoleName")?.Value ??
            user.FindFirst("PermissionLevel")?.Value ??
            string.Empty;

        return lvlId == "4" ||
               lvlId == "3" ||
               role.Equals(
                   "Employee",
                   StringComparison.OrdinalIgnoreCase) ||
               role.Equals(
                   "Assistant",
                   StringComparison.OrdinalIgnoreCase);
    }

    private void HandleFilesSelected(
        InputFileChangeEventArgs args)
    {
        _selectionError = null;
        _analysisError = null;
        _result = null;
        _selectedPage = string.Empty;
        _showAnalysisModal = false;
        _showFileList = true;

        IReadOnlyList<IBrowserFile> selected;

        try
        {
            selected =
                args.GetMultipleFiles(
                    MaxFiles);
        }
        catch (InvalidOperationException)
        {
            _selectionError =
                $"You can select a maximum of {MaxFiles} files at once.";

            return;
        }

        foreach (var file in selected)
        {
            if (!file.Name.EndsWith(
                    ".ps",
                    StringComparison.OrdinalIgnoreCase))
            {
                _selectionError =
                    $"'{file.Name}' was ignored because it is not a .ps file.";

                continue;
            }

            if (_files.Any(
                    x =>
                        x.File.Name.Equals(
                            file.Name,
                            StringComparison.OrdinalIgnoreCase)
                        &&
                        x.File.Size ==
                        file.Size))
            {
                continue;
            }

            if (_files.Count >= MaxFiles)
            {
                _selectionError =
                    $"You can select a maximum of {MaxFiles} files.";

                break;
            }

            _files.Add(
                new SelectedPsFile(
                    Guid.NewGuid(),
                    file));
        }
    }

    private void MoveFile(
        int index,
        int offset)
    {
        var destination =
            index + offset;

        if (index < 0 ||
            index >= _files.Count ||
            destination < 0 ||
            destination >= _files.Count)
        {
            return;
        }

        (
            _files[index],
            _files[destination]
        ) =
        (
            _files[destination],
            _files[index]
        );

        _result = null;
        _selectedPage = string.Empty;
        _showAnalysisModal = false;
        _analysisError = null;
    }

    private void RemoveFile(
        int index)
    {
        if (index < 0 ||
            index >= _files.Count)
        {
            return;
        }

        _files.RemoveAt(index);

        _result = null;
        _selectedPage = string.Empty;
        _showAnalysisModal = false;
        _analysisError = null;
    }

    private void ClearFiles()
    {
        _files.Clear();

        _result = null;
        _selectedPage = string.Empty;
        _showAnalysisModal = false;
        _showFileList = true;
        _selectionError = null;
        _analysisError = null;
    }

    private async Task AnalyzeAsync()
    {
        if (_files.Count == 0 ||
            _analyzing)
        {
            return;
        }

        _analyzing = true;
        _analysisError = null;
        _result = null;
        _selectedPage = string.Empty;
        _showAnalysisModal = false;

        try
        {
            _result =
                await CheckerService
                    .AnalyzeBookAsync(
                        _files
                            .Select(x => x.File)
                            .ToList());

            _showFileList = false;
            _showAnalysisModal = true;
        }
        catch (Exception ex)
        {
            _analysisError =
                ex.Message;
        }
        finally
        {
            _analyzing = false;
        }
    }

    private void ToggleFileList()
    {
        _showFileList =
            !_showFileList;
    }

    private void CloseAnalysisModal()
    {
        _showAnalysisModal = false;
    }

    private static int GetPageNumberForSorting(
        string pageNumber)
    {
        return int.TryParse(
            pageNumber,
            NumberStyles.Integer,
            CultureInfo.InvariantCulture,
            out var value)
                ? value
                : int.MaxValue;
    }

    private static string FormatBytes(
        long bytes)
    {
        string[] units =
        [
            "B",
            "KB",
            "MB",
            "GB"
        ];

        var size =
            (double)bytes;

        var unit = 0;

        while (size >= 1024 &&
               unit < units.Length - 1)
        {
            size /= 1024;
            unit++;
        }

        return $"{size:0.##} {units[unit]}";
    }

    private sealed record SelectedPsFile(
        Guid Id,
        IBrowserFile File);

    private sealed record PageErrorGroup(
        string Page,
        IReadOnlyList<PsListingOrderError> Errors);
}