    }

    private static int ContarGrupoSystem(Permisos item)
    {
        return Contar(item.EditPermissionLevels) +
               Contar(item.ViewAllEmployeeTypes);
    }

    private int ContarTotalPermisos(Permisos item)
    {
        return ContarGrupoUsers(item) +
               ContarGrupoBooks(item) +
               ContarGrupoAssignments(item) +
               ContarGrupoEvaluations(item) +
               ContarGrupoEmployees(item) +
               ContarGrupoLateWork(item) +
               ContarGrupoSystem(item);
    }

