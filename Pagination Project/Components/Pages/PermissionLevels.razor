    private static int Contar(bool valor)
    {
        return valor ? 1 : 0;
    }

    private int ContarGrupoUsers(Permisos item)
    {
        return Contar(item.CreateUser) +
               Contar(item.EditUser) +
               Contar(item.DeleteUser) +
               Contar(PuedeAdministrarUnlockUsers && item.UnlockUsers);
    }

    private static int ContarGrupoBooks(Permisos item)
    {
        return Contar(item.CreateBook) +
               Contar(item.EditBook) +
               Contar(item.DeleteBook) +
               Contar(item.BooksView);
    }

