    private void MostrarMensaje(string mensaje, string tipo)
    {
        Mensaje = mensaje;
        TipoMensaje = tipo;

        MostrarResultadoPermiso(
            ObtenerTituloResultado(mensaje, tipo),
            mensaje,
            tipo);
    }

    private static string ObtenerTituloResultado(string mensaje, string tipo)
    {
        if (string.Equals(tipo, "error", StringComparison.OrdinalIgnoreCase))
        {
            if (mensaje.Contains("not found", StringComparison.OrdinalIgnoreCase))
                return "Permission level not found";

            if (mensaje.Contains("already exists", StringComparison.OrdinalIgnoreCase))
                return "Duplicate permission level";

            if (mensaje.Contains("assigned to one or more users", StringComparison.OrdinalIgnoreCase))
                return "Permission level in use";

            return "Unable to complete action";
        }

        if (mensaje.Contains("created", StringComparison.OrdinalIgnoreCase))
            return "Permission level created";

        if (mensaje.Contains("updated", StringComparison.OrdinalIgnoreCase))
            return "Permission level updated";

        if (mensaje.Contains("deleted", StringComparison.OrdinalIgnoreCase))
            return "Permission level deleted";

        return "Permission Levels";
    }

    private void MostrarResultadoPermiso(string titulo, string mensaje, string tipo)
    {
        TituloModalResultadoPermiso = titulo;
        MensajeModalResultadoPermiso = mensaje;
        TipoModalResultadoPermiso = string.Equals(
            tipo,
            "error",
            StringComparison.OrdinalIgnoreCase)
                ? "error"
                : "success";

        MostrarModalResultadoPermiso = true;
    }

    private void CerrarModalResultadoPermiso()
    {
        MostrarModalResultadoPermiso = false;
        TituloModalResultadoPermiso = string.Empty;
        MensajeModalResultadoPermiso = string.Empty;
        TipoModalResultadoPermiso = "success";
    }

    private void LimpiarMensaje()
    {
        Mensaje = string.Empty;
        TipoMensaje = "success";
    }

