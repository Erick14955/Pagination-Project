@page "/permission-levels"
@page "/permisos"
@page "/niveles-permisos"

@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using Pagination_Project.Data
@using Pagination_Project.Models
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims

@attribute [Authorize]
@layout Pagination_Project.Components.Layout.DashboardLayout

@inject IDbContextFactory<AppDbContext> DbFactory
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Permission Levels</PageTitle>

<div class="permissions-page">

    <section class="page-hero">
        <div>
            <h1>Permission Levels Management</h1>
            <p>
                Create, edit and manage user permission profiles. Each permission level must have a unique name.
            </p>
        </div>

        <div class="hero-stats">
            <div class="stat-card">
                <span>Total Levels</span>
                <strong>@PermisosLista.Count</strong>
            </div>

            <div class="stat-card">
                <span>Current Mode</span>
                <strong>@(PermisoActual.Id > 0 ? "Editing" : "Creating")</strong>
            </div>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(Mensaje))
    {
        <div class="alert-box @TipoMensaje">
            @Mensaje
        </div>
    }

    <section class="form-card">
        <div class="section-header">
            <div>
                <h2>@(PermisoActual.Id > 0 ? "Edit Permission Level" : "Create Permission Level")</h2>
                <p>
                    Enter the permission name and select the allowed actions for this profile.
                </p>
            </div>

            <div class="header-actions">
                <button type="button" class="btn-light" @onclick="NuevoPermiso">
                    ✨ New
                </button>
            </div>
        </div>

        <div class="form-grid">
            <div class="form-group full">
                <label>Permission Name</label>

                <input class="form-control"
                       placeholder="Example: Administrator, Supervisor, Evaluator..."
                       @bind="PermisoActual.Name"
                       @bind:event="oninput" />

                <small>
                    This name is unique. It will identify the permission level assigned to users.
                </small>
            </div>
        </div>
    </section>

    <section class="summary-grid">
        <div class="summary-card">
            <span>Users</span>
            <strong>@TotalUsers</strong>
            <small>permissions selected</small>
        </div>

        <div class="summary-card">
            <span>Books</span>
            <strong>@TotalBooks</strong>
            <small>permissions selected</small>
        </div>

        <div class="summary-card">
            <span>Assignments</span>
            <strong>@TotalAssignments</strong>
            <small>permissions selected</small>
        </div>

        <div class="summary-card">
            <span>Evaluations</span>
            <strong>@TotalEvaluations</strong>
            <small>permissions selected</small>
        </div>

        <div class="summary-card">
            <span>Employees</span>
            <strong>@TotalEmployees</strong>
            <small>permissions selected</small>
        </div>

        <div class="summary-card late-work-summary">
            <span>Late Work</span>
            <strong>@TotalLateWork</strong>
            <small>permissions selected</small>
        </div>

        <div class="summary-card">
            <span>System</span>
            <strong>@TotalSystem</strong>
            <small>permissions selected</small>
        </div>
    </section>

    <section class="permissions-grid">

        <div class="permission-block">
            <div class="block-header">
                <div>
                    <h2>👤 Users</h2>
                    <p>Manage user registration and maintenance permissions.</p>
                </div>

                <div class="total-box">
                    <span>Total</span>
                    <strong>@TotalUsers</strong>
                </div>
            </div>

            <div class="toggles-container">

                <div class="toggle-item">
                    <label class="switch">
                        <input type="checkbox" @bind="PermisoActual.CreateUser" />
                        <span class="slider"></span>
                    </label>
                    <span>Create User</span>
                </div>

                <div class="toggle-item">
                    <label class="switch">
                        <input type="checkbox" @bind="PermisoActual.EditUser" />
                        <span class="slider"></span>
                    </label>
                    <span>Edit User</span>
                </div>

                <div class="toggle-item">
                    <label class="switch">
                        <input type="checkbox" @bind="PermisoActual.DeleteUser" />
                        <span class="slider"></span>
                    </label>
                    <span>Delete User</span>
                </div>

                @if (PuedeAdministrarUnlockUsers)
                {
                    <div class="toggle-item">
                        <label class="switch">
                            <input type="checkbox" @bind="PermisoActual.UnlockUsers" />
                            <span class="slider"></span>
                        </label>
                        <span>Unlock Users</span>
                    </div>
                }

            </div>
        </div>

        <div class="permission-block">
            <div class="block-header">
                <div>
                    <h2>📚 Books</h2>
                    <p>Manage books creation, edition, deletion and visibility.</p>
                </div>

                <div class="total-box">
                    <span>Total</span>
                    <strong>@TotalBooks</strong>
                </div>
            </div>

            <div class="toggles-container">

                <div class="toggle-item">
                    <label class="switch">
                        <input type="checkbox" @bind="PermisoActual.CreateBook" />
                        <span class="slider"></span>
                    </label>
                    <span>Create Book</span>
                </div>

                <div class="toggle-item">
                    <label class="switch">
                        <input type="checkbox" @bind="PermisoActual.EditBook" />
                        <span class="slider"></span>
                    </label>
                    <span>Edit Book</span>
                </div>

                <div class="toggle-item">
                    <label class="switch">
                        <input type="checkbox" @bind="PermisoActual.DeleteBook" />
                        <span class="slider"></span>
                    </label>
                    <span>Delete Book</span>
                </div>

                <div class="toggle-item">
                    <label class="switch">
                        <input type="checkbox" @bind="PermisoActual.BooksView" />
                        <span class="slider"></span>
                    </label>
                    <span>Books View</span>
                </div>

            </div>
        </div>

        <div class="permission-block">
            <div class="block-header">
                <div>
                    <h2>🗂️ Assignments</h2>
                    <p>Manage book assignment and assignment visualization.</p>
                </div>

                <div class="total-box">
                    <span>Total</span>
                    <strong>@TotalAssignments</strong>
                </div>
            </div>

            <div class="toggles-container">

                <div class="toggle-item">
                    <label class="switch">
                        <input type="checkbox" @bind="PermisoActual.CreateAssignations" />
                        <span class="slider"></span>
                    </label>
                    <span>Create Assignations</span>
                </div>

                <div class="toggle-item">
                    <label class="switch">
                        <input type="checkbox" @bind="PermisoActual.AsignBook" />
                        <span class="slider"></span>
                    </label>
                    <span>Assign Book</span>
                </div>

                <div class="toggle-item">
                    <label class="switch">
                        <input type="checkbox" @bind="PermisoActual.ViewAssignations" />
                        <span class="slider"></span>
                    </label>
                    <span>View Assignations</span>
                </div>

            </div>
        </div>

        <div class="permission-block">
            <div class="block-header">
                <div>
                    <h2>✅ Evaluations</h2>
                    <p>Permission to qualify assignment evaluations.</p>
                </div>

                <div class="total-box">
                    <span>Total</span>
                    <strong>@TotalEvaluations</strong>
                </div>
            </div>

            <div class="toggles-container">

                <div class="toggle-item">
                    <label class="switch">
                        <input type="checkbox" @bind="PermisoActual.QualifyBook" />
                        <span class="slider"></span>
                    </label>
                    <span>Qualify Book</span>
                </div>

            </div>
        </div>

        <div class="permission-block">
            <div class="block-header">
                <div>
                    <h2>👥 Employees</h2>
                    <p>Manage employee creation, edition and deletion.</p>
                </div>

                <div class="total-box">
                    <span>Total</span>
                    <strong>@TotalEmployees</strong>
                </div>
            </div>

            <div class="toggles-container">

                <div class="toggle-item">
                    <label class="switch">
                        <input type="checkbox" @bind="PermisoActual.CreateEmployees" />
                        <span class="slider"></span>
                    </label>
                    <span>Create Employees</span>
                </div>

                <div class="toggle-item">
                    <label class="switch">
                        <input type="checkbox" @bind="PermisoActual.EditEmployees" />
                        <span class="slider"></span>
                    </label>
                    <span>Edit Employees</span>
                </div>

                <div class="toggle-item">
                    <label class="switch">
                        <input type="checkbox" @bind="PermisoActual.DeleteEmployees" />
                        <span class="slider"></span>
                    </label>
                    <span>Delete Employees</span>
                </div>

                <div class="toggle-item">
                    <label class="switch">
                        <input type="checkbox" @bind="PermisoActual.ViewEmployees" />
                        <span class="slider"></span>
                    </label>
                    <span>View Employees</span>
                </div>

            </div>
        </div>

        <div class="permission-block late-work-block">
            <div class="block-header">
                <div>
                    <h2>⏱️ Late Work</h2>
                    <p>Manage access to late work activities registration, edition, deletion and completion.</p>
                </div>

                <div class="total-box">
                    <span>Total</span>
                    <strong>@TotalLateWork</strong>
                </div>
            </div>

            <div class="toggles-container">

                <div class="toggle-item">
                    <label class="switch">
                        <input type="checkbox" @bind="PermisoActual.LateWork" />
                        <span class="slider"></span>
                    </label>
                    <span>Late Work View</span>
                </div>

                <div class="toggle-item">
                    <label class="switch">
                        <input type="checkbox" @bind="PermisoActual.CreateLateWork" />
                        <span class="slider"></span>
                    </label>
                    <span>Create Late Work</span>
                </div>

                <div class="toggle-item">
                    <label class="switch">
                        <input type="checkbox" @bind="PermisoActual.EditLateWork" />
                        <span class="slider"></span>
                    </label>
                    <span>Edit Late Work</span>
                </div>

                <div class="toggle-item">
                    <label class="switch">
                        <input type="checkbox" @bind="PermisoActual.DeleteLateWork" />
                        <span class="slider"></span>
                    </label>
                    <span>Delete Late Work</span>
                </div>

                <div class="toggle-item">
                    <label class="switch">
                        <input type="checkbox" @bind="PermisoActual.CompleteLateWork" />
                        <span class="slider"></span>
                    </label>
                    <span>Complete Late Work</span>
                </div>

            </div>
        </div>

        <div class="permission-block">
            <div class="block-header">
                <div>
                    <h2>⚙️ System</h2>
                    <p>Administrative permissions related to permission levels.</p>
                </div>

                <div class="total-box">
                    <span>Total</span>
                    <strong>@TotalSystem</strong>
                </div>
            </div>

            <div class="toggles-container">

                <div class="toggle-item">
                    <label class="switch">
                        <input type="checkbox" @bind="PermisoActual.EditPermissionLevels" />
                        <span class="slider"></span>
                    </label>
                    <span>Edit Permission Levels</span>
                </div>

                <div class="toggle-item">
                    <label class="switch">
                        <input type="checkbox" @bind="PermisoActual.ViewAllEmployeeTypes" />
                        <span class="slider"></span>
                    </label>
                    <span>View All Employee Types</span>
                </div>

            </div>
        </div>

    </section>

    <section class="form-card">
        <div class="section-header actions-section">
            <div>
                <h2>@(PermisoActual.Id > 0 ? "Update Permission Level" : "Save Permission Level")</h2>
                <p>
                    Save the current permission profile or clear the form to create another one.
                </p>
            </div>

            <div class="header-actions">
                <button type="button"
                        class="btn-primary"
                        disabled="@Guardando"
                        @onclick="GuardarPermisoAsync">
                    @(Guardando ? "Saving..." : PermisoActual.Id > 0 ? "Update Permission" : "Save Permission")
                </button>

                <button type="button" class="btn-light" @onclick="NuevoPermiso">
                    Clear
                </button>

                <button type="button" class="btn-light" @onclick="SeleccionarTodos">
                    Select All
                </button>

                <button type="button" class="btn-light" @onclick="QuitarTodos">
                    Clear Permissions
                </button>

                <button type="button"
                        class="btn-danger"
                        disabled="@(PermisoActual.Id == 0 || Guardando)"
                        @onclick="SolicitarEliminarPermiso">
                    Delete
                </button>
            </div>
        </div>
    </section>

    <section class="list-card">
        <div class="section-header table-header">
            <div>
                <h2>Permission Levels History</h2>
                <p>Double click on a row to load and edit a permission level.</p>
            </div>

            <div class="list-filters">
                <div class="search-box">
                    <span>🔎</span>
                    <input placeholder="Search by permission name..."
                           @bind="Busqueda"
                           @bind:event="oninput" />
                </div>

                <button type="button" class="btn-filter-clear" @onclick="LimpiarFiltros">
                    Clear
                </button>
            </div>
        </div>

        @if (Cargando)
        {
            <div class="loading-state">
                Loading permission levels...
            </div>
        }
        else if (!PermisosFiltrados.Any())
        {
            <div class="empty-state">
                <strong>No permission levels to display.</strong>
                <span>Create a new permission level or change the search filter.</span>
            </div>
        }
        else
        {
            <div class="table-container">
                <table class="permissions-table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Permission Name</th>
                            <th>Users</th>
                            <th>Books</th>
                            <th>Assignments</th>
                            <th>Evaluations</th>
                            <th>Employees</th>
                            <th>Late Work</th>
                            <th>System</th>
                            <th>Total</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in PermisosFiltrados)
                        {
                            <tr class="@(PermisoActual.Id == item.Id ? "selected-row" : "")"
                                @ondblclick="() => SeleccionarPermisoAsync(item.Id)">
                                <td data-label="ID">
                                    <span class="id-pill">@item.Id</span>
                                </td>

                                <td data-label="Permission Name">
                                    <div class="permission-title">
                                        <strong>@item.Name</strong>
                                    </div>
                                </td>

                                <td data-label="Users">@ContarGrupoUsers(item)</td>
                                <td data-label="Books">@ContarGrupoBooks(item)</td>
                                <td data-label="Assignments">@ContarGrupoAssignments(item)</td>
                                <td data-label="Evaluations">@ContarGrupoEvaluations(item)</td>
                                <td data-label="Employees">@ContarGrupoEmployees(item)</td>
                                <td data-label="Late Work">@ContarGrupoLateWork(item)</td>
                                <td data-label="System">@ContarGrupoSystem(item)</td>

                                <td data-label="Total">
                                    <strong class="total-permissions">
                                        @ContarTotalPermisos(item)
                                    </strong>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

</div>

@if (MostrarModalResultadoPermiso)
{
    <div class="permission-result-modal-overlay"
         role="presentation"
         @onclick="CerrarModalResultadoPermiso">

        <div class="permission-result-modal-card @TipoModalResultadoPermiso"
             role="dialog"
             aria-modal="true"
             aria-labelledby="permissionResultModalTitle"
             @onclick:stopPropagation="true">

            <div class="permission-result-modal-accent"></div>

            <div class="permission-result-modal-content">
                <div class="permission-result-modal-icon" aria-hidden="true">
                    @if (TipoModalResultadoPermiso == "success")
                    {
                        <svg viewBox="0 0 24 24">
                            <path d="M20 6 9 17l-5-5"></path>
                        </svg>
                    }
                    else
                    {
                        <svg viewBox="0 0 24 24">
                            <circle cx="12" cy="12" r="9"></circle>
                            <path d="M12 7v6"></path>
                            <path d="M12 17h.01"></path>
                        </svg>
                    }
                </div>

                <div class="permission-result-modal-copy">
                    <span class="permission-result-modal-eyebrow">Permission Levels</span>
                    <h3 id="permissionResultModalTitle">@TituloModalResultadoPermiso</h3>
                    <p>@MensajeModalResultadoPermiso</p>
                </div>
            </div>

            <div class="permission-result-modal-actions">
                <button type="button"
                        class="permission-result-modal-ok"
                        @onclick="CerrarModalResultadoPermiso">
                    OK
                </button>
            </div>
        </div>
    </div>
}

@if (MostrarConfirmacionEliminar)
{
    <div class="permission-delete-modal-overlay"
         role="presentation"
         @onclick="CancelarEliminacion">

        <div class="permission-delete-modal-card"
             role="dialog"
             aria-modal="true"
             aria-labelledby="permissionDeleteModalTitle"
             @onclick:stopPropagation="true">

            <div class="permission-delete-modal-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                    <path d="M4 7h16"></path>
                    <path d="M9 7V4h6v3"></path>
                    <path d="M7 7l1 13h8l1-13"></path>
                    <path d="M10 11v5"></path>
                    <path d="M14 11v5"></path>
                </svg>
            </div>

            <div class="permission-delete-modal-copy">
                <span>Delete permission level</span>
                <h3 id="permissionDeleteModalTitle">Delete “@PermisoActual.Name”?</h3>
                <p>
                    This action permanently removes the permission level. It cannot be undone.
                </p>
            </div>

            <div class="permission-delete-summary">
                <div>
                    <span>Permission level</span>
                    <strong>@PermisoActual.Name</strong>
                </div>

                <div>
                    <span>Enabled permissions</span>
                    <strong>@ContarTotalPermisos(PermisoActual)</strong>
                </div>
            </div>

            <div class="permission-delete-warning">
                The level cannot be deleted while it is assigned to one or more users.
            </div>

            <div class="permission-delete-modal-actions">
                <button type="button"
                        class="permission-delete-cancel"
                        disabled="@Guardando"
                        @onclick="CancelarEliminacion">
                    Cancel
                </button>

                <button type="button"
                        class="permission-delete-confirm"
                        disabled="@Guardando"
                        @onclick="ConfirmarEliminarPermisoAsync">
                    @(Guardando ? "Deleting..." : "Delete Permission Level")
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<Permisos> PermisosLista { get; set; } = new();
    private Permisos PermisoActual { get; set; } = new();

    private string Mensaje { get; set; } = string.Empty;
    private string TipoMensaje { get; set; } = "success";
    private string Busqueda { get; set; } = string.Empty;

    private bool Cargando { get; set; } = true;
    private bool Guardando { get; set; } = false;

    private bool MostrarModalResultadoPermiso { get; set; }
    private string TituloModalResultadoPermiso { get; set; } = string.Empty;
    private string MensajeModalResultadoPermiso { get; set; } = string.Empty;
    private string TipoModalResultadoPermiso { get; set; } = "success";

    private bool MostrarConfirmacionEliminar { get; set; }

    private ClaimsPrincipal? _user;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _user = authState.User;

        await CargarPermisosAsync();
        NuevoPermiso();
    }

    private bool PuedeAdministrarUnlockUsers =>
    _user != null && HasPermission(_user, "UnlockUsers");

    private static bool HasPermission(ClaimsPrincipal user, string claimType)
    {
        return string.Equals(
            user.FindFirst(claimType)?.Value,
            "True",
            StringComparison.OrdinalIgnoreCase);
    }

    private async Task CargarPermisosAsync()
    {
        try
        {
            Cargando = true;

            await using var db = await DbFactory.CreateDbContextAsync();

            PermisosLista = await db.Set<Permisos>()
                .AsNoTracking()
                .OrderBy(x => x.Name)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            MostrarMensaje($"Error loading permission levels: {ex.Message}", "error");
        }
        finally
        {
            Cargando = false;
        }
    }

    private IEnumerable<Permisos> PermisosFiltrados
    {
        get
        {
            IEnumerable<Permisos> query = PermisosLista;

            if (!string.IsNullOrWhiteSpace(Busqueda))
            {
                var filtro = Busqueda.Trim().ToUpperInvariant();

                query = query.Where(x =>
                    (x.Name ?? string.Empty).ToUpperInvariant().Contains(filtro) ||
                    x.Id.ToString().Contains(filtro));
            }

            return query;
        }
    }

    private async Task SeleccionarPermisoAsync(int id)
    {
        try
        {
            LimpiarMensaje();

            await using var db = await DbFactory.CreateDbContextAsync();

            var permiso = await db.Set<Permisos>()
                .AsNoTracking()
                .FirstOrDefaultAsync(x => x.Id == id);

            if (permiso is null)
            {
                MostrarMensaje("Permission level not found.", "error");
                return;
            }

            PermisoActual = CopiarPermiso(permiso);
        }
        catch (Exception ex)
        {
            MostrarMensaje($"Error selecting permission level: {ex.Message}", "error");
        }
    }

    private void NuevoPermiso()
    {
        PermisoActual = new Permisos
        {
            Id = 0,
            Name = string.Empty
        };

        LimpiarMensaje();
    }

    private async Task GuardarPermisoAsync()
    {
        try
        {
            Guardando = true;
            LimpiarMensaje();

            var nombreLimpio = PermisoActual.Name?.Trim() ?? string.Empty;

            if (string.IsNullOrWhiteSpace(nombreLimpio))
            {
                MostrarMensaje("Permission name is required.", "error");
                return;
            }

            await using var db = await DbFactory.CreateDbContextAsync();

            var existeNombre = await db.Set<Permisos>()
                .AsNoTracking()
                .AnyAsync(x =>
                    x.Id != PermisoActual.Id &&
                    x.Name.ToLower() == nombreLimpio.ToLower());

            if (existeNombre)
            {
                MostrarMensaje("A permission level with this name already exists.", "error");
                return;
            }

            if (PermisoActual.Id == 0)
            {
                var nuevo = CopiarPermiso(PermisoActual);
                nuevo.Id = 0;
                nuevo.Name = nombreLimpio;

                db.Set<Permisos>().Add(nuevo);
                await db.SaveChangesAsync();

                NuevoPermiso();

                MostrarMensaje("Permission level created successfully.", "success");
            }
            else
            {
                var permisoDb = await db.Set<Permisos>()
                    .FirstOrDefaultAsync(x => x.Id == PermisoActual.Id);

                if (permisoDb is null)
                {
                    MostrarMensaje("Permission level not found.", "error");
                    return;
                }

                permisoDb.Name = nombreLimpio;

                permisoDb.CreateUser = PermisoActual.CreateUser;
                permisoDb.EditUser = PermisoActual.EditUser;
                permisoDb.DeleteUser = PermisoActual.DeleteUser;

                if (PuedeAdministrarUnlockUsers)
                {
                    permisoDb.UnlockUsers = PermisoActual.UnlockUsers;
                }

                permisoDb.CreateBook = PermisoActual.CreateBook;
                permisoDb.EditBook = PermisoActual.EditBook;
                permisoDb.DeleteBook = PermisoActual.DeleteBook;
                permisoDb.AsignBook = PermisoActual.AsignBook;
                permisoDb.BooksView = PermisoActual.BooksView;
                permisoDb.QualifyBook = PermisoActual.QualifyBook;

                permisoDb.CreateEmployees = PermisoActual.CreateEmployees;
                permisoDb.EditEmployees = PermisoActual.EditEmployees;
                permisoDb.DeleteEmployees = PermisoActual.DeleteEmployees;
                permisoDb.ViewEmployees = PermisoActual.ViewEmployees;

                permisoDb.EditPermissionLevels = PermisoActual.EditPermissionLevels;
                permisoDb.ViewAllEmployeeTypes = PermisoActual.ViewAllEmployeeTypes;
                permisoDb.ViewAssignations = PermisoActual.ViewAssignations;
                permisoDb.CreateAssignations = PermisoActual.CreateAssignations;

                permisoDb.LateWork = PermisoActual.LateWork;
                permisoDb.CreateLateWork = PermisoActual.CreateLateWork;
                permisoDb.EditLateWork = PermisoActual.EditLateWork;
                permisoDb.DeleteLateWork = PermisoActual.DeleteLateWork;
                permisoDb.CompleteLateWork = PermisoActual.CompleteLateWork;

                await db.SaveChangesAsync();

                NuevoPermiso();

                MostrarMensaje("Permission level updated successfully.", "success");
            }

            await CargarPermisosAsync();
        }
        catch (DbUpdateException)
        {
            MostrarMensaje("This permission name already exists or there was a database error while saving.", "error");
        }
        catch (Exception ex)
        {
            MostrarMensaje($"Error saving permission level: {ex.Message}", "error");
        }
        finally
        {
            Guardando = false;
        }
    }

    private void SolicitarEliminarPermiso()
    {
        if (PermisoActual.Id == 0 || Guardando)
            return;

        LimpiarMensaje();
        MostrarConfirmacionEliminar = true;
    }

    private void CancelarEliminacion()
    {
        if (Guardando)
            return;

        MostrarConfirmacionEliminar = false;
    }

    private async Task ConfirmarEliminarPermisoAsync()
    {
        if (PermisoActual.Id == 0 || Guardando)
            return;

        MostrarConfirmacionEliminar = false;

        try
        {
            Guardando = true;
            LimpiarMensaje();

            await using var db = await DbFactory.CreateDbContextAsync();

            var permisoDb = await db.Set<Permisos>()
                .Include(x => x.Usuarios)
                .FirstOrDefaultAsync(x => x.Id == PermisoActual.Id);

            if (permisoDb is null)
            {
                MostrarMensaje("Permission level not found.", "error");
                return;
            }

            if (permisoDb.Usuarios.Any())
            {
                MostrarMensaje(
                    "This permission level cannot be deleted because it is assigned to one or more users.",
                    "error");
                return;
            }

            db.Set<Permisos>().Remove(permisoDb);
            await db.SaveChangesAsync();

            NuevoPermiso();
            await CargarPermisosAsync();

            MostrarMensaje("Permission level deleted successfully.", "success");
        }
        catch (Exception ex)
        {
            MostrarMensaje($"Error deleting permission level: {ex.Message}", "error");
        }
        finally
        {
            Guardando = false;
        }
    }

